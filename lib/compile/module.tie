type tie<class>
// 模块产物分离：主 IR 由正常编译链完整生成后，把模块函数的 define 块
// 抽成独立 .ll，主 IR 只留 declare；链接期 clang 合并多个 .ll。
// 模块边界由 LLVM 链接保证，主单元不持有模块实现。
import "../support/text.tie"
import "./modstate.tie"
namespace modunit;

func sym_hit(syms: table<string>, s: string) -> bool {
    var i: i64 = 0
    while i < len(syms) {
        if syms[i] == s {
            return true
        }
        i = i + 1
    }
    return false
}

pub func split_main_ir(ll: string, out_prefix: string) -> string {
    var syms = modstate.syms()
    var all = modstate.all_syms()
    var lines = tie.support::split_char(ll, "\n")
    // 主 .ll 可达近万行，逐行字符串累加是 O(n²)：一律走 sb 通道。
    var head = string_builder()
    var mods = string_builder()
    var main = string_builder()
    var mod_count: i64 = 0
    var i: i64 = 0
    while i < len(lines) {
        var ln = lines[i]
        if tie.support::has_prefix(str.clone(ln), "define ") {
            var at = tie.support::find_char(str.clone(ln), "@")
            var lp = tie.support::find_char(str.clone(ln), "(")
            var sym = ""
            if at >= 0 && lp > at {
                sym = tie.support::slice(str.clone(ln), at + 1, lp)
            }
            var mline = ln
            if sym_hit(syms, sym) {
                // pub 导出函数：去掉 internal，成为模块对外的链接符号。
                if tie.support::has_prefix(str.clone(mline), "define internal ") {
                    mline = "define " + tie.support::slice(str.clone(mline), 16, str_len(mline))
                }
            } else if sym_hit(all, sym) {
                // 非 pub 辅助函数：强制 internal，模块 .ll 内可见、链接期外部不可见。
                // （lib/class 角色关闭了裁剪，llvmgen 不会自动标 internal。）
                if tie.support::has_prefix(str.clone(mline), "define ") {
                    if !tie.support::has_prefix(str.clone(mline), "define internal ") {
                        mline = "define internal " + tie.support::slice(str.clone(mline), 7, str_len(mline))
                    }
                }
            }
            var block = string_builder()
            sb_append(block, mline + "\n")
            i = i + 1
            while i < len(lines) {
                sb_append(block, lines[i] + "\n")
                if lines[i] == "}" {
                    break
                }
                i = i + 1
            }
            i = i + 1
            var btext = sb_build(block)
            if sym_hit(all, sym) {
                sb_append(mods, btext)
                mod_count = mod_count + 1
                if sym_hit(syms, sym) {
                    var brace = tie.support::find_char(str.clone(ln), "{")
                    var sig = tie.support::slice(str.clone(ln), 7, brace)
                    if tie.support::has_prefix(str.clone(sig), "internal ") {
                        sig = tie.support::slice(str.clone(sig), 9, str_len(sig))
                    }
                    modstate.add_decl("declare " + sig + "\n")
                }
            } else {
                sb_append(main, btext)
            }
            continue
        }
        // 模块命名空间的全局定义随模块 .ll 走；主 .ll 只留 external 声明，
        // 避免两个 .ll 重复定义。tie 的全局初始化集中在主入口（按 external
        // 符号引用），链接后仍是同一份全局，语义不变。
        if tie.support::has_prefix(str.clone(ln), "@") {
            var gsym = ""
            var sp = tie.support::slice(str.clone(ln), 1, str_len(ln))
            var eqp = tie.support::find_char(str.clone(sp), " ")
            if eqp > 0 {
                gsym = tie.support::slice(str.clone(sp), 0, eqp)
            }
            if str_len(gsym) > 0 && modstate.is_mod_sym(gsym) {
                // 行格式固定：`@sym = global <ty> <init>`；按 `= global ` 定长偏移
                // 解析类型，不依赖子串搜索（text 库只有单字符 find_char）。
                var s2 = tie.support::slice(str.clone(sp), eqp + 1, str_len(sp))
                if tie.support::has_prefix(str.clone(s2), "= global ") {
                    var tyrest = tie.support::slice(str.clone(s2), 9, str_len(s2))
                    var tyend = tie.support::find_char(str.clone(tyrest), " ")
                    var gty = tyrest
                    if tyend > 0 {
                        gty = tie.support::slice(str.clone(tyrest), 0, tyend)
                    }
                    var comma = tie.support::find_char(str.clone(gty), ",")
                    if comma > 0 {
                        gty = tie.support::slice(str.clone(gty), 0, comma)
                    }
                    if str_len(gty) > 0 && tie.support::find_char(str.clone(gty), "[") < 0 {
                        sb_append(mods, ln + "\n")
                        mod_count = mod_count + 1
                        sb_append(main, "@" + gsym + " = external global " + gty + "\n")
                        i = i + 1
                        continue
                    }
                }
                modstate.set_err("模块全局类型暂不支持产物分离: " + ln)
                return ""
            }
        }
        sb_append(head, ln + "\n")
        sb_append(main, ln + "\n")
        i = i + 1
    }
    if mod_count > 0 {
        var out = out_prefix + "0.ll"
        if !file_write(out, sb_build(head) + sb_build(mods)) {
            modstate.set_err("模块 IR 写盘失败: " + out)
            return ""
        }
        modstate.add_ll(out)
    }
    return sb_build(main) + "\n" + modstate.declares_text()
}
