type tie<class>
// lib/support/diag/locale.tie —— 诊断消息的语言切换层
// ============================================================
// 消息文本按「诊断族」集中成函数：调用点只传结构化参数（名字、类型名、个数），
// 语言选择由 diagcode.cur_lang() 决定（CLI: --lang=<code>）。
// 码与文本彻底解耦：码由调用点显式登记（ERR:E#####:…），本文件只产出文本。
//
// 新增语言的做法：在对应函数里加一个分支，而不是复制整个消息目录。
import "./diagcode.tie"
import "./locdata.tie"

// 语言包目录（data/locale 的父级解析结果），由 driver 在解析参数后登记；
// 未登记时只在 "data/locale" 上尝试，读不到就整体回落内置消息。
// 键表/值表由本文件持有（locdata 无状态，只做解析与查表）。
pub var g_pack_dir: string = ""
pub var g_pack_lang: string = ""
pub var g_pack_rc: i64 = -1
var g_pack_keys: table<string> = []
var g_pack_vals: table<string> = []

pub func set_pack_dir(d: string) -> i64 {
    g_pack_dir = d
    g_pack_lang = ""
    return 0
}

// 把模板里的 <名字> 占位符换成实参（只做字面替换，不做转义）。
func fill_tok(t: string, k: string, v: string) -> string {
    var out = ""
    var n = str_len(t)
    var i = 0
    var pat = "<" + k + ">"
    var m = str_len(pat)
    while i < n {
        if i + m <= n && str.slice(t, i, i + m) == pat {
            out = out + v
            i = i + m
        } else {
            out = out + str_char(t, i)
            i = i + 1
        }
    }
    return out
}

// 按当前语言惰性载入语言包；语言变化即重载。载入码留在 g_pack_rc。
unsafe func ensure_pack() {
    var l = diagcode.cur_lang()
    if l == g_pack_lang {
        return
    }
    g_pack_lang = l
    g_pack_rc = -1
    g_pack_keys = []
    g_pack_vals = []
    if str_len(g_pack_dir) > 0 {
        g_pack_rc = locdata.load_into(g_pack_dir + "/" + l + ".td", g_pack_keys, g_pack_vals)
        if g_pack_rc == 0 {
            return
        }
    }
    g_pack_rc = locdata.load_into("data/locale/" + l + ".td", g_pack_keys, g_pack_vals)
}

// 取语言包模板（未命中返回空串，调用方回落内置消息）。
func pack_msg(key: string) -> string {
    unsafe { ensure_pack() }
    var t = ""
    unsafe { t = locdata.lookup(g_pack_keys, g_pack_vals, key) }
    return t
}

// 变量初始化类型不匹配（E00377）。
pub func msg_var_type_mismatch(nm: string, ann: string, got: string) -> string {
    var pt = pack_msg("E00377.msg")
    if str_len(pt) > 0 {
        return fill_tok(fill_tok(fill_tok(pt, "nm", nm), "ann", ann), "got", got)
    }
    if diagcode.cur_lang() == "en-US" {
        return "variable '" + nm + "' type mismatch: annotated " + ann + ", but the expression infers " + got
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "變數 '" + nm + "' 類型不符：標註 " + ann + "，運算式推導為 " + got
    }
    return "变量 '" + nm + "' 类型不匹配：标注 " + ann + "，表达式推导为 " + got
}

// 数组字面量元素个数/元素类型与标注不符（同属 E00377 族）。
pub func msg_var_array_mismatch(nm: string, ann: string, need: string, actual: string, elemt: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "variable '" + nm + "' type mismatch: annotated " + ann + "; an array literal needs " + need + " elements (got " + actual + "), each of type " + elemt
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "變數 '" + nm + "' 類型不符：標註 " + ann + "；陣列常值元素個數必須為 " + need + "（實際 " + actual + "），且元素類型必須與 " + elemt + " 一致"
    }
    return "变量 '" + nm + "' 类型不匹配：标注 " + ann + "；数组字面量元素个数必须为 " + need + "（实际 " + actual + "），且元素类型必须与 " + elemt + " 一致"
}
// 未定义函数（E00489）。
pub func msg_undef_func(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "undefined function '" + nm + "'"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "未定義的函式 '" + nm + "'"
    }
    return "未定义的函数 '" + nm + "'"
}

// 调用实参类型不匹配（E00588）。
pub func msg_call_arg_mismatch(nm: string, want: string, got: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "call to '" + nm + "' has a mismatched argument type: expected " + want + ", got " + got
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "呼叫 '" + nm + "' 參數類型不符：期望 " + want + "，實際 " + got
    }
    return "调用 '" + nm + "' 参数类型不匹配：期望 " + want + "，实际 " + got
}
// 复合赋值类型不匹配（E00406）。
pub func msg_compound_assign_mismatch(target: string, expr: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "compound assignment type mismatch: target is " + target + ", expression is " + expr
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "複合指派類型不符：目標類型 " + target + " 與運算式 " + expr
    }
    return "复合赋值类型不匹配：目标类型 " + target + " 与表达式 " + expr
}

// 类型未定义（E00554）。
pub func msg_undef_type(nm: string) -> string {
    var pt = pack_msg("E00554.msg")
    if str_len(pt) > 0 {
        return fill_tok(pt, "nm", nm)
    }
    if diagcode.cur_lang() == "en-US" {
        return "undefined type '" + nm + "'"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "未定義的類型 '" + nm + "'"
    }
    return "类型 '" + nm + "' 未定义"
}

// 参数传递约定修饰重复（E00693）。
pub func msg_param_dup_conv(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' repeats a passing-convention modifier (ref/immut/move/deep/shared: at most once each)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 的傳遞約定修飾重複出現（ref/immut/move/deep/shared 各至多一次）"
    }
    return "参数 '" + nm + "' 的传递约定修饰重复出现（ref/immut/move/deep/shared 各至多一次）"
}

// immut 与 ref 互斥（E00690）。
pub func msg_param_immut_ref(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' cannot be both immut and ref (a read-only and a mutable borrow are exclusive)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 不能同時標註 immut 與 ref（唯讀借用與可寫借用互斥）"
    }
    return "参数 '" + nm + "' 不能同时标注 immut 与 ref（只读借用与可写借用互斥）"
}

// move 与 ref/immut 互斥（E00691）。
pub func msg_param_move_ref(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' cannot be move together with ref/immut (ownership is transferred, so nothing is left to borrow)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 不能同時標註 move 與 ref/immut（所有權已移交，無從借用）"
    }
    return "参数 '" + nm + "' 不能同时标注 move 与 ref/immut（所有权已移交，无从借用）"
}

// shared 与 deep 互斥（E00905）。
pub func msg_param_shared_deep(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' cannot be both shared and deep (sharing the same copy and copying on entry are exclusive)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 不能同時標註 shared 與 deep（共享與值拷貝互斥）"
    }
    return "参数 '" + nm + "' 不能同时标注 shared 与 deep（共享与值拷贝互斥）"
}

// ref 参数不能带默认值（E00357）。
pub func msg_param_ref_default(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' is ref, so it cannot have a default value (pass the argument at every call)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 的 ref 參數不能有預設值（必須在呼叫點傳實參）"
    }
    return "参数 '" + nm + "' 的 ref 参数不能有默认值（必须在调用点传实参）"
}

// ref 修饰只支持表与定长数组（E00692）。
pub func msg_param_ref_kind(nm: string, got: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' uses ref, which only applies to table parameters (table/table<T>) or fixed arrays (array<T, N>); it is " + got
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 的 ref 修飾僅支援表參數（table/table<T>）或定長陣列（array<T, N>），實際是 " + got
    }
    return "参数 '" + nm + "' 的 ref 修饰仅支持表参数（table/table<T>）或定长数组（array<T, N>），实际是 " + got
}

// 可选参数必须连续排在必选参数之后（E00360）。
pub func msg_param_optional_order(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' lacks a default value; optional parameters (with defaults) must come after every required one"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 缺少預設值；可選參數（帶預設值）必須連續排在必選參數之後"
    }
    return "参数 '" + nm + "' 缺少默认值：可选参数（带默认值）必须连续排在必选参数之后"
}

// 默认值必须是字面量或编译期常量（E00914）。
pub func msg_param_default_const(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' needs a literal or compile-time constant default (a const reference or constant arithmetic; no calls and no runtime input)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 的預設值必須是字面量或編譯期常數運算式（const 引用／常數算術；不可含呼叫或執行期依賴）"
    }
    return "参数 '" + nm + "' 的默认值必须是字面量或编译期常量表达式（const 引用/常量算术；不可含调用或运行期依赖）"
}

// 默认值类型不匹配（E00361）。
pub func msg_param_default_type(nm: string, want: string, got: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "parameter '" + nm + "' default type mismatch: expected " + want + ", got " + got
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "參數 '" + nm + "' 預設值類型不符：期望 " + want + "，實際 " + got
    }
    return "参数 '" + nm + "' 默认值类型不匹配：期望 " + want + "，实际 " + got
}

// 诊断码说明（--explain=<code>）：成因 + 修法各一句，随 --lang 切换。
// 未知码返回可用码清单，便于脚本探测本版本支持哪些说明。
pub func help_for(dc: string) -> string {
    // 语言包优先：键形如 "E00406.help"；包里有就用包，没有才走内置分支。
    var pt = pack_msg(dc + ".help")
    if str_len(pt) > 0 {
        return pt
    }
    var en = diagcode.cur_lang() == "en-US"
    var tw = diagcode.cur_lang() == "zh-TW"
    if dc == "E00377" {
        if en {
            return "E00377 · type mismatch in a variable or array initializer — the declared type and the inferred type differ; align the annotation with the expression."
        }
        if tw {
            return "E00377 · 變數或陣列初始化的類型不符——標註類型與運算式推導類型不一致；使兩者一致。"
        }
        return "E00377 · 变量或数组初始化的类型不匹配——标注类型与表达式推导类型不一致；使两者一致。"
    }
    if dc == "E00406" {
        if en {
            return "E00406 · compound assignment type mismatch — the target and the expression must share a type; convert one side explicitly."
        }
        if tw {
            return "E00406 · 複合指派類型不符——目標與運算式必須同型；先顯式轉換一側。"
        }
        return "E00406 · 复合赋值类型不匹配——目标与表达式必须同型；先显式转换一侧。"
    }
    if dc == "E00489" {
        if en {
            return "E00489 · undefined function — the name has no declaration in scope; check spelling, imports and namespaces."
        }
        if tw {
            return "E00489 · 未定義的函式——該名稱在此作用域無宣告；檢查拼寫、import 與命名空間。"
        }
        return "E00489 · 未定义的函数——该名字在此作用域没有声明；检查拼写、import 与命名空间。"
    }
    if dc == "E00554" {
        if en {
            return "E00554 · undefined type — the annotation names a type that is not declared; check spelling or define it."
        }
        if tw {
            return "E00554 · 未定義的類型——標註引用了未宣告的型別；檢查拼寫或補上定義。"
        }
        return "E00554 · 类型未定义——标注引用了未声明的类型；检查拼写或补上定义。"
    }
    if dc == "E00588" {
        if en {
            return "E00588 · argument type mismatch in a call — an argument disagrees with the parameter type; pass the declared type."
        }
        if tw {
            return "E00588 · 呼叫引數類型不符——引數與形參型別不一致；依簽章傳參。"
        }
        return "E00588 · 调用实参类型不匹配——实参形参类型不一致；按签名传参。"
    }
    if dc == "E00357" {
        if en {
            return "E00357 · a ref parameter cannot carry a default value — pass the argument at every call"
        }
        if tw {
            return "E00357 · ref 參數不能有預設值——每次呼叫都要傳實參"
        }
        return "E00357 · ref 参数不能有默认值——每次调用都要传实参"
    }
    if dc == "E00360" {
        if en {
            return "E00360 · a required parameter follows an optional one — move every defaulted parameter to the end"
        }
        if tw {
            return "E00360 · 必選參數排在可選參數之後——把帶預設值的參數集中到最後"
        }
        return "E00360 · 必选参数排在可选参数之后——把带默认值的参数集中到最后"
    }
    if dc == "E00361" {
        if en {
            return "E00361 · a parameter default disagrees with the annotated type — give a literal of that type"
        }
        if tw {
            return "E00361 · 參數預設值與標註型別不符——改用該型別的字面量"
        }
        return "E00361 · 参数默认值与标注类型不符——改用该类型的字面量"
    }
    if dc == "E00690" {
        if en {
            return "E00690 · immut and ref are mutually exclusive — pick read-only or mutable borrowing"
        }
        if tw {
            return "E00690 · immut 與 ref 互斥——只保留唯讀借用或可寫借用之一"
        }
        return "E00690 · immut 与 ref 互斥——只保留只读借用或可写借用之一"
    }
    if dc == "E00691" {
        if en {
            return "E00691 · move cannot be combined with ref/immut — ownership is transferred, so nothing is left to borrow"
        }
        if tw {
            return "E00691 · move 不能與 ref/immut 併用——所有權已移交，無從借用"
        }
        return "E00691 · move 不能与 ref/immut 并用——所有权已移交，无从借用"
    }
    if dc == "E00692" {
        if en {
            return "E00692 · ref only applies to table parameters or fixed arrays — drop ref or change the parameter type"
        }
        if tw {
            return "E00692 · ref 僅適用於表參數或定長陣列——去掉 ref 或改用這兩種型別"
        }
        return "E00692 · ref 仅适用于表参数或定长数组——去掉 ref 或改用这两种类型"
    }
    if dc == "E00693" {
        if en {
            return "E00693 · a passing-convention modifier repeats — each of ref/immut/move/deep/shared may appear once"
        }
        if tw {
            return "E00693 · 傳遞約定修飾重複——ref/immut/move/deep/shared 各只能出現一次"
        }
        return "E00693 · 传递约定修饰重复——ref/immut/move/deep/shared 各只能出现一次"
    }
    if dc == "E00905" {
        if en {
            return "E00905 · shared and deep are mutually exclusive — sharing one copy and copying on entry contradict"
        }
        if tw {
            return "E00905 · shared 與 deep 互斥——共享同一份與入口深拷貝語意對立"
        }
        return "E00905 · shared 与 deep 互斥——共享同一份与入口深拷贝语义对立"
    }
    if dc == "E00914" {
        if en {
            return "E00914 · a parameter default must be a literal or a compile-time constant — no calls, no runtime input"
        }
        if tw {
            return "E00914 · 參數預設值必須是字面量或編譯期常數——不可含呼叫或執行期依賴"
        }
        return "E00914 · 参数默认值必须是字面量或编译期常量——不可含调用或运行期依赖"
    }
    if dc == "E00456" {
        if en {
            return "E00456 · promoting a value to a port/interface object needs an unsafe block or function — the object borrows the concrete value"
        }
        if tw {
            return "E00456 · 提升到 port/interface 物件需在 unsafe 區塊或函式內——物件借用具體值"
        }
        return "E00456 · 提升到 port/interface 对象需在 unsafe 块或函数内——对象借用具体值"
    }
    if dc == "E00556" {
        if en {
            return "E00556 · the type argument does not implement the port the generic bound requires — add `impl P for T`"
        }
        if tw {
            return "E00556 · 型別實參未實作泛型約束要求的 port——補寫 `impl P for T`"
        }
        return "E00556 · 类型实参未实现泛型约束要求的 port——补写 `impl P for T`"
    }
    if dc == "E00557" {
        if en {
            return "E00557 · the type argument does not implement the interface the generic bound requires — add the missing methods in an impl block"
        }
        if tw {
            return "E00557 · 型別實參未實作泛型約束要求的 interface——在 impl 區塊補齊缺少的方法"
        }
        return "E00557 · 类型实参未实现泛型约束要求的 interface——在 impl 块补齐缺少的方法"
    }
    if dc == "E00560" {
        if en {
            return "E00560 · the concrete type does not satisfy the interface, so it cannot be promoted — implement the missing method or fix its signature"
        }
        if tw {
            return "E00560 · 具體型別不滿足 interface，不能提升——實作缺少的方法或修正簽名"
        }
        return "E00560 · 具体类型不满足 interface，不能提升——实现缺少的方法或修正签名"
    }
    if dc == "E00561" {
        if en {
            return "E00561 · the concrete type has no impl for this port, so it cannot be promoted — write `impl P for T` first"
        }
        if tw {
            return "E00561 · 具體型別沒有該 port 的 impl，不能提升——先寫 `impl P for T`"
        }
        return "E00561 · 具体类型没有该 port 的 impl，不能提升——先写 `impl P for T`"
    }
    if dc == "E00112" {
        if en {
            return "E00112 · impl method parameter count differs from the port signature — mirror the port's parameter list"
        }
        if tw {
            return "E00112 · impl 方法參數個數與 port 簽名不符——照 port 的參數列表寫"
        }
        return "E00112 · impl 方法参数个数与 port 签名不符——照 port 的参数列表写"
    }
    if dc == "E00113" {
        if en {
            return "E00113 · impl method parameter type differs from the port signature — make the types identical"
        }
        if tw {
            return "E00113 · impl 方法參數類型與 port 簽名不符——型別必須完全一致"
        }
        return "E00113 · impl 方法参数类型与 port 签名不符——类型必须完全一致"
    }
    if dc == "E00114" {
        if en {
            return "E00114 · impl method has no self receiver — write `func name(self, ...)`"
        }
        if tw {
            return "E00114 · impl 方法缺 self 接收者——寫成 `func name(self, ...)`"
        }
        return "E00114 · impl 方法缺 self 接收者——写成 `func name(self, ...)`"
    }
    if dc == "E00118" {
        if en {
            return "E00118 · the first parameter of an impl method must be named self"
        }
        if tw {
            return "E00118 · impl 方法的第一參數必須命名為 self"
        }
        return "E00118 · impl 方法的第一参数必须命名为 self"
    }
    if dc == "E00120" {
        if en {
            return "E00120 · impl method return type differs from the port signature — align the return types"
        }
        if tw {
            return "E00120 · impl 方法回傳類型與 port 簽名不符——對齊回傳型別"
        }
        return "E00120 · impl 方法返回类型与 port 签名不符——对齐返回类型"
    }
    if dc == "E00210" {
        if en {
            return "E00210 · the impl block is missing a method the port requires — every port method must be implemented"
        }
        if tw {
            return "E00210 · impl 區塊漏掉 port 要求的方法——port 方法必須全部實作"
        }
        return "E00210 · impl 区块漏掉 port 要求的方法——port 方法必须全部实现"
    }
    if dc == "W00002" {
        if en {
            return "W00002 · integer division truncates — the quotient is floored; convert an operand to f64 to keep the fraction."
        }
        if tw {
            return "W00002 · 整數除法截斷——商向下取整會丟失小數；需保留精度請把運算元轉為 f64。"
        }
        return "W00002 · 整数除法截断——商向下取整会丢失小数；需保留精度请把操作数转为 f64。"
    }
    if dc == "W00003" {
        if en {
            return "W00003 · repeated string concatenation — tie strings are immutable, so each `+` copies everything; build long text with string_builder + sb_append + sb_build."
        }
        if tw {
            return "W00003 · 字串串接累積——tie 字串不可變，每次串接都複製全部舊內容；長文字請用 string_builder + sb_append + sb_build。"
        }
        return "W00003 · 字符串拼接累积——tie 字符串不可变，每次拼接都复制全部旧内容；长文本请用 string_builder + sb_append + sb_build。"
    }
    if dc == "W00015" {
        if en {
            return "W00015 · mutable binding never assigned — a `var` that is never written should be `const`."
        }
        if tw {
            return "W00015 · 可變綁定未修改——宣告 var 卻從未賦值，應改用 const。"
        }
        return "W00015 · 可变绑定未修改——声明 var 却从未赋值，应改用 const。"
    }
    if dc == "W00008" {
        if en {
            return "W00008 · variable shadows an outer binding — an inner declaration reuses a name that is already visible; rename one of them."
        }
        if tw {
            return "W00008 · 變數遮蔽——內層宣告沿用外層已可見的名稱；請改名其中一個。"
        }
        return "W00008 · 变量遮蔽——内层声明沿用了外层已可见的名字；请改名其中之一。"
    }
    if dc == "W00012" {
        if en {
            return "W00012 · magic number — a literal other than 0 or 1 used directly in an expression; give it a named constant so the meaning is visible."
        }
        if tw {
            return "W00012 · 魔法數字——運算式直接使用 0/1 以外的字面量；請改用具名常數。"
        }
        return "W00012 · 魔法数字——表达式直接使用 0/1 以外的字面量；请改用具名常量。"
    }
    if dc == "W00014" {
        if en {
            return "W00014 · boolean argument — passing a bool literal hides which branch the parameter selects; use a named constant or split the function."
        }
        if tw {
            return "W00014 · 布林參數呼叫——實參為 bool 字面量，看不出參數代表哪一種語意；請改用常數或拆分函式。"
        }
        return "W00014 · 布尔参数调用——实参是 bool 字面量，看不出参数代表哪种语义；请改用常量或拆分函数。"
    }
    if dc == "W00016" {
        if en {
            return "W00016 · mutable global table used as shared state — several write sites mutate it; pass the table explicitly or keep the writes in one place."
        }
        if tw {
            return "W00016 · 全域可變表被當成共享狀態——多處寫入同一張全域表；請改為顯式傳遞或集中寫入。"
        }
        return "W00016 · 全局可变表被当作共享状态——多处写入同一张全局表；请改为显式传递或集中写入。"
    }
    if dc == "W00017" {
        if en {
            return "W00017 · nesting too deep — control flow is nested beyond five levels; extract the inner block into a function."
        }
        if tw {
            return "W00017 · 巢狀過深——控制流超過五層；請把內層抽成函式。"
        }
        return "W00017 · 嵌套过深——控制流超过五层；请把内层抽成函数。"
    }
    if dc == "W00001" {
        if en {
            return "W00001 · floating-point equality — f64/f32 values are not exact in binary, so == and != often surprise; compare with a tolerance instead (|a-b| < 1e-9)."
        }
        if tw {
            return "W00001 · 浮點相等比較——f64/f32 在二進位下不精確，== 與 != 常出乎意料；請改用容差比較（|a-b| < 1e-9）。"
        }
        return "W00001 · 浮点相等比较——f64/f32 在二进制下不精确，== 与 != 常出乎意料；请改用容差比较（|a-b| < 1e-9）。"
    }
    if dc == "W00004" {
        if en {
            return "W00004 · table copy shares the buffer — `var b = a` copies only the handle, so writes through b are visible through a; clone explicitly when you need an independent copy."
        }
        if tw {
            return "W00004 · 表變數拷貝共用底層——`var b = a` 只複製句柄，透過 b 的修改在 a 也看得到；需要獨立副本請顯式複製。"
        }
        return "W00004 · 表变量拷贝共享底层——`var b = a` 只复制句柄，通过 b 的修改在 a 也看得到；需要独立副本请显式复制。"
    }
    if dc == "W00005" {
        if en {
            return "W00005 · unused variable — declared but never read; delete it, or prefix with an underscore to state the intent."
        }
        if tw {
            return "W00005 · 未使用變數——宣告後從未讀取；請刪除，或以底線前綴表明有意保留。"
        }
        return "W00005 · 未使用变量——声明后从未读取；请删除，或以下划线前缀表明有意保留。"
    }
    if dc == "W00006" {
        if en {
            return "W00006 · unused function — declared but never called; delete it, or check whether a call site is missing."
        }
        if tw {
            return "W00006 · 未使用函式——宣告後從未被呼叫；請刪除，或確認是否漏了呼叫點。"
        }
        return "W00006 · 未使用函数——声明后从未被调用；请删除，或确认是否漏了调用点。"
    }
    if dc == "W00007" {
        if en {
            return "W00007 · unused import — imported but never referenced; drop it to shorten compile time."
        }
        if tw {
            return "W00007 · 未使用 import——匯入後從未引用；移除可縮短編譯時間。"
        }
        return "W00007 · 未使用 import——导入后从未引用；移除可缩短编译时间。"
    }
    if dc == "W00009" {
        if en {
            return "W00009 · unreachable statement — the code after `return` never runs; delete it or move it before the return."
        }
        if tw {
            return "W00009 · 不可達語句——`return` 之後的程式碼永遠不會執行；請刪除或移到 return 之前。"
        }
        return "W00009 · 不可达语句——`return` 之后的代码永远不会执行；请删除或移到 return 之前。"
    }
    if dc == "W00010" {
        if en {
            return "W00010 · empty block — no statements and no comment placeholder; delete it, or add a TODO comment explaining why it stays empty."
        }
        if tw {
            return "W00010 · 空語句區塊——區塊內既無語句也無註解佔位；請刪除，或加入 TODO 註解說明為何留空。"
        }
        return "W00010 · 空语句块——块内既无语句也无注释占位；请删除，或加入 TODO 注释说明为何留空。"
    }
    if dc == "W00011" {
        if en {
            return "W00011 · unused parameter — the parameter is never read; drop it, or prefix it with an underscore to state the intent."
        }
        if tw {
            return "W00011 · 參數未使用——形參從未被讀取；請移除，或以底線前綴表明有意保留。"
        }
        return "W00011 · 参数未使用——形参从未被读取；请移除，或以下划线前缀表明有意保留。"
    }
    if dc == "W00013" {
        if en {
            return "W00013 · mutation while iterating a table — appending or removing inside the loop makes the iteration skip or overrun; collect indices first and mutate after the loop."
        }
        if tw {
            return "W00013 · 遍歷時改表——迴圈內追加或移除元素會讓迭代漏項或越界；請先收集索引，迴圈結束後再改。"
        }
        return "W00013 · 遍历时改表——循环内追加或移除元素会让迭代漏项或越界；请先收集索引，循环结束后再改。"
    }
    if dc == "W00018" {
        if en {
            return "W00018 · integer literal out of range — the literal does not fit the target narrow type; convert explicitly or use a wider type."
        }
        if tw {
            return "W00018 · 整數字面量溢出——字面量超出目標窄型別範圍；請顯式轉換或改用更寬型別。"
        }
        return "W00018 · 整数字面量溢出——字面量超出目标窄类型范围；请显式转换或改用更宽类型。"
    }
    if dc == "W00019" {
        if en {
            return "W00019 · table write past the end — a write with i >= len is discarded; resize or append up to that index first, or fix the index."
        }
        if tw {
            return "W00019 · 表越界寫入——i >= len 的寫入會被丟棄；請先 resize 或追加到該下標，或修正下標。"
        }
        return "W00019 · 表越界写入——i >= len 的写入会被丢弃；请先 resize 或追加到该下标，或修正下标。"
    }
    if dc == "W00024" {
        if en {
            return "W00024 · duplicate declaration — the same name is declared twice and the later one hides the earlier; rename one of them or delete the duplicate."
        }
        if tw {
            return "W00024 · 變數重複宣告——同名變數再次宣告，後者覆蓋前者；請改名或刪除重複宣告。"
        }
        return "W00024 · 变量重复声明——同名变量再次声明，后者覆盖前者；请改名或删除重复声明。"
    }
    if dc == "W00025" {
        if en {
            return "W00025 · constant-false condition — the branch never runs; delete the dead branch or fix the condition."
        }
        if tw {
            return "W00025 · 條件恆假——條件為常數 0/false，該分支永不執行；請刪除死分支或修正條件。"
        }
        return "W00025 · 条件恒假——条件为常量 0/false，该分支永不执行；请删除死分支或修正条件。"
    }
    if dc == "W00026" {
        if en {
            return "W00026 · constant-true condition — the else branch never runs; check whether the condition was written as intended."
        }
        if tw {
            return "W00026 · 條件恆真——條件為常數 true/非零，else 分支永不執行；請確認條件是否寫錯。"
        }
        return "W00026 · 条件恒真——条件为常量 true/非零，else 分支永不执行；请确认条件是否写错。"
    }
    if dc == "W00027" {
        if en {
            return "W00027 · integer division by zero — a literal zero divisor crashes at run time; fix the divisor or guard it."
        }
        if tw {
            return "W00027 · 整數除以零——字面量 0 作除數，執行期必崩；請修正除數或加上保護。"
        }
        return "W00027 · 整数除以零——字面量 0 作除数，运行期必崩；请修正除数或加上保护。"
    }
    if dc == "W00028" {
        if en {
            return "W00028 · switch without default — an unmatched value is silently ignored; add a default branch or state the omission explicitly."
        }
        if tw {
            return "W00028 · switch 缺少 default——未匹配的值會被靜默忽略；請補上 default 分支或明確說明可省略。"
        }
        return "W00028 · switch 缺少 default——未匹配的值会被静默忽略；请补上 default 分支或明确说明可省略。"
    }
    if dc == "W00029" {
        if en {
            return "W00029 · optimization level lowered — O3 did not fit the memory cap, so the build fell back to O2; raise the cap or accept the level."
        }
        if tw {
            return "W00029 · 最佳化檔次自動調降——記憶體上限下 O3 不可用，已降為 O2；提高上限或接受該檔次。"
        }
        return "W00029 · 优化档次自动降级——内存上限下 O3 不可用，已降为 O2；提高上限或接受该档次。"
    }
    if dc == "W00030" {
        if en {
            return "W00030 · unused memory credential — a mem-domain credential is declared but never used in this scope or file; delete the declaration."
        }
        if tw {
            return "W00030 · 憑證掛空——宣告了 mem 域憑證但本作用域或全檔未使用；請刪除該宣告。"
        }
        return "W00030 · 凭据挂空——声明了 mem 域凭据但本作用域或全文件未使用；请删除该声明。"
    }
    if dc == "W00031" {
        if en {
            return "W00031 · rebinding a field of a by-value table parameter — by-value passing copies only the handle, so reassigning the field is invisible to the caller (self-assignment is a no-op); return a new value or mutate through the handle."
        }
        if tw {
            return "W00031 · 按值形參表欄位重綁——按值傳參只複製句柄，重新指派欄位呼叫方看不到（自賦值更是無效）；請改用回傳值或經句柄改內容。"
        }
        return "W00031 · 按值形参表字段重绑定——按值传参只复制句柄，重新赋值字段调用方看不到（自赋值更是无效）；请改用返回值或经句柄改内容。"
    }
    if en {
        return "unknown diagnostic code '" + dc + "'; documented codes: E00112 E00113 E00114 E00118 E00120 E00210 E00357 E00360 E00361 E00377 E00406 E00456 E00489 E00554 E00556 E00557 E00560 E00561 E00588 E00690 E00691 E00692 E00693 E00905 E00914 W00001 W00002 W00003 W00004 W00005 W00006 W00007 W00008 W00009 W00010 W00011 W00012 W00013 W00014 W00015 W00016 W00017 W00018 W00019 W00024 W00025 W00026 W00027 W00028 W00029 W00030 W00031"
    }
    if tw {
        return "未知的診斷碼 '" + dc + "'；已有說明的碼：E00112 E00113 E00114 E00118 E00120 E00210 E00357 E00360 E00361 E00377 E00406 E00456 E00489 E00554 E00556 E00557 E00560 E00561 E00588 E00690 E00691 E00692 E00693 E00905 E00914 W00001 W00002 W00003 W00004 W00005 W00006 W00007 W00008 W00009 W00010 W00011 W00012 W00013 W00014 W00015 W00016 W00017 W00018 W00019 W00024 W00025 W00026 W00027 W00028 W00029 W00030 W00031"
    }
    return "未知的诊断码 '" + dc + "'；已有说明的码：E00112 E00113 E00114 E00118 E00120 E00210 E00357 E00360 E00361 E00377 E00406 E00456 E00489 E00554 E00556 E00557 E00560 E00561 E00588 E00690 E00691 E00692 E00693 E00905 E00914 W00001 W00002 W00003 W00004 W00005 W00006 W00007 W00008 W00009 W00010 W00011 W00012 W00013 W00014 W00015 W00016 W00017 W00018 W00019 W00024 W00025 W00026 W00027 W00028 W00029 W00030 W00031"
}

// 提升到 port/interface 对象需要 unsafe/mem 凭据（E00456）。
pub func msg_promote_needs_unsafe(sname: string, pname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "promoting '" + sname + "' to port '" + pname + "' requires an unsafe block or an unsafe function (an interface object borrows the concrete object, so pointer operations count as unsafe)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "提升 '" + sname + "' 到 port '" + pname + "' 必須在 unsafe 區塊或 unsafe 函式中（介面物件借用具體物件，指標操作歸 unsafe）"
    }
    return "提升 '" + sname + "' 到 port '" + pname + "' 必须在 unsafe 块或 unsafe 函数中（接口对象借用具体对象，指针操作归 unsafe）"
}

// interface 约束不满足导致不能提升：缺少方法（E00560）。
pub func msg_iface_promote_missing(sname: string, iname: string, mname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "type '" + sname + "' does not implement interface '" + iname + "', so it cannot be promoted (missing method '" + mname + "')"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "類型 '" + sname + "' 未實作 interface '" + iname + "'，不能提升（缺少方法 '" + mname + "'）"
    }
    return "类型 '" + sname + "' 未实现 interface '" + iname + "'，不能提升（缺少方法 '" + mname + "'）"
}

// interface 约束不满足导致不能提升：方法签名不匹配（E00560）。
pub func msg_iface_promote_sig(sname: string, iname: string, mname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "type '" + sname + "' does not implement interface '" + iname + "', so it cannot be promoted (method '" + mname + "' has a mismatched signature)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "類型 '" + sname + "' 未實作 interface '" + iname + "'，不能提升（方法 '" + mname + "' 簽名不符）"
    }
    return "类型 '" + sname + "' 未实现 interface '" + iname + "'，不能提升（方法 '" + mname + "' 签名不匹配）"
}

// interface 约束不满足导致不能提升：无方法级细节（E00560）。
pub func msg_iface_promote_plain(sname: string, iname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "type '" + sname + "' does not implement interface '" + iname + "', so it cannot be promoted"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "類型 '" + sname + "' 未實作 interface '" + iname + "'，不能提升"
    }
    return "类型 '" + sname + "' 未实现 interface '" + iname + "'，不能提升"
}

// port 约束不满足导致不能提升（E00561）。
pub func msg_port_promote_missing(sname: string, pname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "type '" + sname + "' does not implement port '" + pname + "', so it cannot be promoted (write `impl " + pname + " for " + sname + "` first)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "類型 '" + sname + "' 未實作 port '" + pname + "'，不能提升（請先寫 impl " + pname + " for " + sname + "）"
    }
    return "类型 '" + sname + "' 未实现 port '" + pname + "'，不能提升（请先写 impl " + pname + " for " + sname + "）"
}

// 泛型约束（interface）不满足：缺少方法（E00557）。
