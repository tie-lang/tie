type tie<class>
// lib/support/diag/locale.tie —— 诊断消息的语言切换层
// ============================================================
// 消息文本按「诊断族」集中成函数：调用点只传结构化参数（名字、类型名、个数），
// 语言选择由 diagcode.cur_lang() 决定（CLI: --lang=<code>）。
// 码与文本彻底解耦：码由调用点显式登记（ERR:E#####:…），本文件只产出文本。
//
// 新增语言的做法：在对应函数里加一个分支，而不是复制整个消息目录。
import "./diagcode.tie"

// 变量初始化类型不匹配（E00377）。
pub func msg_var_type_mismatch(nm: string, ann: string, got: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "variable '" + nm + "' type mismatch: annotated " + ann + ", but the expression infers " + got
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "變數 '" + nm + "' 類型不符：標註 " + ann + "，運算式推導為 " + got
    }
    return "变量 '" + nm + "' 类型不匹配：标注 " + ann + "，表达式推导为 " + got
}

// 数组字面量元素个数/元素类型与标注不符（同属 E00377 族）。
pub func msg_var_array_mismatch(nm: string, ann: string, need: string, actual: string, elemt: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "variable '" + nm + "' type mismatch: annotated " + ann + "; an array literal needs " + need + " elements (got " + actual + "), each of type " + elemt
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "變數 '" + nm + "' 類型不符：標註 " + ann + "；陣列常值元素個數必須為 " + need + "（實際 " + actual + "），且元素類型必須與 " + elemt + " 一致"
    }
    return "变量 '" + nm + "' 类型不匹配：标注 " + ann + "；数组字面量元素个数必须为 " + need + "（实际 " + actual + "），且元素类型必须与 " + elemt + " 一致"
}
// 未定义函数（E00489）。
pub func msg_undef_func(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "undefined function '" + nm + "'"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "未定義的函式 '" + nm + "'"
    }
    return "未定义的函数 '" + nm + "'"
}

// 调用实参类型不匹配（E00588）。
pub func msg_call_arg_mismatch(nm: string, want: string, got: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "call to '" + nm + "' has a mismatched argument type: expected " + want + ", got " + got
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "呼叫 '" + nm + "' 參數類型不符：期望 " + want + "，實際 " + got
    }
    return "调用 '" + nm + "' 参数类型不匹配：期望 " + want + "，实际 " + got
}
// 复合赋值类型不匹配（E00406）。
pub func msg_compound_assign_mismatch(target: string, expr: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "compound assignment type mismatch: target is " + target + ", expression is " + expr
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "複合指派類型不符：目標類型 " + target + " 與運算式 " + expr
    }
    return "复合赋值类型不匹配：目标类型 " + target + " 与表达式 " + expr
}

// 类型未定义（E00554）。
pub func msg_undef_type(nm: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "undefined type '" + nm + "'"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "未定義的類型 '" + nm + "'"
    }
    return "类型 '" + nm + "' 未定义"
}

// 诊断码说明（--explain=<code>）：成因 + 修法各一句，随 --lang 切换。
// 未知码返回可用码清单，便于脚本探测本版本支持哪些说明。
pub func help_for(dc: string) -> string {
    var en = diagcode.cur_lang() == "en-US"
    var tw = diagcode.cur_lang() == "zh-TW"
    if dc == "E00377" {
        if en {
            return "E00377 · type mismatch in a variable or array initializer — the declared type and the inferred type differ; align the annotation with the expression."
        }
        if tw {
            return "E00377 · 變數或陣列初始化的類型不符——標註類型與運算式推導類型不一致；使兩者一致。"
        }
        return "E00377 · 变量或数组初始化的类型不匹配——标注类型与表达式推导类型不一致；使两者一致。"
    }
    if dc == "E00406" {
        if en {
            return "E00406 · compound assignment type mismatch — the target and the expression must share a type; convert one side explicitly."
        }
        if tw {
            return "E00406 · 複合指派類型不符——目標與運算式必須同型；先顯式轉換一側。"
        }
        return "E00406 · 复合赋值类型不匹配——目标与表达式必须同型；先显式转换一侧。"
    }
    if dc == "E00489" {
        if en {
            return "E00489 · undefined function — the name has no declaration in scope; check spelling, imports and namespaces."
        }
        if tw {
            return "E00489 · 未定義的函式——該名稱在此作用域無宣告；檢查拼寫、import 與命名空間。"
        }
        return "E00489 · 未定义的函数——该名字在此作用域没有声明；检查拼写、import 与命名空间。"
    }
    if dc == "E00554" {
        if en {
            return "E00554 · undefined type — the annotation names a type that is not declared; check spelling or define it."
        }
        if tw {
            return "E00554 · 未定義的類型——標註引用了未宣告的型別；檢查拼寫或補上定義。"
        }
        return "E00554 · 类型未定义——标注引用了未声明的类型；检查拼写或补上定义。"
    }
    if dc == "E00588" {
        if en {
            return "E00588 · argument type mismatch in a call — an argument disagrees with the parameter type; pass the declared type."
        }
        if tw {
            return "E00588 · 呼叫引數類型不符——引數與形參型別不一致；依簽章傳參。"
        }
        return "E00588 · 调用实参类型不匹配——实参形参类型不一致；按签名传参。"
    }
    if en {
        return "unknown diagnostic code '" + dc + "'; documented codes: E00377 E00406 E00489 E00554 E00588"
    }
    if tw {
        return "未知的診斷碼 '" + dc + "'；已有說明的碼：E00377 E00406 E00489 E00554 E00588"
    }
    return "未知的诊断码 '" + dc + "'；已有说明的码：E00377 E00406 E00489 E00554 E00588"
}
