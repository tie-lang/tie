// 泛型约束（interface）不满足：方法签名不匹配（E00557）。
pub func msg_generic_iface_sig(sname: string, iname: string, mname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "type '" + sname + "' does not implement interface '" + iname + "' (method '" + mname + "' has a mismatched signature)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "類型 '" + sname + "' 未實作 interface '" + iname + "'（方法 '" + mname + "' 簽名不符）"
    }
    return "类型 '" + sname + "' 未实现 interface '" + iname + "'（方法 '" + mname + "' 签名不匹配）"
}

// 泛型约束（interface）不满足：无方法级细节（E00557）。
pub func msg_generic_iface_plain(sname: string, iname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "type '" + sname + "' does not implement interface '" + iname + "' (generic constraint not satisfied)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "類型 '" + sname + "' 未實作 interface '" + iname + "'（泛型約束不符）"
    }
    return "类型 '" + sname + "' 未实现 interface '" + iname + "'（泛型约束不满足）"
}

// 泛型约束（port）不满足（E00556）。
pub func msg_generic_port(sname: string, pname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "type '" + sname + "' does not implement port '" + pname + "' (generic constraint not satisfied)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "類型 '" + sname + "' 未實作 port '" + pname + "'（泛型約束不符）"
    }
    return "类型 '" + sname + "' 未实现 port '" + pname + "'（泛型约束不满足）"
}

// 方法缺 self 接收者（E00114）：kind 取 "port" / "interface" / "impl"。
pub func msg_method_needs_self(kind: string, mname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return kind + " method '" + mname + "' must take self as its first parameter"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return kind + " 方法 '" + mname + "' 必須有 self 接收者（第一參數）"
    }
    return kind + " 方法 '" + mname + "' 必须有 self 接收者（第一参数）"
}

// 方法第一参数名不是 self（E00118）：kind 取 "port" / "interface" / "impl"。
pub func msg_method_first_param_self(kind: string, mname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "the first parameter of " + kind + " method '" + mname + "' must be self"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return kind + " 方法 '" + mname + "' 的第一參數必須是 self"
    }
    return kind + " 方法 '" + mname + "' 的第一参数必须是 self"
}

// impl 缺少 port 要求的方法（E00210）。
pub func msg_impl_missing_method(pname: string, sname: string, mname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "impl '" + pname + " for " + sname + "' is missing method '" + mname + "' (every port method must be implemented)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "impl '" + pname + " for " + sname + "' 缺少方法 '" + mname + "'（port 方法必須全部實作）"
    }
    return "impl '" + pname + " for " + sname + "' 缺少方法 '" + mname + "'（port 方法必须全部实现）"
}

// impl 方法参数个数与 port 签名不符（E00112）。
pub func msg_impl_arity(mname: string, want: string, got: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "impl method '" + mname + "' has a mismatched parameter count: expected " + want + ", got " + got
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "impl 方法 '" + mname + "' 參數個數與 port 簽名不符：期望 " + want + "，實際 " + got
    }
    return "impl 方法 '" + mname + "' 参数个数与 port 签名不匹配：期望 " + want + "，实际 " + got
}

// impl 方法参数类型与 port 签名不符（E00113）。
pub func msg_impl_param_type(mname: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "impl method '" + mname + "' has a mismatched parameter type (port method parameters must keep the same types)"
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "impl 方法 '" + mname + "' 參數類型與 port 簽名不符（port 方法參數必須型別一致）"
    }
    return "impl 方法 '" + mname + "' 参数类型与 port 签名不匹配（port 方法参数必须类型一致）"
}

// impl 方法返回类型与 port 签名不符（E00120）。
pub func msg_impl_ret_type(mname: string, want: string, got: string) -> string {
    if diagcode.cur_lang() == "en-US" {
        return "impl method '" + mname + "' has a mismatched return type: expected " + want + ", got " + got
    }
    if diagcode.cur_lang() == "zh-TW" {
        return "impl 方法 '" + mname + "' 回傳類型與 port 簽名不符：期望 " + want + "，實際 " + got
    }
    return "impl 方法 '" + mname + "' 返回类型与 port 签名不匹配：期望 " + want + "，实际 " + got
}
