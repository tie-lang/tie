// 诊断码说明（--explain=<code>）：成因 + 修法各一句，随 --lang 切换。
// 未知码返回可用码清单，便于脚本探测本版本支持哪些说明。
pub func help_for(dc: string) -> string {
    // 说明文本的唯一真源是语言包（data/locale/<lang>.td，键 "<码>.help"）。
    var pt = pack_msg(dc + ".help")
    if str_len(pt) > 0 {
        return pt
    }
    var codes = "E00112 E00113 E00114 E00118 E00120 E00210 E00357 E00360 E00361 E00377 E00406 E00456 E00489 E00554 E00556 E00557 E00560 E00561 E00588 E00690 E00691 E00692 E00693 E00905 E00914 W00001 W00002 W00003 W00004 W00005 W00006 W00007 W00008 W00009 W00010 W00011 W00012 W00013 W00014 W00015 W00016 W00017 W00018 W00019 W00024 W00025 W00026 W00027 W00028 W00029 W00030 W00031"
    var en = diagcode.cur_lang() == "en-US"
    var tw = diagcode.cur_lang() == "zh-TW"
    if pack_ok() == 0 {
        // 包没载入：不能谎称号不存在，明确指向路径问题。
        if en {
            return "diagnostic language pack 'data/locale/" + diagcode.cur_lang() + ".td' is not loaded; run tiec from the repository root or pass --lib-root. Documented codes: " + codes
        }
        if tw {
            return "診斷語言包 'data/locale/" + diagcode.cur_lang() + ".td' 未載入；請在倉庫根目錄執行 tiec，或指定 --lib-root。已有說明的碼：" + codes
        }
        return "诊断语言包 'data/locale/" + diagcode.cur_lang() + ".td' 未载入；请在仓库根目录运行 tiec，或指定 --lib-root。已有说明的码：" + codes
    }
    if en {
        return "unknown diagnostic code '" + dc + "'; documented codes: " + codes
    }
    if tw {
        return "未知的診斷碼 '" + dc + "'；已有說明的碼：" + codes
    }
    return "未知的诊断码 '" + dc + "'；已有说明的码：" + codes
}

