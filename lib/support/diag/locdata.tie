type tie<class>
// compiler/support/diag/locdata.tie —— 语言包数据文件解析（命名空间 locdata）
// ============================================================
// 定位：把 `type tie<data>` 形态的扁平语言包（`data/locale/<tag>.td`）在**编译器
// 运行时**读进内存，供 lib/support/diag/locale.tie 取消息模板。
//
// 支持的形态（刻意只做这一种，够语言包用，出错可诊断）：
//   [
//       "E00554.msg": "类型 '<nm>' 未定义。",
//       "E00377.msg": "变量 '<nm>' 类型不匹配：标注 <ann>，表达式推导为 <got>。",
//   ]
// 即「字符串键 → 字符串值」的扁平表；条目间逗号可省略，允许尾逗号与 // 行注释。
// 不支持嵌套表/数组/数字/转义（语言包不需要；遇到即报错，不静默猜）。
//
// 本文件**不持有任何状态**：键表与值表由调用方传入并持有。原因见账本——
// 模块级全局表在「同文件自用」没问题，但一句话都别指望跨文件共享状态。
//
// 索引一律按**码点**（`str_len`/`str_char`/`str.slice` 的语义），不要混用字节接口。
// 读取失败返回负值：-1 无文件、-2 无表字面量、-3 键不是字符串、-4 缺冒号、
// -5 值不是字符串、-6 缺收尾 ']'。调用方据此回落到内置消息。

namespace locdata;

// 第 i 个码点（越界返回空串）。
unsafe func ch(s: string, i: i64) -> string {
    if i < 0 || i >= str_len(s) {
        return "";
    }
    return str_char(s, i);
}

// 跳过空白、逗号与 // 行注释，返回下一个有效位下标（文件尾返回 str_len）。
unsafe func skip_gap(s: string, i: i64) -> i64 {
    var n = str_len(s);
    var j = i;
    while j < n {
        var c = ch(s, j);
        if c == " " || c == "\t" || c == "\n" || c == "\r" || c == "," {
            j = j + 1;
        } else if c == "/" {
            if ch(s, j + 1) == "/" {
                var k = j + 2;
                while k < n && ch(s, k) != "\n" {
                    k = k + 1;
                }
                j = k;
            } else {
                return j;
            }
        } else {
            return j;
        }
    }
    return n;
}

// 从 i 处的 '"' 起读一个字符串，返回结束引号之后的下标；失败 -1。
unsafe func read_str(s: string, i: i64) -> i64 {
    var n = str_len(s);
    if ch(s, i) != "\"" {
        return -1;
    }
    var j = i + 1;
    while j < n {
        var c = ch(s, j);
        if c == "\"" {
            return j + 1;
        }
        if c == "\\" {
            // 不支持转义：出现反斜杠说明格式超纲
            return -1;
        }
        j = j + 1;
    }
    return -1;
}

func substr(s: string, a: i64, b: i64) -> string {
    if b <= a {
        return "";
    }
    return str.slice(s, a, b)
}

// 解析整篇文本，键追加到 ks、值追加到 vs（调用方负责先清空）。成功 0。
pub unsafe fn parse_into(s: string, ref ks: table<string>, ref vs: table<string>) -> i64 {
    var n = str_len(s);
    // 跳过 `type tie<data>` 头与前置注释，定位到第一个 '['（表字面量起点）。
    var i = 0;
    while i < n && ch(s, i) != "[" {
        i = i + 1;
    }
    if i >= n {
        return -2;
    }
    i = skip_gap(s, i + 1);
    while i < n && ch(s, i) != "]" {
        var k1 = read_str(s, i);
        if k1 < 0 {
            return -3;
        }
        var key = substr(s, i + 1, k1 - 1);
        i = skip_gap(s, k1);
        if i >= n || ch(s, i) != ":" {
            return -4;
        }
        i = skip_gap(s, i + 1);
        var v1 = read_str(s, i);
        if v1 < 0 {
            return -5;
        }
        var val = substr(s, i + 1, v1 - 1);
        table_push(ks, key);
        table_push(vs, val);
        i = skip_gap(s, v1);
    }
    if i >= n || ch(s, i) != "]" {
        return -6;
    }
    return 0;
}

// 读文件并解析。成功 0，失败 -1（文件不存在）或解析负码。
pub unsafe fn load_into(path: string, ref ks: table<string>, ref vs: table<string>) -> i64 {
    var ex = false
    unsafe { ex = file_exists(path) }
    if !ex {
        return -1;
    }
    var txt = ""
    unsafe { txt = file_read(path) }
    var rc = 0
    unsafe { rc = parse_into(txt, ks, vs) }
    return rc
}

// 在解析结果里按键查值；未命中返回空串（调用方据此回落内置消息）。
pub unsafe fn lookup(ref ks: table<string>, ref vs: table<string>, key: string) -> string {
    var m = len(ks)
    var j = 0
    while j < m {
        if ks[j] == key {
            return vs[j]
        }
        j = j + 1
    }
    return ""
}
