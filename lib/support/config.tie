type tie<class>
// config.tie —— 后端开关（工具经 set_* 注入；irgen/llvmgen 共用）
pub var g_dynlib: bool = false;          // 动态库模式：登记导出面 + 边界检查
pub var g_dll_export: string = "";       // --dll-export 白名单（空 = 不过滤）
pub var g_check_bounds: bool = false;    // --check-bounds 数组越界检查
pub var g_asm_target: string = "";       // 目标三元组（asm! 平台条件编译用）
