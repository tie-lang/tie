pub func ctx_current() -> i64 {
    return g_ctx_cur
}

pub func ctx_bind(id: i64) -> i64 {
    if g_ctx_ready == 0 {
        if id == 0 {
            g_ctx_cur = 0
            return 0
        }
        return -1
    }
    if id < 0 || id >= len(c_cur_fn) {
        return -1
    }
    ir_funcs_names = c_ir_funcs_names[id]
    ir_funcs_rets = c_ir_funcs_rets[id]
    ir_funcs_params_off = c_ir_funcs_params_off[id]
    ir_funcs_params_cnt = c_ir_funcs_params_cnt[id]
    ir_funcs_params_tys_off = c_ir_funcs_params_tys_off[id]
    ir_funcs_param_tys = c_ir_funcs_param_tys[id]
    ir_funcs_entry = c_ir_funcs_entry[id]
    ir_funcs_inst_total = c_ir_funcs_inst_total[id]
    ir_funcs_exported = c_ir_funcs_exported[id]
    ir_funcs_inline = c_ir_funcs_inline[id]
