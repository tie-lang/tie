type tie<class>
namespace ir;
// context.tie —— 编译上下文接口
// ============================================================
// 第一步：接口先立，单实例语义不变（IR 表仍由库内单例承载）。
// 第二步再把 g_* 表按 context 分桶，ctx_new 才真正创建独立状态。
// 约束：同一时刻只允许一个活跃上下文；ctx_bind 只接受当前 id。

var g_ctx_cur: i64 = 1

pub func ctx_new() -> i64 {
    return g_ctx_cur
}

pub func ctx_current() -> i64 {
    return g_ctx_cur
}

pub func ctx_bind(id: i64) -> i64 {
    if id <= 0 {
        return -1
    }
    if id != g_ctx_cur {
        return -1
    }
    return 0
}

pub func ctx_free(id: i64) -> i64 {
    if id != g_ctx_cur {
        return -1
    }
    return 0
}
