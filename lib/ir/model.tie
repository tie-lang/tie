type tie<class>
namespace tie.ir;
// model.tie —— tieir 内存模型（最小面）
// ============================================================
// 覆盖：函数 / 参数 / add·sub·mul / ret。全部用**扁平表**（tie 不允许
// table<R> 作形参/返回值；库内不跨界传表，只暴露标量与字符串）。
// 后续扩展：常量、比较、分支、调用、表/字符串；序列化在 serialize.tie。

// 算子码（与 backend 的助记符映射一一对应）
pub const OP_ADD: i64 = 0;
pub const OP_SUB: i64 = 1;
pub const OP_MUL: i64 = 2;
pub const OP_RET: i64 = 3;

// 函数表
var g_fname: table<string> = []
var g_fret: table<string> = []
var g_fpoff: table<i64> = []      // 参数在 g_pname/g_pty 的起点
var g_fpn: table<i64> = []        // 参数个数
var g_fioff: table<i64> = []      // 指令在 g_i* 的起点
var g_fin: table<i64> = []        // 指令条数
// 参数扁平段
var g_pname: table<string> = []
var g_pty: table<string> = []
// 指令扁平段（每指令 5 槽：op/dst/a/b/ty）
var g_iop: table<i64> = []
var g_idst: table<string> = []
var g_ia: table<string> = []
var g_ib: table<string> = []
var g_ity: table<string> = []

pub func reset() {
    table_trunc(g_fname, 0)
    table_trunc(g_fret, 0)
    table_trunc(g_fpoff, 0)
    table_trunc(g_fpn, 0)
    table_trunc(g_fioff, 0)
    table_trunc(g_fin, 0)
    table_trunc(g_pname, 0)
    table_trunc(g_pty, 0)
    table_trunc(g_iop, 0)
    table_trunc(g_idst, 0)
    table_trunc(g_ia, 0)
    table_trunc(g_ib, 0)
    table_trunc(g_ity, 0)
}

pub func new_func(name: string, ret: string) -> i64 {
    table_push(g_fname, name)
    table_push(g_fret, ret)
    table_push(g_fpoff, len(g_pname))
    table_push(g_fpn, 0)
    table_push(g_fioff, len(g_iop))
    table_push(g_fin, 0)
    return len(g_fname) - 1
}

pub func add_param(fid: i64, name: string, ty: string) {
    table_push(g_pname, name)
    table_push(g_pty, ty)
    g_fpn[fid] = g_fpn[fid] + 1
}

func add_instr(fid: i64, op: i64, dst: string, a: string, b: string, ty: string) {
    table_push(g_iop, op)
    table_push(g_idst, dst)
    table_push(g_ia, a)
    table_push(g_ib, b)
    table_push(g_ity, ty)
    g_fin[fid] = g_fin[fid] + 1
}

pub func add(fid: i64, dst: string, a: string, b: string, ty: string) {
    add_instr(fid, OP_ADD, dst, a, b, ty)
}

pub func sub(fid: i64, dst: string, a: string, b: string, ty: string) {
    add_instr(fid, OP_SUB, dst, a, b, ty)
}

pub func mul(fid: i64, dst: string, a: string, b: string, ty: string) {
    add_instr(fid, OP_MUL, dst, a, b, ty)
}

pub func ret_val(fid: i64, val: string) {
    add_instr(fid, OP_RET, "", val, "", "")
}

// ---- 只读访问面 ----
pub func func_count() -> i64 { return len(g_fname) }
pub func func_name(fid: i64) -> string { return g_fname[fid] }
pub func func_ret(fid: i64) -> string { return g_fret[fid] }
pub func param_off(fid: i64) -> i64 { return g_fpoff[fid] }
pub func param_count(fid: i64) -> i64 { return g_fpn[fid] }
pub func param_name(i: i64) -> string { return g_pname[i] }
pub func param_ty(i: i64) -> string { return g_pty[i] }
pub func instr_off(fid: i64) -> i64 { return g_fioff[fid] }
pub func instr_count(fid: i64) -> i64 { return g_fin[fid] }
pub func instr_op(i: i64) -> i64 { return g_iop[i] }
pub func instr_dst(i: i64) -> string { return g_idst[i] }
pub func instr_a(i: i64) -> string { return g_ia[i] }
pub func instr_b(i: i64) -> string { return g_ib[i] }
pub func instr_ty(i: i64) -> string { return g_ity[i] }
