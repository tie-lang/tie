pub const S_N_MAP_TYPE: i64 = 204;
// 泛型语法节点（2026-08-14，与 ast.tie 同号权威）：N_TYPE_PARAMS（声明点
// 类型参数列表）/ N_TYPE_PARAM（单个类型参数）/ N_TYPE_ARGS（使用点类型
// 实参列表）。语义层在 FnDef/Struct/Call/MethodCall/StructType 的 children
// 头部读取「泛型槽」时用这三个常量判定（配合 sstate.slot_off 统一偏移）。
pub const S_N_TYPE_PARAMS: i64 = 125;
const S_N_TYPE_PARAM: i64 = 126;
pub const S_N_TYPE_ARGS: i64 = 127;
pub const S_N_ENUM: i64 = 128;
pub const S_N_ENUM_VARIANT: i64 = 129;
pub const S_N_UNSAFE_BLOCK: i64 = 130;  // unsafe 块（S1.2 U3）
pub const S_N_ASM: i64 = 131;           // asm! 内联汇编（S1.2 I1）
pub const S_N_TRY: i64 = 133;           // ? 后缀解包（S2.3，与 ast.tie N_TRY 同号）
pub const S_N_PANIC: i64 = 134;         // panic 语句（S2.3，与 ast.tie N_PANIC 同号）
pub const S_N_FN_LIT: i64 = 132;        // func 字面量（S2.2 闭包，与 ast.tie N_FN_LIT 同号）
pub const S_N_CALL_EXPR: i64 = 148;     // 调用表达式（P2a，与 ast.tie N_CALL_EXPR 同号）
pub const S_N_FN_TYPE: i64 = 205;       // 函数值类型（S2.2，与 ast.tie N_FN_TYPE 同号）
pub const S_N_ARRAY_TYPE: i64 = 206;    // L1 定长数组类型（与 ast.tie N_ARRAY_TYPE 同号）
pub const S_N_IS: i64 = 207;            // `is` 类型判定（与 ast.tie N_IS 同号，规范 §3.16）
// S2.4 port 接口模型（与 ast.tie N_PORT/N_IMPL 同号权威）：
//   编号 138/139：与 S3.3 宏节点（135-137）错开（整合时统一，见 ast.tie）。
pub const S_N_PORT: i64 = 138;          // port 声明：Port[name=port 名, children=[泛型槽(-1), 方法 FnDef...]]
pub const S_N_IMPL: i64 = 139;          // impl 块：Impl[children=[port 类型, struct 类型, 方法 FnDef...]]
// S3.3 宏/元编程（与 ast.tie 同号）：
pub const S_N_MACRO_DEF: i64 = 135;     // 宏定义（M3）
pub const S_N_CODE_LIT: i64 = 136;      // 准引用字面量（C1）
const S_N_CODE_INTERP: i64 = 137;   // 插值表达式（$x / $(expr)）
// 一期并发 actor（与 ast.tie N_ACTOR 同号）：
pub const S_N_ACTOR: i64 = 141;         // actor 声明：Actor[name=actor 名, aux=items 数,
                                    //   children=[字段 ClassField..., 方法 FnDef...]]
                                    //   （方法 async 标记经 FnDef val bit2）
pub const S_N_RUN_ACTOR: i64 = 142;     // run 表达式（run 上下文识别，非保留字）
// 三期 goto/标签（与 ast.tie N_GOTO_LABEL/N_GOTO 同号）：
pub const S_N_GOTO_LABEL: i64 = 143;    // `#[tag.x]` 语句位置标签
pub const S_N_GOTO: i64 = 144;          // `unsafe goto #x` 无条件跳转
pub const S_N_GUARD_STMT: i64 = 153;    // p.8.2.11 guard else 早退（与 ast.tie N_GUARD_STMT 同号）
pub const S_N_SWITCH_EXPR: i64 = 156;   // p.9.10.1 match/switch 表达式（与 ast.tie 同号）
pub const S_N_TRY_BLOCK: i64 = 157;     // p.9.11.3 try 错误聚合块（与 ast.tie N_TRY_BLOCK 同号）
pub const S_N_DEFER: i64 = 158;         // p.9.11.4 defer 资源释放（与 ast.tie N_DEFER 同号）
pub const S_N_TYPE_ALIAS: i64 = 160;    // p.9.11.32 类型别名（与 ast.tie N_TYPE_ALIAS 同号）
pub const S_N_YIELD: i64 = 161;         // p.9.11.15 yield 产出语句（与 ast.tie N_YIELD 同号）
// p.9.13.4 块管道 `x -> { v -> expr }`（与 ast.tie N_BLOCK_PIPE 同号）。
// tag 162：YIELD(161) 之后的首个空闲号（注意 ast.tie 里 160 被 N_TYPE_ALIAS 与
// N_SLICE 重复占用，属既有重号，勿再复用该值）。
pub const S_N_BLOCK_PIPE: i64 = 162;
// p.9.11.34 语义期类型引用（与 ast.tie N_SEM_TYPE 同号）：val = 语义类型 id。
pub const S_N_SEM_TYPE: i64 = 163;
// 三期 A 组 guard<cap> 凭据（与 ast.tie N_GUARD_GET/N_GUARD_USE/N_GUARD_WITH 同号）
pub const S_N_GUARD_GET: i64 = 145;     // `unsafe.get(share)` 取得凭据（表达式）
pub const S_N_GUARD_USE: i64 = 146;     // `unsafe use g { ... }` 持证越界块
pub const S_N_GUARD_WITH: i64 = 147;    // `unsafe with(share) { ... }` 临时凭据块
// r.1.6.7：`unsafe.revoke(g)` 凭据撤销（与 ast.tie N_GUARD_REVOKE 同号）
pub const S_N_GUARD_REVOKE: i64 = 149;
namespace sstate {


// ==================== S1.5 移动语义：变量 live/moved 状态 ====================
// 独立升序表 lv_moved：存在即 moved（复用 bs_find 二分）。函数边界（check_fn
// 入口）调用 lv_moved_reset 清空；赋值/按值传参/返回移动时 lv_moved_mark 登记；
// 读取变量前 lv_moved_is 查询——moved 则报 "use of moved value"。
// 表为独立存储（不并入 lv_* 并行表）：S1.2-1.4 并行会话在改 sinfer 的
// lv_insert 五表同步，本表由 scheck/sinfer 额外维护，避免与该同步耦合。


