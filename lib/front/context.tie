pub func ctx_current() -> i64 {
    return g_ctx_cur
}

pub func ctx_new() -> i64 {
    if g_ctx_ready == 0 {
        cap_0()
        cap_1()
        cap_2()
        cap_3()
        cap_4()
        cap_5()
        g_ctx_ready = 1
    }
    push_0()
    push_1()
    push_2()
    push_3()
    push_4()
    push_5()
    var id = len(c_s_tags) - 1
    ctx_bind(id)
    return id
}

pub func ctx_bind(id: i64) -> i64 {
    if g_ctx_ready == 0 {
        if id == 0 {
            g_ctx_cur = 0
            return 0
        }
        return -1
    }
    if id < 0 || id >= len(c_s_tags) {
        return -1
    }
    save_0()
    save_1()
    save_2()
    save_3()
    save_4()
    save_5()
    load_0(id)
    load_1(id)
    load_2(id)
    load_3(id)
    load_4(id)
    load_5(id)
    g_ctx_cur = id
    return 0
}
