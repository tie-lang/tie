type tie<class>
// compiler/frontend/scollect.tie —— T2.6 顶层收集子遍（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = 顶层收集：函数/命名空间/struct/全局变量/
// extern 登记 + struct 字段拍平 + 返回表预扫描 + 命名空间全名补全）。
// 对应 proto/semantic.tie 862-872（tre_bi_init）+ 873-957（collect_top）
// + 960-1058（find_struct_node/collect_struct_fields/collect_all_struct_fields）
// + 1066-1207（scan_return_elem/scan_blk/collect_all_return_tables）
// + 1208-1247（collect_fn）+ 1266-1336（collect_ns/ns_full_name）
// + 1339-1407（collect_global_var）逻辑搬移。
// 依赖：./sstate.tie（AST 全局 + 符号表 + 工具）+ ./sinfer.tie（表达式推断
// + resolve_call_name + table_ret_elem）+ ./scollect_port.tie（同 namespace
// scollect 跨文件拆分：S2.4 port/impl 及其余分区，本文件 import 文本内联并入）。
// 树式无环：由 scheck.tie import。
import "./sinfer.tie"
import "./scollect_port.tie"

// S2.4：impl 块暂存队列（N_IMPL 节点 id）。collect_top 遇到 N_IMPL 时只登记
// 队列（struct 声明可能在其后，须等全部 struct 登记完再解析）；
// collect_top 之后由 semantic 主流程调用 collect_impl_fns() 统一处理：
// 方法节点改名 <struct 名>::<方法名> → g_extra_tops → collect_fn → reg_impl。
// 注：tie 全局变量必须放文件顶层（namespace 外）。
pub var g_impl_pending: table<i64>;

// p.9.17.2 缺陷 #4a：标量全局的**初始化表达式类型检查延迟**执行——
// collect_top 期间 enum 只有名字登记（en_keys），变体表（en_vnames 等）由
// semantic 主流程在其后的 collect_all_enums() 填充；此时对 enum 变体常量
// 初始化器跑 infer_expr 会误报 E00506「枚举 'X' 没有变体 'Y'」（变体扫描落空）。
// 此处暂存（节点, 标注类型, 全名），由 check_deferred_global_inits() 在
// collect_all_enums() 之后统一检查。
pub var gd_nodes: table<i64>;
pub var gd_tys: table<i64>;
pub var gd_nms: table<string>;

namespace scollect {

// 内置函数返回表预登记（语言底座）
pub func tre_bi_init() {
    tre_bi_keys = table_new_i64()
    tre_bi_vals = table_new_i64()
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("list_dir"), types.named(TK_STR))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("walk_dir"), types.named(TK_STR))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("byte_read"), types.named(TK_I64))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("byte_concat"), types.named(TK_I64))
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("regex_find_all"), types.named(TK_STR))
    // p.6.9.1 stdio：stdin_read → i64 字节表（EOF 空表），升序插于 regex_find_all 后
    sstate.sorted_insert(tre_bi_keys, tre_bi_vals, intern.intern("stdin_read"), types.named(TK_I64))
}

// extern 返回类型标量判定（对齐 Rust is_scalar_extern_ty：i8..u64/f32/f64/bool/char/string）
func is_scalar_t(t: i64) -> bool {
    if types.kind(t) != K_NAMED {
        return false
    }
    // Named 且 TyKw 在标量集（0-10, 12-13；排除 trit=11, void=14+）
    if t >= 0 && t <= 10 {
        return true
    }
    if t == TK_CHAR || t == TK_STR {
        return true
    }
    return false
}

// p.9.0-L.3 默认值 const 白名单（结构性判据，单源供「命名参数默认值」与
// 「actor 字段初值」共用）：字面量 / 空表 [] / const 全局引用 / 纯常量算术·
// 比较·逻辑·位·移位·整除·幂·floor 取余 二元 / 一元负号·取反·按位非 / 三目。
// 排除运行期表达式：函数调用、非空表字面量、闭包、下标、字段访问、箭头、
// `in`、自增自减、可变全局/局部变量引用。
// ★ 设计裁定（2026-10-09）：**结构性判定而非编译期求值**——const 全局的值在
// 后端 global_init_fold 折叠，发射点直接生成等价代码；const 不可变 ⇒ 运行期
// 求值与编译期折叠同值，无需前端先折叠（也避开「引用后文 const」的收集序问题）。
// ★ 分工：struct 字段默认值**不在**本白名单内——字段默认值是「逐构造运行期
// 求值」语义（tiu DrawList 的 table_new_*() 90 处存量依赖），与参数默认值的
// const 白名单是两回事，见 ROAD p.9.0-L.3 条目。
// depth 上限防病态深表达式（16 层足够任何可读默认值）。
func is_const_default_expr(n: i64, depth: i64) -> bool {
    if depth > 16 {
        return false
    }
    if n < 0 {
        return false
    }
    var t = s_tags[n]
    if t == S_N_INT_LIT || t == S_N_FLOAT_LIT || t == S_N_BOOL_LIT ||
        t == S_N_CHAR_LIT || t == S_N_STR_LIT {
        return true
    }
    if t == S_N_TABLE_LIT {
        // 仅空表 []（与既有字面量白名单同判；非空表是运行期构造）
        return sstate.nchild(n) == 0
    }
    if t == S_N_VAR {
        // 仅 const 全局（可变全局/局部变量随运行期变化，违背默认值常量语义）
        var nid = intern.intern(sstate.name_str(n))
        var idx = sstate.bs_find(gb_keys, nid)
        if idx < 0 {
            return false
        }
        return (gb_const[idx] & 1) == 1
    }
    if t == S_N_UNARY {
        var op = s_vals[n]
        // U_NEG=0 U_NOT=1 U_BIT_NOT=6；自增自减（2-5）是语句性操作，排除
        if op != 0 && op != 1 && op != 6 {
            return false
        }
        return is_const_default_expr(sstate.child(n, 0), depth + 1)
    }
    if t == S_N_BINARY {
        var op = s_vals[n]
        // 0-17（算术/比较/逻辑/位/移位）+ 21-23/27（checked 族，纯函数）+
        // 24 整除 \ 25 幂 ** 26 floor 取余 %%；排除 18/19 箭头、20 elvis、28 in
        if op < 0 || op > 27 || op == 18 || op == 19 || op == 20 {
            return false
        }
        return is_const_default_expr(sstate.child(n, 0), depth + 1) &&
            is_const_default_expr(sstate.child(n, 1), depth + 1)
    }
    if t == S_N_TERNARY {
        return is_const_default_expr(sstate.child(n, 0), depth + 1) &&
            is_const_default_expr(sstate.child(n, 1), depth + 1) &&
            is_const_default_expr(sstate.child(n, 2), depth + 1)
    }
    return false
}

// S10：extern 边界合格类型 = 标量（is_scalar_t）或 ptr<T>/slice<T>。
// 平台桥允许 unsafe extern 用指针传引用/出参（桥原生 Win32/OS API，如
// GetConsoleMode 的指针形参、CreatePipe 的句柄出参）。表/map/struct 等堆布局仍拒绝。
//（本判定同时用于返回类型——struct 按值返回的 C ABI（sret 隐藏指针）不在本最小集。）
func is_extern_ok_t(t: i64) -> bool {
    if is_scalar_t(t) {
        return true
    }
    var k = types.kind(t)
    return k == K_PTR || k == K_SLICE
}

// p.6.8.3：extern 参数合格类型 = 标量/string/ptr/slice 或 **repr(C) struct**。
// repr(C) struct 按引用传（C ABI 传指针，callee 就地改读写）；非 repr(C) struct
// 拒绝——布局非显式 C 契约，跨 FFI 边界字段偏移不确定（生成侧见 irgen_call.tig_struct_byref）。
func is_extern_param_ok_t(t: i64) -> bool {
    if is_extern_ok_t(t) {
        return true
    }
    if types.kind(t) == K_STRUCT {
        // repr(C) 判定：直接查 struct 定义节点的 repr(C) 标注（val=1）。
        // 不依赖 st_reprc——该表在 collect_struct_fields 惰性填充，可能晚于
        // extern 收集（此时字段未解析），此时读取为 0 会误拒 repr(C) 结构体。
        var rname = types.type_name(t)
        var rnode = find_struct_node(rname)
        if rnode >= 0 && s_vals[rnode] == 1 {
            return true
        }
    }
    return false
}

// 顶层函数签名收集（含参数/返回类型解析 + 默认值/ref 校验）
pub func collect_fn(fn_node: i64, full: string) -> i64 {
    // 泛型模板登记分派（2026-08-14 泛型语法）：children[0] == N_TYPE_PARAMS
    // 时按模板登记（sstate.reg_generic → gt_* 表），**不**按普通函数收集——
    // 否则模板参数类型（TypeVar 名如 "T"）经 stype.parse_type_node 会报
    // "类 'T' 未定义"。单态化展开语义由 T3b 负责，本任务只保证泛型声明
    // 本身不使语义崩溃 + 模板结构就位。
    if sstate.nchild(fn_node) > 0 {
        var slot0 = sstate.child(fn_node, 0)
        if slot0 >= 0 {
            if s_tags[slot0] == S_N_TYPE_PARAMS {
                var gret = sstate.reg_generic(full, fn_node, 0)
                if gret < 0 {
                    return -1
                }
                return 0
            }
            if s_tags[slot0] == S_N_TYPE_ARGS {
                // p.8.1.3 显式特化：`func name<具体类型>(...)` ——类型实参已具体
                // 化，mangle 函数名为 name$T1$T2 并按普通函数收集（与泛型实例化
                // 同 key：调用点 instantiate_fn 幂等命中 → 自动优先绑定特化实现）。
                var sargs = sgen.parse_type_args_ast(slot0)
                if len(sargs) == 0 {
                    return -1
                }
                full = sgen.mangle(full, sargs)
                s_names[fn_node] = intern.intern(full)
                s_children[s_coff[fn_node]] = -1   // 泛型槽清 -1（普通函数布局）
            }
        }
    }
    var nparams = s_aux[fn_node]
    var is_pub = s_vals[fn_node]
    // S1.2 的「参数/返回含指针类型 ⇒ 必须 unsafe fn」两条门禁已随安全边界
    // 重分类（§11.8，2026-10-01）撤销，故原先在此取出的函数 unsafe 标志
    //（val bit1）在本函数内不再被消费。`is_pub` 保留：下文 reg_fn 传的是整个
    // val（含各标志位），不只是 pub。
    //
    // `unsafe fn` 仍是**有意义的声明**：函数体因此获得不安全上下文
    //（see check_fn：sig_unsafe(sig) == 1 ⇒ g_unsafe_depth + 1），体内仍可做
    // 解引用/分配等操作级门禁保护的动作。变的只是「签名里出现指针类型」不再是
    // 判定函数是否必须 unsafe 的依据。
    // 返回类型：FnDef children[slot_off]（新布局 children[0]=泛型槽→偏移 1；
    // 旧布局无槽→children[0]=返回类型。slot_off 统一判定保证自举双兼容）
    var rt_node = sstate.child(fn_node, sstate.slot_off(fn_node))
    var ret_ty = sgen.parse_generic_type_node(rt_node)
    if ret_ty < 0 {
        return -1
    }
    // §11.8 重分类（2026-10-01）：返回指针/切片/原子类型不再要求 unsafe fn ——
    // 返回值是一个值，持有它不引发 UB；解引用才是危险面，由调用点的操作级
    // 门禁（sinfer_ret_q2.tie 的 unsafe 内置清单）拦截。
    // p.9.11.15 生成器检测：函数体含 N_YIELD → 生成器函数。语言侧定稿——
    // 生成器必须声明返回类型（= 元素类型，非 void），签名返回类型登记为
    // table<elem>（调用方 gen() 得表，for/推导式直接消费）；运行期惰性
    // 协程由 p.9.5.1 trm-lite 承载，本轮 IR = 攒表返回（探针验证产出序列）。
    var g_body = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + nparams)
    var is_gen_fn: i64 = 0
    if g_body >= 0 {
        if contains_yield(g_body) {
            is_gen_fn = 1
        }
    }
    if is_gen_fn == 1 {
        if ret_ty == types.named(TK_VOID) {
            sm_err_line = s_lines[fn_node]
            sm_err_col = s_cols[fn_node]
            sm_err_msg = "生成器函数（含 yield）必须声明返回类型（= yield 产出元素的类型），实际是 void（请写 `-> 元素类型`）"
            return -1
        }
        ret_ty = types.table_of(ret_ty)   // 签名返回类型 → table<elem>
    }
    var p_tys: table<i64> = table_new_i64()
    var p_refs: table<i64> = table_new_i64()
    var p_defs: table<i64> = table_new_i64()
    var p_vars: table<i64> = table_new_i64()
    // 必选参数数（默认值前）：**初值 0**，由下方循环按「最后一个无默认值且非变参
    // 的参数位置 +1」覆盖。
    // RCA（p.9.11.23，2026-09-27）：此处原为 `var required: i64 = nparams`
    //（意图「默认全部必选」）+ 变参时扣 1，导致**全部参数都带默认值**的函数
    // 必选数停在 nparams（而非 0）——于是 `d0(c: 9)` 这类调用被个数检查
    // （nc < req）误拒，报「期望 3 个参数，实际 1 个」。同理变参函数
    //（`f(a: i64 = 1, b: ...T)`）也会停在 nparams-1。改为 0 初值后：
    //   * 无默认值参数逐个覆盖（语义不变）
    //   * 全部带默认值 → 0（正确）
    //   * 纯变参 `sum(rest: ...i64)` → 0（变参在循环中被跳过，不加计）
    //   * `f(a: i64, b: ...T)` → 1（a 覆盖）
    // 该改动只**放宽**（required 变小或不变），故既有可通过的调用不受影响。
    var required: i64 = 0
    // 默认值校验：ref 不能带默认值 + 可选参数必须连续 + 默认值必须字面量 + 类型匹配
    var seen_default: bool = false
    var k: i64 = 0
    while k < nparams {
        // 第 k 个参数：children[slot_off + 1 + k]
        var p = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + k)
        var pt = sgen.parse_generic_type_node(sstate.child(p, 0))
        if pt < 0 {
            return -1
        }
        // §11.8 重分类（2026-10-01）：参数为指针/切片/原子类型不再要求 unsafe fn
        // —— 传参只是复制一个值，不引发 UB。「安全切片 vs 裸指针」的两层门禁
        // 由此合到操作一层（见 sinfer_ret_q2.tie）。
        var is_ref = s_vals[p] & 1   // by_ref（p.9.11.11 immut 存 bit1，掩码 & 1）
        // p.9.11.26 四约定矩阵：统一声明面 + 互斥诊断。
        //   bit0=ref（可写借用）· bit1=immut（只读借用）· bit2=move（所有权转移）
        //   · bit3=重复修饰 · bit4=deep（入口深拷贝）· bit5=shared（显式共享不复制）
        // 互斥裁决（同槽双约 = 语义矛盾，编译诊断）：
        //   * immut × ref：只读借用与可写借用不可共存
        //   * move × (ref | immut)：所有权已移交，无从「借用」
        //   * 同类修饰重复（`ref ref x`）也属笔误，一并诊断
        // 诊断先行（同槽首个问题即报），避免叠加多条互相掩盖。
        var is_immut_p = (s_vals[p] / 2) % 2
        var is_move_p = (s_vals[p] / 4) % 2
        var is_dup_p = (s_vals[p] / 8) % 2
        var is_deep_p = (s_vals[p] / 16) % 2
        var is_shared_p = (s_vals[p] / 32) % 2
        if is_dup_p == 1 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的传递约定修饰重复出现（ref/immut/move/deep/shared 各至多一次）"
            return -1
        }
        if is_immut_p == 1 && is_ref == 1 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 不能同时标注 immut 与 ref（只读借用与可写借用互斥）"
            return -1
        }
        if is_move_p == 1 && (is_ref == 1 || is_immut_p == 1) {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 不能同时标注 move 与 ref/immut（所有权已移交，无从借用）"
            return -1
        }
        // ★ r.1.6.12 `shared` × `deep` 互斥：一个声明「不复制、共享同一份」，
        // 一个声明「入口深拷贝、与调用方完全独立」——语义直接对立，同槽双标必是笔误。
        if is_shared_p == 1 && is_deep_p == 1 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 不能同时标注 shared 与 deep（共享与值拷贝互斥）"
            return -1
        }
        var is_var = s_aux[p]   // 变参标志（`name: ...T`，parser 写入 aux）
        var has_def: i64 = 0
        var def_node: i64 = -1
        if sstate.nchild(p) > 1 {
            def_node = sstate.child(p, 1)
            if def_node >= 0 {
                has_def = 1
            }
        }
        // 变参（`...T`）：必须最后一个、无 ref、无默认值、元素类型限标量
        if is_var == 1 {
            if k != nparams - 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 必须是最后一个参数"
                return -1
            }
            if is_ref == 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 不能同时使用 ref 修饰"
                return -1
            }
            if has_def == 1 {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 不能有默认值"
                return -1
            }
            // 元素类型限标量（i8..u64/f32/f64/bool/char/string；对齐 extern 标量集）
            if !is_scalar_t(pt) {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "变参参数 '" + sstate.name_str(p) + "' 元素类型必须是标量（i8..u64/f32/f64/bool/char/string），实际是 " + types.type_name(pt)
                return -1
            }
            // 变参在函数体/调用点表现为 table<T>（签名登记表类型）
            pt = types.table_of(pt)
        }
        // ref 参数不能有默认值（对齐 Rust：必须在调用点传实参）
        if is_ref == 1 && has_def == 1 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的 ref 参数不能有默认值（必须在调用点传实参）"
            return -1
        }
        // ref 形参仅支持表/定长数组参数（对齐 Rust：标量/字符串/struct 形参引用无实义）
        // L1：array<T, N> 值类型按引用传参（指针），避免聚合值拷贝——扩散热点
        // matmul/conv 的行列数组全走 ref，零拷贝。
        if is_ref == 1 && !types.is_table(pt) && !types.is_array(pt) {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的 ref 修饰仅支持表参数（table/table<T>）或定长数组（array<T, N>），实际是 " + types.type_name(pt)
            return -1
        }
        // 可选参数（带默认值）必须连续排在必选参数之后
        // （变参不参与该约束——它恒居末位，前面允许可选参数）
        if has_def == 1 {
            seen_default = true
        } else if seen_default && is_var == 0 {
            sm_err_line = s_lines[p]
            sm_err_col = s_cols[p]
            sm_err_msg = "参数 '" + sstate.name_str(p) + "' 缺少默认值：可选参数（带默认值）必须连续排在必选参数之后"
            return -1
        }
        // 默认值白名单（p.9.0-L.3）：字面量（数/布尔/字符/字符串/空表 []）或
        // const 白名单表达式（const 全局引用、常量算术/比较/拼接/三目——见
        // is_const_default_expr）。曾仅字面量 ⇒ E00359 挡住 const 引用与常量算术。
        if has_def == 1 {
            var dt = def_node
            var dtag = s_tags[dt]
            var is_ok: bool = false
            if dtag == S_N_INT_LIT || dtag == S_N_FLOAT_LIT || dtag == S_N_BOOL_LIT || dtag == S_N_CHAR_LIT || dtag == S_N_STR_LIT {
                is_ok = true
            } else if dtag == S_N_TABLE_LIT {
                if sstate.nchild(dt) == 0 {
                    is_ok = true
                }
            } else if is_const_default_expr(dt, 0) {
                is_ok = true
            }
            if !is_ok {
                sm_err_line = s_lines[p]
                sm_err_col = s_cols[p]
                sm_err_msg = "参数 '" + sstate.name_str(p) + "' 的默认值必须是字面量或编译期常量表达式（const 引用/常量算术；不可含调用或运行期依赖）"
                return -1
            }
            // 默认值类型匹配：默认值推导类型必须与参数类型兼容
            // 空表字面量 [] 默认值：直接通过（对齐 Rust：空表 → 任意表类型）
            var dt_ty = sinfer.infer_expr(dt)
            if dt_ty < 0 {
                return -1
            }
            var is_empty_tbl: bool = false
            if dtag == S_N_TABLE_LIT {
                if sstate.nchild(dt) == 0 {
                    is_empty_tbl = true
                }
            }
            if !is_empty_tbl {
                if !stype.types_match(pt, dt_ty, dt) {
                    sm_err_line = s_lines[p]
                    sm_err_col = s_cols[p]
                    sm_err_msg = "参数 '" + sstate.name_str(p) + "' 默认值类型不匹配：期望 " + types.type_name(pt) + "，实际 " + types.type_name(dt_ty)
                    return -1
                }
            }
        }
        table_push(p_tys, pt)
        table_push(p_refs, is_ref)
        table_push(p_defs, has_def)
        table_push(p_vars, is_var)
        // 必选数：变参本身不计数（调用方可传 0 个额外实参）
        if has_def == 0 && is_var == 0 {
            required = k + 1
        }
        k = k + 1
    }
    // M2.1.8：namespace <struct 名> 内的函数，首参 == 该 struct 类型 → 首参
    // **自动按引用传递**（对齐 Rust ir.rs：param_by_ref[0]，字段修改反映到调用方）。
    // `pub func inc(c: Counter)` 在 namespace Counter 内：c 首参标 ref，
    // c.inc() 转发时传 c 的槽地址，inc 内 c.count 修改写回调用方。
    // p.9.11.20 enum 关联方法同约定：namespace <enum 名> 内函数首参 == 该
    // enum 类型 → 首参自动 ref（方法分派 obj.method() → <enum>::method(obj)）。
    if nparams > 0 {
        var last2 = sstate.rfind_ns(full)
        if last2 >= 0 {
            var ns_name = ig_slice2(full, 0, last2)
            var snid = intern.intern(ns_name)
            var sidx2 = sstate.bs_find(st_keys, snid)
            if sidx2 >= 0 {
                var si2 = st_vals[sidx2]
                if p_tys[0] == types.struct_of(si2) {
                    p_refs[0] = 1  // 首参按引用（接收者）
                }
            } else {
                var eidx2 = sstate.bs_find(en_keys, snid)
                if eidx2 >= 0 {
                    var ei2 = en_vals[eidx2]
                    if p_tys[0] == types.enum_of(ei2) {
                        p_refs[0] = 1  // enum 接收者按引用（对齐 struct 方法）
                    }
                }
            }
        }
    }
    if sstate.reg_fn(full, is_pub, nparams, required, ret_ty, p_tys, p_refs, p_defs, p_vars, fn_node) < 0 {
        sm_err_line = s_lines[fn_node]
        sm_err_col = s_cols[fn_node]
        return -1
    }
    // p.9.11.15：生成器标记（签名返回类型已登记为 table<elem>；scheck 校验
    // yield 元素类型、irgen 按生成器发射攒表/返回表）
    if is_gen_fn == 1 {
        var g_sig = sstate.fn_sig(full)
        sstate.mark_gen(g_sig)
    }
    return 0
}

// p.9.11.15 生成器检测辅助：子树（语句/表达式）是否含 N_YIELD。
// 递归扫描子节点；N_FN_LIT（闭包）与 N_FN_DEF（块内函数定义）为函数边界，
// 不深入（闭包内 yield 由 scheck 在闭包体检查时报错，不属外层函数）。
// **N_CASE_BIND 特判**（对齐 sgen.clone_inner）：children[1] 是**变量名池 id**
//（非 AST 节点，parser 直接把 intern id 塞进 children）——不能当节点递归
//（会把池 id 当节点 id 读 s_tags 递归进无关子树，可能成环 → 栈溢出崩溃，
// 2026-09-13 enum 参数 + payload 解构实测 0xC0000409）；只递归 children[0]。
func contains_yield(node: i64) -> bool {
    if node < 0 {
        return false
    }
    var tag = s_tags[node]
    if tag == S_N_YIELD {
        return true
    }
    if tag == S_N_FN_LIT || tag == S_N_FN_DEF {
        return false
    }
    if tag == N_CASE_BIND {
        return contains_yield(sstate.child(node, 0))
    }
    var nc = sstate.nchild(node)
    var k: i64 = 0
    while k < nc {
        if contains_yield(sstate.child(node, k)) {
            return true
        }
        k = k + 1
    }
    return false
}

// 字符串切片（scollect 本地辅助；对齐 irgen.ig_slice）
// 性能重写（O(n)）：字节定位 + StringBuilder 拷贝（旧逐字符拼接 O(n²)）
func ig_slice2(s: string, start: i64, end: i64) -> string {
    var n: i64 = str_len(s)
    if start < 0 {
        start = 0
    }
    if end > n {
        end = n
    }
    if start >= end {
        return ""
    }
    var b: i64 = 0
    var i: i64 = 0
    var bstart: i64 = 0
    while i < end {
        if i == start {
            bstart = b
        }
        b = b + utf8_seq_len(s, b)
        i = i + 1
    }
    var sb = string_builder()
    var k: i64 = bstart
    while k < b {
        sb_append_byte(sb, str_byte(s, k))
        k = k + 1
    }
    return sb_build(sb)
}

// 顶层 struct 声明登记分派（泛型语法 2026-08-14）：
// children[0] == N_TYPE_PARAMS → 泛型 struct 模板登记（sstate.reg_generic →
// gt_* 表，跳过普通 struct 收集——模板字段的 TypeVar 类型无法静态解析，
// collect_struct_fields 会因"类 'T' 未定义"崩溃）；否则普通 reg_struct。
// 返回 0 成功 / -1 错误（sm_err_* 已置）。
func collect_struct_decl(s: i64) -> i64 {
    var nm = sstate.name_str(s)
    if sstate.nchild(s) > 0 {
        var slot0 = sstate.child(s, 0)
        if slot0 >= 0 {
            if s_tags[slot0] == S_N_TYPE_PARAMS {
                var gret = sstate.reg_generic(nm, s, 1)
                if gret < 0 {
                    return -1
                }
                return 0
            }
        }
    }
    var parent = ""
    var p = s_aux[s]
    if p >= 0 {
        parent = intern.lookup(p)
    }
    // struct 与函数名冲突（对齐 Rust check_struct_namespace：struct 名不能与
    // 同命名空间函数同名——构造调用 vs 函数调用的歧义）
    var snid = intern.intern(nm)
    if sstate.bs_find(fn_keys, snid) >= 0 {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        sm_err_msg = "struct 名 '" + nm + "' 与函数名冲突"
        return -1
    }
    var idx = sstate.reg_struct(nm, parent)
    if idx < 0 {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        return -1
    }
    // p.9.22.6 全量符号表：struct 声明登记（kind 1；type = struct_of(idx)）。
    xref.reg_decl(snid, 1, types.struct_of(idx), s)
    // p.9.21.6-1 模块边界显式化：struct 行来源模块回填（reg_struct 默认 0；
    // 此处持定义节点 s，反查真实文件 id）
    st_mod[idx] = sstate.file_id_of_node(s)
    // struct 名登记（types.type_name / 泛型 mangling 片段还原用；追加式与
    // reg_struct 索引顺序一致——实例化 struct 由 sgen.instantiate_struct 同步登记）
    types.set_struct_name(idx, nm)
    return 0
}

// 查找顶层 struct 定义节点（按名字）
pub func find_struct_node(name: string) -> i64 {
    // import 展开后 struct 可能在 g_extra_tops（全部文件顶层，与 find_fn_node 一致）
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == S_N_STRUCT {
            if sstate.name_str(s) == name {
                return s
            }
        }
        i = i + 1
    }
    return -1
}

}