// ==================== check 主入口 ====================
// 语义检查入口：AST 协议文本 → "OK:<typed>" / "ERR:<line> <col> <msg>"
pub func check(ast_text: string) -> string {
    return check_impl(ast_text, "")
}

// 便捷入口：源码字符串 + 基准目录 → 完整语义检查（parse + import 展开 + check）
pub func check_src(src: string, base_dir: string) -> string {
    // 剥离文件类型声明头部（type tie / type tie<X>）——真实管线由预处理完成，
    // check 路径须等效（否则头部声明被当顶层标识符报错；strip_type_decl 与
    // 展开 import 时同规则，行号占位保一致）
    var ast_text = parser.parse_src(strip_type_decl(src))
    if sstate.has_prefix_str(ast_text, "ERR:") {
        return ast_text
    }
    return check_impl(ast_text, base_dir)
}

// check 核心（含 import 展开）
pub func check_impl(ast_text: string, base_dir: string) -> string {
    g_cur_dir = base_dir
    reset_sem_state()
    if sstate.load_ast(ast_text) < 0 {
        return "ERR:0 0 AST 协议解析失败"
    }
    g_root = s_n - 1
    // import 展开（主文件顶层进 g_extra_tops，import 文件递归合并）
    var er = expand_imports()
    if er < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    var r = scollect.collect_top()
    if r < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // S2.4 impl 块统一处理（struct/port 全部登记后：方法改名 + 签名登记 +
    // 完整性/签名检查 + impl 记录）。须在 expand_generics 之前——泛型约束
    // 校验（instantiate_fn/struct）依赖 impl 表就绪。
    var ifr = scollect.collect_impl_fns()
    if ifr < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 泛型单态化预扫描展开（T3b）：遍历模板 → 扫描调用点 → 展开 → 去重 →
    // 递归处理新实例化（展开产物进入 fn_keys/st_keys 后由后续阶段覆盖）。
    // 须在 collect_all_struct_fields 之前——展开的 struct 字段拍平由
    // instantiate_struct 即时完成，主流程再遍历 st_keys 时 cls_done 跳过
    var ge = expand_generics()
    if ge < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 泛型字段类型预实例化（2026-08-14）：字段类型中的模板 struct 引用（如
    // `A<i64>`）在此先行实例化，避免 collect_all_struct_fields 拍平时实例化
    // 副作用顶偏 cls_fldoff（详见 scollect.pre_instantiate_field_types 注释）
    var pr = scollect.pre_instantiate_field_types()
    if pr < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // struct 字段拍平收集（含继承；须在逐函数检查前完成）
    var r3 = scollect.collect_all_struct_fields()
    if r3 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // enum 变体收集（须在 struct 字段拍平之后——payload 类型可能引用 struct）
    var r5 = scollect.collect_all_enums()
    if r5 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // p.9.17.2 缺陷 #4a：延迟的全局标量初始化类型检查（须在 enum 变体收集后——
    // enum 变体常量初始化器依赖 en_vnames 变体表）
    var r6 = scollect.check_deferred_global_inits()
    if r6 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 返回表元素预扫描（先于逐函数 check）
    var r4 = scollect.collect_all_return_tables()
    if r4 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 逐函数检查（T3b 稳定化：检查期间 infer_call 会触发展开新实例化 → fn_keys
    // 增长，循环重扫直到无新函数——防 sorted_insert 把新签名插到游标之前被跳过）
    var checked: table<i64> = table_new_i64()
    var again: bool = true
    while again {
        again = false
        var i: i64 = 0
        while i < len(fn_keys) {
            var fid = fn_keys[i]
            var chk: i64 = 0
            var has: bool = false
            while chk < len(checked) {
                if checked[chk] == fid {
                    has = true
                    break
                }
                chk = chk + 1
            }
            if !has {
                table_push(checked, fid)
                again = true
                var fname = intern.lookup(fid)
                // S1.5 移动语义：每函数检查前重置 live/moved 状态表
                // （lv_* 局部表在 scheck.check_fn 重置；lv_moved 独立表在此
                // 同步重置——sstate 定义，见 lv_moved_reset）
                sstate.lv_moved_reset()
                var r2 = scheck.check_fn_walk(fname)
                if r2 < 0 {
                    return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
                }
                // S1.5 移动语义独立 pass：类型检查后遍历函数体，跟踪 live/moved
                // （复用已重置的 lv_moved；内置/原语调用借用，用户函数按值堆参数移动）。
                // 门控全在 smove 内部：凭据（§11.6）**始终检查**；堆类型**默认开**
                // （2026-10-01 迁移完成：tiec 自举审计 85 → 0，string 已因
                // 「不可变值」移出跟踪范围），`TIE_MOVE_CHECK=0` 可显式关闭。
                var r_mv = smove.check_fn_walk(fname)
                if r_mv < 0 {
                    return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
                }
            }
            i = i + 1
        }
    }
    // S2.2 闭包体延迟检查：所有函数检查完后 FIFO 处理 g_clo_pending
    // （闭包体用登记时 lv 快照重建独立作用域，不影响外层函数）
    var rc = scheck.check_pending_closures()
    if rc < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // W00030 文件粒度收尾：整个文件都没用到文件级授权的域 ⇒ 挂空告警。
    scheck.cap_idle_flush()
    return sm_ok_protocol()
}

// 内存版 check 核心（T5.3 消除 AST 文本协议往返；前置条件：
// parser.parse_ast 已成功执行、ast 节点池在内存）。
// 与 check_impl(ast_text, base_dir) 语义完全等价：仅把 sstate.load_ast(协议文本)
// 替换为 copy_ast_tables()（内存直拷 ast 表 → sstate 表），import 展开走内存版
// expand_one_import（parse_ast + append_ast_mem）。状态重置、collect 系列、
// 逐函数 check 循环与错误返回格式全部保留。
// 返回 "OK:<typed>" 或 "ERR:<line> <col> <msg>"。
pub func check_ast(base_dir: string) -> string {
    g_cur_dir = base_dir
    reset_sem_state()
    // 内存直拷：ast 节点池 → sstate 9 列（替代 sstate.load_ast 的文本反序列化）
    unsafe {
        var smc0 = GetTickCount()
    }
    if copy_ast_tables() < 0 {
        return "ERR:0 0 AST 协议解析失败"
    }
    unsafe {
        var smc1 = GetTickCount()
    }
    sm_t_copy = smc1 - smc0
    g_root = s_n - 1
    // import 展开（主文件顶层进 g_extra_tops，import 文件递归合并）。
    // dev33 批次10 任务29：跨文件宏——import 展开**先于**宏展开，导入文件的
    // 宏定义（pub）才可见；同时记录各文件顶层 StmtList 根（g_file_roots，
    // 供 mexpand 做宏可见性判定）。
    var er = expand_imports()
    if er < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    unsafe {
        var smc3 = GetTickCount()
    }
    sm_t_imp = smc3 - smc1
    // S3.3 宏展开 pass（跨文件宏：g_extra_tops 收集全部文件顶层宏定义；
    // 展开结果参与类型检查）。失败返回与后续同格式的 ERR 协议文本。
    if mexpand.expand_sstate() < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    unsafe {
        var smc2 = GetTickCount()
    }
    sm_t_mexp = smc2 - smc3
    var r = scollect.collect_top()
    if r < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    unsafe {
        var smc4 = GetTickCount()
    }
    sm_t_coll = smc4 - smc3
    // S2.4 impl 块统一处理（同 check_impl：方法改名 + 签名登记 + 完整性/
    // 签名检查 + impl 记录；须在 expand_generics 之前——泛型约束校验依赖
    // impl 表就绪）
    var ifr = scollect.collect_impl_fns()
    if ifr < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    unsafe {
        var smc5 = GetTickCount()
    }
    sm_t_impl = smc5 - smc4
    // 泛型单态化预扫描展开（T3b）：同 check_impl（见其注释）
    var ge = expand_generics()
    if ge < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    unsafe {
        var smc6 = GetTickCount()
    }
    sm_t_gen = smc6 - smc5
    // 泛型字段类型预实例化（2026-08-14）：字段类型中的模板 struct 引用（如
    // `A<i64>`）在此先行实例化，避免 collect_all_struct_fields 拍平时实例化
    // 副作用顶偏 cls_fldoff（详见 scollect.pre_instantiate_field_types 注释）
    var pr = scollect.pre_instantiate_field_types()
    if pr < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // struct 字段拍平收集（含继承；须在逐函数检查前完成）
    var r3 = scollect.collect_all_struct_fields()
    if r3 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    unsafe {
        var smc7 = GetTickCount()
    }
    sm_t_flds = smc7 - smc6
    // enum 变体收集（须在 struct 字段拍平之后——payload 类型可能引用 struct）
    var r5 = scollect.collect_all_enums()
    if r5 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // p.9.17.2 缺陷 #4a：延迟的全局标量初始化类型检查（须在 enum 变体收集后——
    // enum 变体常量初始化器依赖 en_vnames 变体表）
    var r6 = scollect.check_deferred_global_inits()
    if r6 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 返回表元素预扫描（先于逐函数 check）
    var r4 = scollect.collect_all_return_tables()
    if r4 < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // 逐函数检查（T3b 稳定化，同 check_impl）
    // 性能重构：checked 改直索引表（checked[sig] = 1；sig 稠密 0..N-1）——
    // 旧版线性扫 checked 查 fid 是 O(N²)；泛型展开中 sig 追加时循环扩容。
    unsafe {
        var smc8 = GetTickCount()
    }
    var checked: table<i64> = table_new_i64()
    var again: bool = true
    while again {
        again = false
        var i: i64 = 0
        while i < len(fn_keys) {
            var fid = fn_keys[i]
            var sig = fn_vals[i]
            while len(checked) <= sig {
                table_push(checked, 0)
            }
            if checked[sig] == 0 {
                checked[sig] = 1
                again = true
                var fname = intern.lookup(fid)
                // S1.5 移动语义：每函数检查前重置 live/moved 状态表（同 check_impl）
                sstate.lv_moved_reset()
                var r2 = scheck.check_fn_walk(fname)
                if r2 < 0 {
                    return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
                }
                // S1.5 移动语义独立 pass（同 check_impl；门控在 smove 内部两层）
                var r_mv = smove.check_fn_walk(fname)
                if r_mv < 0 {
                    return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
                }
            }
            i = i + 1
        }
    }
    // S2.2 闭包体延迟检查：所有函数检查完后 FIFO 处理 g_clo_pending
    // （闭包体用登记时 lv 快照重建独立作用域，不影响外层函数）
    var rc = scheck.check_pending_closures()
    if rc < 0 {
        return "ERR:" + to_string(sm_err_line) + " " + to_string(sm_err_col) + " " + sm_err_msg
    }
    // W00030 文件粒度收尾：整个文件都没用到文件级授权的域 ⇒ 挂空告警。
    scheck.cap_idle_flush()
    unsafe {
        var smc9 = GetTickCount()
    }
    sm_t_fns = smc9 - smc8
    // 子阶段计时报告（TIEC_TIME=1）
    var tmv = get_env("TIEC_TIME")
    if tmv == "1" {
        println("[sem] copy=" + to_string(sm_t_copy) + "ms mexp=" + to_string(sm_t_mexp) +
            "ms imports=" + to_string(sm_t_imp) + "ms collect=" + to_string(sm_t_coll) +
            "ms impl=" + to_string(sm_t_impl) + "ms generics=" + to_string(sm_t_gen) +
            "ms fields=" + to_string(sm_t_flds) + "ms fns=" + to_string(sm_t_fns) + "ms")
        println("[sem.imp] strip=" + to_string(sm_t_imp_strip) + "ms lex=" +
            to_string(sm_t_imp_lex) + "ms build=" + to_string(sm_t_imp_build) +
            "ms append=" + to_string(sm_t_imp_append) + "ms fill=" +
            to_string(sm_t_imp_fill) + "ms")
    }
    return sm_ok_protocol()
}

// p.9.16.1 内存工程：前端 AST 释放接口（LSP「重型能力用完即弃」）。
// 语义：把 s_* 列式表与符号表回退到空始态，并同时清 intern 池与 parser 节点池。
// 用途：tsp 在每次分析产出所需结果（诊断 / 符号索引）后调用，
// 把「按需物化整棵 AST」的峰值还给系统（长驻会话不再随文档数线性增长）。
// 约定：调用后先前取得的节点 id / 名字池 id **全部失效**；
// 调用方只应保存脱离 s_* / intern 的平面结果（诊断文本、字符串符号名）。
// 纯 tie、零新增运行时（无析构器、无新增引用计数）。
// 无 caller 调用时行为逐字节不变（单次编译路径零影响）。
pub func release_ast() {
    release_ast_keep_intern()
    intern.reset()
}

// 常驻编译服务（--serve-compile 的 op=2 请求）：单元间复位，**保留 intern 池**。
// 与 release_ast 的唯一差别：不清名字池。理由：服务进程里已有模块**长期持有**
// 名字池 id（角色注册表、dbgem 记录族、诊断表），清池会让这些 id 重新指向别的
// 名字——实测症状极隐蔽：asm_mem_probe 的「str_cat 临时串可释放」判定被带偏，
// 产物多出一条 `call @tie_str_free_if_heap`（语义仍是错的释放点）。
// 池单调增长在构建服务里可接受（增量 ≈ 各单元标识符总量），CLI 一次性路径不受影响。
pub func release_ast_keep_intern() {
    reset_sem_state()
    // 导入展开状态表一并清（expand_imports 下次会重建）。
    g_imported = table_new_string()
    g_file_base = table_new_i64()
    g_imp_idkeys = table_new_i64()
    g_imp_idvals = table_new_i64()
    g_extra_tops = table_new_i64()
    g_imp_alias_names = table_new_string()
    sstate.ns_rename_reset()
    g_imp_alias_paths = table_new_string()
    g_file_roots = table_new_i64()
    g_file_count = 1
    g_root = 0
    s_n = 0
    // parser 节点池：与 s_* 同批清（s_names 存的就是池 id；调用方决定是否清池）
    ast.reset()
}

// p.9.15.1 依赖感知缓存：转调 sstate.imported_paths（driver 无法直接访问
// sstate 命名空间，经 semantic 透出；sstate 函数跨命名空间调用已由本文件
// 既有 sstate.xxx 用法证实可行）。
pub func imported_paths() -> table<string> {
    return sstate.imported_paths()
}

// p.9.14.2 独立警告 pass：总开关访问器（driver 经 semantic. 转调；必须在
// namespace 内定义才能被 driver 用 semantic.set_warn_enabled/semantic.sm_warn_enabled
// 访问——顶层 pub 函数不挂 semantic 命名空间，此前报「未定义」即由此起）。
// 是否启用警告检查。
pub func sm_warn_enabled() -> bool {
    return sm_warn_active
}

// 开关设置（driver -w 开启、--no-warn 关闭；默认 false = 只报错）。
pub func set_warn_enabled(on: bool) {
    sm_warn_active = on
}

// 已收集警告条数。
pub func warn_count() -> i64 {
    return len(sm_warn_msgs)
}

// 第 i 条警告行号。
pub func warn_line_at(i: i64) -> i64 {
    return sm_warn_lines[i]
}

// 第 i 条警告列号。
pub func warn_col_at(i: i64) -> i64 {
    return sm_warn_cols[i]
}

// 第 i 条警告核心消息（与 diagcode 警告目录逐字一致）。
pub func warn_msg_at(i: i64) -> string {
    return sm_warn_msgs[i]
}

// 第 i 条警告所属模块序号（0 = 主输入文件）。
pub func warn_file_at(i: i64) -> i64 {
    return sm_warn_files[i]
}

// **主输入文件**（模块序号 0）的警告条数。这是 -Werror 的判定口径：
// 只对「你正在编译的这个文件」要求零警告，不被 std/prelude 自身告警牵连
//（否则任何编译都会失败；库的告警属另一件事，用 warn_other_count 单独可见）。
pub func warn_main_count() -> i64 {
    var c: i64 = 0
    var i: i64 = 0
    while i < len(sm_warn_files) {
        if sm_warn_files[i] == 0 {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// 导入模块（模块序号 > 0）的警告条数，供汇总时如实报告（不隐藏）。
pub func warn_other_count() -> i64 {
    return len(sm_warn_files) - warn_main_count()
}

}