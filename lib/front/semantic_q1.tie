type tie<class>
// compiler/frontend/semantic_q1.tie —— 分片 1（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 只搬函数与紧邻注释；顶层全局 var 与 import 树仍留在 semantic.tie。
// 顶层函数保持顶层身份（跨 ns 裸调依赖），ns 内函数按上下文包 namespace。
// 清空警告通道（每次语义检查入口调用）。
pub func sm_warn_reset() {
    sm_warn_lines = table_new_i64()
    sm_warn_cols = table_new_i64()
    sm_warn_msgs = table_new_string()
    sm_warn_files = table_new_i64()
    sm_cur_file = 0
    // W00016：全局可变表写点累积每编译重置（scheck 侧状态）
    scheck.w16_reset()
}

// 登记一条警告（line/col + 核心消息；核心消息由 diagcode 目录精确匹配）。
// p.9.14.2：总开关关闭时不登记（独立 pass 未启用，零收集成本）。
pub func sm_warn_add(line: i64, col: i64, msg: string) {
    if !sm_warn_active {
        return
    }
    table_push(sm_warn_lines, line)
    table_push(sm_warn_cols, col)
    table_push(sm_warn_msgs, msg)
    table_push(sm_warn_files, sm_cur_file)
}

// 设置「当前检查的模块序号」（check_fn_walk 按函数定义节点设置；进入函数体前调用）。
pub func sm_set_cur_file(fid: i64) {
    sm_cur_file = fid
}

// OK 协议组装："OK:<typed>"（p.9.14.1：警告改结构化事件直发，不再拼 ;W: 文本段；
// driver 经 warn_count/warn_line_at/warn_col_at/warn_msg_at 读取渲染，输出端一次归一化）。
pub func sm_ok_protocol() -> string {
    return "OK:" + to_string(g_typed)
}

namespace semantic {
// CLI 显式指定库根（--lib-root <dir>），优先级最高，覆盖环境变量与默认。
pub func set_lib_root(p: string) {
    if str_len(p) > 0 {
        g_lib_root = p
    }
}

// p.9.11.13 扩展（2026-10-12）：#cfg 求值环境注入——driver 在编译入口单点调用
// （cfg_target/cfg_profile 归一化后），供被导入文件的 #cfg 预处理复用（判据单一来源）。
pub func set_cfg_env(target: string, profile: string) {
    g_cfg_env_target = target
    g_cfg_env_profile = profile
}

// 解析 import 路径：相对当前文件目录（处理 "./" 与 "../"）；
// 结果统一经 normalize_path 归一化（去重键一致，见 normalize_path 注释）。
pub func resolve_import_path(path: string) -> string {
    if sstate.has_prefix_str(path, "./") {
        return normalize_path(g_cur_dir + str.slice(path, 2, str_len(path)))
    }
    if sstate.has_prefix_str(path, "../") {
        // g_cur_dir 形如 "examples/"：去掉最后一个非空目录段得 "…/"，
        // 再拼去掉 ../ 的剩余路径（/ext/x → ext/x）
        var d = g_cur_dir
        var dn = str_len(d)
        // 去掉尾部斜杠（若 d 非空且以 / 结尾）
        while dn > 0 {
            if str_char(d, dn - 1) == "/" {
                dn = dn - 1
            } else {
                break
            }
        }
        // 找到上一个 '/'，截断到它（含）——去掉最后一段
        var cut: i64 = -1
        var i: i64 = dn - 1
        while i >= 0 {
            if str_char(d, i) == "/" {
                cut = i + 1
                break
            }
            i = i - 1
        }
        var parent = ""
        if cut >= 0 {
            parent = str.slice(d, 0, cut)
        }
        return normalize_path(parent + str.slice(path, 3, str_len(path)))
    }
    // p.9.13.7-B：内置库根别名（/std、/ext、/rdu、/sys）→ 库根 + 原路径
    if is_lib_alias(path) {
        return normalize_path(lib_root() + path)
    }
    return normalize_path(path)
}

// 便捷入口：源码字符串 + 基准目录 → 可读语义摘要
pub func check_debug_src(src: string, base_dir: string) -> string {
    // 剥离文件类型声明头部（type tie / type tie<X>）——真实管线由预处理完成，
    // check 路径须等效（否则头部声明被当顶层标识符报错）
    var ast_text = parser.parse_src(strip_type_decl(src))
    if sstate.has_prefix_str(ast_text, "ERR:") {
        return ast_text
    }
    return check_debug(ast_text)
}

