type tie<logic>
// compiler/frontend/error_driver.tie —— T2.7 错误 golden 对比驱动
// ============================================================
// 遍历 _local_only/probes/tests/errors/golden/*.tie，对每个文件跑 semantic.check_src，
// 将语义/语法错误输出为「语义错误 @行:列: 消息」（与 .stderr golden 对齐；
// 原 Rust 基线 test-errors.ps1/regenerate-golden.ps1 已随 0-Rust 退役，2026-09-13 删除）。
//
// 库归属（p.9.21 G3）：本文件是**编排入口**（自带 main，驱动 sema 跑语料），
// 不属于 diag 库（diag 库 = diagcode/errors 数据表与对外渲染），因此门禁矩阵
// 将其归到 driver 库。放在 frontend/ 只是历史路径，diag 库不持有对 sema 的依赖。
import "./semantic.tie"

// 从 "ERR:line col msg" 提取 line/col/msg，并根据消息内容判断错误类型前缀：
// 词法错误（lexer 消息特征）/ 语法错误（parser 消息特征）/ 语义错误（其余）。
// 命名 fmt_err_msg：避免与 interp/interp.tie 的 fmt_err（2 参数）同名冲突——
// error_driver import semantic → mexpand → interp，同名顶层函数合并后
// 语义检查会把 interp 的 2 参数调用误解析到本 1 参数函数（批次1-任务2 修复）。
func fmt_err_msg(r: string) -> string {
    // ERR:line col msg
    var rest = str.slice(r, 4, str_len(r))
    var n = str_len(rest)
    var i: i64 = 0
    while i < n {
        if str_char(rest, i) == " " {
            break
        }
        i = i + 1
    }
    var line = str.slice(rest, 0, i)
    var j = i + 1
    while j < n {
        if str_char(rest, j) == " " {
            break
        }
        j = j + 1
    }
    var col = str.slice(rest, i + 1, j)
    var msg = str.slice(rest, j + 1, n)
    // 词法错误特征（对齐 lexer.rs 消息）
    var prefix = "语义错误"
    if str.contains(msg, "无法识别") || str.contains(msg, "未闭合") ||
        str.contains(msg, "未知转义") || str.contains(msg, "转义符后缺少") {
        prefix = "词法错误"
    }
    return prefix + " @" + line + ":" + col + ": " + msg
}

func main() {
    var files: table<string> = [
        "_local_only/probes/tests/errors/golden/err_000.tie", "_local_only/probes/tests/errors/golden/err_001.tie",
        "_local_only/probes/tests/errors/golden/err_002.tie", "_local_only/probes/tests/errors/golden/err_003.tie",
        "_local_only/probes/tests/errors/golden/err_004.tie", "_local_only/probes/tests/errors/golden/err_005.tie",
        "_local_only/probes/tests/errors/golden/err_006.tie", "_local_only/probes/tests/errors/golden/err_007.tie",
        "_local_only/probes/tests/errors/golden/err_008.tie", "_local_only/probes/tests/errors/golden/err_009.tie",
        "_local_only/probes/tests/errors/golden/err_010.tie", "_local_only/probes/tests/errors/golden/err_011.tie",
        "_local_only/probes/tests/errors/golden/err_012.tie", "_local_only/probes/tests/errors/golden/err_013.tie",
        "_local_only/probes/tests/errors/golden/err_014.tie", "_local_only/probes/tests/errors/golden/err_015.tie",
        "_local_only/probes/tests/errors/golden/err_016.tie", "_local_only/probes/tests/errors/golden/err_017.tie",
        "_local_only/probes/tests/errors/golden/err_018.tie", "_local_only/probes/tests/errors/golden/err_019.tie",
        "_local_only/probes/tests/errors/golden/err_020.tie", "_local_only/probes/tests/errors/golden/err_021.tie",
        "_local_only/probes/tests/errors/golden/err_022.tie", "_local_only/probes/tests/errors/golden/err_023.tie",
        "_local_only/probes/tests/errors/golden/err_024.tie", "_local_only/probes/tests/errors/golden/err_025.tie",
        "_local_only/probes/tests/errors/golden/err_026.tie", "_local_only/probes/tests/errors/golden/err_027.tie",
        "_local_only/probes/tests/errors/golden/err_028.tie", "_local_only/probes/tests/errors/golden/err_029.tie",
        "_local_only/probes/tests/errors/golden/err_030.tie", "_local_only/probes/tests/errors/golden/err_031.tie",
        "_local_only/probes/tests/errors/golden/err_032.tie", "_local_only/probes/tests/errors/golden/err_033.tie",
        "_local_only/probes/tests/errors/golden/err_034.tie", "_local_only/probes/tests/errors/golden/err_035.tie",
        "_local_only/probes/tests/errors/golden/err_036.tie", "_local_only/probes/tests/errors/golden/err_037.tie",
        "_local_only/probes/tests/errors/golden/err_038.tie", "_local_only/probes/tests/errors/golden/err_039.tie",
        "_local_only/probes/tests/errors/golden/err_040.tie", "_local_only/probes/tests/errors/golden/err_041.tie",
        "_local_only/probes/tests/errors/golden/err_042.tie", "_local_only/probes/tests/errors/golden/err_043.tie",
        "_local_only/probes/tests/errors/golden/err_044.tie", "_local_only/probes/tests/errors/golden/err_045.tie",
        "_local_only/probes/tests/errors/golden/err_046.tie", "_local_only/probes/tests/errors/golden/err_047.tie",
        "_local_only/probes/tests/errors/golden/err_048.tie", "_local_only/probes/tests/errors/golden/err_049.tie",
        "_local_only/probes/tests/errors/golden/err_050.tie", "_local_only/probes/tests/errors/golden/err_051.tie",
        "_local_only/probes/tests/errors/golden/err_052.tie", "_local_only/probes/tests/errors/golden/err_053.tie",
        "_local_only/probes/tests/errors/golden/err_054.tie", "_local_only/probes/tests/errors/golden/err_055.tie",
        "_local_only/probes/tests/errors/golden/err_056.tie", "_local_only/probes/tests/errors/golden/err_057.tie",
        "_local_only/probes/tests/errors/golden/err_058.tie", "_local_only/probes/tests/errors/golden/err_059.tie",
        "_local_only/probes/tests/errors/golden/err_060.tie", "_local_only/probes/tests/errors/golden/err_061.tie",
        "_local_only/probes/tests/errors/golden/err_062.tie", "_local_only/probes/tests/errors/golden/err_063.tie",
        "_local_only/probes/tests/errors/golden/err_064.tie", "_local_only/probes/tests/errors/golden/err_065.tie",
        // 批次1（import 段错误修复）回归用例：
        // err_066 = import 不存在的文件（任务1）；err_067 = import 语法错误文件；
        // err_068 = import 语义错误文件（任务2 两类坏输入）
        "_local_only/probes/tests/errors/golden/err_066.tie", "_local_only/probes/tests/errors/golden/err_067.tie",
        "_local_only/probes/tests/errors/golden/err_068.tie"
    ]
    var i: i64 = 0
    while i < len(files) {
        var src = file_read(files[i])
        var r = semantic.check_src(src, "_local_only/probes/tests/errors/golden/")
        var out = ""
        if str_len(r) >= 3 {
            if str_char(r, 0) == "E" {
                out = fmt_err_msg(r)
            }
        }
        if out == "" {
            out = "（无错误输出）"
        }
        println(out)
        i = i + 1
    }
}
