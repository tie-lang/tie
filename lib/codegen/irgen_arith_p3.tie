type tie<class>
// lib/codegen/irgen_arith_p3.tie —— irgen_arith 分片 3
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 irgen_arith.tie。
namespace irgen;
// 复合赋值运算（Assign op ≥ 0）：在 load 出的旧值与右值上执行二元运算。
// 类型分派：字符串 += → str_cat；浮点 → fadd 族；整数/位运算 → 常规 opcode。
func tig_compound_assign(op: i64, lv: i64, rv: i64, ty: i64) -> i64 {
    // 字符串拼接（+=）：str_cat 指令
    if ty == types.named(TK_STR) && op == 0 {
        var sc = ir.new_inst(g_cur_block, 56, types.named(TK_STR))  // str_cat
        ir.add_operand(sc, lv, 0)
        ir.add_operand(sc, rv, 0)
        return ir.get_value(sc)
    }
    var is_f = types.is_float(ty)
    // `%%=`（浮点）：与二元 `%%` 同构 —— a - floor(a/b)*b（余数符号跟随除数）。
    // 必须提前返回：frem 的语义与 floor 取余不同（-7.0 frem 3.0 == -1.0，
    // 而 -7.0 %% 3.0 == 2.0），故不能像 `%=` 那样靠一个 opcode 表达。
    if op == 26 && is_f {
        var q2 = ir.new_inst(g_cur_block, 16, ty)  // fdiv a/b
        ir.add_operand(q2, lv, 0)
        ir.add_operand(q2, rv, 0)
        var fl2 = tig_ext_call1("floor", ir.get_value(q2), ty, ty)
        if fl2 < 0 {
            return -1
        }
        var pr2 = ir.new_inst(g_cur_block, 15, ty)  // fmul floor(a/b)*b
        ir.add_operand(pr2, fl2, 0)
        ir.add_operand(pr2, rv, 0)
        var sb2 = ir.new_inst(g_cur_block, 14, ty)  // fsub a - q*b
        ir.add_operand(sb2, lv, 0)
        ir.add_operand(sb2, ir.get_value(pr2), 0)
        return ir.get_value(sb2)
    }
    var iop: i64 = -1
    if op == 0 {
        iop = 0  // +=
    } else if op == 1 {
        iop = 1  // -=
    } else if op == 2 {
        iop = 2  // *=
    } else if op == 3 {
        iop = 3  // /=
    } else if op == 24 {
        iop = 3  // \=：先取截断商；有符号整数随后套 floor 调整（见函数尾）
    } else if op == 4 {
        iop = 4  // %=
    } else if op == 26 {
        iop = 4  // %%=：先取截断余数；有符号整数随后套 floor 调整（见函数尾）
    } else if op == 13 {
        iop = 6  // &=
    } else if op == 14 {
        iop = 7  // |=
    } else if op == 15 {
        iop = 8  // ^=
    } else if op == 16 {
        iop = 10  // <<=
    } else if op == 17 {
        iop = 11  // >>=
    }
    if is_f {
        if op == 0 {
            iop = 13  // fadd
        } else if op == 1 {
            iop = 14  // fsub
        } else if op == 2 {
            iop = 15  // fmul
        } else if op == 3 {
            iop = 16  // fdiv
        } else if op == 4 {
            iop = 17  // fmod
        } else if op == 24 {
            iop = 16  // \= 浮点：先 fdiv，随后套 floor（见下）
        }
    }
    if iop < 0 {
        return -1
    }
    var inst = ir.new_inst(g_cur_block, iop, ty)
    ir.add_operand(inst, lv, 0)
    ir.add_operand(inst, rv, 0)
    var res = ir.get_value(inst)
    // `\=`（浮点）：fdiv 结果再取 floor，保持与二元 `\` 的 floor-div 语义一致。
    if op == 24 && is_f {
        return tig_ext_call1("floor", res, ty, ty)
    }
    // -S.7 `\=`（有符号整数）：截断商 → floor 商，与二元 `\` 同语义（规范 §3.3）。
    // 无符号/char/trit 在 tig_floor_fix_div 内直接返回截断值（无负值，两者等价）。
    if op == 24 {
        return tig_floor_fix_div(lv, res, rv, ty)
    }
    // `%%=`（有符号整数）：截断余数 → floor 余数，与二元 `%%` 同语义。
    // 无符号/char/trit 在 tig_floor_fix_mod 内直接返回截断值（无负值，两者等价）。
    if op == 26 {
        return tig_floor_fix_mod(res, rv, ty)
    }
    return res
}

// `+` 扩展的辅助：把标量值转成字符串（供 string+标量 拼接）。
// 复用语料库里的**值级**转换 helper（它们直接吃 SSA 值，不需要调用节点）：
//   * 整数（含窄整数/无符号）→ 先拓宽到 i64 再 tig_i64_to_str
//   * f64/f32 → tig_f64_to_str
//   * bool → cond_br + phi 在 "true"/"false" 两常量间选（与内置 to_string 同语义）
// 其它类型（表/聚合/指针等）返回 -1——本扩展只面向标量。
func tig_scalar_to_str(v: i64, t: i64) -> i64 {
    if types.is_int(t) {
        var w = stype.int_width(t)
        var iv = v
        if w > 0 && w < 64 {
            iv = tig_widen(v, t, types.named(TK_I64))
            if iv < 0 {
                return -1
            }
        }
        return tig_i64_to_str(iv, stype.is_signed(t))
    }
    if types.is_float(t) {
        return tig_f64_to_str(v)
    }
    if types.is_bool_like(t) {
        var t_str = tig_str_lit(interner.intern("\"true\""))
        var f_str = tig_str_lit(interner.intern("\"false\""))
        var bcond = tig_cond_to_bool(v, t)
        var t_blk = ir.new_block(g_cur_func, interner.intern("cat.t"))
        var f_blk = ir.new_block(g_cur_func, interner.intern("cat.f"))
        var m_blk = ir.new_block(g_cur_func, interner.intern("cat.m"))
        var cbr = ir.new_inst(g_cur_block, 31, -1)  // cond_br
        ir.add_operand(cbr, bcond, 0)
        ir.add_operand(cbr, t_blk, 1)
        ir.add_operand(cbr, f_blk, 1)
        g_cur_block = t_blk
        var br1 = ir.new_inst(g_cur_block, 30, -1)  // br merge
        ir.add_operand(br1, m_blk, 1)
        g_cur_block = f_blk
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, m_blk, 1)
        g_cur_block = m_blk
        // φ 汇合：opcode **33** 是 phi（32 不是——用错会生成 label 类型导致
        // LLVM 校验报「defined with type 'label' but expected 'ptr'」，实测）。
        var ph = ir.new_inst(g_cur_block, 33, types.named(TK_STR))  // phi
        ir.add_operand(ph, t_str, 0)
        ir.add_operand(ph, t_blk, 1)
        ir.add_operand(ph, f_str, 0)
        ir.add_operand(ph, f_blk, 1)
        return ir.get_value(ph)
    }
    sm_err_msg = "'+' 的字符串拼接只支持标量（整数/浮点/bool），不支持 " + types.type_name(t)
    return -1
}

// 二进制安全文本比较：长度头 + 字节序列，内嵌 NUL 不作终止符。
// 返回 i1 值 id；op 5..10 依次为 == != < > <= >=。
// 机制：取两侧长度头的较小值做 memcmp，得到公共前缀的字典序符号；前缀相同
// 时再由长度决定大小。UTF-8 字节序与码点序一致，故按字节比较即规范 §3.6
// 的「按码点顺序比较」。字符串块带 32 字节尾填充，CRT 向量化宽读不越界。
func tig_str_cmp_bytes(op: i64, lv: i64, rv: i64) -> i64 {
    var nl = s21_str_head_len(lv)
    var nr = s21_str_head_len(rv)
    // 较小长度 = memcmp 的比较长度，避免读越界
    var lt_len = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
    ir.add_operand(lt_len, nl, 0)
    ir.add_operand(lt_len, nr, 0)
    ir.add_operand(lt_len, 2, 2)  // slt
    var sel = ir.new_inst(g_cur_block, 34, types.named(TK_I64))
    ir.add_operand(sel, ir.get_value(lt_len), 0)
    ir.add_operand(sel, nl, 0)
    ir.add_operand(sel, nr, 0)
    var mlen = ir.get_value(sel)
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, types.named(TK_STR))
    table_push(avs, lv)
    table_push(ats, types.named(TK_STR))
    table_push(avs, rv)
    table_push(ats, types.named(TK_I64))
    table_push(avs, mlen)
    var cmp = tig_ext_call_typed("memcmp", ats, avs, types.named(TK_I32))
    if cmp < 0 {
        return -1
    }
    // 公共前缀的三种符号：=0 / <0 / >0
    var c0 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
    ir.add_operand(c0, cmp, 0)
    ir.add_operand(c0, 0, 2)
    ir.add_operand(c0, 0, 2)  // eq
    var lt0 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
    ir.add_operand(lt0, cmp, 0)
    ir.add_operand(lt0, 0, 2)
    ir.add_operand(lt0, 2, 2)  // slt
    var gt0 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
    ir.add_operand(gt0, cmp, 0)
    ir.add_operand(gt0, 0, 2)
    ir.add_operand(gt0, 3, 2)  // sgt
    // 长度关系：前缀相同时由长度兜底
    var le = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
    ir.add_operand(le, nl, 0)
    ir.add_operand(le, nr, 0)
    ir.add_operand(le, 0, 2)  // eq
    var lnlt = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
    ir.add_operand(lnlt, nl, 0)
    ir.add_operand(lnlt, nr, 0)
    ir.add_operand(lnlt, 2, 2)  // slt
    var eq_all = ir.new_inst(g_cur_block, 6, types.named(TK_BOOL))  // and
    ir.add_operand(eq_all, ir.get_value(c0), 0)
    ir.add_operand(eq_all, ir.get_value(le), 0)
    var eqv = ir.get_value(eq_all)
    if op == 5 {
        return eqv
    }
    if op == 6 {
        var nx = ir.new_inst(g_cur_block, 8, types.named(TK_BOOL))
        ir.add_operand(nx, eqv, 0)
        ir.add_operand(nx, 1, 2)
        return ir.get_value(nx)
    }
    // 前缀相同且左更短 ⇒ 左 < 右；前缀不同时由 memcmp 符号定
    var lt_same = ir.new_inst(g_cur_block, 6, types.named(TK_BOOL))
    ir.add_operand(lt_same, ir.get_value(c0), 0)
    ir.add_operand(lt_same, ir.get_value(lnlt), 0)
    var lt_all = ir.new_inst(g_cur_block, 7, types.named(TK_BOOL))  // or
    ir.add_operand(lt_all, ir.get_value(lt0), 0)
    ir.add_operand(lt_all, ir.get_value(lt_same), 0)
    // 前缀相同且左更长 ⇒ 左 > 右
    var rngt = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
    ir.add_operand(rngt, nr, 0)
    ir.add_operand(rngt, nl, 0)
    ir.add_operand(rngt, 2, 2)  // slt
    var gt_same = ir.new_inst(g_cur_block, 6, types.named(TK_BOOL))
    ir.add_operand(gt_same, ir.get_value(c0), 0)
    ir.add_operand(gt_same, ir.get_value(rngt), 0)
    var gt_all = ir.new_inst(g_cur_block, 7, types.named(TK_BOOL))  // or
    ir.add_operand(gt_all, ir.get_value(gt0), 0)
    ir.add_operand(gt_all, ir.get_value(gt_same), 0)
    if op == 7 {
        return ir.get_value(lt_all)
    }
    if op == 8 {
        return ir.get_value(gt_all)
    }
    // <= 是 > 的否定；>= 是 < 的否定
    if op == 9 {
        var ng = ir.new_inst(g_cur_block, 8, types.named(TK_BOOL))
        ir.add_operand(ng, ir.get_value(gt_all), 0)
        ir.add_operand(ng, 1, 2)
        return ir.get_value(ng)
    }
    if op == 10 {
        var nl2 = ir.new_inst(g_cur_block, 8, types.named(TK_BOOL))
        ir.add_operand(nl2, ir.get_value(lt_all), 0)
        ir.add_operand(nl2, 1, 2)
        return ir.get_value(nl2)
    }
    return -1
}

// 字符串二元运算：拼接（+）→ str_cat(56) 指令；比较 → 长度头 + 字节序列。
func tig_binary_str(op: i64, lv: i64, rv: i64) -> i64 {
    if op == 0 {
        // 拼接：str_cat(56) 指令 [lhs, rhs]
        var inst = ir.new_inst(g_cur_block, 56, types.named(TK_STR))
        ir.add_operand(inst, lv, 0)
        ir.add_operand(inst, rv, 0)
        return ir.get_value(inst)
    }
    // 比较：长度头 + 字节序列（二进制安全；含内嵌 NUL 的文本不再被截断）
    return tig_str_cmp_bytes(op, lv, rv)
}

// 相等比较的元素类型是否含浮点。含浮点时禁用句柄短路：NaN 不等于自身，
// 同一块的内容相等按内容语义应为假，短路会错误地给出真。无法判定的类型
// 一律保守返回真（只损失一次短路，不改变结论）。
func eq_ty_has_float(t: i64, depth: i64) -> bool {
    if t < 0 || depth > 16 {
        return true
    }
    if types.is_float(t) {
        return true
    }
    if types.is_table(t) {
        return eq_ty_has_float(types.table_elem(t), depth + 1)
    }
    if types.kind(t) == K_STRUCT {
        var si = types.low(t)
        if si < 0 || si >= len(cls_fldoff) {
            return true
        }
        var off = cls_fldoff[si]
        var cnt = cls_nfld[si]
        var i: i64 = 0
        while i < cnt {
            if eq_ty_has_float(fld_tys[off + i], depth + 1) {
                return true
            }
            i = i + 1
        }
        return false
    }
    if types.kind(t) == K_TUPLE {
        var ti = t - BASE_TUPLE
        if ti < 0 || ti >= len(tup_n) {
            return true
        }
        var to = tup_offs[ti]
        var tn = tup_n[ti]
        var j: i64 = 0
        while j < tn {
            if eq_ty_has_float(tup_tys[to + j], depth + 1) {
                return true
            }
            j = j + 1
        }
        return false
    }
    return false
}

// 位可比较元素类型：整数族 / bool / char。判据 = memcmp 逐字节与 == 语义
// 一致——浮点排除（NaN 位相同而 IEEE 不等、±0 位不同而 IEEE 相等）；字符串
// 排除（元素槽是长度头指针，等值串可异址）；struct 排除（布局填充字节未
// 初始化，memcmp 可能误判不等）。
func tig_ty_bitwise_comparable(t: i64) -> bool {
    if types.is_int(t) || t == types.named(TK_BOOL) || t == types.named(TK_CHAR) {
        return true
    }
    return false
}

// 类型图可能成环：struct 字段经表/映射元素回指自身（路径访问集判环，镜像
// 语义层 eq_comparable 的 seen 纪律）。纯表自嵌套（table<table<T>>）类型有
// 限不成环；可构造的值级环必经 struct 表字段链。无环类型零开销——句柄对
// 栈的进出栈调用只在可能成环的类型上发射。
func tig_ty_may_cycle(t: i64, seen: ref table<i64>, depth: i64) -> bool {
    if t < 0 || depth > 32 {
        return false
    }
    var k = types.kind(t)
    if k == K_STRUCT {
        var si = types.low(t)
        if si < 0 || si >= len(cls_fldoff) {
            return false
        }
        var i: i64 = 0
        while i < len(seen) {
            if seen[i] == si {
                return true
            }
            i = i + 1
        }
        var base = len(seen)
        table_push(seen, si)
        var off = cls_fldoff[si]
        var cnt = cls_nfld[si]
        var j: i64 = 0
        while j < cnt {
            if tig_ty_may_cycle(fld_tys[off + j], seen, depth + 1) {
                return true
            }
            j = j + 1
        }
        table_trunc(seen, base)
        return false
    }
    if k == K_TABLE || k == K_MAP {
        var et = types.table_elem(t)
        if et < 0 {
            return false
        }
        return tig_ty_may_cycle(et, seen, depth + 1)
    }
    return false
}

// 取（或按需生成）类型 t 的专用相等比较函数符号名。memo 先登记后生成体
// ⇒ 成环类型间的相互引用在编译期断链（发射 call 而非内联展开），运行期由
// 句柄对栈（tl_tbl$eq_mark/unmark）判重入实现共归纳。失败返回 ""（错误已置）。
func tig_eq_fn_get(t: i64) -> string {
    var i: i64 = 0
    while i < len(g_eq_keys) {
        if g_eq_keys[i] == t {
            return intern.lookup(g_eq_names[i])
        }
        i = i + 1
    }
    var k = types.kind(t)
    var nm = ""
    if k == K_TABLE || k == K_MAP {
        nm = "tie_eq_t" + to_string(len(g_eq_keys))
    } else if k == K_STRUCT {
        nm = "tie_eq_s" + to_string(len(g_eq_keys))
    } else {
        sm_err_msg = "内部错误：相等函数生成收到非容器/聚合类型（函数 " + g_cur_fn_name + "）"
        return ""
    }
    table_push(g_eq_keys, t)
    table_push(g_eq_names, intern.intern(nm))
    var gr: i64 = -1
    if k == K_TABLE || k == K_MAP {
        gr = tig_eq_gen_table(t, nm)
    } else {
        gr = tig_eq_gen_struct(t, nm)
    }
    if gr < 0 {
        return ""
    }
    return nm
}

// 同单元专用比较函数调用（opcode 35 call；两 ptr 实参，返回 i1）。
func tig_eq_call_two(fnm: string, a1: i64, a2: i64) -> i64 {
    var BT = types.named(TK_BOOL)
    var TSTR = types.named(TK_STR)
    var ci = ir.new_inst(g_cur_block, 35, BT)
    ir.add_operand(ci, interner.intern(fnm), 0)
    ir.add_operand(ci, BT, 2)
    ir.add_operand(ci, TSTR, 2)
    ir.add_operand(ci, a1, 0)
    ir.add_operand(ci, TSTR, 2)
    ir.add_operand(ci, a2, 0)
    return ir.get_value(ci)
}

// 生成表/映射专用比较函数（规范 §3.6「自引用由比较过程检测并终止」）：
// 函数体 = mark → 命中即真（共归纳）→ 句柄/长度短路 → 位可比 memcmp 快路径
// → 逐元素循环。元素为表/映射/struct 时**调用**对应专用函数（memo 断编译期
// 递归），其余元素走 tig_agg_field_cmp 内联判据。结果槽 + 唯一出口：unmark
// 与 ret 只写一处，与全部早退路径汇合（配对弹出不会漏）。
func tig_eq_gen_table(ty: i64, nm: string) -> i64 {
    var ety = types.table_elem(ty)
    if ety < 0 {
        ety = types.low(ty)
    }
    var BT = types.named(TK_BOOL)
    var T64 = types.named(TK_I64)
    var TSTR = types.named(TK_STR)
    var params: table<i64> = table_new_i64()
    table_push(params, TSTR)
    table_push(params, TSTR)
    var fid = ir.new_func(interner.intern(nm), BT, params)
    var saved_fn = g_cur_fn_name
    var saved_func = g_cur_func
    var saved_block = g_cur_block
    g_cur_func = fid
    g_cur_fn_name = nm
    g_used_trmlite = true
    var lv = ir.param_val(fid, 0)
    var rv = ir.param_val(fid, 1)
    var b0 = ir.new_block(fid, interner.intern("entry"))
    var bhit = ir.new_block(fid, interner.intern("hit"))
    var bsame = ir.new_block(fid, interner.intern("same"))
    var blen = ir.new_block(fid, interner.intern("len"))
    var bmc = ir.new_block(fid, interner.intern("memcmp"))
    var bmz = ir.new_block(fid, interner.intern("mczero"))
    var binit = ir.new_block(fid, interner.intern("init"))
    var bhead = ir.new_block(fid, interner.intern("head"))
    var bbody = ir.new_block(fid, interner.intern("body"))
    var bstep = ir.new_block(fid, interner.intern("step"))
    var bfalse = ir.new_block(fid, interner.intern("no"))
    var bexit = ir.new_block(fid, interner.intern("exit"))
    g_cur_block = b0
    var rslot = ir.new_inst(g_cur_block, 20, BT)
    ir.add_operand(rslot, BT, 2)
    var rsv = ir.get_value(rslot)
    s21_store(rsv, tig_bool_lit(1), BT)
    // mark：命中 = 同一对比较正在进行 → 共归纳判相等
    var mi = tl_i64_2("tl_tbl$eq_mark", tig_ptrtoint(lv), tig_ptrtoint(rv))
    var hit = tig_icmp_c(mi, tig_int_lit(0), 3)  // sgt（已是 i1 值 id）
    var cb0 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb0, hit, 0)
    ir.add_operand(cb0, bhit, 1)
    ir.add_operand(cb0, bsame, 1)
    g_cur_block = bhit
    var br0 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(br0, bexit, 1)
    // 句柄短路（值类型不含浮点时启用）
    g_cur_block = bsame
    if !eq_ty_has_float(ety, 0) {
        var li = tig_ptrtoint(lv)
        var ri = tig_ptrtoint(rv)
        var same = tig_icmp_c(li, ri, 0)
        var cb1 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb1, same, 0)
        ir.add_operand(cb1, bexit, 1)
        ir.add_operand(cb1, blen, 1)
    } else {
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, blen, 1)
    }
    // 长度短路
    g_cur_block = blen
    var nl = s21_table_len(lv)
    var nr = s21_table_len(rv)
    var le = tig_icmp_c(nl, nr, 0)
    var cb2 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb2, le, 0)
    if tig_ty_bitwise_comparable(ety) {
        ir.add_operand(cb2, bmc, 1)
    } else {
        ir.add_operand(cb2, binit, 1)
    }
    ir.add_operand(cb2, bfalse, 1)
    // 位可比快路径
    g_cur_block = bmc
    var gt0 = tig_icmp_c(nl, tig_int_lit(0), 3)  // sgt（空表免 memcmp：null 实参 C UB）
    var cbm = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbm, gt0, 0)
    ir.add_operand(cbm, bmz, 1)
    var bm = ir.new_block(fid, interner.intern("mcmp"))
    ir.add_operand(cbm, bm, 1)
    g_cur_block = bm
    var bytes = s21_bin(2, nl, tig_int_lit(elem_size(ety)))
    var atsm: table<i64> = table_new_i64()
    var avsm: table<i64> = table_new_i64()
    table_push(atsm, TSTR)
    table_push(avsm, t21_data(lv))
    table_push(atsm, TSTR)
    table_push(avsm, t21_data(rv))
    table_push(atsm, T64)
    table_push(avsm, bytes)
    var cmpm = tig_ext_call_typed("memcmp", atsm, avsm, types.named(TK_I32))
    if cmpm < 0 {
        g_cur_fn_name = saved_fn
        g_cur_func = saved_func
        g_cur_block = saved_block
        return -1
    }
    var c0m = tig_icmp_c(cmpm, tig_int_lit(0), 0)  // eq
    s21_store(rsv, c0m, BT)
    var brm = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brm, bexit, 1)
    g_cur_block = bmz
    var brz = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brz, bexit, 1)
    // 循环
    g_cur_block = binit
    var kslot = ir.new_inst(g_cur_block, 20, T64)
    ir.add_operand(kslot, T64, 2)
    var ksv = ir.get_value(kslot)
    s21_store(ksv, tig_int_lit(0), T64)
    var bri = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bri, bhead, 1)
    g_cur_block = bhead
    var kc = tig_icmp_c(s21_load(ksv, T64), nl, 2)  // slt
    var cbh = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbh, kc, 0)
    ir.add_operand(cbh, bbody, 1)
    ir.add_operand(cbh, bexit, 1)
    g_cur_block = bbody
    var kv = s21_load(ksv, T64)
    var esz = s21_bin(6, t21_esz(lv), tig_int_lit(4611686018427387903))  // and：掩掉深表/哈希位
    var offv = s21_bin(2, kv, esz)
    var ek = types.kind(ety)
    var fc: i64 = -1
    if ek == K_TABLE || ek == K_MAP {
        // 元素为表/映射：加载句柄 → 调专用比较函数（编译期递归断链）
        var el = s21_load(s21_gep(t21_data(lv), offv, false), ety)
        var er = s21_load(s21_gep(t21_data(rv), offv, false), ety)
        var sub = tig_eq_fn_get(ety)
        if str_len(sub) == 0 {
            g_cur_fn_name = saved_fn
            g_cur_func = saved_func
            g_cur_block = saved_block
            return -1
        }
        fc = tig_eq_call_two(sub, el, er)
    } else if ek == K_STRUCT {
        // 元素为 struct：元素地址直传（数据缓冲连续布局）→ 调专用函数
        var sub = tig_eq_fn_get(ety)
        if str_len(sub) == 0 {
            g_cur_fn_name = saved_fn
            g_cur_func = saved_func
            g_cur_block = saved_block
            return -1
        }
        fc = tig_eq_call_two(sub, s21_gep(t21_data(lv), offv, false), s21_gep(t21_data(rv), offv, false))
    } else {
        var ld = s21_load(s21_gep(t21_data(lv), offv, false), ety)
        var rd = s21_load(s21_gep(t21_data(rv), offv, false), ety)
        fc = tig_agg_field_cmp(ety, ld, rd)
    }
    if fc < 0 {
        g_cur_fn_name = saved_fn
        g_cur_func = saved_func
        g_cur_block = saved_block
        return -1
    }
    var notfc = ir.new_inst(g_cur_block, 8, BT)  // xor：元素不等
    ir.add_operand(notfc, fc, 0)
    ir.add_operand(notfc, 1, 2)
    var cbb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbb, ir.get_value(notfc), 0)
    ir.add_operand(cbb, bfalse, 1)
    ir.add_operand(cbb, bstep, 1)
    g_cur_block = bstep
    s21_store(ksv, s21_bin(0, kv, tig_int_lit(1)), T64)  // k++
    var brb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brb, bhead, 1)
    g_cur_block = bfalse
    s21_store(rsv, tig_bool_lit(0), BT)
    var brf = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brf, bexit, 1)
    // 唯一出口：unmark（与入口 mark 配对）+ ret
    g_cur_block = bexit
    var ea: table<i64> = table_new_i64()
    var ev: table<i64> = table_new_i64()
    tig_trmlite_call("tl_tbl$eq_unmark", ea, ev, -1)
    var res = s21_load(rsv, BT)
    var rt = ir.new_inst(g_cur_block, 32, -1)  // ret
    ir.add_operand(rt, res, 0)
    g_cur_fn_name = saved_fn
    g_cur_func = saved_func
    g_cur_block = saved_block
    return 0
}

// 生成 struct 专用比较函数：逐字段 and 链（直线无早退，无 mark——可构造的
// 值级环必经表字段，环检测由表专用函数的句柄对栈承担）。字段分派：表/映射
// → 加载句柄调表专用函数；嵌套 struct → 字段地址直传调子函数；其余内联判据。
func tig_eq_gen_struct(agg: i64, nm: string) -> i64 {
    var si = types.low(agg)
    if si < 0 || si >= len(cls_fldoff) {
        sm_err_msg = "元组比较目标不是元组（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var BT = types.named(TK_BOOL)
    var TSTR = types.named(TK_STR)
    var nf = cls_nfld[si]
    var off = cls_fldoff[si]
    var params: table<i64> = table_new_i64()
    table_push(params, TSTR)
    table_push(params, TSTR)
    var fid = ir.new_func(interner.intern(nm), BT, params)
    var saved_fn = g_cur_fn_name
    var saved_func = g_cur_func
    var saved_block = g_cur_block
    g_cur_func = fid
    g_cur_fn_name = nm
    var la = ir.param_val(fid, 0)
    var ra = ir.param_val(fid, 1)
    var b0 = ir.new_block(fid, interner.intern("entry"))
    g_cur_block = b0
    var acc: i64 = -1
    var i: i64 = 0
    while i < nf {
        var fty = fld_tys[off + i]
        var lgp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep 左字段地址
        ir.add_operand(lgp, la, 0)
        ir.add_operand(lgp, i, 2)
        var rgp = ir.new_inst(g_cur_block, 27, agg)
        ir.add_operand(rgp, ra, 0)
        ir.add_operand(rgp, i, 2)
        var fc: i64 = -1
        var fk = types.kind(fty)
        if fk == K_TABLE || fk == K_MAP {
            var lv = tig_agg_field_load(ir.get_value(lgp), fty)
            var rv = tig_agg_field_load(ir.get_value(rgp), fty)
            var sub = tig_eq_fn_get(fty)
            if str_len(sub) == 0 {
                g_cur_fn_name = saved_fn
                g_cur_func = saved_func
                g_cur_block = saved_block
                return -1
            }
            fc = tig_eq_call_two(sub, lv, rv)
        } else if fk == K_STRUCT {
            var sub = tig_eq_fn_get(fty)
            if str_len(sub) == 0 {
                g_cur_fn_name = saved_fn
                g_cur_func = saved_func
                g_cur_block = saved_block
                return -1
            }
            fc = tig_eq_call_two(sub, ir.get_value(lgp), ir.get_value(rgp))
        } else {
            var lv = tig_agg_field_load(ir.get_value(lgp), fty)
            var rv = tig_agg_field_load(ir.get_value(rgp), fty)
            fc = tig_agg_field_cmp(fty, lv, rv)
        }
        if fc < 0 {
            g_cur_fn_name = saved_fn
            g_cur_func = saved_func
            g_cur_block = saved_block
            return -1
        }
        if acc < 0 {
            acc = fc
        } else {
            var a2 = ir.new_inst(g_cur_block, 6, BT)  // and
            ir.add_operand(a2, acc, 0)
            ir.add_operand(a2, fc, 0)
            acc = ir.get_value(a2)
        }
        i = i + 1
    }
    if acc < 0 {
        acc = tig_bool_lit(1)
    }
    var rt = ir.new_inst(g_cur_block, 32, -1)  // ret
    ir.add_operand(rt, acc, 0)
    g_cur_fn_name = saved_fn
    g_cur_func = saved_func
    g_cur_block = saved_block
    return 0
}

// 表按内容相等：句柄短路 → 长度短路 → 逐元素循环。
// 结果用 i1 槽汇合（而非 phi），循环提前失败与多个入口都写同一个槽，
// 无需枚举 done 块的全部前驱。元素比较复用 tig_agg_field_cmp，故标量、
// 浮点（IEEE oeq）、字符串（二进制安全）与结构字段走与顶层 == 同一判据。
// 性能分层：元素为位可比较标量 → 长度相等后单次 memcmp 取代逐元素循环
//（行池比较的标量字段列自动受益）。
func tig_table_compare(op: i64, ty: i64, lv: i64, rv: i64) -> i64 {
    var ety = types.table_elem(ty)
    if ety < 0 {
        // 防御分支：裸 table 的元素类型未知，语义层已先行拒绝；复用既有文案
        sm_err_msg = "元组比较目标不是元组（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var BT = types.named(TK_BOOL)
    var T64 = types.named(TK_I64)
    var rslot = ir.new_inst(g_cur_block, 20, BT)
    ir.add_operand(rslot, BT, 2)
    var rsv = ir.get_value(rslot)
    s21_store(rsv, tig_bool_lit(1), BT)
    // 自引用环检测（规范 §3.6「自引用由比较过程检测并终止」）：可能成环的
    // 类型才进句柄对栈（无环类型零开销）。mark 命中 = 同一对比较正在进行
    // → 按共归纳判相等直接短路；退出在 done 统一 unmark（全部分支唯一汇合
    // 点，配对弹出不漏）。可构造的值级环必经 struct 表字段链——递归比较
    // 再次进入本函数时同一句柄对被识别。
    var seen_c: table<i64> = table_new_i64()
    var track = tig_ty_may_cycle(ety, seen_c, 0)
    if track {
        // 自引用类型（规范 §3.6「自引用由比较过程检测并终止」）：内联展开对
        // 成环类型编译期无限递归 ⇒ 改发**按类型生成的专用比较函数**调用
        // （memo 化断编译期递归；函数体内 mark 命中即真 = 共归纳，句柄/长度
        // 短路与位可比 memcmp 快路径与内联版逐项等价）。
        var fnm = tig_eq_fn_get(ty)
        if str_len(fnm) == 0 {
            return -1
        }
        return tig_eq_call_two(fnm, lv, rv)
    }
    var lenchk = ir.new_block(g_cur_func, interner.intern("eq.tbl.len"))
    var falseblk = ir.new_block(g_cur_func, interner.intern("eq.tbl.no"))
    var initblk = ir.new_block(g_cur_func, interner.intern("eq.tbl.init"))
    var head = ir.new_block(g_cur_func, interner.intern("eq.tbl.h"))
    var body = ir.new_block(g_cur_func, interner.intern("eq.tbl.b"))
    var done = ir.new_block(g_cur_func, interner.intern("eq.tbl.done"))
    // 同一句柄短路（仅类型不含浮点时启用）
    if !eq_ty_has_float(ety, 0) {
        var li = tig_ptrtoint(lv)
        var ri = tig_ptrtoint(rv)
        var same = tig_icmp_c(li, ri, 0)
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, same, 0)
        ir.add_operand(cb0, done, 1)
        ir.add_operand(cb0, lenchk, 1)
    } else {
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, lenchk, 1)
    }
    // 长度短路
    g_cur_block = lenchk
    var nl = s21_table_len(lv)
    var nr = s21_table_len(rv)
    var le = tig_icmp_c(nl, nr, 0)
    var bitwise = tig_ty_bitwise_comparable(ety)
    var mcmpblk = ir.new_block(g_cur_func, interner.intern("eq.tbl.memcmp"))
    var cb1 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb1, le, 0)
    if bitwise {
        ir.add_operand(cb1, mcmpblk, 1)
    } else {
        ir.add_operand(cb1, initblk, 1)
    }
    ir.add_operand(cb1, falseblk, 1)
    if bitwise {
        // memcmp 快路径：n = nl * esz（编译期元素宽度）。nl == 0 时不调 memcmp
        //（空表 data 可能为 null，n=0 的 null 实参是 C UB）直接判相等。
        g_cur_block = mcmpblk
        var zblk = ir.new_block(g_cur_func, interner.intern("eq.tbl.z"))
        var mb = ir.new_block(g_cur_func, interner.intern("eq.tbl.m"))
        var gt0 = tig_icmp_c(nl, tig_int_lit(0), 3)  // sgt
        var cbm = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbm, gt0, 0)
        ir.add_operand(cbm, mb, 1)
        ir.add_operand(cbm, zblk, 1)
        g_cur_block = mb
        var eszb = tig_int_lit(elem_size(ety))
        var bytes = s21_bin(2, nl, eszb)  // mul
        var atsm: table<i64> = table_new_i64()
        var avsm: table<i64> = table_new_i64()
        table_push(atsm, types.named(TK_STR))
        table_push(avsm, t21_data(lv))
        table_push(atsm, types.named(TK_STR))
        table_push(avsm, t21_data(rv))
        table_push(atsm, types.named(TK_I64))
        table_push(avsm, bytes)
        var cmpm = tig_ext_call_typed("memcmp", atsm, avsm, types.named(TK_I32))
        if cmpm < 0 {
            return -1
        }
        var c0m = tig_icmp_c(cmpm, tig_int_lit(0), 0)  // eq
        s21_store(rsv, c0m, BT)
        var brm = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brm, done, 1)
        g_cur_block = zblk
        s21_store(rsv, tig_bool_lit(1), BT)
        var brz = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brz, done, 1)
        // 快路径下循环块（initblk/head/body）未生成内容：函数顶部已创建，
        // LLVM 要求每个块带终结指令，空块补 br done（无前驱，永不执行）。
        g_cur_block = initblk
        var bri0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bri0, done, 1)
        g_cur_block = head
        var brh0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh0, done, 1)
        g_cur_block = body
        var brb0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb0, done, 1)
    } else {
        // 循环初始化：k = 0
        g_cur_block = initblk
    var kslot = ir.new_inst(g_cur_block, 20, T64)
    ir.add_operand(kslot, T64, 2)
    var ksv = ir.get_value(kslot)
    s21_store(ksv, tig_int_lit(0), T64)
    var bri = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bri, head, 1)
    // head：k < nl → body / done
    g_cur_block = head
    var kc = tig_icmp_c(s21_load(ksv, T64), nl, 2)  // slt
    var cbh = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbh, kc, 0)
    ir.add_operand(cbh, body, 1)
    ir.add_operand(cbh, done, 1)
    // body：两侧元素逐个比较，任一不等即写结果槽并退出
    g_cur_block = body
    var kv = s21_load(ksv, T64)
    // esz 低 62 位才是元素字节宽度：bit62 是深表标记、bit63 是 map 哈希标记。
    // 不过滤会拿带标记的巨大值算偏移，复合元素表读到越界内存而误判相等。
    var esz = s21_bin(6, t21_esz(lv), tig_int_lit(4611686018427387903))  // and
    var offv = s21_bin(2, kv, esz)  // mul：k * esz
    var ld = s21_load(s21_gep(t21_data(lv), offv, false), ety)
    var rd = s21_load(s21_gep(t21_data(rv), offv, false), ety)
    var fc = tig_agg_field_cmp(ety, ld, rd)
    if fc < 0 {
        return -1
    }
    var notfc = ir.new_inst(g_cur_block, 8, BT)  // xor i1 fc, 1
    ir.add_operand(notfc, fc, 0)
    ir.add_operand(notfc, 1, 2)
    var next = ir.new_block(g_cur_func, interner.intern("eq.tbl.next"))
    var cbb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbb, ir.get_value(notfc), 0)
    ir.add_operand(cbb, falseblk, 1)
    ir.add_operand(cbb, next, 1)
    g_cur_block = next
    s21_store(ksv, s21_bin(0, kv, tig_int_lit(1)), T64)  // k++
    var brb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brb, head, 1)
    }
    // 失败分支
    g_cur_block = falseblk
    s21_store(rsv, tig_bool_lit(0), BT)
    var brf = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brf, done, 1)
    // 汇合：读结果槽；!= 取反。可能成环的类型在此统一 unmark（唯一汇合点，
    // 与入口 eq_mark 配对弹出——hit/memcmp/循环三路全经此处）。
    g_cur_block = done
    if track {
        var empty_a: table<i64> = table_new_i64()
        var empty_b: table<i64> = table_new_i64()
        tig_trmlite_call("tl_tbl$eq_unmark", empty_a, empty_b, -1)
    }
    var res = s21_load(rsv, BT)
    if op == 6 {
        var nx = ir.new_inst(g_cur_block, 8, BT)
        ir.add_operand(nx, res, 0)
        ir.add_operand(nx, 1, 2)
        return ir.get_value(nx)
    }
    return res
}

// 映射按内容相等：len 短路 → 运行期模式分支。
//  数组模式（≤1024 条目）：数据按键有序（内联二分插入），两侧 zip 对比即
//  按键规范化语义——键二进制安全比较 + 值按静态类型比较（tig_agg_field_cmp）。
//  哈希模式（>1024 条目，条目无序）：len 相等 + 遍历 l 的非空槽，逐键查 r
//  （contains 免 raise + map_get 取值比较）——无重复键 ⇒ 单方向即充分。
//  布局：数组 entry 16 字节（键 ptr@0、值@8）；哈希 cap@0、htab@16、空槽键 null。
//  值类型边界：多字值（struct/enum/fn/any）装不进 8 字节值槽，编译期拒绝。
func tig_map_compare(op: i64, ty: i64, lv: i64, rv: i64) -> i64 {
    var vty = types.table_elem(ty)
    if vty < 0 {
        vty = types.low(ty)
    }
    if vty < 0 {
        sm_err_msg = "元组比较目标不是元组（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var vk = types.kind(vty)
    if vk == K_STRUCT || vk == K_ENUM || vk == K_FN || vk == K_TUPLE || vty == types.named(TK_ANY) {
        sm_err_msg = "映射相等不支持多字值类型 " + types.type_name(vty) + "（entry 值槽 8 字节，函数 " + g_cur_fn_name + "）"
        return -1
    }
    var BT = types.named(TK_BOOL)
    var T64 = types.named(TK_I64)
    var rslot = ir.new_inst(g_cur_block, 20, BT)
    ir.add_operand(rslot, BT, 2)
    var rsv = ir.get_value(rslot)
    s21_store(rsv, tig_bool_lit(1), BT)
    var lenchk = ir.new_block(g_cur_func, interner.intern("eq.map.len"))
    var falseblk = ir.new_block(g_cur_func, interner.intern("eq.map.no"))
    var modechk = ir.new_block(g_cur_func, interner.intern("eq.map.mode"))
    var done = ir.new_block(g_cur_func, interner.intern("eq.map.done"))
    // 同一句柄短路（仅值类型不含浮点时启用）
    if !eq_ty_has_float(vty, 0) {
        var li = tig_ptrtoint(lv)
        var ri = tig_ptrtoint(rv)
        var same = tig_icmp_c(li, ri, 0)
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, same, 0)
        ir.add_operand(cb0, done, 1)
        ir.add_operand(cb0, lenchk, 1)
    } else {
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, lenchk, 1)
    }
    // 长度短路（两模式 len@8 同义）
    g_cur_block = lenchk
    var nl = s21_table_len(lv)
    var nr = s21_table_len(rv)
    var le = tig_icmp_c(nl, nr, 0)
    var cb1 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb1, le, 0)
    ir.add_operand(cb1, modechk, 1)
    ir.add_operand(cb1, falseblk, 1)
    // 模式分派：esz 符号位（哈希模式 esz 为负；s21_map_is_hash 已返回 i1 值 id）
    g_cur_block = modechk
    var ish = s21_map_is_hash(lv)
    var ainit = ir.new_block(g_cur_func, interner.intern("eq.map.ainit"))
    var ahead = ir.new_block(g_cur_func, interner.intern("eq.map.ahead"))
    var abody = ir.new_block(g_cur_func, interner.intern("eq.map.abody"))
    var anext = ir.new_block(g_cur_func, interner.intern("eq.map.anext"))
    var hinit = ir.new_block(g_cur_func, interner.intern("eq.map.hinit"))
    var hhead = ir.new_block(g_cur_func, interner.intern("eq.map.hhead"))
    var hbody = ir.new_block(g_cur_func, interner.intern("eq.map.hbody"))
    var hchk = ir.new_block(g_cur_func, interner.intern("eq.map.hchk"))
    var hget = ir.new_block(g_cur_func, interner.intern("eq.map.hget"))
    var hstep = ir.new_block(g_cur_func, interner.intern("eq.map.hstep"))
    var cbm = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbm, ish, 0)
    ir.add_operand(cbm, hinit, 1)
    ir.add_operand(cbm, ainit, 1)
    // ---------- 数组臂：zip 对比（键有序） ----------
    g_cur_block = ainit
    var kslot = ir.new_inst(g_cur_block, 20, T64)
    ir.add_operand(kslot, T64, 2)
    var ksv = ir.get_value(kslot)
    s21_store(ksv, tig_int_lit(0), T64)
    var bri = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bri, ahead, 1)
    g_cur_block = ahead
    var kc = tig_icmp_c(s21_load(ksv, T64), nl, 2)  // slt
    var cbh = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbh, kc, 0)
    ir.add_operand(cbh, abody, 1)
    ir.add_operand(cbh, done, 1)
    g_cur_block = abody
    var kv = s21_load(ksv, T64)
    var offv = s21_bin(2, kv, tig_int_lit(16))  // mul：i * 16
    var kl = s21_load(s21_gep(t21_data(lv), offv, false), types.named(TK_STR))
    var kr = s21_load(s21_gep(t21_data(rv), offv, false), types.named(TK_STR))
    var keq = tig_str_cmp_bytes(5, kl, kr)
    if keq < 0 {
        return -1
    }
    var offv8 = s21_bin(0, offv, tig_int_lit(8))  // add：+8
    var vl = s21_load(s21_gep(t21_data(lv), offv8, false), vty)
    var vr = s21_load(s21_gep(t21_data(rv), offv8, false), vty)
    var vc = tig_agg_field_cmp(vty, vl, vr)
    if vc < 0 {
        return -1
    }
    var kbad = ir.new_inst(g_cur_block, 8, BT)  // xor：键不等
    ir.add_operand(kbad, keq, 0)
    ir.add_operand(kbad, 1, 2)
    var vbad = ir.new_inst(g_cur_block, 8, BT)  // xor：值不等（vc = 值相等）
    ir.add_operand(vbad, vc, 0)
    ir.add_operand(vbad, 1, 2)
    var bad = ir.new_inst(g_cur_block, 7, BT)  // or：键不等或值不等
    ir.add_operand(bad, ir.get_value(kbad), 0)
    ir.add_operand(bad, ir.get_value(vbad), 0)
    var cbb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbb, ir.get_value(bad), 0)
    ir.add_operand(cbb, falseblk, 1)
    ir.add_operand(cbb, anext, 1)
    g_cur_block = anext
    s21_store(ksv, s21_bin(0, kv, tig_int_lit(1)), T64)  // i++
    var brb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brb, ahead, 1)
    // ---------- 哈希臂：遍历 l 非空槽，逐键 contains + get 比较 ----------
    g_cur_block = hinit
    var cap = s21_load(s21_gep(lv, 0, true), T64)
    var htab = s21_load(s21_gep(lv, 16, true), types.named(TK_STR))
    var hslot = ir.new_inst(g_cur_block, 20, T64)
    ir.add_operand(hslot, T64, 2)
    var hsp = ir.get_value(hslot)
    s21_store(hsp, tig_int_lit(0), T64)
    var bh0 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bh0, hhead, 1)
    g_cur_block = hhead
    var hc = tig_icmp_c(s21_load(hsp, T64), cap, 2)  // slt
    var cbh2 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbh2, hc, 0)
    ir.add_operand(cbh2, hbody, 1)
    ir.add_operand(cbh2, done, 1)
    g_cur_block = hbody
    var kp = s21_hslot_key(htab, s21_load(hsp, T64))
    var nonempty = tig_cmp_zero(kp, 1)  // key != null（已是 i1 值 id）
    var cbh3 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbh3, nonempty, 0)
    ir.add_operand(cbh3, hchk, 1)
    ir.add_operand(cbh3, hstep, 1)
    g_cur_block = hchk
    var c1v = s21_map_contains(rv, kp)  // i1 布尔
    var cbh4 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbh4, c1v, 0)
    ir.add_operand(cbh4, hget, 1)
    ir.add_operand(cbh4, falseblk, 1)
    g_cur_block = hget
    var hv = s21_hslot_val(htab, s21_load(hsp, T64), vty)
    var gv2 = s21_map_get(rv, kp, vty)
    var vc2 = tig_agg_field_cmp(vty, hv, gv2)
    if vc2 < 0 {
        return -1
    }
    var cbh5 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbh5, vc2, 0)
    ir.add_operand(cbh5, hstep, 1)
    ir.add_operand(cbh5, falseblk, 1)
    g_cur_block = hstep
    s21_store(hsp, s21_bin(0, s21_load(hsp, T64), tig_int_lit(1)), T64)  // i++
    var bh1 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bh1, hhead, 1)
    // 失败分支（两臂共用的提前退出出口）
    g_cur_block = falseblk
    s21_store(rsv, tig_bool_lit(0), BT)
    var brf = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brf, done, 1)
    // 汇合：读结果槽；!= 取反
    g_cur_block = done
    var res = s21_load(rsv, BT)
    if op == 6 {
        var nx = ir.new_inst(g_cur_block, 8, BT)
        ir.add_operand(nx, res, 0)
        ir.add_operand(nx, 1, 2)
        return ir.get_value(nx)
    }
    return res
}

// 逻辑短路 && / ||：cond_br + phi 汇合（对齐 Rust ir.rs）。
//   a && b：br a → then(求 b) / else(false)；then 后 phi [b, then], [false, else]
//   a || b：br a → then(true) / else(求 b)；else 后 phi [true, then], [b, else]
func tig_logic_short(op: i64, lhs: i64, rhs: i64) -> i64 {
    var lv = tig_expr(lhs)
    if lv < 0 {
        return -1
    }
    var then_blk = ir.new_block(g_cur_func, interner.intern("sc.then"))
    var else_blk = ir.new_block(g_cur_func, interner.intern("sc.else"))
    var merge_blk = ir.new_block(g_cur_func, interner.intern("sc.merge"))
    var cbr = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbr, lv, 0)
    if op == 11 {
        // &&：lv 真 → 求 b；假 → false
        ir.add_operand(cbr, then_blk, 1)
        ir.add_operand(cbr, else_blk, 1)
    } else {
        // ||：lv 真 → true；假 → 求 b
        ir.add_operand(cbr, then_blk, 1)
        ir.add_operand(cbr, else_blk, 1)
    }
    // then 分支
    g_cur_block = then_blk
    var tv: i64 = 0
    if op == 11 {
        var bv = tig_expr(rhs)
        if bv < 0 {
            return -1
        }
        tv = bv
    } else {
        // || 短路 true：i1 字面量 true
        tv = tig_bool_lit(1)
    }
    // 值实际产生块：rhs 若为嵌套短路，g_cur_block 已是其内部 merge 块
    // （phi 的 incoming 前驱必须用该块，否则违反 LLVM 支配规则）
    var tv_blk = g_cur_block
    if !block_terminated() {
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, merge_blk, 1)
    }
    // else 分支
    g_cur_block = else_blk
    var ev: i64 = 0
    if op == 11 {
        ev = tig_bool_lit(0)
    } else {
        var bv2 = tig_expr(rhs)
        if bv2 < 0 {
            return -1
        }
        ev = bv2
    }
    var ev_blk = g_cur_block
    if !block_terminated() {
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, merge_blk, 1)
    }
    // merge：phi 合流（incoming 前驱块 = 值实际产生块，非写死的 then/else 块）
    g_cur_block = merge_blk
    var phi = ir.new_inst(g_cur_block, 33, types.named(TK_BOOL))  // phi i1
    ir.add_operand(phi, tv, 0)
    ir.add_operand(phi, tv_blk, 1)
    ir.add_operand(phi, ev, 0)
    ir.add_operand(phi, ev_blk, 1)
    return ir.get_value(phi)
}

// 当前块是否已 terminated（ret/br/cond_br）——块尾汇合 br 生成前检查，
// 避免 ret 后追加死代码 br（LLVM 解析 terminator 后的指令会编号错乱：
// "instruction expected to be numbered" 报错）
func block_terminated() -> bool {
    var en = ir.block_end(g_cur_block)
    if en <= ir.block_start(g_cur_block) {
        return false
    }
    var lop = ir.ins_op(en - 1)
    return lop == 30 || lop == 31 || lop == 32
}

