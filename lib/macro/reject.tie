type tie<lib>
// lib/macro/reject.tie —— 编译期宏执行器的「显式拒绝」实现
// ============================================================
// 宏执行器以函数值注入编译段；不提供执行能力的宿主必须显式拒绝，
// 不能静默放过，也不能让宏展开错误退化成空结果。
// 三个入口对应 tie.front::check 的 ep / em / eproc 三个执行器槽，
// 一律遵守 OK: / ERR: 前缀协议。
import "/std/string.tie"
namespace tie.macroreject;

pub func reason() -> string {
    return "JIT 不支持编译期宏展开"
}

pub func proto(p: string) -> string {
    return "ERR:" + reason()
}

pub func expand(name: string, args: table<string>) -> string {
    return "ERR:" + reason()
}

pub func expand_proc(name: string, args: table<string>) -> string {
    return "ERR:" + reason()
}
