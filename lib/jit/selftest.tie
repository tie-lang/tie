type tie<lib>
// lib/jit/selftest.tie —— JIT 完整链路自检
// ============================================================
// 覆盖 ABI 校验 → open → add_ir → lookup → dyn_call_p → close 六步，
// 用一段最小 LLVM IR 驱动会话层完成，不依赖编译段，保持 jit 库只依赖
// 内置库与 lib/jit 的依赖边界。
import "/std/string.tie"
import "./llvmc.tie"
import "./session.tie"
namespace tie.jittest;

pub func chk(ok: bool, tag: string) -> bool {
    if ok {
        println("[PASS] " + tag)
    } else {
        println("[FAIL] " + tag)
    }
    return ok
}

pub func run() -> i64 {
    if !chk(tie.jit::available(), "LLVM-C 运行时与 ABI 校验") {
        println("[jit] " + tie.jit::last_error())
        println("请用 python tools/tiej/build.py 重新构建产物")
        return 1
    }
    var ll = "define i64 @tiej_selftest() {\n  ret i64 42\n}\n"
    var r = tie.jitsession::run(ll, "tiej_selftest")
    if !chk(r == "OK:42", "IR 装载 → 查符号 → 调用 → 会话关闭") {
        println("[jit] " + r)
        return 1
    }
    println("tiej selftest: PASS（完整 JIT 链路）")
    return 0
}
