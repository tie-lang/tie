type tie<lib, unsafe:mem, unsafe:ext>
import "/std/string.tie"
import "./tjdecl.tie"
namespace tie.jit;
// lib/jit/llvmc.tie —— LLVM-C 垫片的 tie 绑定（extern 直连）
// ============================================================
// 垫片源码 lib/jit/tiej_llvm.c 在构建期以 -DTJ_STATIC 编成静态对象，与
// LLVM-C 导入库一起链进 tiej 可执行产物。tie 侧用 unsafe extern fn 直接
// 调用 C 符号，运行期不再 LoadLibrary 任何自研垫片 DLL，符号缺失或 ABI
// 漂移在构建期 / 启动期就会暴露，不做静默降级。
//
// 公共面保持 available / open / add_ir / lookup / f64_* / close / last_error
// 不变，session 与 marshal 的调用点无需改动。错误串取回后立刻清空线程局部
// 缓冲，避免上一次失败被下一次调用重复读出。
//
// 解耦：本库只依赖内置库与 lib/jit，输入是 LLVM IR 文本，不认识编译器源码。

var g_ready: bool = false
var g_abi_err: string = ""

// 宿主与垫片的 ABI 版本必须一致。版本漂移属于构建错配，直接拒绝执行。
func ensure() -> bool {
    if g_ready {
        return true
    }
    var v: i64 = 0
    unsafe {
        v = tj_abi_version()
    }
    if v != 4 {
        g_abi_err = "LLVM-C 垫片 ABI 版本不符：期望 4，实际 " + to_string(v)
        return false
    }
    unsafe {
        tj_err_clear()
    }
    g_ready = true
    return true
}

// 垫片是否可用（ABI 不符返回 false，调用方据此给出诊断）。
pub func available() -> bool {
    return ensure()
}

// 最近一次失败的错误串（无错误返回空串）。
pub func last_error() -> string {
    if !ensure() {
        return g_abi_err
    }
    var s = ""
    unsafe {
        s = tj_last_error()
        tj_err_clear()
    }
    return s
}

// 新建 JIT 会话；0 = 失败。
pub func open() -> i64 {
    if !ensure() {
        return 0
    }
    unsafe {
        tj_err_clear()
        return tj_jit_open()
    }
}

// 加入一段 LLVM IR 文本；0 = 成功。
pub func add_ir(jit: i64, ir: string) -> i64 {
    if !ensure() {
        return 1
    }
    unsafe {
        tj_err_clear()
        return tj_jit_add_ir(jit, ir, len(ir))
    }
}

// 查符号地址；0 = 未找到（错误串见 last_error）。
pub func lookup(jit: i64, name: string) -> i64 {
    if !ensure() {
        return 0
    }
    unsafe {
        tj_err_clear()
        return tj_jit_lookup(jit, name)
    }
}

// 十进制文本 → LLVM IR double 字面量。
pub func f64_ir(s: string) -> string {
    if !ensure() {
        return ""
    }
    unsafe {
        return tj_f64_ir(s)
    }
}

// 十进制文本 → f64 位模式（wrapper 参数槽用 i64 承载浮点）。
pub func f64_bits(s: string) -> i64 {
    if !ensure() {
        return 0
    }
    unsafe {
        return tj_f64_bits(s)
    }
}

// f64 位模式 → 十进制文本（JIT 包装统一用 i64 槽返回）。
pub func f64_text(bits: i64) -> string {
    if !ensure() {
        return ""
    }
    unsafe {
        return tj_f64_text(bits)
    }
}

// ---- 按单元 ResourceTracker（会话化用）--------------------------------
// 一个 LLJIT 会话可装载多个编译单元，每个单元持有独立 RT；移除一个单元
// 不会波及同会话里的其它单元。所有符号仍在 main JITDylib，lookup 路径不变。
pub func rt_create(jit: i64) -> i64 {
    if !ensure() {
        return 0
    }
    unsafe {
        tj_err_clear()
        return tj_rt_create(jit)
    }
}

pub func rt_add_ir(jit: i64, rt: i64, ir: string) -> i64 {
    if !ensure() {
        return 1
    }
    unsafe {
        tj_err_clear()
        return tj_rt_add_ir(jit, rt, ir, len(ir))
    }
}

pub func rt_remove(rt: i64) -> i64 {
    if !ensure() {
        return 1
    }
    unsafe {
        tj_err_clear()
        return tj_rt_remove(rt)
    }
}

pub func rt_lookup(jit: i64, name: string) -> i64 {
    if !ensure() {
        return 0
    }
    unsafe {
        tj_err_clear()
        return tj_rt_lookup(jit, name)
    }
}

pub func close(jit: i64) {
    if ensure() {
        unsafe {
            tj_jit_close(jit)
        }
    }
}
