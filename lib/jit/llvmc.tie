type tie<class, unsafe:mem, unsafe:ext>
namespace tie.jit;
// llvmc.tie —— LLVM-C 薄垫片（tiej_llvm.dll）的 tie 绑定
// ============================================================
// 垫片源码：lib/jit/tiej_llvm.c；构建产物：_local_only/bin/tiej_llvm.dll
// 垫片导出面（C ABI，全部 ≤5 参）：
//   tj_abi_version() / tj_jit_open() / tj_jit_add_ir(jit, ir, len)
//   tj_jit_lookup(jit, name) / tj_jit_close(jit) / tj_last_error()
// 本文件只做：加载、过程地址缓存、dyn_call_p 封装、错误串复制。
// 解耦：不 import 任何编译器源码；输入是 LLVM IR 文本（后续由 tieir 生成）。

var g_dll: i64 = 0
var g_open: i64 = 0
var g_add: i64 = 0
var g_look: i64 = 0
var g_close: i64 = 0
var g_err: i64 = 0

func ensure() -> bool {
    unsafe {
        if g_dll != 0 {
            return true
        }
        g_dll = load_library("tiej_llvm.dll")
        if g_dll == 0 {
            return false
        }
        g_open = get_proc(g_dll, "tj_jit_open")
        g_add = get_proc(g_dll, "tj_jit_add_ir")
        g_look = get_proc(g_dll, "tj_jit_lookup")
        g_close = get_proc(g_dll, "tj_jit_close")
        g_err = get_proc(g_dll, "tj_last_error")
        return g_open != 0 && g_add != 0 && g_look != 0 && g_close != 0 && g_err != 0
    }
}

// 垫片是否可用（DLL 缺失时返回 false，调用方据此降级/报错）。
pub func available() -> bool {
    return ensure()
}

// 最近一次失败的错误串（无错误返回空串）。
pub func last_error() -> string {
    unsafe {
        if !ensure() {
            return "tiej_llvm.dll 不可用"
        }
        return cstr_to_string(dyn_call_p(g_err, 0, 0, 0, 0, 0))
    }
}

// 新建 JIT 会话；0 = 失败。
pub func open() -> i64 {
    unsafe {
        if !ensure() {
            return 0
        }
        return dyn_call_p(g_open, 0, 0, 0, 0, 0)
    }
}

// 加入一段 LLVM IR 文本；0 = 成功。
pub func add_ir(jit: i64, ir: string) -> i64 {
    unsafe {
        if !ensure() {
            return 1
        }
        return dyn_call_p(g_add, jit, ir, len(ir), 0, 0)
    }
}

// 查符号地址；0 = 未找到（错误串见 last_error）。
pub func lookup(jit: i64, name: string) -> i64 {
    unsafe {
        if !ensure() {
            return 0
        }
        return dyn_call_p(g_look, jit, name, 0, 0, 0)
    }
}

pub func close(jit: i64) {
    unsafe {
        if ensure() {
            dyn_call_p(g_close, jit, 0, 0, 0, 0)
        }
    }
}
