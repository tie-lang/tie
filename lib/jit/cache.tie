type tie<lib>
// lib/jit/cache.tie —— 进程内编译缓存的 LRU 策略（纯函数）
// ============================================================
// 只在内存里维护「最近使用序号」；不做跨进程磁盘缓存，运行期不落编译产物。
// 状态由 session.tie 以平行表持有，本库只提供策略判定，避免跨文件写回陷阱。
import "/std/string.tie"
namespace tie.jitcache;

pub func cap() -> i64 {
    return 32
}

pub func live_count(live: table<i64>) -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < len(live) {
        if live[i] == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// 复用已释放的槽，避免长驻会话里平行表无限增长。
pub func free_slot(live: table<i64>) -> i64 {
    var i: i64 = 0
    while i < len(live) {
        if live[i] == 0 {
            return i
        }
        i = i + 1
    }
    return -1
}

// 返回仍存活且最久未用的单元下标；没有存活单元时返回 -1。
pub func victim(lru: table<i64>, live: table<i64>) -> i64 {
    var best: i64 = -1
    var i: i64 = 0
    while i < len(lru) {
        if i < len(live) && live[i] == 1 {
            if best < 0 || lru[i] < lru[best] {
                best = i
            }
        }
        i = i + 1
    }
    return best
}
