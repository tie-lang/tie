type tie<class, unsafe:mem>

// 内部数组访问：tl_vec 是裸指针实现（unsafe），包成安全函数，
// 免得每个调用点散落 unsafe 块；句柄是 tl_vec 私有布局的 i64。
func gc_new() -> i64 {
    var r: i64 = 0
    unsafe {
        r = tl_vec.vec_new()
    }
    return r
}
func gc_len(h: i64) -> i64 {
    var r: i64 = 0
    unsafe {
        r = tl_vec.vec_len(h)
    }
    return r
}
func gc_get(h: i64, i: i64) -> i64 {
    var r: i64 = 0
    unsafe {
        r = tl_vec.vec_at(h, i)
    }
    return r
}
func gc_set(h: i64, i: i64, v: i64) {
    unsafe {
        // 与原 table 的越界写语义一致：扩容补零后再写
        if i >= tl_vec.vec_len(h) {
            tl_vec.vec_fill(h, i + 1, 0)
        }
        tl_vec.vec_set(h, i, v)
    }
}
func gc_push(h: i64, v: i64) {
    unsafe {
        tl_vec.vec_push(h, v)
    }
}
// core/gc/gc.tie —— trm-lite 阶段1：简单 mark-sweep GC（stop-the-world，命名空间 trm_lite_gc）。
// 对标 trm core/gc 的探针语义：扁平对象图（size/alive/marked）+ 扁平边表（from/to/alive），
// 精确根集；从根全扫标记（栈预分配、无链式指针），再清扫不可达。
// 阶段1只做简单 GC 内核语义验证；与执行体内核（core/mnn/sched.tie）正交，后续由
// 「collect()」薄内置委托调用。
// 状态全用扁平 table<i64>（对象 id 即下标），规避 tiec 嵌套表复绑定缺陷。

const TRM_LITE_GC_VERSION: string = "0.1.0"

// GCStats：一次收集统计（total = 累计对象数，live = 幸存可达数，freed = 本轮回收数）。
struct GCStats {
    var total: i64 = 0
    var live: i64 = 0
    var freed: i64 = 0
}

// ---------- 托管对象表（对象 id 即下标） ----------
var g_size: i64 = 0;           // 对象字节大小
var g_alive: i64 = 0;          // 0/1：是否占用槽位（尚未被 sweep）
var g_marked: i64 = 0;         // 0/1：本次收集是否可达

// ---------- 扁平边表（边 id 即下标；drop 只置 alive=0，不删除/重建） ----------
var g_edge_from: i64 = 0;      // 出边源对象 id
var g_edge_to: i64 = 0;        // 出边目标对象 id
var g_edge_alive: i64 = 0;     // 0/1：该边是否仍生效

// ---------- 根集合 ----------
var g_roots: i64 = 0;          // 精确根集合

// ---------- 表全局惰性初始化（trm_lite.a 静态链接时 main 不初始化库内
// 表全局，桥函数首次调用时创建；import 内联时幂等无害） ----------
var g_tl_gc_init: i64 = 0

func tl_gc_ensure() {
    if g_tl_gc_init == 0 {
        g_size = gc_new()
        g_alive = gc_new()
        g_marked = gc_new()
        g_edge_from = gc_new()
        g_edge_to = gc_new()
        g_edge_alive = gc_new()
        g_roots = gc_new()
        g_tl_gc_init = 1
    }
}

namespace trm_lite_gc;

// ---------- 生命周期 ----------
pub func alloc(size: i64) -> i64 {
    if size < 0 {
        return -1
    }
    var id: i64 = gc_len(g_size)
    gc_push(g_size, size)
    gc_push(g_alive, 1)
    gc_push(g_marked, 0)
    return id
}

// 建立 from → to 引用（追加一条活跃边）。
pub func add_edge(from: i64, to: i64) {
    if from < 0 || from >= gc_len(g_alive) || to < 0 || to >= gc_len(g_alive) {
        return
    }
    if gc_get(g_alive, from) != 1 {
        return
    }
    gc_push(g_edge_from, from)
    gc_push(g_edge_to, to)
    gc_push(g_edge_alive, 1)
}

// 移除对象 from 的第 k 条「活跃出边」（按下标序；alive 置 0，不缩表）。
pub func drop_edge(from: i64, k: i64) {
    if from < 0 || from >= gc_len(g_alive) {
        return
    }
    var seen: i64 = 0
    var e: i64 = 0
    while e < gc_len(g_edge_from) {
        if gc_get(g_edge_alive, e) == 1 && gc_get(g_edge_from, e) == from {
            if seen == k {
                gc_set(g_edge_alive, e, 0)
                return
            }
            seen = seen + 1
        }
        e = e + 1
    }
}

pub func add_root(id: i64) {
    var i: i64 = 0
    while i < gc_len(g_roots) {
        if gc_get(g_roots, i) == id {
            return
        }
        i = i + 1
    }
    gc_push(g_roots, id)
}

pub func drop_root(id: i64) {
    // 去重重建（无缩表原语），回绑全局根集合。
    var nt = gc_new()
    var j: i64 = 0
    while j < gc_len(g_roots) {
        if gc_get(g_roots, j) != id {
            gc_push(nt, gc_get(g_roots, j))
        }
        j = j + 1
    }
    g_roots = nt
}

// ---------- 访问器（供探针/验收断言） ----------
pub func obj_size(id: i64) -> i64 {
    if id < 0 || id >= gc_len(g_size) {
        return -1
    }
    return gc_get(g_size, id)
}
pub func obj_live(id: i64) -> bool {
    if id < 0 || id >= gc_len(g_alive) {
        return false
    }
    return gc_get(g_alive, id) == 1
}
pub func obj_edge_count(id: i64) -> i64 {
    var n: i64 = 0
    var e: i64 = 0
    while e < gc_len(g_edge_from) {
        if gc_get(g_edge_alive, e) == 1 && gc_get(g_edge_from, e) == id {
            n = n + 1
        }
        e = e + 1
    }
    return n
}
pub func live_count() -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < gc_len(g_alive) {
        if gc_get(g_alive, i) == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
pub func alloc_count() -> i64 {
    return gc_len(g_size)
}
pub func root_count() -> i64 {
    return gc_len(g_roots)
}
pub func module_version() -> string {
    return TRM_LITE_GC_VERSION
}

// ---------- 主流程：mark + sweep ----------
// 从根出发做全扫标记：栈预先分配满容量（仅启动时 table_push 增长），热循环内用「索引写」，
// 标记可达对象：从精确根集出发全扫扁平边表（迭代、无递归）。
// stack 表变量提升到函数入口声明——非入口块表变量会触发编译器
// loopf 哨兵（tl_loopf_1 等），独立编译再静态链接的单元（trm_lite.a vs
// 用户程序/编译器自举产物）同名哨兵 → LNK2005 多重定义。入口声明则走
// 出口析构路径（本函数体无回边重写，语义等价）。
pub func gc_mark() -> i64 {
    var stack: i64 = gc_new()
    var i: i64 = 0
    while i < gc_len(g_marked) {
        gc_set(g_marked, i, 0)
        i = i + 1
    }
    var cap = gc_len(g_marked)
    var k: i64 = 0
    while k < cap {
        gc_push(stack, 0)
        k = k + 1
    }
    var sp: i64 = 0
    var ri: i64 = 0
    while ri < gc_len(g_roots) {
        var rid = gc_get(g_roots, ri)
        if rid >= 0 && rid < gc_len(g_marked) && gc_get(g_alive, rid) == 1 {
            gc_set(g_marked, rid, 1)
            gc_set(stack, sp, rid)
            sp = sp + 1
        }
        ri = ri + 1
    }
    while sp > 0 {
        sp = sp - 1
        var cur: i64 = gc_get(stack, sp)
        var e: i64 = 0
        // 该对象活边全扫（扁平、无链式指针）
        while e < gc_len(g_edge_from) {
            if gc_get(g_edge_alive, e) == 1 && gc_get(g_edge_from, e) == cur {
                var tgt = gc_get(g_edge_to, e)
                if tgt >= 0 && tgt < gc_len(g_marked) && gc_get(g_alive, tgt) == 1 && gc_get(g_marked, tgt) == 0 {
                    gc_set(stack, sp, tgt)
                    sp = sp + 1
                    gc_set(g_marked, tgt, 1)
                }
            }
            e = e + 1
        }
    }
    var cnt: i64 = 0
    i = 0
    while i < gc_len(g_marked) {
        if gc_get(g_marked, i) == 1 {
            cnt = cnt + 1
        }
        i = i + 1
    }
    return cnt
}

// 回收不可达对象；返回释放的对象个数。
pub func gc_sweep() -> i64 {
    var freed: i64 = 0
    var i: i64 = 0
    while i < gc_len(g_alive) {
        if gc_get(g_alive, i) == 1 && gc_get(g_marked, i) == 0 {
            gc_set(g_alive, i, 0)
            freed = freed + 1
        }
        i = i + 1
    }
    return freed
}

// 完整一次收集：mark + sweep。返回统计。
pub func gc() -> GCStats {
    var reachable = gc_mark()
    var freed = gc_sweep()
    return GCStats(gc_len(g_size), reachable, freed)
}

// collect 内置委托——完整一次收集，返回本轮回收对象数（i64，extern ABI 扁平）。
pub func collect() -> i64 {
    tl_gc_ensure()
    var s = gc()
    return s.freed
}
