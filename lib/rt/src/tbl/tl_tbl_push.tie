type tie<class, unsafe:mem>
namespace tl_tbl;
pub unsafe fn tbl_push(h: i64, src: i64) {
    var p = int_to_ptr(h)
    var lk = lock_v(p)
    unsafe {
        lock_enter_lk(lk);
    }
    var len = len_v(p)
    var esz = esz_v(p) & TBL_MASK   // 掩掉深表标记位（拷贝宽度用纯 esz）
    var need = len + 1
    var data = grow(p, cap_v(p), len, data_v(p), esz, need)
    memcpy(int_to_ptr(data + len * esz), int_to_ptr(src), esz)
    set_len_v(p, need)
    unsafe {
        lock_leave_lk(lk);
    }
}

// 批量追加：**一次锁内**追加 n 个元素——src 为连续 n 个元素（n*esz 字节），
// 元素宽度取容器 esz。语义与「连续调用 n 次 tbl_push」**完全等价**（同一临界区、
// 同一顺序、同一扩容规则、同一 len 提交），但把 N 次加锁粗化为 1 次，并省去 N-1 次
// 字段重读。这是**不改变任何并发语义**的优化路径：原语层只是把 N 次操作放进同一个
// 临界区。返回追加后的新长度。
pub unsafe fn tbl_append_nl(h: i64, src: i64, n: i64) -> i64 {
    var p = int_to_ptr(h)
    var len = len_v(p)
    if n <= 0 {
        return len
    }
    var esz = esz_v(p) & TBL_MASK
    var need = len + n
    var data = grow(p, cap_v(p), len, data_v(p), esz, need)
    memcpy(int_to_ptr(data + len * esz), int_to_ptr(src), n * esz)
    set_len_v(p, need)
    return need
}

pub unsafe fn tbl_append(h: i64, src: i64, n: i64) -> i64 {
    if n <= 0 {
        return len_v(int_to_ptr(h))
    }
    var p = int_to_ptr(h)
    var lk = lock_v(p)
    unsafe {
        lock_enter_lk(lk);
    }
    var len = len_v(p)
    var esz = esz_v(p) & TBL_MASK
    var need = len + n
    var data = grow(p, cap_v(p), len, data_v(p), esz, need)
    memcpy(int_to_ptr(data + len * esz), int_to_ptr(src), n * esz)
    set_len_v(p, need)
    unsafe {
        lock_leave_lk(lk);
    }
    return need
}

// 预留容量：一次锁内把 cap 提到至少 need（不改变 len）。批量构造前
// 调用可避免中途多次 realloc（配合 tbl_append 构成「一次分配 + 一次锁」的批量路径）。
// 预留入口（指针形参）：同 tbl_release_p，借 nocapture 消除表对象的捕获判定。

pub unsafe fn tbl_push_nl(h: i64, src: i64) {
    var p = int_to_ptr(h)
    var len = len_v(p)
    var esz = esz_v(p) & TBL_MASK
    var need = len + 1
    var data = grow(p, cap_v(p), len, data_v(p), esz, need)
    memcpy(int_to_ptr(data + len * esz), int_to_ptr(src), esz)
    set_len_v(p, need)
}

// ==================== 批量追加（appfuse 融合 pass 与 `table_append` 内置的底座） ====================
// 语义：把 src 前 n 个元素批量追加到 dst 尾（n 钳制 [0, len(src)]；元素宽以 dst 的
// esz 为准，调用方/编译器保证两侧元素类型一致）。与「连续 n 次 tbl_push」（同扩容
// 规则、同 len 提交）逐元素等价，但把 N 次加锁/字段重读/调用粗化成 1 次 + 一段 memcpy。
//
// 自追加守卫（hd == hs）：逐元素循环在 dst==src 时会因 len 增长而**永不终止**
// （调用方侧本已是死循环缺陷）；批量形态不做同款死循环——以「进入时刻的 len」为
// 源快照，单次定容后在单缓冲内**后向**逐元素拷贝（目标恒在源之后，后向序不会覆盖
// 尚未读取的源元素）。
//
// 加锁族对 (dst, src) 双锁：按**句柄地址序**获取（各双锁站点顺序一致 ⇒ 无死锁环；
// 持锁期不调用外部、不重入）；免锁族（_nl）与加锁族共用同一拷贝骨架，选择权在
// 编译器（独占分析 / lock 持证作用域）。

