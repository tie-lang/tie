type tie<class, unsafe:mem>
namespace tl_tbl;
// tl_tbl_slice.tie —— 表只读切片（slice<T>）的运行时表示。
// 切片是独立的 32 字节对象：{refc@0, tbl@8, off@16, len@24}。
// tbl 是**已 retain** 的源表句柄，因此切片存活期间底层 data 不会被回收，
// 不存在悬垂；切片释放（引用计数归零）时统一 release 源表。
// 本文件不做任何边界校验：越界判定由生成代码在切片构造处发射
// （与表下标同一纪律，见 s21_table_set_ex 的两段守卫）。

pub const SL_REFC: i64 = 0;
pub const SL_TBL: i64 = 8;
pub const SL_OFF: i64 = 16;
pub const SL_LEN: i64 = 24;
pub const SL_BYTES: i64 = 32;

// 构造切片：h 为源表句柄，[a, b) 为区间（调用方已保证 0 <= a <= b <= len）。
pub unsafe fn slice_new(h: i64, a: i64, b: i64) -> i64 {
    if h == 0 {
        return 0
    }
    var p = ack(SL_BYTES)
    raw_write(p, SL_REFC, 1)
    raw_write(p, SL_TBL, h)
    raw_write(p, SL_OFF, a)
    raw_write(p, SL_LEN, b - a)
    tbl_retain(h)
    return ptr_to_int(p)
}

pub unsafe fn slice_tbl(s: i64) -> i64 {
    if s == 0 {
        return 0
    }
    return r_i64(int_to_ptr(s), SL_TBL)
}

pub unsafe fn slice_off(s: i64) -> i64 {
    if s == 0 {
        return 0
    }
    return r_i64(int_to_ptr(s), SL_OFF)
}

pub unsafe fn slice_len(s: i64) -> i64 {
    if s == 0 {
        return 0
    }
    return r_i64(int_to_ptr(s), SL_LEN)
}

pub unsafe fn slice_retain(s: i64) {
    if s == 0 {
        return
    }
    var p = int_to_ptr(s)
    raw_write(p, SL_REFC, r_i64(p, SL_REFC) + 1)
}

// 释放切片；归零时先放源表再放自身（源表 release 可能递归释放深表）。
pub unsafe fn slice_release(s: i64) -> i64 {
    if s == 0 {
        return 0
    }
    var p = int_to_ptr(s)
    var rc = r_i64(p, SL_REFC)
    if rc > 1 {
        raw_write(p, SL_REFC, rc - 1)
        return 0
    }
    var h = r_i64(p, SL_TBL)
    free(p)
    if h != 0 {
        tbl_release(h)
    }
    return 0
}