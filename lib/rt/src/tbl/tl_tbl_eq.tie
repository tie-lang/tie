type tie<class, unsafe:mem>
namespace tl_tbl;
var eq_stk: i64 = 0    // 栈缓冲指针（i64）
var eq_cap: i64 = 0    // 已分配对数
var eq_len: i64 = 0    // 已压入对数

pub unsafe fn eq_mark(l: i64, r: i64) -> i64 {
    var i: i64 = 0
    while i < eq_len {
        var base = eq_stk + i * 16
        if raw_read(int_to_ptr(base), 0) == l && raw_read(int_to_ptr(base), 8) == r {
            return 1
        }
        i = i + 1
    }
    if eq_len == eq_cap {
        var ncap: i64 = 8
        if eq_cap > 0 {
            ncap = eq_cap * 2
        }
        var nd = ack(ncap * 16)
        if eq_len > 0 {
            memcpy(nd, int_to_ptr(eq_stk), eq_len * 16)
            free(int_to_ptr(eq_stk))
        }
        eq_stk = ptr_to_int(nd)
        eq_cap = ncap
    }
    var slot = eq_stk + eq_len * 16
    raw_write(int_to_ptr(slot), 0, l)
    raw_write(int_to_ptr(slot), 8, r)
    eq_len = eq_len + 1
    return 0
}

pub unsafe fn eq_unmark() {
    if eq_len > 0 {
        eq_len = eq_len - 1
    }
}



