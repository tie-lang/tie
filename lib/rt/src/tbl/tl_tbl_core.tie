type tie<class, unsafe:mem>
namespace tl_tbl;
// 固定容量越限入口（codegen 按 logic 角色发射定义；运行库只声明、调用）。
// 建表：sh != 0 时块内预留 64 字节 CS（120 B 块，一次分配、随块释放）；
// sh == 0 时块只有 24 句柄 + 32 表头（56 B），lock 字段写 0——运行库的
// 加解锁入口对 lock == 0 是空操作，热路径守卫由 lock_enter_lk/lock_leave_lk
// 负责。装不装锁是编译期判据（独占性）的结果，不是运行期探测。
pub unsafe fn tbl_new_sh(esz: i64, sh: i64) -> i64 {
    var bs: i64 = 120
    if sh == 0 {
        bs = 56
    }
    var h = ack(bs)
    set_cap_v(h, 0)     // cap = 0
    set_len_v(h, 0)     // len = 0
    set_data_v(h, 0)    // data = null
    set_esz_v(h, esz)  // esz = 元素字节大小
    set_refc_v(h, 1)    // refcount = 1（新建表由创建者持有）
    set_fix_v(h, 0)     // 无固定上限（table<T, N, fixed> 的声明点会覆盖）
    if sh != 0 {
        init_lock(h)             // lock = 块内 CS 缓冲（h+56）
    } else {
        set_lock_v(h, 0)         // 无锁表：所有加解锁入口按空操作处理
    }
    return ptr_to_int(h)
}

// 建表（默认装锁）：保持历史行为，供未接判据的调用方使用。
pub unsafe fn tbl_new(esz: i64) -> i64 {
    return tbl_new_sh(esz, 0)
}

// 采纳预建数据缓冲：建一个合法句柄后把 cap/len/data 覆盖为调用方的缓冲区。
// codegen 关闭句柄内联时用它替代手排偏移（s21_tbl_adopt）。
pub unsafe fn tbl_adopt(esz: i64, cap: i64, lenn: i64, dat: ptr<u8>) -> i64 {
    var h = tbl_new(esz)
    var p = int_to_ptr(h)
    set_cap_v(p, cap)
    set_len_v(p, lenn)
    set_data_v(p, ptr_to_int(dat))
    return h
}

// 建表锁：只分配并初始化 CRITICAL_SECTION 缓冲，不接触表句柄。
// codegen 内联建表时调用——句柄的 48 字节块由调用方 malloc，本函数只产锁。
pub unsafe fn lock_new() -> i64 {
    var lk = ack(64)
    unsafe {
        InitializeCriticalSection(ptr_to_int(lk))
    }
    return ptr_to_int(lk)
}

// 就地建锁：句柄块尾部已预留 64 字节 CS 缓冲（h+56），只需初始化并回写
// lock 字段。codegen 内联建表在分配 120 字节后调用它——与 tbl_new 同一契约，
// 建表仍是 2 次分配（句柄块 + 数据），释放只有一次 free。
pub unsafe fn lock_init(p: ptr<u8>) -> i64 {
    init_lock(p)
    return 0
}

// 建深表：元素为表句柄（table<T> 嵌套表，元素宽 8）——tbl_release
// 释放时逐元素释放内层表。esz 字段写入深表标记位（分配尺寸按掩码后计算）。
// 建深表：与 tbl_new_sh 同一布局策略（sh != 0 → 120 B 带块内锁；否则 56 B
// 无锁）。esz 字段写入深表标记位（分配尺寸按掩码后计算）。
pub unsafe fn tbl_new_deep_sh(esz: i64, sh: i64) -> i64 {
    var bs: i64 = 120
    if sh == 0 {
        bs = 56
    }
    var hp = ack(bs)
    set_cap_v(hp, 0)
    set_len_v(hp, 0)
    set_data_v(hp, 0)
    set_esz_v(hp, esz | TBL_DEEP)
    set_fix_v(hp, 0)    // 无固定上限
    set_refc_v(hp, 1)
    if sh != 0 {
        init_lock(hp)
    } else {
        set_lock_v(hp, 0)
    }
    return ptr_to_int(hp)
}

// 建深表（默认装锁）：保持历史行为。
pub unsafe fn tbl_new_deep(esz: i64) -> i64 {
    return tbl_new_deep_sh(esz, 0)
}

// 引用计数 +1：句柄被拷贝到新槽（变量赋值/参数传递/返回值接管）时调用。
pub unsafe fn tbl_retain(h: i64) {
    var p = int_to_ptr(h)
    var rc = refc_v(p)
    set_refc_v(p, rc + 1)
}

// 引用计数 -1：归零则释放表内存（深表先逐元素释放内层表句柄，再释放
// data 缓冲 + lock CS + 句柄块）。空句柄（0/null 槽未初始化）安全跳过——
// 编译器插桩的旧值释放前无需判空。释放前不再加锁（归零 = 唯一所有权已断，
// 无并发读者；并发场景由调用方保证同一句柄的最后 release 不再被其它线程
// 使用——与 Go 容器并发不安全同纪律）。
// 释放入口（指针形参）：句柄以 ptr 传入、由 LLVM 标记 nocapture，表对象因此
// 不被判定捕获，表头字段得以提升为 SSA（i64 形参要先 ptrtoint，捕获不可消除）。
// 实现复用 tbl_release，语义完全一致。
pub unsafe fn tbl_release_p(h: i64) -> i64 {
    return tbl_release(h)
}

pub unsafe fn tbl_release(h: i64) -> i64 {
    if h == 0 {
        return 0
    }
    var p = int_to_ptr(h)
    var rc = refc_v(p)
    if rc <= 1 {
        // 深表逐元素释放——元素为 8 字节表句柄，递归释放（嵌套深度
        // 任意层）；元素表由容器 release 与各自引用方 release 守恒（push 时
        // 瞬态值已转移所有权 / 别名值已 retain）。
        var esz = esz_v(p)
        if (esz & TBL_DEEP) != 0 {
            var n = len_v(p)
            var data = data_v(p)
            var i: i64 = 0
            while i < n {
                var eh = raw_read(int_to_ptr(data + i * 8), 0)
                if eh != 0 {
                    tbl_release(eh)
                }
                i = i + 1
            }
        }
        var data = data_v(p)
        if data != 0 {
            free(int_to_ptr(data))
        }
        var lk = lock_v(p)
        if lk != 0 {
            unsafe {
                DeleteCriticalSection(lk);
            }
        }
        free(p)
        return 0
    }
    set_refc_v(p, rc - 1)
    return rc - 1
}

// 表长度：len(t) = [h+8]（无锁读；并发 push 场景下 len 由 tbl_push 锁内提交）。
pub unsafe fn tbl_len(h: i64) -> i64 {
    return len_v(int_to_ptr(h))
}

// 元素字节大小（容器内部 at/set/ensure 用；tiec 侧用编译期尺寸）。
pub unsafe fn tbl_esz(h: i64) -> i64 {
    return esz_v(int_to_ptr(h))
}

// 扩容核心（调用方**已持锁**，且把 cap/len/data/esz 读入并传入）：need > cap 时
// 增长（cap=0→8，否则 1.5 倍，至少 need），返回新 data（i64）；缓冲可能换址。
// **不重读句柄字段**——句柄字段走 r_i64 = 8 次逐字节读，热路径上重复读纯属浪费。
// 原 ensure_locked 内部重读 cap/len/data/esz（32 次字节访问），而
// tbl_push 每元素调一次 → 冗余显著；抽出参数化版本供 push/append/reserve 复用。
unsafe fn grow(p: ptr<u8>, cap: i64, len: i64, data: i64, esz: i64, need: i64) -> i64 {
    // 容量足够即原样返回（固定容量上限 table<T, N, fixed> 的越限判定在生成代码侧，
    // 运行库不读上限字段、也不依赖失败入口，避免归档引入外部符号）。
    if need <= cap {
        return data
    }
    var newcap: i64 = 8
    if cap > 0 {
        newcap = cap + cap / 2
    }
    if newcap < need {
        newcap = need
    }
    var nd = ack(newcap * esz)
    if data != 0 {
        memcpy(nd, int_to_ptr(data), len * esz)   // nd 已是 ptr；data 为 i64
        free(int_to_ptr(data))
    }
    set_data_v(p, ptr_to_int(nd))
    set_cap_v(p, newcap)
    return ptr_to_int(nd)
}

// 纯增长入口——**只接收值参数，不接收表句柄**。动机：inline push 的慢
// 路径原先把表句柄整体交给 tl_tbl$tbl_push_nl，LLVM 据此判定表对象逃逸，表头
// cap/len/data 无法跨循环提升，push 循环每轮重载三个字段（实测占 push 总耗时
// 约 17%）。本入口把「增长」与「提交」拆开：由调用方（codegen 内联序列）负责
// 把新 data/新 cap 写回表头，运行时侧看不到表对象。

// shared 表：把刚建出的无锁表换成 120 B 块内锁布局（声明点 desugar 的 table_shared 调用）。

// shared 表：把无锁表复制成一张带块内锁的表（声明点 desugar 的 table_shared 调用）。
// 视图语义不可行（两张句柄共享 data 会在 release 时双重释放），故取复制语义：
// 原表保持独立、不被掏空，因此同一张表转换多次或与多个变量共享都安全。
pub unsafe fn tbl_share_new(h: i64) -> i64 {
    unsafe {
        var p = int_to_ptr(h)
        if ptr_to_int(p) == 0 {
            return h
        }
        var esz = esz_v(p)
        if (esz & TBL_DEEP) != 0 {
            // 深表不转换：元素是子表句柄，浅拷贝会破坏引用计数守恒。
            return h
        }
        var ncap = cap_v(p)
        var nlen = len_v(p)
        var np = ack(120)
        set_len_v(np, nlen)
        set_cap_v(np, ncap)
        set_esz_v(np, esz)
        set_refc_v(np, 1)
        set_fix_v(np, fix_v(p))
        init_lock(np)
        var nd: i64 = 0
        if ncap > 0 {
            nd = ptr_to_int(ack(ncap * esz))
            if nlen > 0 {
                memcpy(int_to_ptr(nd), int_to_ptr(data_v(p)), nlen * esz)
            }
        }
        set_data_v(np, nd)
        return ptr_to_int(np)
    }
}
