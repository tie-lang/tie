type tie<class, unsafe:mem>
// tl_tbl.tie —— trm-lite 字节层表容器（命名空间 tl_tbl）的汇总入口。
// 实现在同目录的分片文件里：layout（句柄字段/锁原语）、core（生命周期）、
// grow（扩容/预留）、access（读写）、push（追加）、batch（批量）、
// cow（写时复制）、eq（表相等）。tiec 通过 extern 符号 tl_tbl$* 调用。
import "./tl_tbl_layout.tie"
import "./tl_tbl_core.tie"
import "./tl_tbl_grow.tie"
import "./tl_tbl_access.tie"
import "./tl_tbl_push.tie"
import "./tl_tbl_batch.tie"
import "./tl_tbl_cow.tie"
import "./tl_tbl_eq.tie"
