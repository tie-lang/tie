type tie<class, unsafe:mem>
namespace tl_tbl;
// ==================== 写时复制（，非 unsafe 区的默认写入前提） ====================
// **解决什么**：共享句柄的两个别名（`var b = a`，rc=2）在写入时互相可见——
// 更严重的是**越界写自动扩容会改写共享的 len/cap**，于是
// `var a=[1,2,3]; var b=a; b[100]=42` 会让 `len(a)` 也变成 101（实测）。写 b
// 静默改变了 a 的形状——这正是「非 unsafe 区写不出危险代码」要杜绝的。
//
// **做法**：写入前先分离——rc > 1 说明还有别的别名，此刻克隆表体得到独占副本
// （rc=1），把写落在副本上；rc == 1 说明独占，直接原地写（零额外成本）。
// 返回**可能已更新的句柄**，调用方负责写回自己的槽：
//     t = tbl_cow(t)      // 分离（独占时原样返回）
//     t = tbl_set_cow(t, i, v)
//
// **为何前置分离而不是在 tbl_set 内部判断**：越界扩容发生在 tbl_set **之前**
// （编译器 s21_table_set_ex 先 push 零值把 len 撑到 need）。若只在 tbl_set 里
// 分离，扩容早已污染共享的旧表。分离必须早于任何字段改写。
//
// **为何不用运行期「独占标志」**：与免锁入口同一理由——表可经全局槽
// 被多线程共享而不触发 retain，标志会恒为「独占」。refcount 是**已存在的真实
// 计数**（tbl_retain/tbl_release 维护），不引入新状态。
//
// **成本**：独占路径 = 一次 r_i64(rc) 读（8 次字节访问）后直接返回；共享路径 =
// 首次写付一次 O(len) 克隆，此后副本 rc=1 恢复独占。相较「每次赋值深拷贝」
// （每次 O(len)），只在真正发生共享写时才付费。

// 克隆表体：返回全新句柄（rc=1，数据为 len*esz 字节的独立副本）。
// 深表逐元素 retain（新表与旧表各自持有一份元素引用；旧表最终 release 时会
// 逐元素 release，两侧守恒）。普通表的元素按字节拷贝——元素若是 string，
// 两个表得到各自独立的 (ptr,len) 副本而**共享同一字节缓冲**：string 无
// refcount 且不可变（见 smove.is_owned 注释），共享只读缓冲没有别名写风险。
unsafe fn tbl_clone_body(h: i64) -> i64 {
    var p = int_to_ptr(h)
    var len = len_v(p)
    var esz = esz_v(p)             // 含深表标记位
    var pure = esz & TBL_MASK
    var isdeep = (esz & TBL_DEEP) != 0
    var nh = ack(120)                 // 24 句柄 + 32 表头 + 64 锁
    var ncap: i64 = 0
    var ndata: i64 = 0
    if len > 0 {
        var ndp = ack(len * pure)
        ndata = ptr_to_int(ndp)
        memcpy(ndp, int_to_ptr(data_v(p)), len * pure)
        ncap = len
    }
    set_cap_v(nh, ncap)
    set_len_v(nh, len)
    set_data_v(nh, ndata)
    set_esz_v(nh, esz)                 // 原样保留深表标记
    set_refc_v(nh, 1)
    set_fix_v(nh, 0)                  // 副本继承软容量，无固定上限
    init_lock(nh)
    if isdeep {
        var i: i64 = 0
        while i < len {
            var eh = raw_read(int_to_ptr(ndata + i * 8), 0)
            if eh != 0 {
                tbl_retain(eh)
            }
            i = i + 1
        }
    }
    return ptr_to_int(nh)
}

// 递归深克隆表体：用户可见的 `table_clone` 内建专用。与 tbl_clone_body 同构，
// 差别在深表的每个元素句柄**递归克隆**——副本与源在最内层也互不影响
//（tbl_clone_body 只 retain 元素句柄，内层对象仍共享）。
// 为何不把 tbl_clone_body 改成递归：它服务于 `deep` 形参与 COW（写时分离），那里要的
// 是 O(len) 增量与「缓冲/锁独立」，改成整树克隆会让每次共享写都付全树代价。
// 终止性：tie 的类型系统不允许递归类型，嵌套深度由类型决定必然有限，递归必终止。
unsafe fn tbl_clone_deep_body(h: i64) -> i64 {
    var p = int_to_ptr(h)
    var len = len_v(p)
    var esz = esz_v(p)
    var pure = esz & TBL_MASK
    var isdeep = (esz & TBL_DEEP) != 0
    var nh = ack(120)                 // 24 句柄 + 32 表头 + 64 锁
    var ncap: i64 = 0
    var ndata: i64 = 0
    if len > 0 {
        var ndp = ack(len * pure)
        ndata = ptr_to_int(ndp)
        memcpy(ndp, int_to_ptr(data_v(p)), len * pure)
        ncap = len
    }
    set_cap_v(nh, ncap)
    set_len_v(nh, len)
    set_data_v(nh, ndata)
    set_esz_v(nh, esz)
    set_fix_v(nh, 0)                  // 副本继承软容量，无固定上限
    set_refc_v(nh, 1)
    init_lock(nh)
    if isdeep {
        var i: i64 = 0
        while i < len {
            var slot = int_to_ptr(ndata + i * 8)
            var eh = cap_v(slot)
            if eh != 0 {
                set_cap_v(slot, tbl_clone_deep_body(eh))
            }
            i = i + 1
        }
    }
    return ptr_to_int(nh)
}

// 无条件克隆：返回全新句柄，与源**完全独立**（独立 data 缓冲 + 独立锁）。
// 与 tbl_cow 的区别：**不读引用计数**。原因：struct 按值拷贝**不会 retain 其表字段**
//（实测：按值传参发射的是整 struct 的 `store`，不含逐字段 retain），故 rc ≠ 别名数，
// 靠它判「是否共享」会漏判。`deep` 形参的语义是「无条件独立」，所以用它。
// 深表逐元素 retain（两侧各自持有元素引用，守恒）。
pub unsafe fn tbl_clone(h: i64) -> i64 {
    if h == 0 {
        return 0
    }
    return tbl_clone_body(h)
}

// 克隆入口（指针形参）：同 tbl_release_p/tbl_reserve_p，借 nocapture 让 LLVM 认定
// 源表句柄不被捕获，避免「句柄交给跨模块函数」造成的表对象逃逸。
// 走递归深克隆：`table_clone` 是用户可见的「独立副本」（规范 §13.5），深表的内层表
// 也必须一起复制，否则 `dc[0][0] = 99` 会经由共享的内层表回写到源。
pub unsafe fn tbl_clone_p(h: i64) -> i64 {
    if h == 0 {
        return 0
    }
    return tbl_clone_deep_body(h)
}

// 分离：共享（rc>1）→ 克隆并放弃对旧表的一次引用；独占 → 原样返回。
// 返回值即调用方应当写回自己槽的句柄。
// ⚠ 依赖 rc 准确；见 tbl_clone 关于「struct 拷贝不 retain 表字段」的说明——在那种
//   形态下 rc 偏低，本函数会误判为独占。仅用于**已确认 rc 可信**的场景（同函数内
//   由 tiec 插桩 retain/release 的表变量）。
pub unsafe fn tbl_cow(h: i64) -> i64 {
    if h == 0 {
        return 0
    }
    if refc_v(int_to_ptr(h)) <= 1 {
        return h                      // 独占：无需分离
    }
    var nh = tbl_clone_body(h)
    tbl_release(h)                    // 让出对旧表的一份引用（其它别名仍在）
    return nh
}

// COW 下标写（非 unsafe 区的默认路径）：必要时先分离再写，返回应写回的句柄。
// 越界语义与 tbl_set 一致（静默返回 0，不写）。扩容由编译器侧先行处理——
// 故本入口收到的 i 必然 < len；此处仍保留越界守卫以防直接调用。
pub unsafe fn tbl_set_cow(h: i64, i: i64, src: i64) -> i64 {
    var nh = tbl_cow(h)
    tbl_set(nh, i, src)
    return nh
}

// COW 追加（非 unsafe 区的默认路径）：必要时先分离再 push，返回应写回的句柄。
pub unsafe fn tbl_push_cow(h: i64, src: i64) -> i64 {
    var nh = tbl_cow(h)
    tbl_push(nh, src)
    return nh
}

// ---------- 相等比较句柄对栈（规范 §3.6：嵌套自引用由比较过程检测并终止） ----------
// 共归纳环检测：比较器进入嵌套表比较前调 eq_mark(l, r)——对已在栈中的句柄对
// 返回 1（调用方按相等短路，环按共归纳收敛），新对压栈返回 0；比较退出时
// eq_unmark 配对弹出（无论结论，汇合点统一调）。栈为纯内存动态数组（16 字节
// 对 {l, r}，按 2^n 增长），与本文件其余部分同纪律：零 table<T> 依赖——否则
// trm_lite.a 被表 codegen 的 tiec 重建时经全局 var 初始化自调 tbl 路径成环。
// 并发注记：栈为进程级单例，eq_mark 的查重与压栈非原子——并发比较同一对
// 自引用结构存在误判窗口；容器级并发不安全是既有纪律（Go 同款），此处从之。

