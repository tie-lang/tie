type tie<class, unsafe:mem>
// 分配失败入口：由 codegen 在每个编译单元发射（printf 诊断 + catchable panic 收尾）。
// 运行库自身**没有** printf/exit 通道（panic 一律由 codegen 就地发射），所以这里只声明、
// 由 tiec 生成定义；trm_lite.a 是单成员归档，用到表的程序必然带上该引用。
// void 桥按 i64 返回声明（x64 ABI 下调用方忽略返回值）。
unsafe extern fn tie_oom_fail(need: i64) -> i64
// 固定容量越限入口：table<T, N, fixed> 写超过 N 时由 codegen 发射定义（printf 诊断 +
// 统一失败语义），与 tie_oom_fail 同构；运行库只声明、调用。
// core/tbl/tl_tbl.tie —— trm-lite 字节层表容器（命名空间 tl_tbl）。
// ============================================================
// 供 tiec 表运行时内置（table<T>）**静态链接**：容器 = 48 字节句柄
//   {cap@0, len@8, data@16, esz@24, lock@32, refcount@40}（cap/len/esz/refcount
//   为 i64，data 为原始字节缓冲指针，lock 为 kernel32 CRITICAL_SECTION 缓冲指针，
//   均以 i64 承载）。tiec 以 extern 符号调用 tl_tbl$tbl_*。
// 纯 unsafe/ptr 裸内存实现（**零 table<T> 依赖**）——保证 trm_lite.a 可被
// 任意表 codegen 的 tiec 重建而无自引用环（tbl_at 若用 table<i64> 记账会
// 在「新表 codegen」下自调自身形成无限递归）。
// 用户程序无需 import 本库——tiec 检测到表内置时自动链接。
// 扩容语义对齐编译器旧内联 s21_table_grow：newcap = cap==0 ? max(8,need)
//   : max(cap+cap/2, need)；新缓冲 alloc(newcap*esz) + memcpy 旧 len*esz 字节。
// 并发安全：句柄携带每表锁（kernel32 CS，本文件自持单一声明源，
//   不 import tl_sync——tl_sync 会被复杂形态内联进调用方，tl_tbl 再 import 会
//   使 tl_runtime.o 捆绑 tl_sync$* 与内联方链接期多重定义；自持后 tl_tbl.o
//   仅含 tl_tbl$*，可被任意形态按需提取）；
//   `tbl_push` 单步锁内完成 len/ensure/memcpy/set_len（表追加的并发竞态根治，
//   对齐 Go「容器并发不安全，append 由运行时锁保护」）；tbl_at/tbl_set 持锁
//   防与扩容 realloc 并发；tbl_ensure 保留（编译器编译期路径，同线程）。
// 引用计数：句柄 @40 refcount——tbl_new 置 1；tbl_retain 增（拷贝句柄
//   到新槽）；tbl_release 减（归零 → free data+lock+句柄）。编译器在表变量
//   赋值/返回/作用域出口插桩 retain/release，使表内存可回收（tie 无自动回收）。

// 锁原语自持 kernel32 extern（不 import tl_sync）——tl_sync 会被
// 复杂形态（sched_ws/chan）内联进调用方，若 tl_tbl 再 import，tl_runtime.o
// 将捆绑 tl_sync$* 与内联方链接期多重定义；自持后 tl_tbl.o 仅含 tl_tbl$*，
// 可被任意形态程序按需提取而不撞符号。x64 ABI：CS 缓冲地址以 i64 传。
// extern 声明改为共用 tl_k32 纯声明源（同单元不重名；不产生符号）。

// 深表标记：esz 高比特位（bit 62；bit 63 已被 map 哈希模式占用）。
// 深表 = 元素为表句柄（table<T> 嵌套表，元素宽 8）——tbl_release 对深表
// 逐元素释放（元素自身是表，递归处理嵌套深度）；元素为标量/字符串/any 盒的
// 普通表保持既有行为（数据缓冲整体释放，不逐元素）。标记随元素宽存 esz 字段，
// 分配/拷贝尺寸一律按掩码后的纯 esz 计算。
pub const TBL_DEEP: i64 = 4611686018427387904   // 1 << 62
pub const TBL_MASK: i64 = 4611686018427387903   // 掩掉 bit62 保留低位尺寸
namespace tl_tbl;

// 句柄字段访问器（值形态，全 i64）：形参是字段块基址 ptr<u8>，返回值一律 i64。
// 分片里的裸 r_i64(p, 偏移)/w_i64(p, 偏移, v) 逐处替换成 cap_v/len_v/data_v/esz_v/lock_v/refc_v
// 与对应 set_*，句柄布局只在这一层表达；换布局时改这里，不动调用点。
// 现有布局：24 字节句柄 {len@0, cap@8, 保留@16}，表头紧随其后（基址 = 句柄 + 24）：
// {refcount@24, esz@32, lock@40, data@48}。句柄与表头同块分配，tbl_release 只 free 一次；
// 元素缓冲仍独立分配。
// esz 高位带「深表」标记位，读取方自己按 TBL_MASK 掩（与旧写法一致）。
pub unsafe fn hdr_v(p: ptr<u8>) -> ptr<u8> {
    return int_to_ptr(ptr_to_int(p) + 24)
}
pub unsafe fn len_v(p: ptr<u8>) -> i64 {
    return r_i64(p, 0)
}
pub unsafe fn set_len_v(p: ptr<u8>, v: i64) {
    w_i64(p, 0, v)
}
pub unsafe fn cap_v(p: ptr<u8>) -> i64 {
    return r_i64(p, 8)
}
pub unsafe fn set_cap_v(p: ptr<u8>, v: i64) {
    w_i64(p, 8, v)
}
// 固定容量上限（table<T, N, fixed>）：句柄 @16 存 `limit * 65536 + 65535`。
// 低 16 位是标记：只有 set_fix_v 写过的槽才被认作上限，未初始化/其它用途的
// 堆垃圾不会被误判（旧一代 codegen 不写该槽时仍然安全）。普通表为 0。
// 上限只由 tbl_fix_p 在声明点写入，之后任何增长企图（need > limit）都走失败入口。
pub unsafe fn fix_v(p: ptr<u8>) -> i64 {
    var w = r_i64(p, 16)
    if w <= 0 {
        return 0
    }
    var q = w / 65536
    if w - q * 65536 != 65535 {
        return 0
    }
    return q
}
pub unsafe fn set_fix_v(p: ptr<u8>, v: i64) {
    w_i64(p, 16, v * 65536 + 65535)
}
// 以 i64 句柄为参数的包装（codegen 侧按 i64 调用，避免 ptr/i64 形参类型不匹配）。
pub unsafe fn tbl_fix_lim(h: i64) -> i64 {
    return fix_v(int_to_ptr(h))
}
pub unsafe fn refc_v(p: ptr<u8>) -> i64 {
    return r_i64(hdr_v(p), 0)
}
pub unsafe fn set_refc_v(p: ptr<u8>, v: i64) {
    w_i64(hdr_v(p), 0, v)
}
pub unsafe fn esz_v(p: ptr<u8>) -> i64 {
    return r_i64(hdr_v(p), 8)
}
pub unsafe fn set_esz_v(p: ptr<u8>, v: i64) {
    w_i64(hdr_v(p), 8, v)
}
pub unsafe fn lock_v(p: ptr<u8>) -> i64 {
    return r_i64(hdr_v(p), 16)
}
pub unsafe fn set_lock_v(p: ptr<u8>, v: i64) {
    w_i64(hdr_v(p), 16, v)
}
pub unsafe fn data_v(p: ptr<u8>) -> i64 {
    return r_i64(hdr_v(p), 24)
}
pub unsafe fn set_data_v(p: ptr<u8>, v: i64) {
    w_i64(hdr_v(p), 24, v)
}

// 裸槽读写：p 是**任意 i64 槽地址**（out 形参、元素槽、配对栈），与句柄无关。
// 这类访问不能借用句柄访问器——句柄访问器的偏移随布局变化，裸槽永远是槽首。
pub unsafe fn raw_read(p: ptr<u8>, off: i64) -> i64 {
    return r_i64(p, off)
}
pub unsafe fn raw_write(p: ptr<u8>, off: i64, v: i64) {
    w_i64(p, off, v)
}
import "../mnn/tl_k32.tie"

// ---------- 句柄 i64 字段逐字节读写 ----------
// deref/deref_write 对 ptr<u8> 是单字节存取，i64 字段须 8 字节组装。
pub unsafe fn w_i64(p: ptr<u8>, off: i64, v: i64) {
    var k: i64 = 0
    while k < 8 {
        deref_write(int_to_ptr(ptr_to_int(p) + off + k), (v >> (k * 8)) & 255)
        k = k + 1
    }
}

pub unsafe fn r_i64(p: ptr<u8>, off: i64) -> i64 {
    var v: i64 = 0
    var k: i64 = 0
    while k < 8 {
        var b = deref(int_to_ptr(ptr_to_int(p) + off + k))
        v = v | (b << (k * 8))
        k = k + 1
    }
    return v
}

// 带检查的分配：`alloc` 返回 0 表示 OOM，此时走 tie_oom_fail —— 分配失败必须是**可见
// 失败**（诊断 + panic 收尾），不允许 null 句柄继续传播成下游的野指针崩溃。
// 运行库内部所有 alloc 一律改走这里。
pub unsafe fn ack(n: i64) -> ptr<u8> {
    var p = alloc(n)
    if ptr_to_int(p) == 0 {
        tie_oom_fail(n)
    }
    return p
}

// 每表锁：句柄 @32 存 CRITICAL_SECTION 缓冲地址（tbl_new 时 alloc+init）。
// 自持 extern 后 tl_tbl.o 仅含 tl_tbl$*，任意形态程序按需提取不撞符号。
pub unsafe fn lock_of(h: i64) -> i64 {
    return lock_v(int_to_ptr(h))
}
// 锁可选：非 `shared` 表不装锁（句柄 @40 为 0），此时加解锁是空操作。
// 判据在生成代码侧（编译期「是否可能被另一执行流访问」），运行库只按句柄
// 里有没有锁决定做不做——没有锁不等于漏锁，因为判定发生在编译期。
pub unsafe fn lock_enter(h: i64) {
    var lk = lock_of(h)
    if lk != 0 {
        unsafe {
            EnterCriticalSection(lk);
        }
    }
}
pub unsafe fn lock_leave(h: i64) {
    var lk = lock_of(h)
    if lk != 0 {
        unsafe {
            LeaveCriticalSection(lk);
        }
    }
}
// 给已有句柄补装一把锁（独立分配 64 字节 CS 缓冲并回写 @40）。
// 生成代码在「该表可能跨执行流访问」时才调用；句柄块因此可以只有 56 字节。
pub unsafe fn lock_attach(h: i64) -> i64 {
    var p = int_to_ptr(h)
    if lock_v(p) != 0 {
        return 0
    }
    var lk = ack(64)
    unsafe {
        InitializeCriticalSection(ptr_to_int(lk));
    }
    set_lock_v(p, ptr_to_int(lk))
    return 0
}

// 就地初始化每表锁：句柄块尾部（24 句柄 + 32 表头 = 56）紧跟 64 字节
// CRITICAL_SECTION 缓冲，不再单独 malloc —— 建表从 3 次分配降到 2 次，
// 释放也只需一次 free。lock 字段记自身地址，锁与句柄同生共死。
pub unsafe fn init_lock(p: ptr<u8>) -> i64 {
    var base = ptr_to_int(p) + 56
    unsafe {
        InitializeCriticalSection(base)
    }
    set_lock_v(p, base)
    w_i64(p, 16, 0)
    return base
}

// 建空表：esz = 元素字节大小。返回句柄（i64 = 指向 120 字节块的指针）。
