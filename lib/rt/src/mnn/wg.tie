type tie<class, unsafe:mem>

// 内部数组访问：tl_vec 是裸指针实现（unsafe），包成安全函数，
// 免得每个调用点散落 unsafe 块；句柄是 tl_vec 私有布局的 i64。
func wv_new() -> i64 {
    var r: i64 = 0
    unsafe {
        r = tl_vec.vec_new()
    }
    return r
}
func wv_len(h: i64) -> i64 {
    var r: i64 = 0
    unsafe {
        r = tl_vec.vec_len(h)
    }
    return r
}
func wv_get(h: i64, i: i64) -> i64 {
    var r: i64 = 0
    unsafe {
        r = tl_vec.vec_at(h, i)
    }
    return r
}
func wv_set(h: i64, i: i64, v: i64) {
    unsafe {
        // 与原 table 的越界写语义一致：扩容补零后再写
        if i >= tl_vec.vec_len(h) {
            tl_vec.vec_fill(h, i + 1, 0)
        }
        tl_vec.vec_set(h, i, v)
    }
}
func wv_push(h: i64, v: i64) {
    unsafe {
        tl_vec.vec_push(h, v)
    }
}
// core/mnn/wg.tie —— trm-lite WaitGroup 结构化并发（命名空间 trm_lite_wg）
// 语义对标 Go sync.WaitGroup：
//   · wg_new() -> i64：新组句柄（1 起；每组合 CS/CV 缓冲 + 计数槽）
//   · wg_add(h, n)：计数 += n（n ≥ 0；并发 add 安全）
//   · wg_done(h)：计数 -= 1，归零广播唤醒全部 wg_wait
//   · wg_wait(h)：锁内等计数 == 0（50ms 限时重新谓词，防挂死兜底）
//   · 计数读写全持组锁（U3/U4 纪律：游标与数据同锁）；句柄分配持全局分配锁
//     （句柄序号 + 平行数组追加复合临界区）
// 承载：平行数组（句柄 = 下标+1），CS/CV 缓冲 alloc + tl_k32 声明源自持。
import "./tl_k32.tie"
import "../util/tl_vec.tie"

const WG_MAX: i64 = 256        // 组数上限
const WG_WAIT_MS: i64 = 50     // wg_wait 限时重新谓词间隔

var g_wg_next: i64 = 0         // 下一个组句柄（1 起）
var g_wg_alloc_cs: i64 = 0     // 全局分配锁（句柄序号 + 平行数组复合临界区）
var g_wg_cs: i64 = 0   // 每组合锁缓冲地址
var g_wg_cv: i64 = 0   // 每组条件变量缓冲地址
var g_wg_cnt: i64 = 0  // 每组计数
var g_wg_init: i64 = 0

namespace trm_lite_wg;

// 一次初始化（幂等）。
pub func ensure() {
    if g_wg_init == 0 {
        unsafe {
            g_wg_alloc_cs = ptr_to_int(alloc(64))
            InitializeCriticalSection(g_wg_alloc_cs)
        }
        g_wg_cs = wv_new()
        g_wg_cv = wv_new()
        g_wg_cnt = wv_new()
        g_wg_init = 1
    }
}

// 分配新组，返回句柄（1 起；达上限返回 0）。句柄序号 + 平行数组追加 = 复合临界区。
pub func wg_new() -> i64 {
    ensure()
    var cs: i64 = 0
    unsafe {
        cs = ptr_to_int(alloc(64))
        InitializeCriticalSection(cs)
    }
    var cv: i64 = 0
    unsafe {
        cv = ptr_to_int(alloc(64))
        InitializeConditionVariable(cv)
    }
    var h: i64 = 0
    unsafe {
        EnterCriticalSection(g_wg_alloc_cs)
        if g_wg_next >= WG_MAX {
            LeaveCriticalSection(g_wg_alloc_cs)
            return 0
        }
        g_wg_next = g_wg_next + 1
        h = g_wg_next
        wv_push(g_wg_cs, cs)
        wv_push(g_wg_cv, cv)
        wv_push(g_wg_cnt, 0)
        LeaveCriticalSection(g_wg_alloc_cs)
    }
    return h
}

// wg_lock/wg_unlock（每组合锁）。
func wg_lock(h: i64) {
    unsafe {
        EnterCriticalSection(wv_get(g_wg_cs, h - 1))
    }
}
func wg_unlock(h: i64) {
    unsafe {
        LeaveCriticalSection(wv_get(g_wg_cs, h - 1))
    }
}

// wg_add：锁内计数 += n（n ≥ 0；调用方保证）。
pub func wg_add(h: i64, n: i64) {
    ensure()
    if h < 1 || h > g_wg_next {
        return
    }
    wg_lock(h)
    wv_set(g_wg_cnt, h - 1, wv_get(g_wg_cnt, h - 1) + n)
    wg_unlock(h)
}

// wg_done：计数 -= 1，归零广播唤醒全部 wg_wait。
pub func wg_done(h: i64) {
    ensure()
    if h < 1 || h > g_wg_next {
        return
    }
    wg_lock(h)
    wv_set(g_wg_cnt, h - 1, wv_get(g_wg_cnt, h - 1) - 1)
    if wv_get(g_wg_cnt, h - 1) <= 0 {
        wv_set(g_wg_cnt, h - 1, 0)
        unsafe {
            WakeConditionVariable(wv_get(g_wg_cv, h - 1))
        }
    }
    wg_unlock(h)
}

// wg_wait：锁内等计数 == 0（50ms 限时重新谓词防挂死兜底）。
pub func wg_wait(h: i64) {
    ensure()
    if h < 1 || h > g_wg_next {
        return
    }
    wg_lock(h)
    while wv_get(g_wg_cnt, h - 1) > 0 {
        unsafe {
            SleepConditionVariableCS(wv_get(g_wg_cv, h - 1), wv_get(g_wg_cs, h - 1), WG_WAIT_MS)
        }
    }
    wg_unlock(h)
}

// 观察量：某组当前计数（探针断言）。
pub func wg_count(h: i64) -> i64 {
    if h < 1 || h > g_wg_next {
        return 0
    }
    return wv_get(g_wg_cnt, h - 1)
}

// 运行时清理（进程收尾）：销毁各组锁 + 全局分配锁。
pub func shutdown() {
    if g_wg_init == 1 {
        var i: i64 = 0
        while i < g_wg_next {
            unsafe {
                DeleteCriticalSection(wv_get(g_wg_cs, i))
            }
            i = i + 1
        }
        unsafe {
            DeleteCriticalSection(g_wg_alloc_cs)
        }
        g_wg_alloc_cs = 0
        g_wg_init = 0
    }
}
