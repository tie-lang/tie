type tie<class, unsafe:mem>
// lib/interp/vval.tie —— 解释器值模型（Value enum，载荷为运行时宿主对象）
// ============================================================
// 表示（标量内联 + 复合值=运行时宿主对象）：
//   Nil                     无值
//   Int(i64)                整数
//   Flt(f64)                浮点（原生 f64 载荷，无需手工 bitcast）
//   Bool(i64) 0/1           布尔
//   Trit(i64) -1/0/1        平衡三进制
//   Chr(i64)                字符码点
//   Rng(i64, i64, i64)      范围起点/终点/闭区间标志（内联）
//   Str(string)             文本（宿主 string，长度头 + UTF-8 数据）
//   Tbl(table<Value>)       表（宿主表句柄，元素直存 Value）
//   Map(i64)                键值表描述符槽（键在 w_mkeys，值在 w_mvals）
//   Code(string)            宏/准引用文本（宿主 string）
//
// # 为什么 Tbl 是 table<Value> 而不是槽下标
//   解释器与 JIT 编译产物共用同一套运行时对象表示：string 是 [8 字节长度头][UTF-8]，
//   表是 48 字节句柄 {cap, len, data, esz, lock, refcount}（lib/rt/src/tbl/tl_tbl.tie）。
//   值里直接存宿主对象，跨 JIT / 解释边界就不需要再转换。
//
// # 表句柄的持有约定（实测结论，见 _local_only/pv6.tie）
//   tie 编译器**不会**为枚举载荷里的表句柄自动 retain/release：枚举值的复制是纯
//   位拷贝。一旦承载该表的局部变量离开作用域，句柄引用计数归零即被释放，而值里
//   仍留着悬垂句柄（实测 300 次构造后 257 个值损坏）。
//   故本模块自建一条约定：**每个 Value.Tbl 在构造时由本模块 retain 一次**，此后
//   该值持有的这一份引用不随任何局部变量消亡；解释器值池常驻会话，不逐值释放。
//   string 无需此约定——实测 3000 个枚举内 string 值无一损坏（string 不做引用计数
//   释放，拼接只产新串）。
//
// # 表的值语义
//   tie 原生表是引用语义（push 原地改）。解释器对外提供**值语义**（旧值视图冻结），
//   故 push / 改元素一律复制出新表；句柄引用计数由构造时的 retain 保活。
//
// # 键值表
//   仍用「描述符槽 + 扁平键值表」：键是 interner id（编译器内部量），不跨 JIT 边界，
//   故不改成宿主对象，保持既有语义与成本。
//
// # 命名与常量纪律
//   顶层常量加 W_ 前缀（避免与共享同一命名空间的其它值模块顶层常量重名）；
//   全局表加 w_ 前缀。
//
// # 调用约定
//   import 后 vval.new_int(...) / vval.type_of(...)。

import "/std/utf.tie"
import "../support/interner.tie"

// ==================== 类型码常量（对外契约，数值稳定） ====================
pub const W_INT: i64 = 0;
pub const W_FLOAT: i64 = 1;
pub const W_BOOL: i64 = 2;
pub const W_TRIT: i64 = 3;
pub const W_CHAR: i64 = 4;
pub const W_STR: i64 = 5;
pub const W_RANGE: i64 = 6;
pub const W_TABLE: i64 = 7;
pub const W_MAP: i64 = 8;
pub const W_VOID: i64 = 9;
pub const W_CODE: i64 = 10;

// ==================== 值类型（拆箱核心） ====================
enum Value {
    Nil
    Int(i64)
    Flt(f64)
    Bool(i64)
    Trit(i64)
    Chr(i64)
    Rng(i64, i64, i64)
    Str(string)
    Tbl(table<Value>)
    Map(i64)
    Code(string)
}

// ==================== 键值表存储（描述符槽） ====================
var w_koff: table<i64>;        // 段起点（w_mkeys / w_mvals 偏移）
var w_kcnt: table<i64>;        // 段元素个数
var w_mkeys: table<i64>;       // 键值表键（interner id，升序段）
var w_mvals: table<Value>;     // 键值表值扁平表

// 键值表写入的键槽（范式固定：混合实参嵌套调用会错位，
// 故键走全局槽、值走参数）。w_ms_key 由调用方在 map_set 前设置。
pub var w_ms_key: i64 = 0;

// 错误槽。**刻意不叫 g_err**：同一进程里还可能有别的值模块持有同名顶层变量，
// import 内联后同作用域重名即重复定义报错。
pub var w_err: string = "";

// 句柄字段偏移（与 lib/rt/src/tbl/tl_tbl.tie 的 48 字节句柄一致）
const W_HOFF_RC: i64 = 40;

namespace vval;

// ==================== 句柄引用计数（跨边界对象所有权） ====================
// 逐字节读 i64：deref 对 ptr<u8> 是单字节存取（同 tl_tbl 的 r_i64 写法）。
unsafe fn w_r_i64(p: i64) -> i64 {
    var v: i64 = 0
    var k: i64 = 0
    while k < 8 {
        var b = deref(int_to_ptr(p + k))
        v = v | (b << (k * 8))
        k = k + 1
    }
    return v
}

unsafe fn w_w_i64(p: i64, v: i64) -> i64 {
    var k: i64 = 0
    while k < 8 {
        var b: i64 = (v >> (k * 8)) & 255
        var q = int_to_ptr(p + k)
        deref_write(q, b)
        k = k + 1
    }
    return 0
}

// 表句柄引用计数 +1（本模块为值持有的一份引用）。
unsafe func wrap_table(t: table<Value>) -> table<Value> {
    var h = ptr_to_int(t)
    if h != 0 {
        var rc = w_r_i64(h + W_HOFF_RC) + 1
        w_w_i64(h + W_HOFF_RC, rc)
    }
    return t
}

// 表句柄当前引用计数（诊断与探针用；0 句柄返回 0）。
pub unsafe func table_refcount(t: table<Value>) -> i64 {
    var h = ptr_to_int(t)
    if h == 0 {
        return 0
    }
    return w_r_i64(h + W_HOFF_RC)
}

// ==================== 会话重置 ====================

pub func reset() {
    w_koff = table_new_i64()
    w_kcnt = table_new_i64()
    w_mkeys = table_new_i64()
    w_mvals = {}
    w_err = ""
}

// ==================== 描述符槽（键值表用） ====================

// 新描述符槽（koff=段起点，kcnt=0），返回槽下标。
func new_slot() -> i64 {
    table_push(w_koff, 0)
    table_push(w_kcnt, 0)
    return len(w_koff) - 1
}

// ==================== 构造 ====================

pub func new_int(v: i64) -> Value {
    return Value.Int(v)
}

pub func new_float(v: f64) -> Value {
    return Value.Flt(v)
}

pub func new_bool(b: bool) -> Value {
    if b {
        return Value.Bool(1)
    }
    return Value.Bool(0)
}

pub func new_trit(v: i64) -> Value {
    return Value.Trit(v)
}

pub func new_char(cp: i64) -> Value {
    return Value.Chr(cp)
}

// 文本值：直接持有宿主 string（无需再进文本槽）。
pub func new_str(s: string) -> Value {
    return Value.Str(s)
}

pub func new_range(s: i64, e: i64, inclusive: i64) -> Value {
    return Value.Rng(s, e, inclusive)
}

// 空表值。
pub func new_table() -> Value {
    var t: table<Value> = {}
    var w: table<Value> = t
    unsafe {
        w = wrap_table(t)
    }
    return Value.Tbl(w)
}

// 空键值表值。
pub func new_map() -> Value {
    var n = new_slot()
    w_koff[n] = len(w_mkeys)
    w_kcnt[n] = 0
    return Value.Map(n)
}

pub func new_void() -> Value {
    return Value.Nil
}

// 宏/准引用文本值。
pub func new_code(proto: string) -> Value {
    return Value.Code(proto)
}

// ==================== 跨边界构造（JIT 侧对象 → 解释器值） ====================

// 宿主 string → 值（string 侧无引用计数，直接持有）。
pub func from_host_string(s: string) -> Value {
    return Value.Str(s)
}

// 宿主表 → 值：调用方交出句柄的一次所有权（本模块 retain 后持有）。
pub func from_host_i64_table(t: table<i64>) -> Value {
    // 把宿主侧 table<i64> 句柄内容转成本模块的表值（逐元素装箱成 Int）。
    // 与 from_host_table 的分工：那个接管现成的 table<Value>，这个负责元素类型
    // 不同（JIT 侧只能表达 i64）时的转换，故必须复制而不是共享句柄。
    var n: table<Value> = {}
    var i: i64 = 0
    while i < len(t) {
        table_push(n, Value.Int(t[i]))
        i = i + 1
    }
    var w: table<Value> = {}
    unsafe { w = wrap_table(n) }
    return Value.Tbl(w)
}

pub func from_host_table(t: table<Value>) -> Value {
    var w: table<Value> = t
    unsafe {
        w = wrap_table(t)
    }
    return Value.Tbl(w)
}

// 值 → 宿主 string（非文本值返回空串）。
pub func to_host_string(v: Value) -> string {
    return str_val(v)
}

// ==================== 访问 ====================

// 类型码（W_* 常量；数值稳定，供协议与诊断共享）。
pub func type_of(v: Value) -> i64 {
    // 只用标签判别，故 case 不绑定载荷（绑定而未用会被判「未声明的变量」）
    switch v {
        case Value.Int:
            return W_INT
        case Value.Flt:
            return W_FLOAT
        case Value.Bool:
            return W_BOOL
        case Value.Trit:
            return W_TRIT
        case Value.Chr:
            return W_CHAR
        case Value.Str:
            return W_STR
        case Value.Rng:
            return W_RANGE
        case Value.Tbl:
            return W_TABLE
        case Value.Map:
            return W_MAP
        case Value.Code:
            return W_CODE
        default:
            return W_VOID
    }
}

// 类型名（错误提示用；文本稳定）。
pub func type_name(v: Value) -> string {
    var t = type_of(v)
    if t == W_INT {
        return "整数"
    }
    if t == W_FLOAT {
        return "浮点数"
    }
    if t == W_BOOL {
        return "布尔"
    }
    if t == W_TRIT {
        return "trit"
    }
    if t == W_CHAR {
        return "字符"
    }
    if t == W_STR {
        return "字符串"
    }
    if t == W_RANGE {
        return "范围"
    }
    if t == W_TABLE {
        return "表"
    }
    if t == W_MAP {
        return "键值表"
    }
    if t == W_CODE {
        return "code"
    }
    return "void"
}

// 整数载荷（非整数值为 0）。
pub func int_val(v: Value) -> i64 {
    switch v {
        case Value.Int(x):
            return x
        case Value.Bool(x):
            return x
        case Value.Trit(x):
            return x
        case Value.Chr(x):
            return x
        default:
            return 0
    }
}

pub func float_val(v: Value) -> f64 {
    switch v {
        case Value.Flt(x):
            return x
        default:
            return 0.0
    }
}

// 字符串值文本（Str / Code 直接取宿主 string；其余空串）。
pub func str_val(v: Value) -> string {
    switch v {
        case Value.Str(x):
            return x
        case Value.Code(x):
            return x
        default:
            return ""
    }
}

// code 值文本（非 code 值返回空串）。
pub func code_str(v: Value) -> string {
    switch v {
        case Value.Code(x):
            return x
        default:
            return ""
    }
}

// Range 起点、终点与闭区间标志。
pub func range_start(v: Value) -> i64 {
    switch v {
        case Value.Rng(a, b, c):
            return a
        default:
            return 0
    }
}
pub func range_end(v: Value) -> i64 {
    switch v {
        case Value.Rng(a, b, c):
            return b
        default:
            return 0
    }
}
pub func range_inclusive(v: Value) -> i64 {
    switch v {
        case Value.Rng(a, b, c):
            return c
        default:
            return 0
    }
}

// 真值判断（只接受布尔；失败置 w_err 返回 false，调用方判 w_err）。
pub func is_truthy(v: Value) -> bool {
    switch v {
        case Value.Bool(x):
            return x != 0
        default:
            w_err = "条件必须是布尔，实际是 " + type_name(v)
            return false
    }
}

// ==================== 表 / 键值表 ====================

// 元素个数。
pub func elem_count(v: Value) -> i64 {
    switch v {
        case Value.Tbl(t):
            return len(t)
        case Value.Map(k):
            return w_kcnt[k]
        default:
            return 0
    }
}

// 第 i 个元素（表）：越界返回 Nil（调用方在越界前已自检，此处只作防御）。
pub func elem_at(v: Value, i: i64) -> Value {
    switch v {
        case Value.Tbl(t):
            if i < 0 {
                return Value.Nil
            }
            if i >= len(t) {
                return Value.Nil
            }
            return t[i]
        default:
            return Value.Nil
    }
}

// 表尾追加：返回**新表值**（旧值视图冻结——值语义）。
// 复制旧元素到新表后追加，最后为新句柄 retain 一次（见文件头持有约定）。
pub func table_push_val(tv: Value, elem: Value) -> Value {
    switch tv {
        case Value.Tbl(old):
            var n: table<Value> = {}
            var i: i64 = 0
            while i < len(old) {
                table_push(n, old[i])
                i = i + 1
            }
            table_push(n, elem)
            unsafe {
                n = wrap_table(n)
            }
            return Value.Tbl(n)
        default:
            return tv
    }
}

// 表第 i 个元素替换为新值：返回新表值（越界由调用方校验）。
pub func table_set_at(tv: Value, i: i64, elem: Value) -> Value {
    switch tv {
        case Value.Tbl(old):
            var n: table<Value> = {}
            var k: i64 = 0
            while k < len(old) {
                if k == i {
                    table_push(n, elem)
                } else {
                    table_push(n, old[k])
                }
                k = k + 1
            }
            unsafe {
                n = wrap_table(n)
            }
            return Value.Tbl(n)
        default:
            return tv
    }
}

// 段内键查找（按 interner id 升序段）：命中返回段内下标，未命中 -1。
func map_find(mid: i64, key_id: i64) -> i64 {
    var off = w_koff[mid]
    var cnt = w_kcnt[mid]
    var i: i64 = 0
    while i < cnt {
        if w_mkeys[off + i] == key_id {
            return i
        }
        i = i + 1
    }
    return -1
}

// 按键读取：命中返回值；未命中置 w_err 返回 Nil。
pub func map_get(mv: Value, key_id: i64) -> Value {
    switch mv {
        case Value.Map(mid):
            var i = map_find(mid, key_id)
            if i < 0 {
                w_err = "运行时错误: map_get 键不存在：'" + interner.lookup(key_id) + "'"
                return Value.Nil
            }
            return w_mvals[w_koff[mid] + i]
        default:
            return Value.Nil
    }
}

// 按键读取（复合赋值用）：未命中返回 Int(0)（不报错）。
pub func map_get_opt(mv: Value, key_id: i64) -> Value {
    switch mv {
        case Value.Map(mid):
            var i = map_find(mid, key_id)
            if i < 0 {
                return Value.Int(0)
            }
            return w_mvals[w_koff[mid] + i]
        default:
            return Value.Int(0)
    }
}

// 段内元素文本比较（键升序维护用）。
func text_less(j: i64) -> bool {
    return interner.lookup(w_mkeys[j]) < interner.lookup(w_mkeys[j - 1])
}

// 写键值：返回新 map 值（键已存在 → 覆盖值；否则按文本字典序升序插入）。
// 键取自 w_ms_key 槽（参数错位规避范式）；n 为调用方新建的空 map。
pub func map_set(n: Value, mv: Value, val: Value) -> Value {
    switch n {
        case Value.Map(nid):
            var key_id = w_ms_key
            var mid: i64 = -1
            switch mv {
                case Value.Map(m):
                    mid = m
                default:
                    mid = -1
            }
            var cnt: i64 = 0
            if mid >= 0 {
                cnt = w_kcnt[mid]
            }
            // 旧段 → 局部表（读全局表立即 push 会写入错乱值，故经局部表过渡）
            var tk: table<i64> = table_new_i64()
            var tv: table<Value> = {}
            var off: i64 = 0
            if mid >= 0 {
                off = w_koff[mid]
            }
            var i: i64 = 0
            while i < cnt {
                table_push(tk, w_mkeys[off + i])
                table_push(tv, w_mvals[off + i])
                i = i + 1
            }
            w_koff[nid] = len(w_mkeys)
            w_kcnt[nid] = cnt
            i = 0
            var replaced = false
            while i < cnt {
                if !replaced && tk[i] == key_id {
                    table_push(w_mkeys, tk[i])
                    table_push(w_mvals, val)
                    replaced = true
                } else {
                    table_push(w_mkeys, tk[i])
                    table_push(w_mvals, tv[i])
                }
                i = i + 1
            }
            if !replaced {
                table_push(w_mkeys, key_id)
                table_push(w_mvals, val)
                var j = len(w_mkeys) - 1
                var moving: bool = true
                while moving {
                    if j <= w_koff[nid] {
                        moving = false
                    } else if text_less(j) {
                        var tmpk: i64 = w_mkeys[j]
                        w_mkeys[j] = w_mkeys[j - 1]
                        w_mkeys[j - 1] = tmpk
                        var tmpv: Value = w_mvals[j]
                        w_mvals[j] = w_mvals[j - 1]
                        w_mvals[j - 1] = tmpv
                        j = j - 1
                    } else {
                        moving = false
                    }
                }
                w_kcnt[nid] = cnt + 1
            }
            return Value.Map(nid)
        default:
            return n
    }
}

// ==================== 字符串化 ====================

// 打印格式（对外契约，逐字节稳定）。
pub func to_print_string(v: Value) -> string {
    switch v {
        case Value.Int(x):
            return to_string(x)
        case Value.Flt(x):
            return to_string(x)
        case Value.Bool(x):
            if x != 0 {
                return "1"
            }
            return "0"
        case Value.Trit(x):
            return to_string(x)
        case Value.Chr(x):
            return utf_char_of(x)
        case Value.Str(x):
            return x
        case Value.Rng(a, b, c):
            if c != 0 {
                return to_string(a) + "..=" + to_string(b)
            }
            return to_string(a) + ".." + to_string(b)
        case Value.Tbl(t):
            return table_print(t)
        case Value.Map(k):
            return map_print(k)
        case Value.Code(x):
            return "<code: " + x + ">"
        default:
            return ""
    }
}

// REPL 结果格式（bool → true/false）。
pub func to_repl_string(v: Value) -> string {
    switch v {
        case Value.Bool(x):
            if x != 0 {
                return "true"
            }
            return "false"
        default:
            return to_print_string(v)
    }
}

// 表 → "[a, b]"。
func table_print(t: table<Value>) -> string {
    var cnt = len(t)
    var out: string = "["
    var i: i64 = 0
    while i < cnt {
        out = out + to_print_string(t[i])
        if i + 1 < cnt {
            out = out + ", "
        }
        i = i + 1
    }
    return out + "]"
}

// 键值表 → "{k: v, k2: v2}"（键升序——构造期已保证）。
func map_print(k: i64) -> string {
    var off = w_koff[k]
    var cnt = w_kcnt[k]
    var out: string = "{"
    var i: i64 = 0
    while i < cnt {
        if i > 0 {
            out = out + ", "
        }
        out = out + interner.lookup(w_mkeys[off + i])
        out = out + ": "
        out = out + to_print_string(w_mvals[off + i])
        i = i + 1
    }
    return out + "}"
}

// ==================== 字面量反转义 ====================

pub func unescape_str(raw: string) -> string {
    var n = str_len(raw)
    var is_raw: bool = false
    if n >= 3 && str_char(raw, 0) == "r" && str_char(raw, 1) == "\"" &&
        str_char(raw, n - 1) == "\"" {
        raw = slice(raw, 2, n - 1)
        is_raw = true
    }
    if !is_raw {
        if n >= 2 {
            if str_char(raw, 0) == "\"" {
                if str_char(raw, n - 1) == "\"" {
                    raw = slice(raw, 1, n - 1)
                }
            }
        }
    }
    var out: string = ""
    var m = str_len(raw)
    var i: i64 = 0
    while i < m {
        var c = str_char(raw, i)
        if !is_raw && c == "\\" && i + 1 < m {
            var e = str_char(raw, i + 1)
            if e == "n" {
                out = out + "\n"
                i = i + 2
            } else if e == "t" {
                out = out + "\t"
                i = i + 2
            } else if e == "r" {
                out = out + "\r"
                i = i + 2
            } else if e == "\\" {
                out = out + "\\"
                i = i + 2
            } else if e == "\"" {
                out = out + "\""
                i = i + 2
            } else if e == "'" {
                out = out + "'"
                i = i + 2
            } else if e == "0" {
                var zsb = string_builder()
                sb_append_byte(zsb, 0)
                out = out + sb_build(zsb)
                i = i + 2
            } else {
                out = out + c
                i = i + 1
            }
        } else {
            out = out + c
            i = i + 1
        }
    }
    return out
}

pub func unescape_char(raw: string) -> i64 {
    var s = unescape_str(raw)
    var n = str_len(s)
    if n == 0 {
        return -1
    }
    return char_code(str_char(s, 0))
}

// ==================== 工具 ====================

func utf_char_of(cp: i64) -> string {
    if cp >= 32 {
        if cp <= 126 {
            return utf.to_char(cp)
        }
    }
    return "?"
}

func slice(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

