type tie<class>
// std/diffusion.tie —— L3 扩散调度与 DDPM 采样/训练数值原语（命名空间 diffusion）
// ============================================================
// 用途：微型扩散定调器（训 16×16 粗图先验）的扩散调度（β/ᾱ 表）、加噪、DDPM 反演
// 去噪单步、全环采样、单步训练损失。纯 tie 实现，std 层，不改编译器。
//
// 【ABI】与 tensor/linalg/nn 一致：大数组一律 `ref array<f32,1024>` / `ref array<f64,1024>`
// 零拷贝通道（4KB），返回 void 或小元数据；Rng 为值语义（纯函数返回新 Rng）。
// 逐元素算术一律升 f64 计算再 as_f32 回写（规避 f32 算术误生成 double 触发 opt 崩溃）。
// 浮点字面量一律十进制（opt 不认科学计数）。
//
// 【调度约定】n_steps 用前 n 个槽，其余为 0；返回 array<f64,1024>（长度即类型）。
//   schedule_linear:  β 线性 β(t)=β0+t·(β1−β0)/(n−1)，单调升。
//   schedule_cosine:  余弦调度（Nichol&Dhariwal / improved-DDPM）：
//       ᾱ(t)=cos((t/n+s)/(1+s)·π/2)² ，β(t)=1−ᾱ(t)/ᾱ(t−1)（ᾱ(−1)=1）。
//     ᾱ 单调降、β 非负，t=0 时 ᾱ≈1（小 s）。实现用内建 cos/逆推 β，无 pow。
//   alpha_cumprod:  ᾱ(t)=∏_{k≤t}(1−β_k)。
//
// 【Model / sample / train_step 与模型解耦（设计决策）】
//   tie 无一等函数值，不能把 UNet/ε_θ 回调作参数传给 sample/train_step（fn 类型复杂且
//   ref/回调 ABI 不稳）。因此本库把 DDPM 拆成**数值原语**，推理/训练主体留在调用方（L3
//   应用层用 nn 各层 forward/backward 显式循环）：
//   - denoise_step：单步反演 x_{t-1}，ε_θ 由调用方预先算好传入（enoise 数组）。这是
//     采样循环的可复用最小单元。
//   - sample：纯数值全环反演（t 从 steps-1→0），每步噪声来自调用方预置的 predict-noise
//     扁平表 eno[steps*n]（模型推理由调用方循环各层 forward 产出，逐步写入该表）。
//   - train_step：只给"噪声预测损失"（MSE(ε,ε_pred)）+ 写出 mse_grad；真正的梯度链
//     （loss→nn backward→optim）由调用方做（与 sample 同因：无回调下不内嵌整模型训练）。
//
// 【字节布局 / 依赖】纯内存计算，不落盘（落盘见 serde/data）。依赖 trng（Rng/gauss）
// 与 loss（mse/mse_grad）。
// EN: L3 diffusion schedules + DDPM numerics. Model-decoupled: denoise_step is a single
// reverse step given a precomputed predicted-noise array; sample runs the full reverse
// loop from a user-filled predict-noise table; train_step yields only the epsilon-prediction
// MSE (forward grad) since tie has no first-class callbacks.

import "/ext/trng.tie";
import "/ext/loss.tie";

// 库标识令牌（可配置；探针用字面量即可）。
// EN: library identity/version token (configurable; probes may use literals).
const DTOK: string = "diffusion-l3-v1"

namespace diffusion {

// ---- 线性 β 调度 ----
// β(t)=β0+t·(β1−β0)/(n−1)，单调线性上升；前 n 槽填充，其余 0。
// EN: linear beta schedule betas[0..n-1], rest 0.
pub func schedule_linear<CAP: i64 = 1024>(n_steps: i64, beta_start: f64, beta_end: f64) -> array<f64, CAP> {
    var betas: array<f64, CAP> = array_init(0.0)
    if n_steps <= 0 {
        return betas
    }
    if n_steps == 1 {
        betas[0] = beta_start
        return betas
    }
    var span = to_f64(n_steps - 1)
    var t: i64 = 0
    while t < n_steps {
        var tt = to_f64(t)
        betas[t] = beta_start + (beta_end - beta_start) * (tt / span)
        t = t + 1
    }
    return betas
}

// ---- 余弦 β 调度 ----
// ᾱ(t)=cos((t/n+s)/(1+s)·π/2)²，β(t)=1−ᾱ(t)/ᾱ(t−1)（ᾱ(−1)=1）。小 s（如 0.008）时
// t=0 的 ᾱ≈1；ß 由 ᾱ 单调降推出恒非负（兜底钳 0）。
// EN: cosine beta schedule via alpha-bar cosine; beta = 1 - alpha_c(t)/alpha_c(t-1).
pub func schedule_cosine<CAP: i64 = 1024>(n_steps: i64, s: f64) -> array<f64, CAP> {
    var betas: array<f64, CAP> = array_init(0.0)
    if n_steps <= 0 {
        return betas
    }
    var ac: array<f64, CAP> = array_init(0.0)
    var ones = 1.0 + s
    var half_pi = 1.5707963267948966
    var t: i64 = 0
    while t < n_steps {
        var frac = to_f64(t) / to_f64(n_steps)
        var ang = (frac + s) / ones * half_pi
        ac[t] = cos(ang) * cos(ang)
        t = t + 1
    }
    var tt: i64 = 0
    while tt < n_steps {
        var prev: f64 = 1.0
        if tt > 0 {
            prev = ac[tt - 1]
        }
        var b = 1.0 - ac[tt] / prev
        if b < 0.0 {
            b = 0.0
        }
        betas[tt] = b
        tt = tt + 1
    }
    return betas
}

// ---- ᾱ 累积乘积（f64）----
// ᾱ(t)=∏_{k=0..t}(1−β_k)。返回前 n 槽，其余 0。
// EN: cumulative alpha prod over betas, first n slots filled.
pub func alpha_cumprod<CAP: i64 = 1024>(betas: ref array<f64, CAP>, n: i64) -> array<f64, CAP> {
    var acp: array<f64, CAP> = array_init(0.0)
    var acc: f64 = 1.0
    var t: i64 = 0
    while t < n {
        acc = acc * (1.0 - betas[t])
        acp[t] = acc
        t = t + 1
    }
    return acp
}

// ---- ᾱ 累积乘积（f32，供张量/加噪直接使用）----
// EN: alpha_cumprod as f32 for tensor add_noise consumers.
pub func alpha_cumprod_f32<CAP: i64 = 1024>(betas: ref array<f64, CAP>, n: i64) -> array<f32, CAP> {
    var acp: array<f32, CAP> = array_init(0.0)
    var acc: f64 = 1.0
    var t: i64 = 0
    while t < n {
        acc = acc * (1.0 - betas[t])
        acp[t] = to_f32(acc)
        t = t + 1
    }
    return acp
}

// ---- 正弦时间位置编码 ----
// dim≤1024；i 偶位 sin、奇位 cos，角度 t·10000^{−2·(i/2)/dim}（用 exp(−2·pair/dim·ln10000)）。
// 对称性：t→−t 偶位取反、奇位不变（半对称）。
// EN: sinusoidal timestep embedding (sin on even idx, cos on odd), dim<=1024.
pub func timestep_embedding<CAP: i64 = 1024>(t: i64, dim: i64) -> array<f64, CAP> {
    var e: array<f64, CAP> = array_init(0.0)
    if dim <= 0 {
        return e
    }
    if dim > 1024 {
        dim = 1024
    }
    var ln10k = 9.210340371976184
    var i: i64 = 0
    while i < dim {
        var pair = i / 2
        var ex = -2.0 * to_f64(pair) / to_f64(dim)
        var ang = to_f64(t) * exp(ex * ln10k)
        if i % 2 == 0 {
            e[i] = sin(ang)
        } else {
            e[i] = cos(ang)
        }
        i = i + 1
    }
    return e
}

// ---- 前向加噪：x_t = √ᾱₜ·x0 + √(1−ᾱₜ)·ε ----
// ε 优先取 noise 池；若 noise[0]==0.0（哨兵表示"没给噪声"）则由 r 用 gauss 生成标准正态
// ε。out 写结果，返回传回更新后的 Rng。f64 计算 as_f32 回写。
// EN: forward add-noise; epsilon from noise pool, or generated (gauss) if noise[0]==0.
pub func add_noise<CAP: i64 = 1024>(x0: ref array<f32, CAP>, n: i64, t: i64, noise: ref array<f32, CAP>,
                   acp: ref array<f64, CAP>, out: ref array<f32, CAP>, r: Rng) -> Rng {
    var at = acp[t]
    var g1 = sqrt(at)
    var g2 = sqrt(1.0 - at)
    var useNoise: bool = true
    if to_f64(noise[0]) == 0.0 {
        useNoise = false
    }
    var rr: Rng = r
    var i: i64 = 0
    while i < n {
        var eps: f64 = to_f64(noise[i])
        if !useNoise {
            var p = trng.gauss(rr)
            rr = p.r2
            eps = p.v2
        }
        out[i] = to_f32(g1 * to_f64(x0[i]) + g2 * eps)
        i = i + 1
    }
    return rr
}

// ---- 单步反演去噪：x_{t-1} = 1/√ᾱₜ·(x_t − √(1−ᾱₜ)·ε_θ) [+ σₜ·z] ----
// enoise 为调用方预计算的该步预测噪声（模型 forward 结果）。sample=true 且 t>0 时加
// σₜ·z 随机项（σₜ=√βₜ=√(1−ᾱₜ/ᾱₜ₋₁)，z~N(0,1) 由 r 生成）；sample=false 为确定性反演
// （给定真实 ε 可精确还原 x0）。t=0：1−ᾱ₀=0 且不加噪 → 干净输出。返回更新后的 Rng。
// EN: one reverse denoising step; sigma noise from beta (ᾱ ratio) when sample & t>0.
pub func denoise_step<CAP: i64 = 1024>(x: ref array<f32, CAP>, n: i64, t: i64, enoise: ref array<f32, CAP>,
                      acp: ref array<f64, CAP>, r: Rng, out: ref array<f32, CAP>, sample: bool) -> Rng {
    var at = acp[t]
    var inv = 1.0 / sqrt(at)
    // 噪声系数 (1-ᾱₜ)/√(1-ᾱₜ) ≡ √(1-ᾱₜ)，后者在 ᾱₜ=1 时稳定为 0（避免 0/0）。
    var tscale = sqrt(1.0 - at)
    var rr: Rng = r
    var i: i64 = 0
    while i < n {
        var xp = inv * (to_f64(x[i]) - tscale * to_f64(enoise[i]))
        out[i] = to_f32(xp)
        i = i + 1
    }
    if sample && t > 0 {
        var atp = acp[t - 1]
        var beta = 1.0 - at / atp
        if beta < 0.0 {
            beta = 0.0
        }
        var sig = sqrt(beta)
        var j: i64 = 0
        while j < n {
            var pz = trng.gauss(rr)
            rr = pz.r2
            out[j] = to_f32(to_f64(out[j]) + sig * pz.v2)
            j = j + 1
        }
    }
    return rr
}

// ---- 全环反演采样（模型解耦，predict-noise 表驱动）----
// 从 x=纯噪声（out 初值=调用方给的 x）开始，t 从 steps-1→0 逐段反演。每步 t 的预测噪声
// 取自扁平表 eno[t*n .. t*n+n]（调用方用模型 forward 逐步预计算填入，steps*n≤1024）。
// strat=true 加 σₜ·z 随机（随机化 DDPM）；false 为确定性（DDIM 风格）。返回更新 Rng。
// EN: full reverse loop driven by a user-filled predict-noise table (steps*n<=1024).
pub func sample<CAP: i64 = 1024>(x: ref array<f32, CAP>, n: i64, steps: i64, acp: ref array<f64, CAP>,
                eno: ref array<f32, CAP>, r: Rng, out: ref array<f32, CAP>, strat: bool) -> Rng {
    var rr: Rng = r
    var i: i64 = 0
    while i < n {
        out[i] = x[i]
        i = i + 1
    }
    var tmp: array<f32, CAP> = array_init(0.0)
    var enes: array<f32, CAP> = array_init(0.0)
    var t = steps - 1
    while t >= 0 {
        var k: i64 = 0
        while k < n {
            enes[k] = eno[t * n + k]
            k = k + 1
        }
        var at = acp[t]
        var inv = 1.0 / sqrt(at)
        var tscale = sqrt(1.0 - at)
        var m: i64 = 0
        while m < n {
            tmp[m] = to_f32(inv * (to_f64(out[m]) - tscale * to_f64(enes[m])))
            m = m + 1
        }
        if strat && t > 0 {
            var atp = acp[t - 1]
            var beta = 1.0 - at / atp
            if beta < 0.0 {
                beta = 0.0
            }
            var sig = sqrt(beta)
            var j: i64 = 0
            while j < n {
                var pz = trng.gauss(rr)
                rr = pz.r2
                tmp[j] = to_f32(to_f64(tmp[j]) + sig * pz.v2)
                j = j + 1
            }
        }
        var c: i64 = 0
        while c < n {
            out[c] = tmp[c]
            c = c + 1
        }
        t = t - 1
    }
    return rr
}

// ---- 单步训练损失：噪声预测 MSE ----
// 返回 loss=MSE(ε, ε_pred)=mean((noise−enoise_pred)²)；并把 gw 写成"对 ε_pred 的梯度"
// = 2(ε_pred−noise)/n（经 loss.mse_grad(epred,noise)），供调用方接 nn backward 链。
// x0/t/acp 为兼容签名保留（完整 noising 由调用方拼装 add_noise），本函数只算损失+梯度。
// EN: epsilon-prediction MSE + mse_grad w.r.t. pred; returns the loss scalar.
pub func train_step<CAP: i64 = 1024>(x0: ref array<f32, CAP>, n: i64, t: i64, noise: ref array<f32, CAP>,
                    enoise_pred: ref array<f32, CAP>, acp: ref array<f64, CAP>,
                    gw: ref array<f32, CAP>) -> f64 {
    var L = loss.mse<CAP>(noise, n, enoise_pred, n)
    loss.mse_grad<CAP>(gw, enoise_pred, noise, n)
    return L
}

}   // namespace diffusion