// compiler/data/locale/en-US.td —— 英文诊断消息包（扁平字符串表）
// 键形态：<码>.msg = 错误消息模板；<码>.help = --explain 说明。
// 占位符 <名字> 由 locale 层按调用点替换；缺项时回落内置文案。
[
    "E00554.msg": "undefined type '<nm>'",
    "E00377.msg": "variable '<nm>' type mismatch: declared <ann>, expression is <got>",
    "E00406.help": "E00406 · compound assignment needs both sides to share a type; convert one side explicitly.",
    "E00489.help": "E00489 · the function is not declared in scope; check the spelling, or import the module that defines it.",
    "E00588.help": "E00588 · a call passes an argument of the wrong type; align the argument with the parameter type.",
    "E00112.help": "E00112 · impl method parameter count differs from the port signature — mirror the port's parameter list",
    "E00113.help": "E00113 · impl method parameter type differs from the port signature — make the types identical",
    "E00114.help": "E00114 · impl method has no self receiver — write `func name(self, ...)`",
    "E00118.help": "E00118 · the first parameter of an impl method must be named self",
    "E00120.help": "E00120 · impl method return type differs from the port signature — align the return types",
    "E00210.help": "E00210 · the impl block is missing a method the port requires — every port method must be implemented",
    "E00456.help": "E00456 · promoting a value to a port/interface object needs an unsafe block or function — the object borrows the concrete value",
    "E00556.help": "E00556 · the type argument does not implement the port the generic bound requires — add `impl P for T`",
    "E00557.help": "E00557 · the type argument does not implement the interface the generic bound requires — add the missing methods in an impl block",
    "E00560.help": "E00560 · the concrete type does not satisfy the interface, so it cannot be promoted — implement the missing method or fix its signature",
    "E00561.help": "E00561 · the concrete type has no impl for this port, so it cannot be promoted — write `impl P for T` first",
  "E00357.help": "E00357 · a ref parameter cannot carry a default value — pass the argument at every call",
  "E00360.help": "E00360 · a required parameter follows an optional one — move every defaulted parameter to the end",
  "E00361.help": "E00361 · a parameter default disagrees with the annotated type — give a literal of that type",
  "E00690.help": "E00690 · immut and ref are mutually exclusive — pick read-only or mutable borrowing",
  "E00691.help": "E00691 · move cannot be combined with ref/immut — ownership is transferred, so nothing is left to borrow",
  "E00692.help": "E00692 · ref only applies to table parameters or fixed arrays — drop ref or change the parameter type",
  "E00693.help": "E00693 · a passing-convention modifier repeats — each of ref/immut/move/deep/shared may appear once",
  "E00905.help": "E00905 · shared and deep are mutually exclusive — sharing one copy and copying on entry contradict",
  "E00914.help": "E00914 · a parameter default must be a literal or a compile-time constant — no calls, no runtime input",
  "W00001.help": "W00001 · floating-point equality — f64/f32 values are not exact in binary, so == and != often surprise; compare with a tolerance instead (|a-b| < 1e-9).",
  "W00002.help": "W00002 · integer division truncates — the quotient is floored; convert an operand to f64 to keep the fraction.",
  "W00003.help": "W00003 · repeated string concatenation — tie strings are immutable, so each `+` copies everything; build long text with string_builder + sb_append + sb_build.",
  "W00004.help": "W00004 · table copy shares the buffer — `var b = a` copies only the handle, so writes through b are visible through a; clone explicitly when you need an independent copy.",
  "W00005.help": "W00005 · unused variable — declared but never read; delete it, or prefix with an underscore to state the intent.",
  "W00006.help": "W00006 · unused function — declared but never called; delete it, or check whether a call site is missing.",
  "W00007.help": "W00007 · unused import — imported but never referenced; drop it to shorten compile time.",
  "W00008.help": "W00008 · variable shadows an outer binding — an inner declaration reuses a name that is already visible; rename one of them.",
  "W00009.help": "W00009 · unreachable statement — the code after `return` never runs; delete it or move it before the return.",
  "W00010.help": "W00010 · empty block — no statements and no comment placeholder; delete it, or add a TODO comment explaining why it stays empty.",
  "W00011.help": "W00011 · unused parameter — the parameter is never read; drop it, or prefix it with an underscore to state the intent.",
  "W00012.help": "W00012 · magic number — a literal other than 0 or 1 used directly in an expression; give it a named constant so the meaning is visible.",
  "W00013.help": "W00013 · mutation while iterating a table — appending or removing inside the loop makes the iteration skip or overrun; collect indices first and mutate after the loop.",
  "W00014.help": "W00014 · boolean argument — passing a bool literal hides which branch the parameter selects; use a named constant or split the function.",
  "W00015.help": "W00015 · mutable binding never assigned — a `var` that is never written should be `const`.",
  "W00016.help": "W00016 · mutable global table used as shared state — several write sites mutate it; pass the table explicitly or keep the writes in one place.",
  "W00017.help": "W00017 · nesting too deep — control flow is nested beyond five levels; extract the inner block into a function.",
  "W00018.help": "W00018 · integer literal out of range — the literal does not fit the target narrow type; convert explicitly or use a wider type.",
  "W00019.help": "W00019 · table write past the end — a write with i >= len is discarded; resize or append up to that index first, or fix the index.",
  "W00024.help": "W00024 · duplicate declaration — the same name is declared twice and the later one hides the earlier; rename one of them or delete the duplicate.",
  "W00025.help": "W00025 · constant-false condition — the branch never runs; delete the dead branch or fix the condition.",
  "W00026.help": "W00026 · constant-true condition — the else branch never runs; check whether the condition was written as intended.",
  "W00027.help": "W00027 · integer division by zero — a literal zero divisor crashes at run time; fix the divisor or guard it.",
  "W00028.help": "W00028 · switch without default — an unmatched value is silently ignored; add a default branch or state the omission explicitly.",
  "W00029.help": "W00029 · optimization level lowered — O3 did not fit the memory cap, so the build fell back to O2; raise the cap or accept the level.",
  "W00030.help": "W00030 · unused memory credential — a mem-domain credential is declared but never used in this scope or file; delete the declaration.",
  "W00031.help": "W00031 · rebinding a field of a by-value table parameter — by-value passing copies only the handle, so reassigning the field is invisible to the caller (self-assignment is a no-op); return a new value or mutate through the handle.",
  "E00377.help": "E00377 · type mismatch in a variable or array initializer — the declared type and the inferred type differ; align the annotation with the expression.",
  "E00554.help": "E00554 · undefined type — the annotation names a type that is not declared; check spelling or define it.",
    "E00693.msg": "parameter '<nm>' repeats a passing-convention modifier (ref/immut/move/deep/shared: at most once each)",
    "E00690.msg": "parameter '<nm>' cannot be both immut and ref (a read-only and a mutable borrow are exclusive)",
    "E00691.msg": "parameter '<nm>' cannot be move together with ref/immut (ownership is transferred, so nothing is left to borrow)",
    "E00905.msg": "parameter '<nm>' cannot be both shared and deep (sharing the same copy and copying on entry are exclusive)",
    "E00357.msg": "parameter '<nm>' is ref, so it cannot have a default value (pass the argument at every call)",
    "E00692.msg": "parameter '<nm>' uses ref, which only applies to table parameters (table/table<T>) or fixed arrays (array<T, N>); it is <got>",
    "E00360.msg": "parameter '<nm>' lacks a default value; optional parameters (with defaults) must come after every required one",
    "E00914.msg": "parameter '<nm>' needs a literal or compile-time constant default (a const reference or constant arithmetic; no calls and no runtime input)",
    "E00361.msg": "parameter '<nm>' default type mismatch: expected <want>, got <got>",
