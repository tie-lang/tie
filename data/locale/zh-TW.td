type tie<data>
// compiler/data/locale/zh-TW.td —— 繁體中文診斷訊息包（扁平字串表）
// 鍵形態：<碼>.msg = 錯誤訊息模板；<碼>.help = --explain 說明。
[
  "E00377.msg": "變數 '<nm>' 類型不符：標註 <ann>，運算式推導為 <got>",
  "E00554.msg": "類型 '<nm>' 未定義",
  "E00112.help": "E00112 · impl 方法參數個數與 port 簽名不符——照 port 的參數列表寫",
  "E00113.help": "E00113 · impl 方法參數類型與 port 簽名不符——型別必須完全一致",
  "E00114.help": "E00114 · impl 方法缺 self 接收者——寫成 `func name(self, ...)`",
  "E00118.help": "E00118 · impl 方法的第一參數必須命名為 self",
  "E00120.help": "E00120 · impl 方法回傳類型與 port 簽名不符——對齊回傳型別",
  "E00210.help": "E00210 · impl 區塊漏掉 port 要求的方法——port 方法必須全部實作",
  "E00357.help": "E00357 · ref 參數不能有預設值——每次呼叫都要傳實參",
  "E00360.help": "E00360 · 必選參數排在可選參數之後——把帶預設值的參數集中到最後",
  "E00361.help": "E00361 · 參數預設值與標註型別不符——改用該型別的字面量",
  "E00377.help": "E00377 · 變數或陣列初始化的類型不符——標註類型與運算式推導類型不一致；使兩者一致。",
  "E00406.help": "E00406 · 複合指派類型不符——目標與運算式必須同型；先顯式轉換一側。",
  "E00456.help": "E00456 · 提升到 port/interface 物件需在 unsafe 區塊或函式內——物件借用具體值",
  "E00489.help": "E00489 · 未定義的函式——該名稱在此作用域無宣告；檢查拼寫、import 與命名空間。",
  "E00554.help": "E00554 · 未定義的類型——標註引用了未宣告的型別；檢查拼寫或補上定義。",
  "E00556.help": "E00556 · 型別實參未實作泛型約束要求的 port——補寫 `impl P for T`",
  "E00557.help": "E00557 · 型別實參未實作泛型約束要求的 interface——在 impl 區塊補齊缺少的方法",
  "E00560.help": "E00560 · 具體型別不滿足 interface，不能提升——實作缺少的方法或修正簽名",
  "E00561.help": "E00561 · 具體型別沒有該 port 的 impl，不能提升——先寫 `impl P for T`",
  "E00588.help": "E00588 · 呼叫引數類型不符——引數與形參型別不一致；依簽章傳參。",
  "E00690.help": "E00690 · immut 與 ref 互斥——只保留唯讀借用或可寫借用之一",
  "E00691.help": "E00691 · move 不能與 ref/immut 併用——所有權已移交，無從借用",
  "E00692.help": "E00692 · ref 僅適用於表參數或定長陣列——去掉 ref 或改用這兩種型別",
  "E00693.help": "E00693 · 傳遞約定修飾重複——ref/immut/move/deep/shared 各只能出現一次",
  "E00905.help": "E00905 · shared 與 deep 互斥——共享同一份與入口深拷貝語意對立",
  "E00914.help": "E00914 · 參數預設值必須是字面量或編譯期常數——不可含呼叫或執行期依賴",
  "W00001.help": "W00001 · 浮點相等比較——f64/f32 在二進位下不精確，== 與 != 常出乎意料；請改用容差比較（|a-b| < 1e-9）。",
  "W00002.help": "W00002 · 整數除法截斷——商向下取整會丟失小數；需保留精度請把運算元轉為 f64。",
  "W00003.help": "W00003 · 字串串接累積——tie 字串不可變，每次串接都複製全部舊內容；長文字請用 string_builder + sb_append + sb_build。",
  "W00004.help": "W00004 · 表變數拷貝共用底層——`var b = a` 只複製句柄，透過 b 的修改在 a 也看得到；需要獨立副本請顯式複製。",
  "W00005.help": "W00005 · 未使用變數——宣告後從未讀取；請刪除，或以底線前綴表明有意保留。",
  "W00006.help": "W00006 · 未使用函式——宣告後從未被呼叫；請刪除，或確認是否漏了呼叫點。",
  "W00007.help": "W00007 · 未使用 import——匯入後從未引用；移除可縮短編譯時間。",
  "W00008.help": "W00008 · 變數遮蔽——內層宣告沿用外層已可見的名稱；請改名其中一個。",
  "W00009.help": "W00009 · 不可達語句——`return` 之後的程式碼永遠不會執行；請刪除或移到 return 之前。",
  "W00010.help": "W00010 · 空語句區塊——區塊內既無語句也無註解佔位；請刪除，或加入 TODO 註解說明為何留空。",
  "W00011.help": "W00011 · 參數未使用——形參從未被讀取；請移除，或以底線前綴表明有意保留。",
  "W00012.help": "W00012 · 魔法數字——運算式直接使用 0/1 以外的字面量；請改用具名常數。",
  "W00013.help": "W00013 · 遍歷時改表——迴圈內追加或移除元素會讓迭代漏項或越界；請先收集索引，迴圈結束後再改。",
  "W00014.help": "W00014 · 布林參數呼叫——實參為 bool 字面量，看不出參數代表哪一種語意；請改用常數或拆分函式。",
  "W00015.help": "W00015 · 可變綁定未修改——宣告 var 卻從未賦值，應改用 const。",
  "W00016.help": "W00016 · 全域可變表被當成共享狀態——多處寫入同一張全域表；請改為顯式傳遞或集中寫入。",
  "W00017.help": "W00017 · 巢狀過深——控制流超過五層；請把內層抽成函式。",
  "W00018.help": "W00018 · 整數字面量溢出——字面量超出目標窄型別範圍；請顯式轉換或改用更寬型別。",
  "W00019.help": "W00019 · 表越界寫入——i >= len 的寫入會被丟棄；請先 resize 或追加到該下標，或修正下標。",
  "W00024.help": "W00024 · 變數重複宣告——同名變數再次宣告，後者覆蓋前者；請改名或刪除重複宣告。",
  "W00025.help": "W00025 · 條件恆假——條件為常數 0/false，該分支永不執行；請刪除死分支或修正條件。",
  "W00026.help": "W00026 · 條件恆真——條件為常數 true/非零，else 分支永不執行；請確認條件是否寫錯。",
  "W00027.help": "W00027 · 整數除以零——字面量 0 作除數，執行期必崩；請修正除數或加上保護。",
  "W00028.help": "W00028 · switch 缺少 default——未匹配的值會被靜默忽略；請補上 default 分支或明確說明可省略。",
  "W00029.help": "W00029 · 最佳化檔次自動調降——記憶體上限下 O3 不可用，已降為 O2；提高上限或接受該檔次。",
  "W00030.help": "W00030 · 憑證掛空——宣告了 mem 域憑證但本作用域或全檔未使用；請刪除該宣告。",
  "W00031.help": "W00031 · 按值形參表欄位重綁——按值傳參只複製句柄，重新指派欄位呼叫方看不到（自賦值更是無效）；請改用回傳值或經句柄改內容。"
]
