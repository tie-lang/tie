type tie<tsc>
// tools/release/notes.tsc.tie —— 发行说明生成器（脚本形态，由 tiep 执行）
// ============================================================
// 与编译形态共用 notes_core.tie：参数、分组与格式只有一份实现。
//
// 用法（仓库根目录）：
//   tiep.exe tools/release/notes.tsc.tie --base auto --version 26.2 --out notes.md
//   --base  auto = 最近标签；空串 = 全部历史
//
// 退出码：0 成功 / 1 生成失败 / 2 参数错误。
// ============================================================

import "./notes_core.tie"

func main() -> i64 {
    if notescore.parse_args() < 0 {
        println(notescore.last_error())
        return 2
    }
    var md = notescore.render()
    if md == "" {
        println(notescore.last_error())
        return 1
    }
    var outpath = notescore.opt_out()
    if outpath == "" {
        println(md)
        return 0
    }
    if !file_write(outpath, md) {
        println("写入失败：" + outpath)
        return 1
    }
    println("已写入：" + outpath)
    return 0
}
