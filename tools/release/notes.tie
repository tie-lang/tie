type tie<logic>
// tools/release/notes.tie —— 发行说明生成器（可执行程序形态）
// ============================================================
// 职责：本入口只做「解析参数 → 调核心 → 输出」。生成规则、分组与格式在
// notes_core.tie（与脚本形态共用一份实现）。
//
// 用法（先编译再运行）：
//   tiec tools/release/notes.tie -o _local_only/bin/notes.exe
//   notes.exe --base auto --version 26.2 --out notes.md
//   --base  auto = 最近标签；空串 = 全部历史
//
// 退出码：0 成功 / 1 生成失败 / 2 参数错误。
// ============================================================

import "./notes_core.tie"

func main() -> i64 {
    if notescore.parse_args() < 0 {
        println(notescore.last_error())
        return 2
    }
    var md = notescore.render()
    if md == "" {
        println(notescore.last_error())
        return 1
    }
    var outpath = notescore.opt_out()
    if outpath == "" {
        println(md)
        return 0
    }
    if !file_write(outpath, md) {
        println("写入失败：" + outpath)
        return 1
    }
    println("已写入：" + outpath)
    return 0
}
