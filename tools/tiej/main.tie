type tie<logic, unsafe:mem, unsafe:ext>
import "../../lib/ir/model.tie"
import "../../lib/backend/llvm_text.tie"
import "../../lib/jit/llvmc.tie"
namespace tie.tool.tiej;
// main.tie —— tiej 命令行入口（tieir → LLVM → LLJIT 自检）
// ============================================================
// 用法（仓根）：
//   tiec tools/tiej/main.tie -o _local_only/bin/tiej.exe
//   _local_only/bin/tiej.exe            # 自检
//   _local_only/bin/tiej.exe --selftest # 同上
// 后续批次：tiej run <file.tir>（tieir 文件加载 + 后端 + 执行）。

func chk(ok: bool, tag: string) -> bool {
    if ok {
        println("[PASS] " + tag)
    } else {
        println("[FAIL] " + tag)
    }
    return ok
}

func build_add() {
    tie.ir::reset()
    var f = tie.ir::new_func("jadd", "i64")
    tie.ir::add_param(f, "a", "i64")
    tie.ir::add_param(f, "b", "i64")
    tie.ir::add(f, "r", "a", "b", "i64")
    tie.ir::ret_val(f, "r")
}

func selftest() -> i64 {
    build_add()
    var ll = tie.backend::emit_module()
    if !chk(tie.jit::available(), "tiej_llvm.dll available") {
        println("构建垫片：clang -shared -O2 lib/jit/tiej_llvm.c -I D:/LLVM/include -L D:/LLVM/lib -lLLVM-C -o _local_only/bin/tiej_llvm.dll")
        return 1
    }
    var j = tie.jit::open()
    if !chk(j != 0, "open") {
        println("[jit] " + tie.jit::last_error())
        return 1
    }
    var rc = tie.jit::add_ir(j, ll)
    if rc != 0 {
        println("[jit] " + tie.jit::last_error())
    }
    if !chk(rc == 0, "add_ir") {
        tie.jit::close(j)
        return 1
    }
    var a = tie.jit::lookup(j, "jadd")
    if !chk(a != 0, "lookup jadd") {
        tie.jit::close(j)
        return 1
    }
    unsafe {
        var r = dyn_call_p(a, 3, 4, 0, 0, 0)
        chk(r == 7, "jadd(3,4) = " + to_string(r))
    }
    tie.jit::close(j)
    println("tiej selftest: PASS")
    return 0
}

func main() {
    var n = arg_count()
    if n > 1 {
        var a = arg_string(1)
        if a == "--selftest" {
            selftest()
            return
        }
        println("tiej —— 尚未实现: " + a)
        println("用法: tiej [--selftest]")
        return
    }
    selftest()
}
