type tie<logic>
// JIT 表运行时验收：建表、追加、长度、下标读写、字符串表。

pub func new_i64() -> i64 {
    var t = table_new_i64()
    table_push(t, 10)
    table_push(t, 20)
    return len(t)
}

pub func rw_i64() -> i64 {
    var t = table_new_i64()
    table_push(t, 7)
    t[0] = 9
    return t[0]
}

pub func sum_i64() -> i64 {
    var t = table_new_i64()
    var i = 0
    while i < 5 {
        table_push(t, i * 3)
        i = i + 1
    }
    var s = 0
    i = 0
    while i < len(t) {
        s = s + t[i]
        i = i + 1
    }
    return s
}

pub func new_string() -> i64 {
    var t = table_new_string()
    table_push(t, "abc")
    table_push(t, "de")
    return len(t)
}
