type tie<logic>
// AOT 对照：同一段表代码经完整编译链运行，用于区分「运行时本身有问题」
// 与「JIT 侧缺初始化/ABI 不一致」。

pub func tblen() -> i64 {
    var t = [1, 2, 3, 4]
    return len(t)
}

pub func tsum() -> i64 {
    var t = [10, 20, 30]
    var s = 0
    var i = 0
    while i < len(t) {
        s = s + t[i]
        i = i + 1
    }
    return s
}

func main() {
    println("tblen=" + to_string(tblen()))
    println("tsum=" + to_string(tsum()))
}
