type tie<logic>
// tools/tshell/src/backend_interp.tie —— 求值后端分发层
// ============================================================
// 调用点（command / repl / run / shlang）始终 import 本文件并调用
// backend_interp.b_*，因此更换后端只需切换这里的分发目标，不必改调用点。
// interp 为默认；jit 走 backend_jit.tie，两者实现同一组 b_* 契约。
import "../../../lib/interp/interp.tie"
import "./backend_jit.tie"
namespace backend_interp {

var g_backend: string = "interp"

pub func set_backend(n: string) {
    g_backend = n
}

pub func b_backend() -> string {
    return g_backend
}

// 求值一段 tie 源码，返回结果文本（错误亦以文本返回）。
pub func b_eval(src: string) -> string {
    if g_backend == "jit" {
        return backend_jit.b_eval(src)
    }
    return interp::eval(src)
}

// 整文件脚本求值（函数跨行持久、多行块、条件 exit(n) 生效）。
// 求值并返回类型化结果（Value）：错误时 has_err() 为真，值为 void。
// 供需要值而非文本的宿主调用点使用（JIT 与解释执行之间的值边界）。
pub func b_eval_value(src: string) -> Value {
    return interp::eval_value(src)
}

// 上一次 tbl 返回值的文本形式（REPL 的 jit-value 命令用）。
pub func b_jit_value_text() -> string {
    return backend_jit.b_jit_value_text()
}

pub func b_eval_script(src: string) -> string {
    if g_backend == "jit" {
        return backend_jit.b_eval_script(src)
    }
    return interp::eval_script(src)
}

pub func b_set_script_args(t: table<string>) {
    if g_backend == "jit" {
        backend_jit.b_set_script_args(t)
        return
    }
    interp::set_script_args(t)
}

pub func b_exit_requested() -> bool {
    if g_backend == "jit" {
        return backend_jit.b_exit_requested()
    }
    return interp::exit_requested()
}

pub func b_exit_code() -> i64 {
    if g_backend == "jit" {
        return backend_jit.b_exit_code()
    }
    return interp::exit_code_val()
}

pub func b_reset() {
    if g_backend == "jit" {
        backend_jit.b_reset()
        return
    }
    interp::reset()
}

// 显式 JIT 调用：只有选择了 jit 后端才开放，避免误以为默认路径已改语义。
pub func b_jit_call(path: string, fname: string, sig: table<string>,
                    args: table<string>, ret: string) -> string {
    if g_backend != "jit" {
        return "ERR:请先 set eval-backend jit"
    }
    return backend_jit.b_jit_call(path, fname, sig, args, ret)
}

pub func b_jit_close() -> string {
    if g_backend != "jit" {
        return "ERR:当前不是 jit 后端"
    }
    return backend_jit.b_jit_close()
}

}   // namespace backend_interp
