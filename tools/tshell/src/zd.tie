type tie<logic>
// src/zd.tie —— zd 帧编解码模块（L3 基础，p.9.3.4）· tink 帧协议
// --------------------------------------------------------------
// 帧格式对齐 tink（std/tink_v2 + tink-xxx 绑定库）：`[len u32 BE][payload][crc u32 BE]`，
// crc = CRC32-IEEE（多项式 0xEDB88320，检查向量 crc32("123456789")==0xCBF43926）。
// 纯函数，IO（stdin/stdout）交由调用方（srv / tedit 协议总线宿主）。同时提供
// 同进程 zd 内存总线的**最小帧原语**（tedit 嵌入形态落协议最小实现，见 docs）。
//
// EN: zd frame codec (tink frame protocol): [len u32 BE][payload][crc u32 BE],
// CRC32-IEEE. Pure; IO left to the caller (srv / tedit protocol bus host).

// 解码结果（decode 用模块全局返回，规避 tie 无多返回值；调用方先查 g_zok）：
var g_zok: bool = false
var g_zpayload: table<i64> = []
var g_zend: i64 = 0

namespace zd {

// 字节表长度（i64 计数）。
pub func z_len(t: table<i64>) -> i64 {
    var n: i64 = 0
    for _b in t {
        n = n + 1
    }
    return n
}

// CRC32-IEEE。
pub func z_crc32(bytes: table<i64>) -> i64 {
    var crc: i64 = 0xFFFFFFFF
    for b in bytes {
        crc = crc ^ (b & 0xFF)
        var k: i64 = 0
        while k < 8 {
            if (crc & 1) != 0 {
                crc = (crc >> 1) ^ 0xEDB88320
            } else {
                crc = crc >> 1
            }
            crc = crc & 0xFFFFFFFF
            k = k + 1
        }
    }
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
}

// 帧编码：[len BE][payload][crc BE]。
pub func z_encode(payload: table<i64>) -> table<i64> {
    var out = table_new_i64()
    var n = z_len(payload)
    // length u32 BE
    table_push(out, (n >> 24) & 0xFF)
    table_push(out, (n >> 16) & 0xFF)
    table_push(out, (n >> 8) & 0xFF)
    table_push(out, n & 0xFF)
    for b in payload {
        table_push(out, b & 0xFF)
    }
    var crc = z_crc32(payload)
    table_push(out, (crc >> 24) & 0xFF)
    table_push(out, (crc >> 16) & 0xFF)
    table_push(out, (crc >> 8) & 0xFF)
    table_push(out, crc & 0xFF)
    return out
}

// 解码一帧：buf 从 pos 起解析；成功 g_zok==true 且 g_zend=下一帧位置，返回 g_zend；
// 失败 g_zok==false 返回 -1。payload 写入 g_zpayload。
pub func z_decode(buf: table<i64>, pos: i64) -> i64 {
    g_zok = false
    var n = z_len(buf)
    if pos + 8 > n {
        return -1
    }
    var len: i64 = 0
    len = (len << 8) | (tab_at(buf, pos) & 0xFF)
    len = (len << 8) | (tab_at(buf, pos + 1) & 0xFF)
    len = (len << 8) | (tab_at(buf, pos + 2) & 0xFF)
    len = (len << 8) | (tab_at(buf, pos + 3) & 0xFF)
    var end0 = pos + 8 + len
    if end0 > n {
        return -1
    }
    // payload
    var payload = table_new_i64()
    var i: i64 = 0
    while i < len {
        table_push(payload, tab_at(buf, pos + 4 + i) & 0xFF)
        i = i + 1
    }
    // CRC u32 BE
    var crc: i64 = 0
    crc = (crc << 8) | (tab_at(buf, end0 - 4) & 0xFF)
    crc = (crc << 8) | (tab_at(buf, end0 - 3) & 0xFF)
    crc = (crc << 8) | (tab_at(buf, end0 - 2) & 0xFF)
    crc = (crc << 8) | (tab_at(buf, end0 - 1) & 0xFF)
    var calc = z_crc32(payload)
    g_zok = (calc == crc)
    g_zpayload = payload
    g_zend = end0
    if g_zok {
        return end0
    }
    return -1
}

// 访问解码结果可用性 / payload / 下一帧位置（getter，供调用方）。
pub func z_ok() -> bool { return g_zok }
pub func z_payload() -> table<i64> { return g_zpayload }
pub func z_end() -> i64 { return g_zend }

// 字节表取元素（下标安全）。
func tab_at(t: table<i64>, idx: i64) -> i64 {
    var i: i64 = 0
    for b in t {
        if i == idx {
            return b
        }
        i = i + 1
    }
    return 0
}

}   // namespace zd