type tie<tsh>
// build.tsh.tie —— tsh (role tsh) build driver; tie/tsh port of build.ps1
// usage: tsh_main.exe -f build.tsh.tie
//        (set env TIE_BUILD_NOCACHE=1 to pass --no-cache to tiec)
// Self-bootstrap via tiec stage0; builds one assembly from src/*.tie:
//   _local_only\bin\tsh_main.exe     standalone (full)
// 二进制不进源码树（src/ 只放 .tie；产物统一 _local_only/bin/）。
// (tedit has been extracted into the independent tedit-repo/tedit repo.)
// NOTE(tsh-limitation): the tsh interp cannot issue a conditional `exit N`
// (bare exit is unusable inside control blocks and exit(N) is unwired), so
// on the tiec-missing / compile-fail path this logs the problem but the
// process still returns 0 (build.ps1 used `exit 1` there).
// 从仓根运行：tsh -f tools/tshell/build.tsh.tie
// 合仓后只依赖仓内 tiec 与 lib/，产物统一进 build/，源码树只放 .tie。
var root = cwd()
var tiec = path_join(root, "build\\tiec.exe")
if !file_exists(tiec) { println("[build] 未找到仓内编译器：" + tiec) }
if !file_exists(tiec) { println("[build] 请先按仓根 README 的步骤构建 build/tiec.exe") }
var opts = ""
if get_env("TIE_BUILD_NOCACHE") == "1" { opts = "--no-cache " }
var outdir = path_join(root, "build")
var _mk = mkdir_all(outdir)
println("[build] compiling tools/tshell/src/tsh_main.tie")
// JIT 后端需要进程内 LLVM-C 垫片对象；LLVM_PREFIX 未设置时退化为纯 interp
// 装配（backend_jit 的 extern 在链接期才需要，故必须显式链入）。
var llvm = get_env("LLVM_PREFIX")
var link_extra = ""
if llvm != "" {
    // 宿主必须导出运行时符号与分配器，JIT 代码才能经进程符号解析命中。
    link_extra = " --link-arg \"-Wl,/DEF:build\\tiej_exports.def build\\tiej_llvm.o -L" + llvm + "\\lib -lLLVM-C\""
}
var rc1 = exec_code("cd /d \"" + root + "\" && build\\tiec.exe " + opts + "\"tools/tshell/src/tsh_main.tie\" -o \"build/tsh.exe\"" + link_extra)
if rc1 != 0 { println("[build] compile failed: tools/tshell/src/tsh_main.tie (rc=" + to_string(rc1) + ")") }
println("[build] done: build\\tsh.exe")
exit 0