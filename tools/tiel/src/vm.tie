type tie<class>
// vm.tie —— tiel 执行核（块表 + 直接线程化分派）
// ============================================================
// 职责：按 ops.tie 的指令面执行编译产物。单线程、无 GC：帧槽用扁平
//   表，返回时截断；字符串走常量池，不拼接。
// 帧：每个函数一次调用一帧，帧槽连续存放在 vm_val/vm_typ 里；base 为
//   当前帧的全局起点，槽号相对 base。调用时压入 (调用者 base, 返回 pc,
//   返回值目标槽, 帧槽数)，返回时据此恢复并写回返回值。
// 错误：单错误槽（首错即停），vm_err 非空即中止；调用方按需上报。
// ============================================================
import "./ops.tie"
namespace tiel;

// ==================== 模块（装载期填充） ====================
pub var vm_code: table<i64> = [];          // 指令流（每指令 OPSZ 槽）
pub var vm_consts: table<string> = [];     // 字符串常量池
pub var vm_fn_base: table<i64> = [];       // 每函数起始 pc
pub var vm_fn_slots: table<i64> = [];      // 每函数帧槽数
pub var vm_fn_nargs: table<i64> = [];      // 每函数参数数
pub var vm_entry: i64 = 0;                 // 入口函数索引

// ==================== 运行时状态 ====================
pub var vm_err: string = "";               // 运行时错误（空 = 无）
pub var vm_retval: i64 = 0;                // 最近一次顶层返回值
pub var vm_rettype: i64 = 0;
var vm_val: table<i64> = [];               // 帧槽值
var vm_typ: table<i64> = [];               // 帧槽类型
var vm_fbase: table<i64> = [];             // 调用者帧基址栈
var vm_fret: table<i64> = [];              // 返回 pc 栈
var vm_fdst: table<i64> = [];              // 返回值目标槽栈
var vm_fnsz: table<i64> = [];              // 帧槽数栈
// 数组对象池：vm_aof[i] 是第 i 个数组在 vm_aro 里的起点，vm_aln[i] 是长度。
// 元素值与类型分两表平行存放；不回收，进程内单调增长（草案 §6 的取舍）。
var vm_aro: table<i64> = [];
var vm_art: table<i64> = [];
var vm_aof: table<i64> = [];
var vm_aln: table<i64> = [];

// ---------- 模块装载 ----------
pub func vm_reset() {
    vm_code = []
    vm_consts = []
    vm_fn_base = []
    vm_fn_slots = []
    vm_fn_nargs = []
    vm_entry = 0
    vm_err = ""
    vm_retval = 0
    vm_rettype = 0
    vm_aro = []
    vm_art = []
    vm_aof = []
    vm_aln = []
}

pub func vm_add_const(s: string) -> i64 {
    var n = len(vm_consts)
    var i = 0
    while i < n {
        if vm_consts[i] == s { return i }
        i = i + 1
    }
    table_push(vm_consts, s)
    return n
}

pub func vm_add_fn(base: i64, slots: i64, nargs: i64) -> i64 {
    table_push(vm_fn_base, base)
    table_push(vm_fn_slots, slots)
    table_push(vm_fn_nargs, nargs)
    return len(vm_fn_base) - 1
}

// ---------- 值访问 ----------
func vm_get(slot: i64) -> i64 { return vm_val[slot] }
func vm_set(slot: i64, v: i64, t: i64) {
    vm_val[slot] = v
    vm_typ[slot] = t
}

// ---------- 真值判定 ----------
func vm_truth(slot: i64) -> bool {
    var t = vm_typ[slot]
    if t == VT_BOOL { return vm_val[slot] != 0 }
    if t == VT_INT { return vm_val[slot] != 0 }
    if t == VT_STR { return true }
    return false
}

// ---------- 值转文本（print 用） ----------
func vm_show(slot: i64) -> string {
    var t = vm_typ[slot]
    if t == VT_INT { return to_string(vm_val[slot]) }
    if t == VT_BOOL {
        if vm_val[slot] != 0 { return "true" }
        return "false"
    }
    if t == VT_STR {
        var idx = vm_val[slot]
        if idx >= 0 && idx < len(vm_consts) { return vm_consts[idx] }
        return ""
    }
    if t == VT_ARR { return vm_show_arr(vm_val[slot]) }
    return "nil"
}

// 数组按 [e0, e1, ...] 展开；元素自身也可以是数组，递归到底。
func vm_show_arr(ai: i64) -> string {
    if ai < 0 || ai >= len(vm_aln) { return "[]" }
    var off = vm_aof[ai]
    var n = vm_aln[ai]
    var s = "["
    var i = 0
    while i < n {
        if i > 0 { s = s + ", " }
        var p = off + i
        var t = vm_art[p]
        if t == VT_INT {
            s = s + to_string(vm_aro[p])
        } else if t == VT_BOOL {
            if vm_aro[p] != 0 { s = s + "true" } else { s = s + "false" }
        } else if t == VT_STR {
            var ci = vm_aro[p]
            if ci >= 0 && ci < len(vm_consts) { s = s + vm_consts[ci] }
        } else if t == VT_ARR {
            s = s + vm_show_arr(vm_aro[p])
        } else {
            s = s + "nil"
        }
        i = i + 1
    }
    return s + "]"
}

// ---------- 布尔与比较辅助 ----------
func b_lit(x: bool) -> i64 {
    if x { return 1 }
    return 0
}
func b_not(x: bool) -> bool {
    if x { return false }
    return true
}

func vm_eq(s1: i64, s2: i64) -> bool {
    if vm_typ[s1] != vm_typ[s2] { return false }
    return vm_val[s1] == vm_val[s2]
}

func vm_cmp(s1: i64, s2: i64) -> i64 {
    if vm_typ[s1] == VT_INT && vm_typ[s2] == VT_INT {
        if vm_val[s1] < vm_val[s2] { return -1 }
        if vm_val[s1] > vm_val[s2] { return 1 }
        return 0
    }
    if vm_typ[s1] == VT_STR && vm_typ[s2] == VT_STR {
        var x = vm_consts[vm_val[s1]]
        var y = vm_consts[vm_val[s2]]
        if x < y { return -1 }
        if x > y { return 1 }
    }
    return 0
}

// ---------- 二进制算术 ----------
func vm_bad_op(what: string) {
    if str_len(vm_err) == 0 { vm_err = "运行时错误：操作数类型不支持（" + what + "）" }
}

// ---------- 主执行循环 ----------
pub func vm_run() -> i64 {
    vm_err = ""
    vm_val = []
    vm_typ = []
    vm_fbase = []
    vm_fret = []
    vm_fdst = []
    vm_fnsz = []
    vm_retval = 0
    vm_rettype = VT_NIL

    var ns = vm_fn_slots[vm_entry]
    var i = 0
    while i < ns {
        table_push(vm_val, 0)
        table_push(vm_typ, VT_NIL)
        i = i + 1
    }

    var base: i64 = 0
    var pc: i64 = vm_fn_base[vm_entry]

    while true {
        if str_len(vm_err) > 0 { return 1 }
        var op = vm_code[pc * OPSZ]
        var a = vm_code[pc * OPSZ + 1]
        var b = vm_code[pc * OPSZ + 2]
        var c = vm_code[pc * OPSZ + 3]

        if op == OP_HALT {
            break
        }
        if op == OP_NOP {
            pc = pc + 1
        } else if op == OP_LOADI {
            vm_set(base + a, b, VT_INT)
            pc = pc + 1
        } else if op == OP_LOADS {
            vm_set(base + a, b, VT_STR)
            pc = pc + 1
        } else if op == OP_LOADB {
            vm_set(base + a, b, VT_BOOL)
            pc = pc + 1
        } else if op == OP_LOADNIL {
            vm_set(base + a, 0, VT_NIL)
            pc = pc + 1
        } else if op == OP_MOV {
            vm_set(base + a, vm_val[base + b], vm_typ[base + b])
            pc = pc + 1
        } else if op == OP_NEG {
            if vm_typ[base + b] != VT_INT { vm_bad_op("取负") } else {
                vm_set(base + a, 0 - vm_val[base + b], VT_INT)
            }
            pc = pc + 1
        } else if op == OP_NOT {
            vm_set(base + a, b_lit(b_not(vm_truth(base + b))), VT_BOOL)
            pc = pc + 1
        } else if op == OP_BNOT {
            vm_set(base + a, 0 - vm_val[base + b] - 1, VT_INT)
            pc = pc + 1
        } else if op == OP_ADD {
            if vm_typ[base + b] == VT_INT && vm_typ[base + c] == VT_INT {
                vm_set(base + a, vm_val[base + b] + vm_val[base + c], VT_INT)
                pc = pc + 1
            } else if vm_typ[base + b] == VT_STR && vm_typ[base + c] == VT_STR {
                // 字符串是不可变值，拼接结果落进常量池。无回收（草案 §6），
                // 循环内反复拼接会持续增长常量池，属已知代价。
                var sa = vm_consts[vm_val[base + b]]
                var sb = vm_consts[vm_val[base + c]]
                vm_set(base + a, vm_add_const(sa + sb), VT_STR)
                pc = pc + 1
            } else {
                vm_bad_op("加法")
                pc = pc + 1
            }
        } else if op == OP_TOSTR {
            // 插值串里的非字符串值按显示形式转成字符串，与 print 的呈现一致。
            vm_set(base + a, vm_add_const(vm_show(base + b)), VT_STR)
            pc = pc + 1
        } else if op == OP_SUB {
            if vm_typ[base + b] == VT_INT && vm_typ[base + c] == VT_INT {
                vm_set(base + a, vm_val[base + b] - vm_val[base + c], VT_INT)
            } else { vm_bad_op("减法") }
            pc = pc + 1
        } else if op == OP_MUL {
            if vm_typ[base + b] == VT_INT && vm_typ[base + c] == VT_INT {
                vm_set(base + a, vm_val[base + b] * vm_val[base + c], VT_INT)
            } else { vm_bad_op("乘法") }
            pc = pc + 1
        } else if op == OP_DIV {
            if vm_typ[base + b] != VT_INT || vm_typ[base + c] != VT_INT {
                vm_bad_op("除法")
            } else if vm_val[base + c] == 0 {
                if str_len(vm_err) == 0 { vm_err = "运行时错误：除数为零" }
            } else {
                vm_set(base + a, vm_val[base + b] / vm_val[base + c], VT_INT)
            }
            pc = pc + 1
        } else if op == OP_MOD {
            if vm_typ[base + b] != VT_INT || vm_typ[base + c] != VT_INT {
                vm_bad_op("取模")
            } else if vm_val[base + c] == 0 {
                if str_len(vm_err) == 0 { vm_err = "运行时错误：除数为零" }
            } else {
                vm_set(base + a, vm_val[base + b] % vm_val[base + c], VT_INT)
            }
            pc = pc + 1
        } else if op == OP_POW {
            if vm_typ[base + b] != VT_INT || vm_typ[base + c] != VT_INT {
                vm_bad_op("幂")
            } else if vm_val[base + c] < 0 {
                if str_len(vm_err) == 0 { vm_err = "运行时错误：幂指数为负" }
            } else {
                var r: i64 = 1
                var k: i64 = 0
                while k < vm_val[base + c] {
                    r = r * vm_val[base + b]
                    k = k + 1
                }
                vm_set(base + a, r, VT_INT)
            }
            pc = pc + 1
        } else if op == OP_BAND {
            vm_set(base + a, vm_val[base + b] & vm_val[base + c], VT_INT)
            pc = pc + 1
        } else if op == OP_BOR {
            vm_set(base + a, vm_val[base + b] | vm_val[base + c], VT_INT)
            pc = pc + 1
        } else if op == OP_BXOR {
            vm_set(base + a, vm_val[base + b] ^ vm_val[base + c], VT_INT)
            pc = pc + 1
        } else if op == OP_SHL {
            vm_set(base + a, vm_val[base + b] << vm_val[base + c], VT_INT)
            pc = pc + 1
        } else if op == OP_SHR {
            vm_set(base + a, vm_val[base + b] >> vm_val[base + c], VT_INT)
            pc = pc + 1
        } else if op == OP_EQ {
            vm_set(base + a, b_lit(vm_eq(base + b, base + c)), VT_BOOL)
            pc = pc + 1
        } else if op == OP_NE {
            vm_set(base + a, b_lit(b_not(vm_eq(base + b, base + c))), VT_BOOL)
            pc = pc + 1
        } else if op == OP_LT {
            vm_set(base + a, b_lit(vm_cmp(base + b, base + c) < 0), VT_BOOL)
            pc = pc + 1
        } else if op == OP_LE {
            vm_set(base + a, b_lit(vm_cmp(base + b, base + c) <= 0), VT_BOOL)
            pc = pc + 1
        } else if op == OP_GT {
            vm_set(base + a, b_lit(vm_cmp(base + b, base + c) > 0), VT_BOOL)
            pc = pc + 1
        } else if op == OP_GE {
            vm_set(base + a, b_lit(vm_cmp(base + b, base + c) >= 0), VT_BOOL)
            pc = pc + 1
        } else if op == OP_JMP {
            pc = a
        } else if op == OP_JMPF {
            if vm_truth(base + b) { pc = pc + 1 } else { pc = a }
        } else if op == OP_JMPT {
            if vm_truth(base + b) { pc = a } else { pc = pc + 1 }
        } else if op == OP_CALL {
            var nb = len(vm_val)
            var nsz = vm_fn_slots[b]
            var na = vm_fn_nargs[b]
            var k: i64 = 0
            while k < nsz {
                table_push(vm_val, 0)
                table_push(vm_typ, VT_NIL)
                k = k + 1
            }
            k = 0
            while k < na {
                vm_val[nb + k] = vm_val[base + c + k]
                vm_typ[nb + k] = vm_typ[base + c + k]
                k = k + 1
            }
            table_push(vm_fbase, base)
            table_push(vm_fret, pc + 1)
            table_push(vm_fdst, a)
            table_push(vm_fnsz, nsz)
            base = nb
            pc = vm_fn_base[b]
        } else if op == OP_RET {
            var rv: i64 = 0
            var rt: i64 = VT_NIL
            if a >= 0 {
                rv = vm_val[base + a]
                rt = vm_typ[base + a]
            }
            var dn = len(vm_fbase)
            if dn == 0 {
                vm_retval = rv
                vm_rettype = rt
                break
            }
            var cb = vm_fbase[dn - 1]
            var cp = vm_fret[dn - 1]
            var cd = vm_fdst[dn - 1]
            var cs = vm_fnsz[dn - 1]
            table_trunc(vm_fbase, dn - 1)
            table_trunc(vm_fret, dn - 1)
            table_trunc(vm_fdst, dn - 1)
            table_trunc(vm_fnsz, dn - 1)
            table_trunc(vm_val, cb + cs)
            table_trunc(vm_typ, cb + cs)
            vm_val[cb + cd] = rv
            vm_typ[cb + cd] = rt
            base = cb
            pc = cp
        } else if op == OP_NEWARR {
            var n = b
            var ai = len(vm_aln)
            var off = len(vm_aro)
            table_push(vm_aof, off)
            table_push(vm_aln, n)
            var k: i64 = 0
            while k < n {
                table_push(vm_aro, vm_val[base + c + k])
                table_push(vm_art, vm_typ[base + c + k])
                k = k + 1
            }
            vm_set(base + a, ai, VT_ARR)
            pc = pc + 1
        } else if op == OP_INDEX {
            var ai2 = vm_val[base + b]
            if vm_typ[base + b] != VT_ARR {
                vm_bad_op("下标")
            } else if ai2 < 0 || ai2 >= len(vm_aln) {
                if str_len(vm_err) == 0 { vm_err = "运行时错误：数组对象越界" }
            } else {
                var ix = vm_val[base + c]
                if ix < 0 || ix >= vm_aln[ai2] {
                    if str_len(vm_err) == 0 { vm_err = "运行时错误：下标越界" }
                } else {
                    var p = vm_aof[ai2] + ix
                    vm_set(base + a, vm_aro[p], vm_art[p])
                }
            }
            pc = pc + 1
        } else if op == OP_SETIDX {
            var si = vm_val[base + a]
            if vm_typ[base + a] != VT_ARR {
                vm_bad_op("下标赋值")
            } else if si < 0 || si >= len(vm_aln) {
                if str_len(vm_err) == 0 { vm_err = "运行时错误：数组对象越界" }
            } else {
                var sj = vm_val[base + b]
                if vm_typ[base + b] != VT_INT {
                    vm_bad_op("下标赋值")
                } else if sj < 0 || sj >= vm_aln[si] {
                    if str_len(vm_err) == 0 { vm_err = "运行时错误：下标越界" }
                } else {
                    var sp = vm_aof[si] + sj
                    vm_aro[sp] = vm_val[base + c]
                    vm_art[sp] = vm_typ[base + c]
                }
            }
            pc = pc + 1
        } else if op == OP_LEN {
            if vm_typ[base + b] == VT_ARR {
                var ai3 = vm_val[base + b]
                if ai3 >= 0 && ai3 < len(vm_aln) {
                    vm_set(base + a, vm_aln[ai3], VT_INT)
                } else {
                    vm_set(base + a, 0, VT_INT)
                }
            } else if vm_typ[base + b] == VT_STR {
                var ci = vm_val[base + b]
                var sl = 0
                if ci >= 0 && ci < len(vm_consts) { sl = str_len(vm_consts[ci]) }
                vm_set(base + a, sl, VT_INT)
            } else {
                vm_bad_op("取长度")
            }
            pc = pc + 1
        } else if op == OP_PRINT {
            println(vm_show(base + a))
            pc = pc + 1
        } else {
            if str_len(vm_err) == 0 { vm_err = "运行时错误：未知指令 " + to_string(op) }
            return 1
        }
    }
    return 0
}
