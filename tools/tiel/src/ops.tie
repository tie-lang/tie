type tie<class>
// ops.tie —— tiel 内核指令集（tsc 子集；寄存器式三地址码）
// ============================================================
// 职责：定义执行核能执行的指令面与编码，供 code.tie（编译器）与
//   vm.tie（执行核）共用。指令面只覆盖 tsc 可产生的子集；白名单之外
//   的语法一律在编译期明确拒绝，不静默忽略。
// 编码：每条指令占 4 个 i64 槽——[op, a, b, c]，顺序存放在 code 表里；
//   pc 为指令序号（不是槽号），code[pc*4 + i] 取第 i 列。
//   a/b/c 的语义由 op 决定；未用的列填 0（不得依赖其值）。
// 槽：每个函数一帧，帧内从 0 开始编号；参数占 0..n-1，局部变量与
//   临时值依次分配。帧大小在编译期统计，装载期一次分配。
// 值：本文件只定义编码，值表示见 value.tie。
// ============================================================
namespace tiel;

// ---------- 控制 ----------
pub const OP_HALT: i64 = 0;      // 停机
pub const OP_NOP: i64 = 1;       // 空操作（调试占位）

// ---------- 常量加载 ----------
pub const OP_LOADI: i64 = 10;    // a=dst  b=整数立即数（i64 全宽）
pub const OP_LOADS: i64 = 11;    // a=dst  b=字符串常量索引
pub const OP_LOADB: i64 = 12;    // a=dst  b=0/1（布尔）
pub const OP_LOADNIL: i64 = 13;  // a=dst

// ---------- 数据搬运 ----------
pub const OP_MOV: i64 = 20;      // a=dst  b=src

// ---------- 一元运算 ----------
pub const OP_NEG: i64 = 30;      // a=dst  b=src
pub const OP_NOT: i64 = 31;      // a=dst  b=src
pub const OP_BNOT: i64 = 32;     // a=dst  b=src（按位取反）

// ---------- 二元算术 ----------
pub const OP_ADD: i64 = 40;
pub const OP_SUB: i64 = 41;
pub const OP_MUL: i64 = 42;
pub const OP_DIV: i64 = 43;
pub const OP_MOD: i64 = 44;
pub const OP_POW: i64 = 45;

// ---------- 二元位运算 ----------
pub const OP_BAND: i64 = 50;
pub const OP_BOR: i64 = 51;
pub const OP_BXOR: i64 = 52;
pub const OP_SHL: i64 = 53;
pub const OP_SHR: i64 = 54;

// ---------- 比较 ----------
pub const OP_EQ: i64 = 60;
pub const OP_NE: i64 = 61;
pub const OP_LT: i64 = 62;
pub const OP_LE: i64 = 63;
pub const OP_GT: i64 = 64;
pub const OP_GE: i64 = 65;

// ---------- 跳转 ----------
pub const OP_JMP: i64 = 70;      // a=目标 pc
pub const OP_JMPF: i64 = 71;     // a=目标 pc  b=条件槽
pub const OP_JMPT: i64 = 72;     // a=目标 pc  b=条件槽

// ---------- 调用 ----------
pub const OP_CALL: i64 = 80;     // a=dst  b=函数索引  c=实参起始槽
pub const OP_RET: i64 = 81;      // a=返回值槽（-1 表示 nil）

// ---------- 内建 ----------
pub const OP_PRINT: i64 = 90;    // a=值槽

// ---------- 聚合 ----------
// 数组在运行期是独立的对象池，值槽里存对象下标；无回收（见草案 §6）。
pub const OP_NEWARR: i64 = 100;  // a=dst  b=元素数  c=源连续槽起点
pub const OP_INDEX: i64 = 101;   // a=dst  b=数组槽  c=下标槽
pub const OP_LEN: i64 = 102;     // a=dst  b=源槽（数组取元素数，字符串取字节数）

// ---------- 编码常量 ----------
pub const OPSZ: i64 = 4;         // 每条指令占的 i64 槽数

// ---------- 值类型标记（value.tie 与 vm.tie 共用） ----------
pub const VT_NIL: i64 = 0;
pub const VT_INT: i64 = 1;
pub const VT_BOOL: i64 = 2;
pub const VT_STR: i64 = 3;
pub const VT_ARR: i64 = 4;       // 值 = 数组池下标
