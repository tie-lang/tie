type tie<class>
// tiel.tie —— tiel 包门面（嵌入集成入口；详见 tie.pkg）
// ============================================================
// 用法（tie 软件内源码级嵌入）：
//     import "<到 tiel 目录>/tiel.tie"
//     var err = tiel_check(src)          // 校验一段 tsc 源码
//     if str_len(err) > 0 { println(err); return 1 }
// 面：
//   tiel_check(src) -> string   —— 跑一遍前端（词法→语法）；返回 CLI 形态
//                                  错误行（error[E#####] @行:列: 消息。）；
//                                  通过则返回空串。
//   tiel_run(src) -> i64        —— 编译成内核字节码并执行；返回进程退出码
//                                  （0 = 正常结束）。错误文本见 tiel_err()。
//   tiel_err() -> string        —— 最近一次 tiel_run 的编译/运行错误（空 = 无）。
//   （结构账直接用 em_stats()；错误槽访问器见 emit.tie。）
// 说明：能力在各子文件——emit（表示层）/ lex（词法）/ parse（语法）/
//   code（字节码生成）/ vm（执行核）/ ops（指令表）/
//   emcodes（错误码表）/ render（CLI 形态拼装）；本文件只是聚合门面，
//   不引入新状态，也不改变任何子文件的行为。
import "./parse.tie"
import "./render.tie"
import "./emcodes.tie"
import "./emit.tie"
import "./lex.tie"
import "./code.tie"
namespace tiel;

// 校验一段源码：先全词法扫描（词法错即停），再语法解析。
// 返回错误行（CLI 形态）或空串（通过）。
pub func tiel_check(src: string) -> string {
    lx_start(src)
    var g: i64 = 0
    while g < 100000000 {
        if !lx_next() {
            return rd_err_slot()
        }
        if lx_kind() == K_EOF {
            break
        }
        g = g + 1
    }
    var r = ps_parse(src)
    if r < 0 || !em_ok() {
        return rd_err_slot()
    }
    return ""
}

// 编译并执行一段源码：返回进程退出码（0 = 正常结束）。
// 编译期拒绝与运行时错误都汇总到 tiel_err()。
pub func tiel_run(src: string) -> i64 {
    return cg_run(src)
}

// 最近一次 tiel_run 的编译/运行错误文本（空 = 无错）。
pub func tiel_err() -> string {
    if str_len(cg_err) > 0 {
        return cg_err
    }
    return vm_err
}
