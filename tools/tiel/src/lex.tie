type tie<class, unsafe:lock>
// lex.tie —— tiel 前端的流式词法器
// 文件级 lock 授权：tiel 会话单线程（嵌入面文档已注「非线程安全」）⇒ 表访问免锁。
// ============================================================
// 形态：游标 + 当前词元（拉取协议），不物化 token 表。
//   lx_start(src) / lx_start_at(src, off, line) 开启会话（源文本由 emit 层保留）
//   → lx_next() 逐个前进。
//   词元 = (kind, 行列, 源字节区段, 名 id)；行列自 1 起，列按码点计。
// ASI（自动分号；对齐现管线实测行为）：
//   换行处按「行尾词元」判定——为续行类时不断句，否则插入分号（分号位置
//   = 下一行行首，宽度为零）。续行类 =
//     运算符：+ - * / % = == != < > <= >= && || & | ^ << >> 及 += -= *= /=
//             %= &= |= ^= <<= >>=（%% ~ ++ -- ? -> <- 等行尾补分号）
//     分隔符：, : ; . .. ..= ... ( [ { } else in
//   括号深度只统计 ( 与 [；{ } 是块边界。（\ 后紧跟换行是行续行符，独立机制）
// 错误面：置入 emit 错误槽（首错即停）；消息文本对齐现管线。
// 简化（后续批次加深）：插值串整体扫描（内部表达式不产出词元）；
//   多行串的缩进剥离属值解析层。前缀 lx_。

import "./emit.tie"
import "./emcodes.tie"
namespace tiel;

// ---------- 词元 kind：基础 ----------
pub const K_EOF: i64 = 0;
pub const K_IDENT: i64 = 1;
pub const K_INT: i64 = 2;
pub const K_FLOAT: i64 = 3;
pub const K_STR: i64 = 4;        // 普通 / 原始 / 多行串
pub const K_INTERP: i64 = 5;     // 插值串（h"…"，整体扫描）
pub const K_CHAR: i64 = 6;

// ---------- 词元 kind：分隔符与括号 ----------
pub const K_LPAREN: i64 = 10;
pub const K_RPAREN: i64 = 11;
pub const K_LBRACKET: i64 = 12;
pub const K_RBRACKET: i64 = 13;
pub const K_LBRACE: i64 = 14;
pub const K_RBRACE: i64 = 15;
pub const K_COMMA: i64 = 16;
pub const K_SEMI: i64 = 17;
pub const K_COLON: i64 = 18;
pub const K_DOT: i64 = 19;
pub const K_DOTDOT: i64 = 20;
pub const K_DOTDOTEQ: i64 = 21;
pub const K_ELLIPSIS: i64 = 22;
pub const K_ARROW: i64 = 23;
pub const K_LARROW: i64 = 24;
pub const K_QUESTION: i64 = 25;
pub const K_QDOT: i64 = 26;
pub const K_QCOLON: i64 = 27;
pub const K_QBRACKET: i64 = 28;

// ---------- 词元 kind：运算符 ----------
pub const K_PLUS: i64 = 40;
pub const K_MINUS: i64 = 41;
pub const K_STAR: i64 = 42;
pub const K_SLASH: i64 = 43;
pub const K_PERCENT: i64 = 44;
pub const K_STARSTAR: i64 = 45;
pub const K_BACKSLASH: i64 = 46;
pub const K_PERCENTPERCENT: i64 = 47;
pub const K_EQEQ: i64 = 50;
pub const K_NOTEQ: i64 = 51;
pub const K_LT: i64 = 52;
pub const K_GT: i64 = 53;
pub const K_LE: i64 = 54;
pub const K_GE: i64 = 55;
pub const K_ANDAND: i64 = 56;
pub const K_OROR: i64 = 57;
pub const K_BANG: i64 = 58;
pub const K_AMP: i64 = 59;
pub const K_PIPE: i64 = 60;
pub const K_CARET: i64 = 61;
pub const K_SHL: i64 = 62;
pub const K_SHR: i64 = 63;
pub const K_TILDE: i64 = 64;
pub const K_INC: i64 = 65;
pub const K_DEC: i64 = 66;
pub const K_EQ: i64 = 70;
pub const K_PLUSEQ: i64 = 71;
pub const K_MINUSEQ: i64 = 72;
pub const K_STAREQ: i64 = 73;
pub const K_SLASHEQ: i64 = 74;
pub const K_PERCENTEQ: i64 = 75;
pub const K_PERCENTPPEQ: i64 = 76;
pub const K_BACKSLASHEQ: i64 = 77;
pub const K_AMPEQ: i64 = 78;
pub const K_PIPEEQ: i64 = 79;
pub const K_CARETEQ: i64 = 80;
pub const K_SHLEQ: i64 = 81;
pub const K_SHREQ: i64 = 82;

// ---------- 词元 kind：关键字（升序表配套） ----------
pub const KW_ALIAS: i64 = 100;
pub const KW_ANY: i64 = 101;
pub const KW_AS: i64 = 102;
pub const KW_BOOL: i64 = 103;
pub const KW_BREAK: i64 = 104;
pub const KW_CASE: i64 = 105;
pub const KW_CHAR: i64 = 106;
pub const KW_CONST: i64 = 107;
pub const KW_CONTINUE: i64 = 108;
pub const KW_DEFAULT: i64 = 109;
pub const KW_ELSE: i64 = 110;
pub const KW_ENUM: i64 = 111;
pub const KW_F32: i64 = 112;
pub const KW_F64: i64 = 113;
pub const KW_FALSE: i64 = 114;
pub const KW_FOR: i64 = 115;
pub const KW_FUNC: i64 = 116;
pub const KW_I128: i64 = 117;
pub const KW_I16: i64 = 118;
pub const KW_I32: i64 = 119;
pub const KW_I64: i64 = 120;
pub const KW_I8: i64 = 121;
pub const KW_IF: i64 = 122;
pub const KW_IMMUT: i64 = 123;
pub const KW_IMPORT: i64 = 124;
pub const KW_IN: i64 = 125;
pub const KW_IS: i64 = 126;
pub const KW_MAP: i64 = 127;
pub const KW_MISC: i64 = 128;
pub const KW_NAMESPACE: i64 = 129;
pub const KW_NUM: i64 = 130;
pub const KW_PANIC: i64 = 131;
pub const KW_PUB: i64 = 132;
pub const KW_REF: i64 = 133;
pub const KW_RETURN: i64 = 134;
pub const KW_STRING: i64 = 135;
pub const KW_SWITCH: i64 = 136;
pub const KW_TABLE: i64 = 137;
pub const KW_TEXT: i64 = 138;
pub const KW_TRIT: i64 = 139;
pub const KW_TRUE: i64 = 140;
pub const KW_U128: i64 = 141;
pub const KW_U16: i64 = 142;
pub const KW_U32: i64 = 143;
pub const KW_U64: i64 = 144;
pub const KW_U8: i64 = 145;
pub const KW_USING: i64 = 146;
pub const KW_VAR: i64 = 147;
pub const KW_VOID: i64 = 148;
pub const KW_WHILE: i64 = 149;
pub const KW_ZERO: i64 = 150;

// ---------- 关键字表（严格升序；二分查找） ----------
pub var lx_kw_keys: table<string> = ["alias", "any", "as", "bool", "break", "case",
    "char", "const", "continue", "default", "else", "enum", "f32", "f64", "false",
    "for", "func", "i128", "i16", "i32", "i64", "i8", "if", "immut", "import", "in",
    "is", "map", "misc", "namespace", "num", "panic", "pub", "ref", "return", "string",
    "switch", "table", "text", "trit", "true", "u128", "u16", "u32", "u64", "u8",
    "using", "var", "void", "while", "zero"];
pub var lx_kw_vals: table<i64> = [KW_ALIAS, KW_ANY, KW_AS, KW_BOOL, KW_BREAK, KW_CASE,
    KW_CHAR, KW_CONST, KW_CONTINUE, KW_DEFAULT, KW_ELSE, KW_ENUM, KW_F32, KW_F64, KW_FALSE,
    KW_FOR, KW_FUNC, KW_I128, KW_I16, KW_I32, KW_I64, KW_I8, KW_IF, KW_IMMUT, KW_IMPORT, KW_IN,
    KW_IS, KW_MAP, KW_MISC, KW_NAMESPACE, KW_NUM, KW_PANIC, KW_PUB, KW_REF, KW_RETURN, KW_STRING,
    KW_SWITCH, KW_TABLE, KW_TEXT, KW_TRIT, KW_TRUE, KW_U128, KW_U16, KW_U32, KW_U64, KW_U8,
    KW_USING, KW_VAR, KW_VOID, KW_WHILE, KW_ZERO];

// ---------- 会话状态 ----------
var lx_src: string = "";
var lx_n: i64 = 0;             // 源总字节数
var lx_pos: i64 = 0;
var lx_cur_line: i64 = 1;
var lx_cur_col: i64 = 1;
var lx_paren: i64 = 0;         // 括号深度（只统计 ( 与 [）
var lx_last_tag: i64 = -1;     // 本行最后词元
var lx_has_tok: bool = false;  // 本行已有词元
var lx_unesc: string = "";     // 未知转义字符暂存（串扫描填充）
var lx_ss: table<i64> = [];       // 位置快照栈（探测回退；每层 6 个标量）
var lx_sss: table<string> = [];   // 位置快照栈（每层 unesc）

// 当前词元
var lx_tag: i64 = 0;
var lx_t_line: i64 = 0;
var lx_t_col: i64 = 0;
var lx_t_off: i64 = 0;
var lx_t_len: i64 = 0;
var lx_t_id: i64 = -1;

// ---------- 基础访问 ----------
func lx_byte(i: i64) -> i64 {
    return str_byte(lx_src, i)
}

func lx_peek(k: i64) -> i64 {
    if lx_pos + k < lx_n {
        return str_byte(lx_src, lx_pos + k)
    }
    return -1
}

// 前进一个字节（列按码点计：UTF-8 延续字节不加列）
func lx_adv1() {
    var b = str_byte(lx_src, lx_pos)
    lx_pos = lx_pos + 1
    if b < 128 || b >= 192 {
        lx_cur_col = lx_cur_col + 1
    }
}

// 前进过换行（行 +1、列回 1）
func lx_adv_nl() {
    lx_pos = lx_pos + 1
    lx_cur_line = lx_cur_line + 1
    lx_cur_col = 1
}

func lx_advan(k: i64) {
    var i: i64 = 0
    while i < k {
        lx_adv1()
        i = i + 1
    }
}

// ---------- 字符分类 ----------
func lx_is_digit(b: i64) -> bool {
    return b >= 48 && b <= 57
}

func lx_is_hex(b: i64) -> bool {
    if b >= 48 && b <= 57 {
        return true
    }
    if b >= 97 && b <= 102 {
        return true
    }
    if b >= 65 && b <= 70 {
        return true
    }
    return false
}

func lx_is_alpha(b: i64) -> bool {
    if b >= 97 && b <= 122 {
        return true
    }
    if b >= 65 && b <= 90 {
        return true
    }
    return b > 127
}

func lx_is_ident_cont(b: i64) -> bool {
    return lx_is_digit(b) || lx_is_alpha(b) || b == 95
}

// ---------- 词元发射 ----------
func lx_emit_span(tag: i64, off: i64, end: i64, line: i64, col: i64) {
    lx_tag = tag
    lx_t_off = off
    lx_t_len = end - off
    lx_t_line = line
    lx_t_col = col
    lx_t_id = -1
    lx_has_tok = true
    if tag == K_LPAREN || tag == K_LBRACKET {
        lx_paren = lx_paren + 1
    }
    if tag == K_RPAREN || tag == K_RBRACKET {
        if lx_paren > 0 {
            lx_paren = lx_paren - 1
        }
    }
    lx_last_tag = tag
}

// ---------- ASI ----------
// 行尾词元是否属于「续行类」（不插分号）
func lx_cont_tag(t: i64) -> bool {
    if t >= K_PLUS && t <= K_PERCENT {
        return true
    }
    if t >= K_EQEQ && t <= K_OROR {
        return true
    }
    if t >= K_AMP && t <= K_SHR {
        return true
    }
    if t >= K_EQ && t <= K_PERCENTEQ {
        return true
    }
    if t >= K_AMPEQ && t <= K_SHREQ {
        return true
    }
    if t == K_BACKSLASH {
        return true
    }
    if t == K_LPAREN || t == K_LBRACKET || t == K_LBRACE || t == K_RBRACE {
        return true
    }
    if t == K_COMMA || t == K_SEMI || t == K_COLON || t == K_DOT {
        return true
    }
    if t == K_DOTDOT || t == K_DOTDOTEQ || t == K_ELLIPSIS {
        return true
    }
    if t == KW_ELSE || t == KW_IN {
        return true
    }
    return false
}

// 换行处的 ASI 判定（在 \n 消费之后调用；pos/line/col 已是下一行行首）
func lx_asi_after_nl() {
    var should = false
    if lx_has_tok {
        if lx_paren == 0 {
            if lx_last_tag >= 0 {
                if !lx_cont_tag(lx_last_tag) {
                    should = true
                }
            }
        }
    }
    if should {
        lx_emit_span(K_SEMI, lx_pos, lx_pos, lx_cur_line, lx_cur_col)
    }
    lx_has_tok = false
    lx_last_tag = -1
}

// ---------- 会话开启 ----------
pub func lx_start(src: string) {
    lx_start_at(src, 0, 1)
}

// 从源内偏移 off 起跑（行号以 line 计）：供语法层跳过头部区后直接起跑
// （与「保行剥离后整文词法」等价，但免整文拷贝）。
pub func lx_start_at(src: string, off: i64, line: i64) {
    em_set_src(src)
    em_clear_err()
    lx_src = src
    lx_n = len(src)
    lx_pos = off
    lx_cur_line = line
    lx_cur_col = 1
    lx_paren = 0
    lx_last_tag = -1
    lx_has_tok = false
    lx_tag = K_EOF
    lx_t_line = 1
    lx_t_col = 1
    lx_t_off = 0
    lx_t_len = 0
    lx_t_id = -1
    table_trunc(lx_ss, 0)
    table_trunc(lx_sss, 0)
}

// ---------- 位置快照（供解析层探测回退；栈式、save/restore 配对、可嵌套） ----------
pub func lx_save() {
    table_push(lx_ss, lx_pos)
    table_push(lx_ss, lx_cur_line)
    table_push(lx_ss, lx_cur_col)
    table_push(lx_ss, lx_paren)
    table_push(lx_ss, lx_last_tag)
    var ht: i64 = 0
    if lx_has_tok {
        ht = 1
    }
    table_push(lx_ss, ht)
    table_push(lx_sss, lx_unesc)
}

pub func lx_restore() {
    var n = len(lx_ss)
    if n < 6 {
        return
    }
    var ht = lx_ss[n - 1]
    var lt = lx_ss[n - 2]
    var lpar = lx_ss[n - 3]
    var lc = lx_ss[n - 4]
    var ll = lx_ss[n - 5]
    var lp = lx_ss[n - 6]
    var i: i64 = 0
    while i < 6 {
        table_pop(lx_ss)
        i = i + 1
    }
    var un: string = ""
    if len(lx_sss) > 0 {
        un = lx_sss[len(lx_sss) - 1]
        table_pop(lx_sss)
    }
    lx_pos = lp
    lx_cur_line = ll
    lx_cur_col = lc
    lx_paren = lpar
    lx_last_tag = lt
    if ht == 1 {
        lx_has_tok = true
    } else {
        lx_has_tok = false
    }
    lx_unesc = un
}

// ---------- 当前词元访问器 ----------
pub func lx_kind() -> i64 {
    return lx_tag
}

pub func lx_line() -> i64 {
    return lx_t_line
}

pub func lx_col() -> i64 {
    return lx_t_col
}

pub func lx_pos_off() -> i64 {
    return lx_t_off
}

pub func lx_pos_len() -> i64 {
    return lx_t_len
}

pub func lx_nameid() -> i64 {
    return lx_t_id
}

pub func lx_text() -> string {
    return str_sub_bytes(lx_src, lx_t_off, lx_t_off + lx_t_len)
}

// ---------- 关键字查找（二分） ----------
func lx_kw_find(s: string) -> i64 {
    var lo: i64 = 0
    var hi: i64 = len(lx_kw_keys) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        var k = lx_kw_keys[mid]
        if k == s {
            return lx_kw_vals[mid]
        }
        if k < s {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

// 关键字规范文本（kind → 关键字表文本；非关键字返回空串）。
// kw 值连续 100..150 ⇒ 下标 = kind - KW_ALIAS（与 lx_kw_keys 的升序一一对应）。
pub func lx_kw_text(k: i64) -> string {
    var i = k - KW_ALIAS
    if i < 0 || i >= len(lx_kw_keys) {
        return ""
    }
    return lx_kw_keys[i]
}

// ---------- 标识符 / 关键字 ----------
func lx_scan_ident() -> i64 {
    var so = lx_pos
    var sl = lx_cur_line
    var sc = lx_cur_col
    // 就地扫描（免逐字节 lx_adv1 调用）：接受集与 lx_is_ident_cont 一致；
    // 列按码点计（续字节 128..191 不计列）。
    var p = lx_pos
    var col = lx_cur_col
    while p < lx_n {
        var b = str_byte(lx_src, p)
        if !(b >= 48 && b <= 57) && !(b >= 97 && b <= 122) && !(b >= 65 && b <= 90) && b != 95 && b <= 127 {
            break
        }
        p = p + 1
        if b < 128 || b >= 192 {
            col = col + 1
        }
    }
    lx_pos = p
    lx_cur_col = col
    var txt = str_sub_bytes(lx_src, so, lx_pos)
    var kw = lx_kw_find(txt)
    if kw >= 0 {
        lx_emit_span(kw, so, lx_pos, sl, sc)
    } else {
        lx_emit_span(K_IDENT, so, lx_pos, sl, sc)
        lx_t_id = em_nameid(txt)
    }
    return 1
}

// ---------- 数值字面量 ----------
// 类型后缀（i8…u128 / f32 / f64）：命中关键字表才算后缀，否则回退
// （十进制与各进制共用）
func lx_try_suffix() {
    if lx_pos < lx_n {
        if lx_is_ident_cont(lx_byte(lx_pos)) {
            var sso = lx_pos
            while lx_pos < lx_n {
                if !lx_is_ident_cont(lx_byte(lx_pos)) {
                    break
                }
                lx_adv1()
            }
            var suf = str_sub_bytes(lx_src, sso, lx_pos)
            if lx_kw_find(suf) < 0 {
                lx_pos = sso
            }
        }
    }
}

func lx_scan_number() -> i64 {
    var so = lx_pos
    var sl = lx_cur_line
    var sc = lx_cur_col
    var is_float = false
    var b0 = lx_byte(lx_pos)
    if b0 == 48 {
        var b1 = lx_peek(1)
        if b1 == 120 || b1 == 88 {            // 0x 十六进制
            lx_advan(2)
            while lx_pos < lx_n {
                var c = lx_byte(lx_pos)
                if lx_is_hex(c) || c == 95 {
                    lx_adv1()
                } else {
                    break
                }
            }
            lx_try_suffix()
            lx_emit_span(K_INT, so, lx_pos, sl, sc)
            return 1
        }
        if b1 == 98 || b1 == 66 {             // 0b 二进制
            lx_advan(2)
            while lx_pos < lx_n {
                var c2 = lx_byte(lx_pos)
                if c2 == 48 || c2 == 49 || c2 == 95 {
                    lx_adv1()
                } else {
                    break
                }
            }
            lx_try_suffix()
            lx_emit_span(K_INT, so, lx_pos, sl, sc)
            return 1
        }
        if b1 == 111 || b1 == 79 {            // 0o 八进制
            lx_advan(2)
            while lx_pos < lx_n {
                var c3 = lx_byte(lx_pos)
                if (c3 >= 48 && c3 <= 55) || c3 == 95 {
                    lx_adv1()
                } else {
                    break
                }
            }
            lx_try_suffix()
            lx_emit_span(K_INT, so, lx_pos, sl, sc)
            return 1
        }
        if b1 == 116 || b1 == 84 {            // 0t 平衡三进制
            lx_advan(2)
            while lx_pos < lx_n {
                var c4 = lx_byte(lx_pos)
                if c4 == 48 || c4 == 49 || c4 == 84 || c4 == 95 {
                    lx_adv1()
                } else {
                    break
                }
            }
            lx_try_suffix()
            lx_emit_span(K_INT, so, lx_pos, sl, sc)
            return 1
        }
    }
    // 十进制整数部分
    while lx_pos < lx_n {
        var c5 = lx_byte(lx_pos)
        if lx_is_digit(c5) || c5 == 95 {
            lx_adv1()
        } else {
            break
        }
    }
    // 小数点（排除 '..' 区间运算符）
    if lx_pos < lx_n {
        if lx_byte(lx_pos) == 46 && lx_peek(1) != 46 {
            is_float = true
            lx_adv1()
            while lx_pos < lx_n {
                var c6 = lx_byte(lx_pos)
                if lx_is_digit(c6) || c6 == 95 {
                    lx_adv1()
                } else {
                    break
                }
            }
        }
    }
    // 指数
    if lx_pos < lx_n {
        var ce = lx_byte(lx_pos)
        if ce == 101 || ce == 69 {
            var p1 = lx_peek(1)
            if lx_is_digit(p1) || p1 == 43 || p1 == 45 {
                is_float = true
                lx_adv1()
                if lx_peek(0) == 43 || lx_peek(0) == 45 {
                    lx_adv1()
                }
                while lx_pos < lx_n {
                    var c7 = lx_byte(lx_pos)
                    if lx_is_digit(c7) {
                        lx_adv1()
                    } else {
                        break
                    }
                }
            }
        }
    }
    lx_try_suffix()
    if is_float {
        lx_emit_span(K_FLOAT, so, lx_pos, sl, sc)
    } else {
        lx_emit_span(K_INT, so, lx_pos, sl, sc)
    }
    return 1
}

// ---------- 插值串的嵌套跳过 ----------
// 跳过一段嵌套普通串（已消费开引号；转义处理同普通串）
func lx_skip_nested_str() -> i64 {
    while lx_pos < lx_n {
        var b = lx_byte(lx_pos)
        if b == 34 {
            lx_adv1()
            return 1
        }
        if b == 92 {
            lx_adv1()
            if lx_pos < lx_n {
                if lx_byte(lx_pos) == 10 {
                    lx_adv_nl()
                } else {
                    lx_adv1()
                }
            }
        } else if b == 10 {
            lx_adv_nl()
        } else {
            lx_adv1()
        }
    }
    return -1
}

func lx_skip_nested_char() -> i64 {
    while lx_pos < lx_n {
        var b = lx_byte(lx_pos)
        if b == 39 {
            lx_adv1()
            return 1
        }
        if b == 10 {
            return -1
        }
        lx_adv1()
    }
    return -1
}

// 跳过插值表达式段（从 '{' 之后开始，跳至配对的 '}' 之后）
func lx_skip_interp_expr() -> i64 {
    var depth: i64 = 1
    while depth > 0 {
        if lx_pos >= lx_n {
            return -1
        }
        var b = lx_byte(lx_pos)
        if b == 123 {
            depth = depth + 1
            lx_adv1()
        } else if b == 125 {
            depth = depth - 1
            lx_adv1()
        } else if b == 34 {
            lx_adv1()
            var r = lx_skip_nested_str()
            if r < 0 {
                return -1
            }
        } else if b == 39 {
            lx_adv1()
            var r2 = lx_skip_nested_char()
            if r2 < 0 {
                return -1
            }
        } else if b == 47 && lx_peek(1) == 47 {
            while lx_pos < lx_n {
                if lx_byte(lx_pos) == 10 {
                    break
                }
                lx_adv1()
            }
        } else if b == 10 {
            lx_adv_nl()
        } else {
            lx_adv1()
        }
    }
    return 1
}

// ---------- 字符串体（引号已消费；raw=1 不做转义处理） ----------
func lx_scan_str_body(kind: i64, raw: i64) -> i64 {
    while lx_pos < lx_n {
        var b = lx_byte(lx_pos)
        if b == 34 {
            lx_adv1()
            return 1
        }
        if b == 92 {
            if raw == 1 {
                lx_adv1()
                continue
            }
            lx_adv1()
            if lx_pos >= lx_n {
                return -2                       // 转义符后缺少字符（EOF）
            }
            var e = lx_byte(lx_pos)
            if e == 110 || e == 116 || e == 114 || e == 92 || e == 34 || e == 39 || e == 48 {
                lx_adv1()
            } else {
                lx_unesc = str_from_code(e)
                return -4                       // 未知转义序列（含 `\`+换行）
            }
            continue
        }
        if b == 10 {
            lx_adv_nl()                         // 普通/插值串可跨行（闭合引号为准）
            continue
        }
        if kind == K_INTERP && b == 123 {       // '{'：插值段或字面 '{{'
            if lx_peek(1) == 123 {
                lx_advan(2)
                continue
            }
            lx_adv1()
            var r = lx_skip_interp_expr()
            if r < 0 {
                return -5
            }
            continue
        }
        if kind == K_INTERP && b == 125 {       // '}}' 字面右花括号
            if lx_peek(1) == 125 {
                lx_advan(2)
                continue
            }
            lx_adv1()
            continue
        }
        // 常规字符快进（免 lx_adv1 调用）
        lx_pos = lx_pos + 1
        if b < 128 || b >= 192 {
            lx_cur_col = lx_cur_col + 1
        }
    }
    return -3                                   // EOF（未闭合）
}

// 三引号多行串（开引号已消费）：找闭合 """；转义照常处理
func lx_scan_triple() -> i64 {
    while lx_pos < lx_n {
        var b = lx_byte(lx_pos)
        if b == 34 && lx_peek(1) == 34 && lx_peek(2) == 34 {
            lx_advan(3)
            return 1
        }
        if b == 92 {
            lx_adv1()
            if lx_pos >= lx_n {
                return -2
            }
            var e = lx_byte(lx_pos)
            if e == 110 || e == 116 || e == 114 || e == 92 || e == 34 || e == 39 || e == 48 {
                lx_adv1()
            } else if e == 10 {
                lx_adv_nl()
            } else {
                lx_unesc = str_from_code(e)
                return -4
            }
            continue
        }
        if b == 10 {
            lx_adv_nl()
        } else {
            // 常规字符快进（免 lx_adv1 调用）
            lx_pos = lx_pos + 1
            if b < 128 || b >= 192 {
                lx_cur_col = lx_cur_col + 1
            }
        }
    }
    return -1
}

// ---------- 字符字面量 ----------
func lx_scan_char() -> i64 {
    var so = lx_pos
    var sl = lx_cur_line
    var sc = lx_cur_col
    lx_adv1()                                   // 开单引号
    if lx_pos >= lx_n {
        em_fail_lex(sl, sc, "字符字面量未闭合")
        return -1
    }
    var b = lx_byte(lx_pos)
    if b == 10 {
        em_fail_lex(sl, sc, "字符字面量未闭合")
        return -1
    }
    if b == 92 {                                // 转义字符
        lx_adv1()
        if lx_pos >= lx_n {
            em_fail_lex(sl, sc, "转义符后缺少字符")
            return -1
        }
        var e = lx_byte(lx_pos)
        if e == 110 || e == 116 || e == 114 || e == 92 || e == 34 || e == 39 || e == 48 {
            lx_adv1()
        } else {
            em_fail_lex(sl, sc, "未知转义序列 \\" + str_from_code(e))
            return -1
        }
    } else {
        lx_adv1()
        // 多字节码点：吃续字节（续字节不进列）
        while lx_pos < lx_n {
            var cb = lx_byte(lx_pos)
            if cb >= 128 && cb <= 191 {
                lx_pos = lx_pos + 1
            } else {
                break
            }
        }
    }
    if lx_pos >= lx_n {
        em_fail_lex(sl, sc, "字符字面量未闭合")
        return -1
    }
    if lx_byte(lx_pos) != 39 {
        em_fail_lex(sl, sc, "字符字面量只能包含一个字符")
        return -1
    }
    lx_adv1()                                   // 闭单引号
    lx_emit_span(K_CHAR, so, lx_pos, sl, sc)
    return 1
}

// 当前字节处一个完整码点的文本（用于无法识别字符的显示）
func lx_cur_cp() -> string {
    var b = lx_byte(lx_pos)
    var k: i64 = 1
    if b >= 240 {
        k = 4
    } else if b >= 224 {
        k = 3
    } else if b >= 192 {
        k = 2
    }
    if lx_pos + k > lx_n {
        k = lx_n - lx_pos
    }
    return str_sub_bytes(lx_src, lx_pos, lx_pos + k)
}

// ---------- 符号 ----------
func lx_scan_symbol() -> i64 {
    var so = lx_pos
    var sl = lx_cur_line
    var sc = lx_cur_col
    var b = lx_byte(lx_pos)
    if b == 46 {                                // '.'
        if lx_peek(1) == 46 {
            if lx_peek(2) == 46 {
                lx_advan(3)
                lx_emit_span(K_ELLIPSIS, so, lx_pos, sl, sc)
                return 1
            }
            if lx_peek(2) == 61 {
                lx_advan(3)
                lx_emit_span(K_DOTDOTEQ, so, lx_pos, sl, sc)
                return 1
            }
            lx_advan(2)
            lx_emit_span(K_DOTDOT, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_DOT, so, lx_pos, sl, sc)
        return 1
    }
    if b == 37 {                                // '%'
        if lx_peek(1) == 37 {
            if lx_peek(2) == 61 {
                lx_advan(3)
                lx_emit_span(K_PERCENTPPEQ, so, lx_pos, sl, sc)
                return 1
            }
            lx_advan(2)
            lx_emit_span(K_PERCENTPERCENT, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_PERCENTEQ, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_PERCENT, so, lx_pos, sl, sc)
        return 1
    }
    if b == 60 {                                // '<'
        if lx_peek(1) == 60 {
            if lx_peek(2) == 61 {
                lx_advan(3)
                lx_emit_span(K_SHLEQ, so, lx_pos, sl, sc)
                return 1
            }
            lx_advan(2)
            lx_emit_span(K_SHL, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_LE, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 45 {
            lx_advan(2)
            lx_emit_span(K_LARROW, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_LT, so, lx_pos, sl, sc)
        return 1
    }
    if b == 62 {                                // '>'
        if lx_peek(1) == 62 {
            if lx_peek(2) == 61 {
                lx_advan(3)
                lx_emit_span(K_SHREQ, so, lx_pos, sl, sc)
                return 1
            }
            lx_advan(2)
            lx_emit_span(K_SHR, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_GE, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_GT, so, lx_pos, sl, sc)
        return 1
    }
    if b == 43 {                                // '+'
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_PLUSEQ, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 43 {
            lx_advan(2)
            lx_emit_span(K_INC, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_PLUS, so, lx_pos, sl, sc)
        return 1
    }
    if b == 45 {                                // '-'
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_MINUSEQ, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 45 {
            lx_advan(2)
            lx_emit_span(K_DEC, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 62 {
            lx_advan(2)
            lx_emit_span(K_ARROW, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_MINUS, so, lx_pos, sl, sc)
        return 1
    }
    if b == 42 {                                // '*'
        if lx_peek(1) == 42 {
            lx_advan(2)
            lx_emit_span(K_STARSTAR, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_STAREQ, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_STAR, so, lx_pos, sl, sc)
        return 1
    }
    if b == 47 {                                // '/'（含 /=；注释已由 slash 分派处理）
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_SLASHEQ, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_SLASH, so, lx_pos, sl, sc)
        return 1
    }
    if b == 61 {                                // '='
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_EQEQ, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 62 {                   // '=>' 已移除
            em_fail_lex(sl, sc, "`=>` 已移除，请用 `->`")
            return -1
        }
        lx_adv1()
        lx_emit_span(K_EQ, so, lx_pos, sl, sc)
        return 1
    }
    if b == 33 {                                // '!'
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_NOTEQ, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_BANG, so, lx_pos, sl, sc)
        return 1
    }
    if b == 38 {                                // '&'
        if lx_peek(1) == 38 {
            lx_advan(2)
            lx_emit_span(K_ANDAND, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_AMPEQ, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_AMP, so, lx_pos, sl, sc)
        return 1
    }
    if b == 124 {                               // '|'
        if lx_peek(1) == 124 {
            lx_advan(2)
            lx_emit_span(K_OROR, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_PIPEEQ, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_PIPE, so, lx_pos, sl, sc)
        return 1
    }
    if b == 94 {                                // '^'
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_CARETEQ, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_CARET, so, lx_pos, sl, sc)
        return 1
    }
    if b == 126 {                               // '~'
        lx_adv1()
        lx_emit_span(K_TILDE, so, lx_pos, sl, sc)
        return 1
    }
    if b == 63 {                                // '?'
        if lx_peek(1) == 46 {
            lx_advan(2)
            lx_emit_span(K_QDOT, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 58 {
            lx_advan(2)
            lx_emit_span(K_QCOLON, so, lx_pos, sl, sc)
            return 1
        }
        if lx_peek(1) == 91 {
            lx_advan(2)
            lx_emit_span(K_QBRACKET, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_QUESTION, so, lx_pos, sl, sc)
        return 1
    }
    if b == 92 {                                // '\'
        if lx_peek(1) == 61 {
            lx_advan(2)
            lx_emit_span(K_BACKSLASHEQ, so, lx_pos, sl, sc)
            return 1
        }
        lx_adv1()
        lx_emit_span(K_BACKSLASH, so, lx_pos, sl, sc)
        return 1
    }
    if b == 58 {                                // ':'
        lx_adv1()
        lx_emit_span(K_COLON, so, lx_pos, sl, sc)
        return 1
    }
    if b == 44 {                                // ','
        lx_adv1()
        lx_emit_span(K_COMMA, so, lx_pos, sl, sc)
        return 1
    }
    if b == 59 {                                // ';'
        lx_adv1()
        lx_emit_span(K_SEMI, so, lx_pos, sl, sc)
        return 1
    }
    if b == 40 {                                // '('
        lx_adv1()
        lx_emit_span(K_LPAREN, so, lx_pos, sl, sc)
        return 1
    }
    if b == 41 {                                // ')'
        lx_adv1()
        lx_emit_span(K_RPAREN, so, lx_pos, sl, sc)
        return 1
    }
    if b == 91 {                                // '['
        lx_adv1()
        lx_emit_span(K_LBRACKET, so, lx_pos, sl, sc)
        return 1
    }
    if b == 93 {                                // ']'
        lx_adv1()
        lx_emit_span(K_RBRACKET, so, lx_pos, sl, sc)
        return 1
    }
    if b == 123 {                               // '{'
        lx_adv1()
        lx_emit_span(K_LBRACE, so, lx_pos, sl, sc)
        return 1
    }
    if b == 125 {                               // '}'
        lx_adv1()
        lx_emit_span(K_RBRACE, so, lx_pos, sl, sc)
        return 1
    }
    // 无法识别：取一个完整码点的原文本
    var bad = lx_cur_cp()
    em_fail_lex(sl, sc, "无法识别的字符 '" + bad + "'")
    return -1
}

// ---------- 注释与除号分派 ----------
func lx_scan_slash() -> i64 {
    var b1 = lx_peek(1)
    if b1 == 47 {                               // 行注释（含 ///）
        while lx_pos < lx_n {
            var cb = str_byte(lx_src, lx_pos)
            if cb == 10 {
                break
            }
            lx_pos = lx_pos + 1
            if cb < 128 || cb >= 192 {
                lx_cur_col = lx_cur_col + 1
            }
        }
        return 0
    }
    if b1 == 42 {                               // 块注释
        var sl = lx_cur_line
        var sc = lx_cur_col
        lx_advan(2)
        while true {
            if lx_pos >= lx_n {
                em_fail_lex(sl, sc, "块注释未闭合")
                return -1
            }
            var b = lx_byte(lx_pos)
            if b == 42 && lx_peek(1) == 47 {
                lx_advan(2)
                return 0
            }
            if b == 10 {
                lx_adv_nl()
            } else {
                lx_adv1()
            }
        }
        return 0
    }
    // 除号族：/ 与 /=
    return lx_scan_symbol()
}

// ---------- 主推进 ----------
pub func lx_next() -> bool {
    while true {
        if lx_pos >= lx_n {
            lx_emit_span(K_EOF, lx_pos, lx_pos, lx_cur_line, lx_cur_col)
            return true
        }
        var b = lx_byte(lx_pos)
        if b == 10 {                            // 换行：ASI 判定
            lx_adv_nl()
            lx_asi_after_nl()
            if lx_tag == K_SEMI {
                return true
            }
            continue
        }
        if b == 32 || b == 9 || b == 13 {
            // 空白段快进（免逐字节调用；三者皆 ASCII ⇒ 每字节计一列）
            while lx_pos < lx_n {
                var wb = str_byte(lx_src, lx_pos)
                if wb != 32 && wb != 9 && wb != 13 {
                    break
                }
                lx_pos = lx_pos + 1
                lx_cur_col = lx_cur_col + 1
            }
            continue
        }
        if b == 47 {                            // '/'
            var r0 = lx_scan_slash()
            if r0 < 0 {
                return false
            }
            if r0 == 0 {
                continue
            }
            return true
        }
        if b == 92 {                            // '\' 行续行符
            var b1 = lx_peek(1)
            if b1 == 10 {
                lx_adv1()
                lx_adv_nl()
                continue
            }
            if b1 == 13 {
                lx_adv1()
                lx_adv1()
                if lx_pos < lx_n && lx_byte(lx_pos) == 10 {
                    lx_adv_nl()
                } else {
                    lx_cur_line = lx_cur_line + 1
                    lx_cur_col = 1
                }
                continue
            }
            var r1 = lx_scan_symbol()
            if r1 < 0 {
                return false
            }
            return true
        }
        // r" 原始串 / h" 插值串（h 与 r 仅在紧贴引号时特殊识别）
        if (b == 114 || b == 104) && lx_peek(1) == 34 {
            var sl = lx_cur_line
            var sc = lx_cur_col
            var so = lx_pos
            var kind2 = K_STR
            if b == 104 {
                kind2 = K_INTERP
            }
            lx_adv1()                           // 前缀字母
            lx_adv1()                           // 开引号
            var raw1: i64 = 0
            if b == 114 {
                raw1 = 1
            }
            var r2 = lx_scan_str_body(kind2, raw1)
            if r2 == -2 {
                em_fail_lex(sl, sc, "转义符后缺少字符")
                return false
            }
            if r2 == -4 {
                em_fail_lex(sl, sc, "未知转义序列 \\" + lx_unesc)
                return false
            }
            if r2 < 0 {
                em_fail_lex(sl, sc, "字符串未闭合")
                return false
            }
            lx_emit_span(kind2, so, lx_pos, sl, sc)
            return true
        }
        if b == 34 {                            // 普通串 / 三引号
            var sl3 = lx_cur_line
            var sc3 = lx_cur_col
            var so3 = lx_pos
            if lx_peek(1) == 34 && lx_peek(2) == 34 {
                lx_advan(3)
                var r3 = lx_scan_triple()
                if r3 == -2 {
                    em_fail_lex(sl3, sc3, "转义符后缺少字符")
                    return false
                }
                if r3 == -4 {
                    em_fail_lex(sl3, sc3, "未知转义序列 \\" + lx_unesc)
                    return false
                }
                if r3 < 0 {
                    em_fail_lex(sl3, sc3, "字符串未闭合")
                    return false
                }
                lx_emit_span(K_STR, so3, lx_pos, sl3, sc3)
                return true
            }
            lx_adv1()
            var r4 = lx_scan_str_body(K_STR, 0)
            if r4 == -2 {
                em_fail_lex(sl3, sc3, "转义符后缺少字符")
                return false
            }
            if r4 == -4 {
                em_fail_lex(sl3, sc3, "未知转义序列 \\" + lx_unesc)
                return false
            }
            if r4 < 0 {
                em_fail_lex(sl3, sc3, "字符串未闭合")
                return false
            }
            lx_emit_span(K_STR, so3, lx_pos, sl3, sc3)
            return true
        }
        if b == 39 {                            // 字符
            var r5 = lx_scan_char()
            if r5 < 0 {
                return false
            }
            return true
        }
        if lx_is_digit(b) {                     // 数字
            var r6 = lx_scan_number()
            if r6 < 0 {
                return false
            }
            return true
        }
        if b == 95 || lx_is_alpha(b) {          // 标识符 / 关键字
            var r7 = lx_scan_ident()
            if r7 < 0 {
                return false
            }
            return true
        }
        var r8 = lx_scan_symbol()
        if r8 < 0 {
            return false
        }
        return true
    }
}
