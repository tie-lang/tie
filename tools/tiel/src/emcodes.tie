type tie<class>
namespace tiel;
// emcodes.tie —— tiel 错误码表（E 码查询；tie Error Code）
// ============================================================
// 职责：把前端错误消息映射为 E 码，供 error[E#####] 形态呈现（见 render.tie）。
//   * ec_norm：归一化——ASCII 0x20..0x7E 连续运行折叠为单个 '%'
//     （与 tiec diagcode 的归一化一致；空格在内）；
//   * ec_lookup：exact（等值）→ prefix（最长前缀）→ E00000 兜底。
// 表内容 = tiel 报错点消息闭包内的全部命中条目（exact + prefix 两层）；
//   超出闭包的消息走 E00000（与 tiec 的未分类兜底语义一致）。
// 数据由 tiec 的 diagcode 目录全量采证生成（对 248 条代表消息回放验证一致）；
// 重采：按仓库工作区的采集工具链重跑并重新生成本文件。
// 边界：ec_norm 按 UTF-8 字节逐字节处理，非 ASCII 字节原样保留。
// 前缀 ec_。

// ---------- exact 表（等值命中；键 = 归一化消息） ----------
var ec_xk: table<string> = [
    "%体内只允许%右花括号，实际是%",
    "%后必须是别名标识符，实际是%",
    "%后必须是字符串路径，实际是%",
    "%已移除，请用%",
    "%表达式不允许重复的%通配臂",
    "%表达式分支之间需用%或右花括号%分隔，实际是%",
    "%表达式必须有%分支（表达式位%须产出值）",
    "函数体内不能有裸代码块",
    "剩余解构%只能出现一次",
    "剩余解构%必须位于解构列表末位",
    "变参参数不能同时使用%修饰",
    "变参参数不能有默认值",
    "变参参数必须是最后一个参数",
    "块注释未闭合",
    "字段访问%后必须是字段名%方法名%数字下标，实际是%",
    "字符串未闭合",
    "字符字面量只能包含一个字符",
    "字符字面量未闭合",
    "无法以%开始表达式",
    "无法识别的字符%",
    "期望%或%或%，实际是%",
    "期望%，实际是%",
    "期望标识符，实际是%",
    "期望类型，实际是%",
    "未知转义序列%",
    "空元组%不支持",
    "空元组类型%不支持",
    "空解构%不支持",
    "记录字面量元素必须是%键%值%（键为标识符或字符串字面量），实际是%",
    "赋值目标必须是变量或对象字段",
    "转义符后缺少字符",
    "闭包函数体必须是以%开始的代码块"];

var ec_xc: table<string> = [
    "E00722",
    "E00736",
    "E00737",
    "E00655",
    "E00793",
    "E00794",
    "E00911",
    "E00807",
    "E00811",
    "E00812",
    "E00814",
    "E00815",
    "E00816",
    "E00394",
    "E00821",
    "E00419",
    "E00422",
    "E00423",
    "E00832",
    "E00481",
    "E00833",
    "E00484",
    "E00485",
    "E00486",
    "E00497",
    "E00543",
    "E00863",
    "E00864",
    "E00868",
    "E00871",
    "E00603",
    "E00872"];

// ---------- prefix 表（最长前缀命中；键 = 归一化前缀） ----------
var ec_pk: table<string> = [
    "%体内只允许%右花括号，实际是%",
    "%后必须是别名标识符，实际是%",
    "%后必须是字符串路径，实际是%",
    "%表达式分支之间需用%或右花括号%分隔，实际是%",
    "字段访问%后必须是字段名%方法名%数字下标，实际是%",
    "无法识别的字符%",
    "期望%或%或%，实际是%",
    "期望%，实际是%",
    "期望标识符，实际是%",
    "期望类型，实际是%",
    "未知转义序列%",
    "记录字面量元素必须是%键%值%（键为标识符或字符串字面量），实际是%"];

var ec_pc: table<string> = [
    "E00722",
    "E00736",
    "E00737",
    "E00794",
    "E00821",
    "E00481",
    "E00833",
    "E00484",
    "E00485",
    "E00486",
    "E00497",
    "E00868"];

// ---------- 归一化（ASCII 运行折叠） ----------
pub func ec_norm(msg: string) -> string {
    var sb = string_builder()
    var n = len(msg)
    var i: i64 = 0
    var folded = false
    while i < n {
        var b = str_byte(msg, i)
        if b >= 32 && b <= 126 {
            if !folded {
                sb_append(sb, "%")
                folded = true
            }
        } else {
            folded = false
            sb_append_byte(sb, b)
        }
        i = i + 1
    }
    return sb_build(sb)
}

// ---------- 前缀判定（字节级） ----------
func ec_starts(s: string, p: string) -> bool {
    var m = len(p)
    if len(s) < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_byte(s, i) != str_byte(p, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// ---------- 查询：exact → prefix（最长）→ E00000 ----------
pub func ec_lookup(msg: string) -> string {
    var norm = ec_norm(msg)
    var i: i64 = 0
    while i < len(ec_xk) {
        if ec_xk[i] == norm {
            return ec_xc[i]
        }
        i = i + 1
    }
    var best: i64 = -1
    var bc: string = ""
    i = 0
    while i < len(ec_pk) {
        if ec_starts(norm, ec_pk[i]) {
            if len(ec_pk[i]) > best {
                best = len(ec_pk[i])
                bc = ec_pc[i]
            }
        }
        i = i + 1
    }
    if best >= 0 {
        return bc
    }
    return "E00000"
}
