type tie<logic>
// shell.tie —— tiel 命令行外壳（tiel 可执行入口）
// ============================================================
// 构建：tiec shell.tie -o tiel.exe
// 用法：
//   tiel <script.tie…>        执行脚本（编译为内核字节码后运行）
//   tiel --check <script.tie…> 只做前端校验（词法/语法/错误码）
//   tiel -v                   版本信息
// 输出：校验错误行为 CLI 形态 `error[E#####] @行:列: 消息。`；
//       执行错误行为 `tiel: <文件>: <消息>`。
// 退出码：0 全部正常 / 1 存在校验失败、编译拒绝、运行错误或脚本返回非零 / 2 用法错误。
import "./tiel.tie"
import "./emcodes.tie"
import "./emit.tie"
import "./lex.tie"
import "./parse.tie"
import "./render.tie"
using tiel
namespace tiel;

func sh_version() {
    println("tiel 0.1.0 —— tie 轻量解释器（前端：词法/语法；内核：字节码 VM）")
    println("用法: tiel <script.tie…>          执行脚本")
    println("      tiel --check <script.tie…>  只做前端校验")
    println("      tiel -v                     版本")
}

// 只校验：打印错误行或校验通过。
func sh_check_file(p: string, src: string) -> i64 {
    var err = tiel_check(src)
    if str_len(err) > 0 {
        println(err)
        return 1
    }
    println("校验通过: " + p)
    return 0
}

// 执行：编译并运行；编译拒绝与运行错误都算失败。
func sh_run_file(p: string, src: string) -> i64 {
    var rc = tiel_run(src)
    if str_len(tiel_err()) > 0 {
        println("tiel: " + p + ": " + tiel_err())
        return 1
    }
    if rc != 0 {
        return 1
    }
    return 0
}

func main() -> i64 {
    var n = arg_count()
    if n < 1 {
        sh_version()
        return 2
    }
    var first = arg_string(0)
    if first == "-v" || first == "--version" {
        sh_version()
        return 0
    }
    var checkOnly: bool = false
    var start: i64 = 0
    if first == "--check" || first == "-c" {
        checkOnly = true
        start = 1
    }
    if start >= n {
        println("tiel: 缺少脚本路径")
        return 2
    }
    var fails: i64 = 0
    var i: i64 = start
    while i < n {
        var p = arg_string(i)
        var src = file_read(p)
        if str_len(src) == 0 {
            println("tiel: 读取失败: " + p)
            fails = fails + 1
        } else {
            if checkOnly {
                fails = fails + sh_check_file(p, src)
            } else {
                fails = fails + sh_run_file(p, src)
            }
        }
        i = i + 1
    }
    if fails > 0 {
        return 1
    }
    return 0
}
