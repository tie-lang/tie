type tie<tsh>
// tools/tiel/scripts/regress-tiel.tsh.tie —— tiel 内核回归
// ============================================================
// 职责：把内联的 tsc 用例写成临时脚本，用 tiel.exe 执行并比对 stdout，
//   负例则要求非零退出码且错误行含指定片段。
// 用法（仓库根目录）：<tsh> -f tools/tiel/scripts/regress-tiel.tsh.tie
// 前置：_local_only/bin/tiel.exe 已构建（tiec tools/tiel/src/shell.tie）。
// 退出码 = FAIL>0 ? 1 : 0。

var tiel = ".\\_local_only\\bin\\tiel.exe"
var pass: i64 = 0
var fail: i64 = 0

func norm(s: string) -> string {
    return replace_all(s, "\r", "")
}

// 子串包含：替换掉后长度变化即视为包含（str_len 按码点计数，两处同口径）。
func has(s: string, sub: string) -> bool {
    return str_len(replace_all(s, sub, "")) != str_len(s)
}

func case_path(name: string, ext: string) -> string {
    return get_env("TEMP") + "\\tiel_reg_" + name + ext
}

// 正例：退出码 0 且 stdout 与期望逐字相等。
func expect_out(name: string, src: string, want: string) {
    var tmp = case_path(name, ".tsc.tie")
    var outf = case_path(name, ".out")
    file_write(tmp, src)
    var rc = exec_code("cmd /c " + tiel + " " + tmp + " > " + outf + " 2>&1")
    var got = norm(file_read(outf))
    if rc == 0 && got == want {
        pass = pass + 1
    } else {
        fail = fail + 1
        println("FAIL " + name + " rc=" + to_string(rc) + " got=[" + got + "] want=[" + want + "]")
    }
}

// 负例：退出码非零且输出含错误片段。
func expect_err(name: string, src: string, needle: string) {
    var tmp = case_path(name, ".tsc.tie")
    var outf = case_path(name, ".out")
    file_write(tmp, src)
    var rc = exec_code("cmd /c " + tiel + " " + tmp + " > " + outf + " 2>&1")
    var got = norm(file_read(outf))
    if rc != 0 && has(got, needle) {
        pass = pass + 1
    } else {
        fail = fail + 1
        println("FAIL " + name + " rc=" + to_string(rc) + " out=[" + got + "] 期待含 [" + needle + "]")
    }
}

println("=== tiel 内核回归 ===")

// ---------- 正例：表达式与变量 ----------
expect_out("arith",
    "var a = 10\nvar b = 3\nprintln(a + b)\nprintln(a - b)\nprintln(a * b)\nprintln(a / b)\nprintln(a % b)\n",
    "13\n7\n30\n3\n1\n")

expect_out("cmp",
    "println(3 > 2)\nprintln(3 == 2)\nprintln(2 >= 2)\nprintln(1 != 1)\n",
    "1\n0\n1\n0\n")

expect_out("unary",
    "var a = 7\nprintln(0 - a)\nprintln(!false)\n",
    "-7\n1\n")

expect_out("assign",
    "var a = 1\na = a + 41\na = a * 2\nprintln(a)\n",
    "84\n")

// ---------- 正例：控制流 ----------
expect_out("ifelse",
    "var a = 5\nif a > 3 {\n    println(\"big\")\n} else {\n    println(\"small\")\n}\n",
    "big\n")

expect_out("ifelse2",
    "var a = 1\nif a > 3 {\n    println(\"big\")\n} else {\n    println(\"small\")\n}\n",
    "small\n")

expect_out("while",
    "var i = 0\nvar s = 0\nwhile i < 5 {\n    s = s + i\n    i = i + 1\n}\nprintln(s)\n",
    "10\n")

expect_out("while_break",
    "var i = 0\nvar s = 0\nwhile i < 10 {\n    if i == 4 { break }\n    s = s + i\n    i = i + 1\n}\nprintln(s)\n",
    "6\n")

expect_out("while_cont",
    "var i = 0\nvar s = 0\nwhile i < 6 {\n    i = i + 1\n    if i == 3 { continue }\n    s = s + i\n}\nprintln(s)\n",
    "18\n")

expect_out("forrange",
    "var s = 0\nfor i in 1..5 {\n    s = s + i\n}\nprintln(s)\n",
    "10\n")

expect_out("forrange_incl",
    "var s = 0\nfor i in 0..=3 {\n    s = s + i\n}\nprintln(s)\n",
    "6\n")

expect_out("forrange_cont",
    "var c = 0\nfor i in 0..10 {\n    if i % 2 == 0 {\n        continue\n    }\n    c = c + 1\n}\nprintln(c)\n",
    "5\n")

expect_out("forrange_nest_break",
    "var n = 0\nfor a in 0..3 {\n    for b in 0..3 {\n        if b == 2 {\n            break\n        }\n        n = n + 1\n    }\n}\nprintln(n)\n",
    "6\n")

expect_out("array_lit",
    "var a = [1, 2, 3]\nprintln(a)\nprintln(a[0])\nprintln(len(a))\n",
    "[1, 2, 3]\n1\n3\n")

expect_out("array_nest",
    "var m = [[1, 2], [3]]\nprintln(m[0][1])\nprintln(len(m))\n",
    "2\n2\n")

expect_out("array_str",
    "var w = [\"ab\", \"cd\"]\nprintln(w[1])\nprintln(len(w))\n",
    "cd\n2\n")

expect_out("forin",
    "var b = [10, 20, 30]\nvar s = 0\nfor x in b {\n    s = s + x\n}\nprintln(s)\n",
    "60\n")

expect_out("forin_cont",
    "var b = [10, 20, 30]\nfor x in b {\n    if x == 20 { continue }\n    println(x)\n}\n",
    "10\n30\n")

expect_out("forin_break",
    "var b = [10, 20, 30]\nfor x in b {\n    if x == 20 { break }\n    println(x)\n}\n",
    "10\n")

expect_out("forin_nest",
    "var m = [[1, 2], [3]]\nvar c = 0\nfor r in m {\n    for v in r {\n        c = c + v\n    }\n}\nprintln(c)\n",
    "6\n")

expect_out("forin_label",
    "var m = [[1, 2], [3]]\nvar c = 0\nout: for r in m {\n    for v in r {\n        if v == 2 { break out }\n        c = c + v\n    }\n}\nprintln(c)\n",
    "1\n")

expect_out("switch_basic",
    "var x = 2\nswitch x {\n    case 1:\n        println(\"one\")\n    case 2:\n        println(\"two\")\n    default:\n        println(\"other\")\n}\n",
    "two\n")

expect_out("switch_multi",
    "switch 4 {\n    case 1, 2, 3:\n        println(\"low\")\n    case 4, 5:\n        println(\"mid\")\n}\n",
    "mid\n")

expect_out("switch_range",
    "switch 19 {\n    case 0..10:\n        println(\"low\")\n    case 11..=41:\n        println(\"mid\")\n    default:\n        println(\"high\")\n}\n",
    "mid\n")

expect_out("switch_default",
    "switch 99 {\n    case 1:\n        println(\"one\")\n    default:\n        println(\"fallback\")\n}\n",
    "fallback\n")

expect_out("switch_str",
    "var s = \"b\"\nswitch s {\n    case \"a\":\n        println(\"A\")\n    case \"b\":\n        println(\"B\")\n}\n",
    "B\n")

expect_out("switch_no_match",
    "switch 5 {\n    case 1:\n        println(\"one\")\n}\nprintln(\"after\")\n",
    "after\n")

expect_out("switch_in_loop",
    "var n = 0\nfor i in 0..4 {\n    switch i {\n        case 0:\n            n = n + 10\n        case 1:\n            n = n + 1\n        default:\n            n = n + 100\n    }\n}\nprintln(n)\n",
    "211\n")

expect_out("switch_expr",
    "func grade(n: i64) -> i64 {\n    return switch n {\n        1 -> 10,\n        2 -> 20,\n        _ -> 0,\n    }\n}\nprintln(grade(1))\nprintln(grade(2))\nprintln(grade(9))\n",
    "10\n20\n0\n")

expect_out("switch_expr_range",
    "func label(n: i64) -> string {\n    return switch n {\n        0..=9 -> \"digit\",\n        10..100 -> \"two\",\n        _ -> \"many\",\n    }\n}\nprintln(label(5))\nprintln(label(42))\nprintln(label(123))\n",
    "digit\ntwo\nmany\n")

expect_out("switch_expr_value",
    "var x = 2\nvar y = switch x { 1 -> 100, 2 -> 200, _ -> 300 }\nprintln(y)\n",
    "200\n")

expect_err("switch_expr_dup_wild",
    "var x = 1\nvar y = switch x { _ -> 1, _ -> 2 }\nprintln(y)\n",
    "重复的")

expect_out("idx_assign",
    "var a = [1, 2, 3]\na[1] = 9\nprintln(a)\n",
    "[1, 9, 3]\n")

expect_out("idx_compound",
    "var a = [1, 2, 3]\na[0] += 5\nprintln(a[0])\na[2] *= 3\nprintln(a[2])\n",
    "6\n9\n")

expect_out("idx_nest",
    "var m = [[1, 2], [3]]\nm[0][1] = 8\nprintln(m)\n",
    "[[1, 8], [3]]\n")

expect_out("idx_str",
    "var s = [\"x\", \"y\"]\ns[0] = s[1] + \"z\"\nprintln(s)\n",
    "[yz, y]\n")

expect_out("str_cat",
    "var a = \"ab\"\nvar b = \"cd\"\nprintln(a + b)\n",
    "abcd\n")

expect_err("str_cat_bad", "println(\"ab\" + 1)\n", "操作数类型不支持")

expect_out("interp_basic",
    "var name = \"world\"\nprintln(h\"hello {name}\")\n",
    "hello world\n")

expect_out("interp_expr",
    "println(h\"1+2={1 + 2}\")\n",
    "1+2=3\n")

expect_out("interp_multi",
    "var a = 2\nvar b = 3\nprintln(h\"{a}x{b}={a * b}\")\n",
    "2x3=6\n")

expect_out("interp_escape",
    "println(h\"{{lit}}\")\n",
    "{lit}\n")

expect_out("interp_plain",
    "println(h\"no expr\")\n",
    "no expr\n")

expect_out("interp_index",
    "var a = [10, 20]\nvar i = 1\nprintln(h\"v={a[i]}\")\n",
    "v=20\n")

expect_err("interp_empty", "println(h\"{}\")\n", "之间为空")

expect_err("interp_bad", "println(h\"{1 +}\")\n", "无法解析")

expect_out("label_break",
    "var n = 0\nouter: for a in 0..3 {\n    for b in 0..3 {\n        if b == 2 {\n            break outer\n        }\n        n = n + 1\n    }\n}\nprintln(n)\n",
    "2\n")

expect_out("label_cont",
    "var m = 0\nskip: for i in 0..6 {\n    if i < 3 {\n        continue skip\n    }\n    m = m + 1\n}\nprintln(m)\n",
    "3\n")

// ---------- 正例：函数与递归 ----------
expect_out("func",
    "func add(x: i64, y: i64) -> i64 {\n    return x + y\n}\nprintln(add(3, 4))\n",
    "7\n")

expect_out("rec",
    "func fact(n: i64) -> i64 {\n    if n <= 1 { return 1 }\n    return n * fact(n - 1)\n}\nprintln(fact(5))\n",
    "120\n")

expect_out("fib",
    "func fib(n: i64) -> i64 {\n    if n < 2 { return n }\n    return fib(n - 1) + fib(n - 2)\n}\nprintln(fib(10))\n",
    "55\n")

// ---------- 正例：字面量 ----------
expect_out("str",
    "println(\"hi\")\n",
    "hi\n")

// ---------- 负例 ----------
expect_err("syntax", "var x =\n", "error[E")
expect_err("undef", "println(y)\n", "未声明的变量")

println("=== 汇总: PASS=" + to_string(pass) + " FAIL=" + to_string(fail) + " ===")
if fail > 0 {
    return 1
}
return 0
