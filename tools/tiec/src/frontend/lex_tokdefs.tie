pub const lex_import: i64 = 20; pub const lex_as: i64 = 21;
pub const lex_struct: i64 = 22; pub const lex_extends: i64 = 23;
pub const lex_namespace: i64 = 24; pub const lex_pub: i64 = 25;
pub const lex_using: i64 = 26; pub const lex_extern: i64 = 27;
pub const lex_true: i64 = 28; pub const lex_false: i64 = 29;
pub const lex_zero: i64 = 30; pub const lex_ref: i64 = 31;
pub const lex_typekw: i64 = 32; pub const lex_lparen: i64 = 33;
pub const lex_rparen: i64 = 34; pub const lex_lbrace: i64 = 35;
pub const lex_rbrace: i64 = 36; pub const lex_lbracket: i64 = 37;
