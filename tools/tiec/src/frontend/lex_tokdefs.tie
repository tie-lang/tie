pub const lex_impl: i64 = 87;       // impl 关键字（S2.4：实现块 impl Drawable for Button { ... }）
// S3.3 宏/元编程：macro 关键字 + 反引号（准引用）+ $（插值）。
// 说明：S3.3 与 S2.4 并行开发，tag 编号取 88-90 不冲突；若合并时 S2.4 已占用
// 88/89，以本文件（后合并者）为准调整（保留 lex_port/lex_impl 不变）。
pub const lex_macro: i64 = 88;      // macro 关键字（S3.3：宏定义 macro name(...) -> code { ... }）
pub const lex_backtick: i64 = 89;   // ` 反引号（S3.3：准引用 `(expr) / `{ stmts } 构造 code 值）
pub const lex_dollar: i64 = 90;     // $ 插值符（S3.3：$x 嵌入 / $name 标识符插值，仅准引用内合法）
// M4 过程宏（dev33 批次9）：# 属性起始符——`#[macro]` 标记宏定义为过程宏
//（token 流 API 驱动），tag 91 为符号表新增（'#' = 0x23，介于 '!=' 与 '$' 之间）。
pub const lex_hash: i64 = 91;       // # 哈希符（属性语法 `#[name]`）
pub const lex_actor: i64 = 92;      // actor 关键字（一期并发：actor 原生语法）
pub const lex_async: i64 = 93;      // async 关键字（actor 异步投递方法修饰）
pub const lex_goto: i64 = 94;       // goto 关键字（三期：`unsafe goto #x` 无条件跳转，§7.1.5）
// P1 数据流箭头 `<-`（镜像 `->`）：符号表新增（'<-' = 0x3C 0x2D，介于 '<' 与 '<<' 之间）
pub const lex_larrow: i64 = 95;
// p.8.2.3 字符串插值起始 '{'：scan_string 插值分支专用 tag——与块/结构体开括号
// lex_lbrace 区分（`if s == "a" {` 的块 lbrace 不能误入插值链）；不落符号表，
// 仅 scan_string 插值分支合成推送。tag 96 位于符号表范围之外，无冲突。
pub const lex_interp_lbrace: i64 = 96;
// p.9.13.1 单箭头统一：`=>` 已移除（lex_fatarrow 定案删除，零兼容别名），
// 符号表不再登记 `=>`；lex_scan.scan_symbol 对 `=>` 直接报「已移除，请用 `->`」。
// 分支臂/返回位/管道统一用 `->`（lex_arrow）。原保留段 tag 97 废弃空闲。
// p.9.11.6 表不可变更新运算符 `with`（保留字，tag 98；位于符号表范围之外，
// 与 lex_interp_lbrace=96 错开；实际映射值在 lex_symtab.build_kw 关键字表登记）。
// `t with {k: v}` 二元运算符 token，参照单箭头 `->` 新 token 手法。
pub const lex_with: i64 = 98;
// p.9.11.9 checked 运算运算符 `+?`/`-?`/`*?`（符号表 3→2→1 最长匹配；
// 与 `?` 解包/`?.`/`a?[i]` 前缀不冲突——各自的第二字符不同，最长匹配天然区分）。
pub const lex_plusq: i64 = 99;    // `+?` checked 加（溢出即运行期报错）
pub const lex_minusq: i64 = 100;  // `-?` checked 减
pub const lex_starq: i64 = 101;   // `*?` checked 乘
// p.9.11.10 `inline` 函数标注保留字（tag 102）；p.9.11.11 `immut` 只读形参保留字。
pub const lex_inline: i64 = 102;  // `inline fn` 内联提示
pub const lex_immut: i64 = 103;   // `fn f(immut t)` 只读形参修饰
// p.9.11.12 @注解起始符（tag 104）：`@name` / `@name(args)` 声明前置注解。
// 映射值登记于 lex_symtab.build_sym（'@' = 0x40，介于 '?' 与 '[' 之间）。
pub const lex_at: i64 = 104;      // @ 注解符（声明前置元数据）
// p.9.13.3 整除运算符 `\`（tag 108）与复合赋值 `\=`（tag 109）：符号表新增。
// 为何不用 `//`（设计稿原定）：`//` 已是行注释（scan_slash 分派），改注释规则是
// 破坏性改动。`\`（0x5C）在符号表中完全空闲——介于 "["（0x5B）与 "]"（0x5D）
// 之间；`\=` 与 `\` 同首字符，按最短优先排在 `\` 之后。字符串内的 `\` 是转义符，
// 走 scan_string 独立路径，与本符号无冲突。
// **为何是 108/109 而非 105/106（RCA，2026-09-27）**：本文件的关键字 tag 已用到
// 107（yield=105 / interface=106 / alias=107），而分配 tag 时只查了符号表一侧的
// 最大值（104）就取号，造成 `lex_backslash` 与 `lex_yield`、`lex_backslasheq` 与
// `lex_interface` **重号**。解析器按 tag 值比较，故关键字与符号会互相误判
//（未爆发仅因 `yield` 不会出现在乘法层，属侥幸）。**纪律：分配 lex tag 前，
// 必须对整个 lex_tokdefs.tie 做一次「值重复」扫描**：
//   grep -o ": i64 = [0-9]*" lex_tokdefs.tie | sed 's/: i64 = //' | sort -n | uniq -d
pub const lex_backslash: i64 = 108;    // `\` 整除（int 截断除 / f64 floor-div）
pub const lex_backslasheq: i64 = 109;  // `\=` 整除复合赋值
// p.9.13.3 幂 `**`（tag 110）与 floor 取余 `%%`（tag 111）：符号表新增。
// 排序（严格升序，最短优先）：`*`(0x2A) < `**`(0x2A 0x2A) < `*=`(0x2A 0x3D) < `*?`(0x2A 0x3F)；
// `%`(0x25) < `%%`(0x25 0x25) < `%=`(0x25 0x3D)。
// 分配依据：本文件最大值此前为 109（上一行），故取 110/111（见上方 RCA 纪律：先做重号扫描）。
pub const lex_starstar: i64 = 110;        // `**` 幂（右结合，高于 `*`）
pub const lex_percentpercent: i64 = 111;  // `%%` floor 取余（与 `\` 成对）
// p.9.11 `%%=` 复合赋值（tag 118，2026-10-07 补）：规范 §1 运算符表与 §4 示例都写了
// `count %%= 5 // 原地取余并写回`，实现此前缺此 token ⇒ 直接报 E00832。
// 取号依据：本文件此前最大值 117；已按上方 RCA 纪律做重号扫描（无重复）。
// 符号表排序（严格升序，最短优先）：`%` < `%%` < `%%=` < `%=`（第 2 字节 0x25 < 0x3D）。
pub const lex_percentpercenteq: i64 = 118;  // `%%=` floor 取余复合赋值
// p.9.11 `is` 类型判定（tag 119，规范 §3.16）：`v is i64` 询问动态类型值的实际类型。
// 取号依据：本文件此前最大值 118；已按上方 RCA 纪律做重号扫描（无重复）。
// 关键字插入位置：build_kw 表 "interface" 与 "macro" 之间（strcmp 升序：interface < is < macro）。
pub const lex_is: i64 = 119;               // `is` 类型判定运算符
// p.9.11 `reentrant`（tag 120，规范 §10.7 重入）：actor 消息方法修饰符——
// 默认不重入（单消费者串行，环 A→B→A 死锁）；标注后该方法阻塞于对外同步 RPC
// 期间允许嵌套处理本 actor 队列中的**异步**消息（同步消息因 done@104 单槽
// 语义仍排队）。
pub const lex_reentrant: i64 = 120;        // `reentrant` actor 方法重入修饰
// p.9.11 `await`（tag 121，规范 §10.6 结果的延后取得）：`var f = w.compute(x)`
// 产生 future<T> 凭据，`var r = await f` 需要时取值（等待 + 结果 + 错误同路径）。
pub const lex_await: i64 = 121;            // `await` future 取值前缀
// p.9.13.3 checked 幂 `**?`（tag 112）：与 `**` 同级；int 族溢出即运行期报错
//（对齐 p.9.11.9 的 `+?`/`-?`/`*?` 族）。符号表排序 `**` < `**?` < `*=`。
pub const lex_starstarq: i64 = 112;       // `**?` checked 幂
// p.9.11.26 参数传递约定矩阵：`move` 保留字（tag 113）。
// 用于**参数位修饰符** `move x: T`（所有权转移约定，与 `ref`/`immut` 并列）。
// 取 113 的依据：本文件此前最大值 112（上一行）；关键字侧用 107（alias），
// 符号侧用到 112，故 113 起空闲（见上方 RCA 纪律：先做重号扫描）。
// 破坏性评估：`move` 此前**没有任何编译器语义**（language.md §13 记载的
// `var b = move a` 用途并未实现——全仓无 move 的 token/节点/处理），且把 move
// 用作标识符的代码仅 9 处且全在注释/README 中 → 升为保留字无实际影响。
pub const lex_move: i64 = 113;            // `move` 所有权转移形参修饰
pub const lex_tilde: i64 = 114;           // `~` 整数按位取反
pub const lex_dotdoteq: i64 = 115;        // `..=` 闭区间
// p.9.11.36 `deep` 值语义形参修饰符（tag 116）：与 `immut`（只读引用）对偶。
//   `func f(deep p: S)` ⇒ 入口把 p 的**表字段**深拷贝一份，此后函数内对 p 的一切
//   修改都影响不到调用方（默认的按值传参只拷贝句柄，表仍是共享的）。
// 取 116 的依据：本文件此前最大值 115（上一行）；已按 RCA 纪律做全文重号扫描
//（grep -o ": i64 = [0-9]*" | sort -n | uniq -d 为空）。破坏性评估：`deep` 在
// tiec/tiu/tlib 全仓**无任何出现**（grep -w = 0），升为保留字无影响。
pub const lex_deep: i64 = 116;            // `deep` 值语义形参修饰（深拷贝表字段）
pub const lex_shared: i64 = 117;          // `shared` 显式共享形参修饰（不复制，可选中高性能路径）
// p.9.11.15 yield 生成器关键字（tag 105）：`func gen() { yield v; ... }`——
// 含 yield 的函数 = 生成器函数（产出序列，调用返回迭代序列对象/表）。
pub const lex_yield: i64 = 105;   // yield 关键字（生成器产出语句）
// p.9.11.21 interface 关键字（tag 106）：`interface Drawable { pub func 签名... }`
// 结构性接口声明（鸭子多态静态检查；与 S2.4 port 名义接口同登记表，语义
// 区别 = 实现关系判定：有签名兼容方法即实现，无需显式 impl 块）。映射值
// 登记于 lex_symtab.build_kw（"interface" 在 "inline" 与 "macro" 之间，严格升序）。
pub const lex_interface: i64 = 106; // interface 关键字（结构性接口声明）
// p.9.11.32：alias 为真保留字（build_kw 登记；既有代码中以 alias 作标识符的
// 10 处已由 prep/alias_kw_clean.tie 一键改名为 alias_id）
pub const lex_alias: i64 = 107;   // alias 关键字（p.9.11.32 类型别名）

namespace lextok {

// ---------- 字符分类 ----------
pub func is_digit(c: i64) -> bool {   // 0-9
    return c >= 48 && c <= 57
}
pub func is_hex_digit(c: i64) -> bool {   // 0-9 a-f A-F
    return (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
}
pub func is_alpha(c: i64) -> bool {   // a-z A-Z + 中文等非 ASCII
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c > 127
}
pub func is_ident_cont(c: i64) -> bool {   // 字母/数字/_
    return is_digit(c) || is_alpha(c) || c == 95
}

// ---------- 行列号反推（行起点表 + 二分；码点列号）----------
// 构建行起点表：g_line_starts[i] = 第 (i+1) 行的起点位置
pub func build_line_starts() {
    g_line_starts = table_new_i64()
    table_push(g_line_starts, 0)
    var i: i64 = 0
    while i < g_n {
        if g_codes[i] == 10 {
            table_push(g_line_starts, i + 1)
        }
        i = i + 1
    }
}

// 位置 → 行号（1 起）：二分找最后一个 <= pos 的行起点，其下标 + 1
pub func line_of(pos: i64) -> i64 {
    var lo: i64 = 0
    var hi: i64 = len(g_line_starts) - 1
    var ans: i64 = 0
    while lo <= hi {
        var mid = (lo + hi) / 2
        if g_line_starts[mid] <= pos {
            ans = mid
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return ans + 1
}

// 位置 → 列号（1 起）：pos - 该行起点 + 1（码点计数，非字节）
pub func col_of(pos: i64) -> i64 {
    var l = line_of(pos)
    return pos - g_line_starts[l - 1] + 1
}

// ---------- ASI 判定 ----------
// 是否二元运算符（区间 [lex_plus..lex_question] 内除 Bang/Inc/Dec 外全部是，
// 与 Rust is_bin_op 对齐；++/-- 特意不算——后缀 i++\n 应补分号）。
// S2.3 起 '?'（lex_question）也不算：它作为后缀解包符（expr ?）时是语句
// 结束符，行尾应补分号（`var v = f() ?\nreturn ...` 才能正确断句）；
// 三目 `cond ? a : b` 在同一行书写，不触发 ASI，不受影响。
func is_bin_op(tag: i64) -> bool {
    return tag >= lex_plus && tag <= lex_question &&
        tag != lex_bang && tag != lex_inc && tag != lex_dec &&
        tag != lex_question
}

// 是否「行尾不可结束语句」集合（Rust finish_line 排除表；RBracket 不在其中）
func no_semi_end(tag: i64) -> bool {
    var bad: table<i64> = [lex_comma, lex_colon, lex_dcolon, lex_dot, lex_dotdot,
        lex_dotdoteq, lex_ellipsis, lex_lparen, lex_lbracket, lex_lbrace, lex_rbrace, lex_semi,
        lex_else, lex_in, lex_interp_lbrace]
    var i: i64 = 0
    while i < len(bad) {
        if bad[i] == tag {
            return true
        }
        i = i + 1
    }
    return false
}

// 是否声明起始 token（doc 附着点；pub 只是修饰符，不算声明起始）
func is_decl_start(tag: i64) -> bool {
    if tag == lex_func || tag == lex_var || tag == lex_const || tag == lex_extern {
        return true
    }
    if tag == lex_struct || tag == lex_enum || tag == lex_namespace || tag == lex_import || tag == lex_using {
        return true
    }
    // S1.2：unsafe fn / repr(C) struct 的 doc 附着
    if tag == lex_unsafe || tag == lex_repr {
        return true
    }
    // S2.4：port 声明 / impl 块的 doc 附着；S3.3：macro 定义
    // （doc 附着到宏定义声明）
    if tag == lex_port || tag == lex_impl || tag == lex_macro {
        return true
    }
    // p.9.11.21：interface 声明的 doc 附着（结构性接口）
    if tag == lex_interface {
        return true
    }
    // 一期并发：actor 声明的 doc 附着
    if tag == lex_actor {
        return true
    }
    return false
}

// ---------- 列式 token 表：重置 / 写入 / 读取 ----------
// 重置列式 token 表与 doc 表（每次 run_lex 调用前）
pub func reset_tokens() {
    tok_tags = table_new_i64()
    tok_lines = table_new_i64()
    tok_cols = table_new_i64()
    tok_lexemes = table_new_i64()
    doc_keys = table_new_i64()
    doc_vals = table_new_i64()
    doc_decl_lines = table_new_i64()
    g_doc_pending = ""
    g_str_triple = 0
}

// 在位置 pos 写入 token 四列并更新 ASI；声明起始 token 且有 pending doc 先 flush
pub func push_token_at(tag: i64, pos: i64, lid: i64) {
    if is_decl_start(tag) {
        flush_doc(line_of(pos))
    }
    var l = line_of(pos)
    table_push(tok_tags, tag)
    table_push(tok_lines, l)
    table_push(tok_cols, pos - g_line_starts[l - 1] + 1)
    table_push(tok_lexemes, lid)
    g_line_has_token = true
    // 括号深度只统计 ( 与 [（{ } 是块边界，不参与换行补分号判定）
    if tag == lex_lparen || tag == lex_lbracket {
        g_paren_depth = g_paren_depth + 1
    } else if tag == lex_rparen || tag == lex_rbracket {
        if g_paren_depth > 0 {
            g_paren_depth = g_paren_depth - 1
        }
    }
    g_last_line_tag = tag
}

// 列式表读取（token_count 含 Eof；lexeme 还原串 / 原始池 id）
pub func token_count() -> i64 {
    return len(tok_tags)
}
pub func token_tag(i: i64) -> i64 {
    return tok_tags[i]
}
pub func token_line(i: i64) -> i64 {
    return tok_lines[i]
}
pub func token_col(i: i64) -> i64 {
    return tok_cols[i]
}
pub func token_lexeme_id(i: i64) -> i64 {
    return tok_lexemes[i]
}
pub func token_lexeme(i: i64) -> string {
    return interner.lookup(tok_lexemes[i])
}

// ---------- doc 注释收集 ----------
// 收集一条 doc：strip 一前导空格 + trim 尾空白；空串不收集；连续 doc 用 \n 拼接
pub func collect_doc(txt: string) {
    var t = txt
    var n = str_len(t)
    if n > 0 {
        if str_char(t, 0) == " " {
            t = str.slice(t, 1, n)
        }
    }
    t = str.trim_end(t)
    if str_len(t) == 0 {
        return
    }
    if str_len(g_doc_pending) > 0 {
        g_doc_pending = g_doc_pending + "\n" + t
    } else {
        g_doc_pending = t
    }
}

// 把 pending doc 附着到当前声明（ordinal = len(doc_keys)，push 即排序对）。
// p.9.11.29：同时记录声明起始 token 所在行（decl_line），parser 侧按
// doc_decl_lines[k] == ast.line(声明节点) 匹配归属。
func flush_doc(decl_line: i64) {
    if str_len(g_doc_pending) == 0 {
        return
    }
    var ord = len(doc_keys)
    table_push(doc_keys, ord)
    table_push(doc_vals, interner.intern(g_doc_pending))
    table_push(doc_decl_lines, decl_line)
    g_doc_pending = ""
}

// ---------- p.9.11.29 doc 注册表跨命名空间读取（parser/工具链消费）----------
// doc 条数。
pub func doc_entry_count() -> i64 {
    return len(doc_keys)
}

// 第 i 条 doc 的声明起始行（1 起）。
pub func doc_entry_line(i: i64) -> i64 {
    return doc_decl_lines[i]
}

// 第 i 条 doc 的文本池 id（interner.name_str 还原串）。
pub func doc_entry_text_id(i: i64) -> i64 {
    return doc_vals[i]
}

// doc 清单输出：共 N 条 + 逐条 doc[ordinal] = 文本（--dump-docs 调试标志）
pub func dump_docs() -> string {
    var out: string = "共 " + to_string(len(doc_keys)) + " 条 doc:\n"
    var i: i64 = 0
    while i < len(doc_keys) {
        out = out + "  doc[" + to_string(doc_keys[i]) + "] = '" +
            interner.name_str(doc_vals[i]) + "'\n"
        i = i + 1
    }
    return out
}

// ---------- ASI 换行处理 ----------
// 换行时按 ASI 规则决定是否补分号（Rust finish_line 语义）；pos 为下一行行首，
// 补出的分号 span 取该位置。
pub func finish_line(pos: i64) {
    var should = false
    if g_line_has_token {
        if g_paren_depth == 0 {
            if g_last_line_tag >= 0 {
                if !is_bin_op(g_last_line_tag) {
                    if !no_semi_end(g_last_line_tag) {
                        should = true
                    }
                }
            }
        }
    }
    if should {
        var lid = interner.intern(";")
        push_token_at(lex_semi, pos, lid)
    }
    g_line_has_token = false
    g_last_line_tag = -1
}

}
