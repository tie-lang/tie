pub const lex_semi: i64 = 42; pub const lex_dot: i64 = 43;
pub const lex_dotdot: i64 = 44; pub const lex_arrow: i64 = 45;
pub const lex_plus: i64 = 46; pub const lex_minus: i64 = 47;
pub const lex_star: i64 = 48; pub const lex_slash: i64 = 49;
pub const lex_percent: i64 = 50; pub const lex_eq: i64 = 51;
pub const lex_eqeq: i64 = 52; pub const lex_noteq: i64 = 53;
pub const lex_lt: i64 = 54; pub const lex_gt: i64 = 55;
pub const lex_le: i64 = 56; pub const lex_ge: i64 = 57;
pub const lex_andand: i64 = 58; pub const lex_oror: i64 = 59;
pub const lex_bang: i64 = 60; pub const lex_pluseq: i64 = 61;
pub const lex_minuseq: i64 = 62; pub const lex_stareq: i64 = 63;
pub const lex_slasheq: i64 = 64; pub const lex_percenteq: i64 = 65;
pub const lex_ampeq: i64 = 66; pub const lex_pipeeq: i64 = 67;
pub const lex_careteq: i64 = 68; pub const lex_shleq: i64 = 69;
pub const lex_shreq: i64 = 70; pub const lex_amp: i64 = 71;
pub const lex_pipe: i64 = 72; pub const lex_caret: i64 = 73;
pub const lex_shl: i64 = 74; pub const lex_shr: i64 = 75;
pub const lex_inc: i64 = 76; pub const lex_dec: i64 = 77;
pub const lex_question: i64 = 78; pub const lex_eof: i64 = 79;
pub const lex_ellipsis: i64 = 80;   // `...` 变参标记（func f(rest: ...i64)）
pub const lex_enum: i64 = 81;       // enum 关键字（enum Color { ... }）
pub const lex_unsafe: i64 = 82;     // unsafe 关键字（S1.2：unsafe fn / unsafe 块）
pub const lex_repr: i64 = 83;       // repr 关键字（S1.2：repr(C) struct 标注）
pub const lex_asm: i64 = 84;        // asm 关键字（S1.2：asm! 内联汇编宏）
pub const lex_panic: i64 = 85;      // panic 关键字（S2.3：panic("消息") 不可恢复错误）
