type tie<class>
// tools/tiec/src/tiep/tiep_import.tie —— 脚本 import / using 展开（解释器侧）
// ============================================================
// 职责：把 import 的文件按编译器前端同一套规则加载进当前会话，并处理 using。
//
// 规则（与前端一致，路径解析复用 lib/support/import_path，单一口径）：
//   - 路径：./ ../ 相对当前文件目录；/std/ /ext/ /rdu/ /sys/ 走库根；
//     绝对路径原样；归一化统一由 import_path 完成。
//   - 加载：读文件 → 剥文件头角色声明 → 词法/语法 → 归档 → 注册其顶层定义。
//   - 导出：被导入文件只导出 pub 顶层函数（默认私有，pub 显式导出），
//     与编译器「文件级私有函数不可跨文件调用」一致。
//   - 选择性导入 `import "x".{a,b}`：只保留选中名及其依赖闭包；
//     选中名必须是 pub 顶层声明，否则按前端同义诊断。
//   - 去重：同一解析后路径只加载一次（重复导入与循环导入都自然终止）。
//   - 别名 `as ns`：与前端一致，仅登记，不构成访问前缀。
//
// 说明：本文件与 tiep 同 namespace，跨文件裸名互调；只依赖内置库与 lib/*。
// ============================================================

import "../../../../lib/support/import_path.tie"

// 当前文件目录（随递归下降切换，返回时恢复）。
pub var g_import_dir: string = "";
// 脚本根目录（宿主设置；reset 时恢复到它）。
var g_script_dir: string = "";
// 已加载的解析后路径。
var g_imp_loaded: table<string>;
var g_imp_loaded_ready: bool = false;
// 导入深度：0 = 主脚本；>0 = 被导入文件（其 main 不参与注册、只导出 pub）。
pub var g_import_depth: i64 = 0;
// 选择性导入的保留集（非空 = 只注册这些顶层名）。
pub var g_import_keep: table<string>;
pub var g_import_keep_ready: bool = false;

namespace tiep {

// 宿主设置脚本所在目录（尾斜杠可无）。
pub func set_script_dir(d: string) {
    g_script_dir = d
    g_import_dir = d
}

// 每次求值前复位导入状态（去重表清空，目录回到脚本根）。
pub func reset_imports() {
    g_imp_loaded = table_new_string()
    g_imp_loaded_ready = true
    g_import_dir = g_script_dir
    g_import_depth = 0
    g_import_keep = table_new_string()
    g_import_keep_ready = false
}

// 路径是否已加载。
func import_seen(p: string) -> bool {
    if !g_imp_loaded_ready {
        g_imp_loaded = table_new_string()
        g_imp_loaded_ready = true
    }
    var i = 0
    while i < len(g_imp_loaded) {
        if g_imp_loaded[i] == p {
            return true
        }
        i = i + 1
    }
    return false
}

// 记录已加载路径。
func import_mark(p: string) {
    // 全局表的写入须「取出 → 改 → 写回」：直接 table_push(全局, …) 改的是副本。
    var cur = g_imp_loaded
    table_push(cur, p)
    g_imp_loaded = cur
}

// 名字是否在选择性导入的保留集里（未启用选择 = 全保留）。
func keep_name(nm: string) -> bool {
    if !g_import_keep_ready {
        return true
    }
    var i = 0
    while i < len(g_import_keep) {
        if g_import_keep[i] == nm {
            return true
        }
        i = i + 1
    }
    return false
}

// 收集子树里的标识符引用（N_VAR 名字）；带访问集，防 AST 回指成环。
func collect_refs(node: i64, ref out: table<string>, ref seen: table<i64>) {
    if node < 0 {
        return
    }
    var s = 0
    while s < len(seen) {
        if seen[s] == node {
            return
        }
        s = s + 1
    }
    table_push(seen, node)
    // 变量引用在 N_VAR；直接调用（含同文件函数互调）的名字挂在 N_CALL 上。
    var nt = isess.ntag(node)
    if nt == N_VAR || nt == N_CALL {
        table_push(out, isess.nname_str(node))
    }
    var k = 0
    while k < isess.nchild(node) {
        collect_refs(isess.nchild_at(node, k), out, seen)
        k = k + 1
    }
}

// 计算选择性导入的保留集：选中名必须命中 pub 顶层声明；依赖闭包一并保留。
func build_keep(root: i64, sel: table<string>) -> i64 {
    var names = table_new_string()
    var nodes = table_new_i64()
    var pubs = table_new_i64()
    var keep = table_new_i64()
    var i = 0
    while i < isess.nchild(root) {
        var s = isess.nchild_at(root, i)
        if isess.ntag(s) != N_IMPORT {
            table_push(names, isess.nname_str(s))
            table_push(nodes, s)
            table_push(pubs, isess.nval(s) & 1)
            table_push(keep, 0)
        }
        i = i + 1
    }

    // 种子：选中名必须存在且为 pub
    var j = 0
    while j < len(sel) {
        var found = false
        var k = 0
        while k < len(names) {
            if names[k] == sel[j] {
                if pubs[k] == 0 {
                    w_err = "选择性导入：'" + sel[j] + "' 是文件级私有声明，不可跨文件引用"
                    return -1
                }
                keep[k] = 1
                found = true
            }
            k = k + 1
        }
        if !found {
            w_err = "选择性导入：'" + sel[j] + "' 不是被导入文件的顶层声明"
            return -1
        }
        j = j + 1
    }

    // 闭包：保留声明体里引用到的同文件顶层名，不动点收敛
    var changed = true
    while changed {
        changed = false
        var x = 0
        while x < len(names) {
            if keep[x] == 1 {
                var refs = table_new_string()
                var seen = table_new_i64()
                collect_refs(nodes[x], refs, seen)
                var r = 0
                while r < len(refs) {
                    var y = 0
                    while y < len(names) {
                        if keep[y] == 0 && names[y] == refs[r] {
                            keep[y] = 1
                            changed = true
                        }
                        y = y + 1
                    }
                    r = r + 1
                }
            }
            x = x + 1
        }
    }

    var keepout = table_new_string()
    var z = 0
    while z < len(names) {
        if keep[z] == 1 {
            table_push(keepout, names[z])
        }
        z = z + 1
    }
    g_import_keep = keepout
    g_import_keep_ready = true
    return 0
}

// using 语句：把点分命名空间下的直接成员引入裸名。
// `using fmt.error;` → 把 "fmt.error.<name>" 注册为 "<name>"。
func apply_using(node: i64) -> i64 {
    var prefix = ""
    var n = isess.naux(node)
    var i = 0
    while i < n {
        if i > 0 {
            prefix = prefix + "::"
        }
        prefix = prefix + isess.nname_str(isess.nchild_at(node, i))
        i = i + 1
    }
    if str_len(prefix) == 0 {
        return 0
    }
    var lead = prefix + "::"
    var all = isess.f_names()
    var j = 0
    while j < len(all) {
        var full = all[j]
        if has_str_prefix(full, lead) {
            var rest = slice_str(full, str_len(lead), str_len(full))
            // 只引入直接成员：剩余部分不再含点号
            var deeper = false
            var k = 0
            while k < str_len(rest) {
                if str_char(rest, k) == ":" {
                    deeper = true
                }
                k = k + 1
            }
            if !deeper {
                isess.f_put(rest, isess.f_get(full))
            }
        }
        j = j + 1
    }
    return 0
}

// 加载一个 import 节点；成功 0，失败 -1（w_err 已置，带文件名）。
func load_import(imp_node: i64) -> i64 {
    var raw = isess.nname_str(imp_node)
    if str_len(raw) == 0 {
        return 0
    }
    var full = importpath.resolve(raw, g_import_dir)
    if import_seen(full) {
        return 0
    }
    import_mark(full)

    var src = file_read(full)
    if str_len(src) == 0 {
        w_err = "导入文件读取失败: '" + full + "'"
        return -1
    }
    var body = strip_role_header(src)
    if !lexer.run_lex(body) {
        w_err = "词法错误（" + full + "）@" + to_string(g_err_line) + ":" +
            to_string(g_err_col) + ": " + g_err_msg
        return -1
    }
    var proto = parser.parse("")
    if has_str_prefix(proto, "ERR:") {
        w_err = "语法错误（" + full + "）" + proto
        return -1
    }
    if sstate.load_ast(proto) < 0 {
        w_err = "内部错误: AST 协议加载失败（" + full + "）"
        return -1
    }
    isess.archive_add()

    // 选择性导入：子节点 = 选中名（N_VAR，name = 名字池 id）
    var nsel = isess.nchild(imp_node)
    var saved_keep = g_import_keep
    var saved_keep_ready = g_import_keep_ready
    if nsel > 0 {
        var sel = table_new_string()
        var q = 0
        while q < nsel {
            var cn = isess.nchild_at(imp_node, q)
            if cn >= 0 {
                table_push(sel, isess.nname_str(cn))
            }
            q = q + 1
        }
        if build_keep(a_root, sel) < 0 {
            g_import_keep = saved_keep
            g_import_keep_ready = saved_keep_ready
            return -1
        }
    } else {
        g_import_keep = table_new_string()
        g_import_keep_ready = false
    }

    // 递归：以被导入文件目录为基准；返回后恢复原目录，原文件遍历不受影响。
    var saved = g_import_dir
    g_import_dir = importpath.dir_of(full)
    g_import_depth = g_import_depth + 1
    var rc = register_top_level()
    g_import_depth = g_import_depth - 1
    g_import_dir = saved
    g_import_keep = saved_keep
    g_import_keep_ready = saved_keep_ready
    if w_err != "" {
        return -1
    }
    return 0
}

}
