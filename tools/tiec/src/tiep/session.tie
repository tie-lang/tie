type tie<class>
// compiler/interp/session.tie —— 自举 v2 T4.1：Session（globals + funcs 注册表
// + AST 归档池 + 求值环境作用域栈）
// ============================================================
// 里程碑：自举 v2 计划 T4.1（.omo/plans/self-hosting-v2.md）——把 Rust 解释器
// crates/tie-interp/src/lib.rs 的 Session（1636 行）/ Env（1845 行）移植为
// tie 语言。Session 是 REPL 持久状态：globals（顶层 var，跨 eval 存活）+
// funcs（顶层/命名空间函数注册表）+ externs（extern 声明名单）。
//
// # AST 归档池（本模块最关键的设计决策）
//   Rust 端 Session 直接持有解析出的 AST（FnDef 克隆进 funcs），节点 id
//   跨 eval 稳定。tie 端 sstate.load_ast 每次解析都**重建** sstate 9 列表，
//   旧节点 id 立即失效——若直接注册 sstate 节点 id，第二次 eval 后函数体
//   指向错误节点。解法：每次解析成功后把 sstate 全表**追加拷贝**进本模块
//   的归档池（a_* 表，id = 归档基数 + 原 id，子节点引用同步重映射），
//   函数注册/求值全部读归档池。归档只增不减，注册过的函数节点永不失效。
//
// # 环境（Env）：作用域链 + 引用槽 + 命名空间前缀 + 流程槽
//   tie 的表无法缩容（无 pop/remove 原语），作用域栈用**扁平表 + 段**方案：
//   env_keys/env_vals 按作用域分段追加（env_soff/scnt 记录每段区间），
//   pop_scope 不删除条目而把段内条目标记 env_alive=0（墓碑）——查找/赋值
//   只认存活条目（对齐 Rust 的栈式作用域语义；内存只增，REPL 规模可接受）。
//   查找顺序：当前函数 ref 槽（by_ref 形参穿透调用方）→ 作用域栈
//   [env_base..顶部] 逆序 → 顶层 globals（对齐 Rust Env::lookup 1885 行）。
//
// # 流程槽（Flow 通道）
//   tie 无 enum/多返回值：exec_stmt/exec_block 的结果经模块级流程槽传递——
//   g_flow（0=正常 1=return 2=break 3=continue）+ g_flow_val（return 值 id）
//   + g_flow_label（break/continue 标签，空串=无）+ g_lastval（最后表达式值）。
//
// # 调用约定
//   import 后 isess.archive_add() / isess.lookup(...) 等；模块级全局
//   （a_* / g_* / env_* 等）跨模块直接可见（import 文本内联）。
//   命名规范：命名空间内函数不加 is_ 前缀；内部工具私有（非 pub）。

import "./vval.tie"

// ==================== AST 归档池（跨 eval 持久；id = 归档基数 + 原 id） ====================
var a_tags: table<i64>;
var a_names: table<i64>;
var a_vals: table<i64>;
var a_aux: table<i64>;
var a_coff: table<i64>;
var a_cnts: table<i64>;
var a_kids: table<i64>;
var a_lines: table<i64>;
var a_cols: table<i64>;
var a_n: i64 = 0;      // 归档节点总数（下一批拷贝的 id 基数）
pub var a_root: i64 = 0;   // 最近一次归档的根 StmtList 节点 id（reset 置 -1）

// ==================== globals（顶层 var，REPL 持久） ====================
// p.9.17.3：键用 **interned id**（整数）替代字符串——变量读写是解释器最热的路径，
// 旧实现每次查找都要与候选名做字符串内容比较（实测 ~143ns/次，且成本随条目数线性
// 增长）。AST 节点名本就以 interner id 存放（a_names），热路径天然持有 id，无需
// 文本往返；字符串版 API 仅作兼容薄包装（内部 intern 一次，冷路径用）。
pub var g_nids: table<i64>;
var g_vals: table<Value>;

// ==================== funcs（已注册函数：全名 → 归档 FnDef 节点 id） ====================
// f_nids = interned id 键（热路径整数线性扫描）；f_keys 保留全名字符串
// （显示/调试用，与 f_nids 下标对齐，由 f_put_nid 维护）。
pub var f_keys: table<string>;
var f_nids: table<i64>;
var f_nodes: table<i64>;

// ==================== macros（S3.3 宏注册表：宏名名单） ====================
// 宏 = 编译期函数（N_MACRO_DEF，布局同 FnDef 但无泛型槽）。宏定义经
// register_top_level 注册进 funcs（可调用）+ 本表标记（调用点分派宏展开）。
// p.9.17.3 后半：m_nids 整数键主表（热查免字符串比较），m_keys 保留显示。
var m_keys: table<string>;
var m_nids: table<i64>;

// ==================== externs（extern 声明名单；调用报明确错误） ====================
var e_keys: table<string>;
var e_nids: table<i64>;

// ==================== 环境：作用域栈（扁平表 + 段 + 墓碑） ====================
var env_nids: table<i64>;   // 变量名 interned id（p.9.17.3：整数键替代字符串键）
var env_vals: table<Value>;
var env_alive: table<i64>;
var env_seg: table<i64>;    // 每条目所属的活动段索引（扁平表并非连续段：内层作用域
                            // 追加的条目会穿插在外层段条目之间——据此逐条归属定位，杜绝
                            // 「递归/内层块后第二个外层 var 错值」的天然非连续 bug）
var env_soff: table<i64>;   // (活动段) 段起点（env_keys 偏移）；段索引 = 扁平表下标
var env_scnt: table<i64>;   // (活动段) 段条目数
var env_depth: i64 = 0;     // 活动作用域段数（逻辑栈深；env_soff[0..env_depth-1] 为活动段）
pub var env_base: i64 = 0;      // 当前函数作用域起点（跨函数隔离；顶层为 0）
pub var env_ns: table<string>;  // 当前执行函数的命名空间前缀段（裸调用补全用）

// ==================== by_ref 引用槽栈（T0.3：形参名 → 调用方变量名） ====================
var r_nids: table<i64>;    // 当前函数各 ref 形参名（interned id）
var r_cnids: table<i64>;   // 对应调用方变量名（interned id；lookup/assign 穿透目标）
var r_soff: table<i64>;    // 每层引用槽段起点（对齐作用域段方案）

// ==================== 流程槽（exec_stmt/exec_block 结果通道） ====================
pub var g_flow: i64 = 0;       // 0=正常 1=return 2=break 3=continue
pub var g_flow_val: Value = vval.new_void();  // return 携带的值（p.9.17.2 拆箱；void = Nil）
pub var g_flow_label: string = "";  // break/continue 标签（空串 = 无标签）
pub var g_lastval: Value = vval.new_void(); // 最后一条表达式语句的值（配合 g_has_last）
pub var g_has_last: bool = false;       // g_lastval 是否携带有效值（Nil 亦为合法 void 值，
                                    // 不能兼作「无值」哨兵，故拆出显式标志）

// 流程码常量
pub const FL_NORMAL: i64 = 0;
pub const FL_RETURN: i64 = 1;
pub const FL_BREAK: i64 = 2;
pub const FL_CONTINUE: i64 = 3;

namespace isess {

// 会话重置：值池 + 归档池 + globals/funcs/externs + 环境 + 流程槽全清。
pub func reset() {
    vval.reset()
    a_tags = table_new_i64()
    a_names = table_new_i64()
    a_vals = table_new_i64()
    a_aux = table_new_i64()
    a_coff = table_new_i64()
    a_cnts = table_new_i64()
    a_kids = table_new_i64()
    a_lines = table_new_i64()
    a_cols = table_new_i64()
    a_n = 0
    a_root = -1
    g_nids = table_new_i64()
    g_vals = {}
    f_keys = table_new_string()
    f_nids = table_new_i64()
    f_nodes = table_new_i64()
    m_keys = table_new_string()
    m_nids = table_new_i64()
    e_keys = table_new_string()
    e_nids = table_new_i64()
    env_nids = table_new_i64()
    env_vals = {}
    env_alive = table_new_i64()
    env_seg = table_new_i64()
    env_soff = table_new_i64()
    env_scnt = table_new_i64()
    env_depth = 0
    env_base = 0
    env_ns = table_new_string()
    r_nids = table_new_i64()
    r_cnids = table_new_i64()
    r_soff = table_new_i64()
    g_flow = 0
    g_flow_val = Value.Nil
    g_flow_label = ""
    g_lastval = Value.Nil
    g_has_last = false
    a_root = -1
}

// ==================== AST 归档 ====================

// 把 sstate 当前 9 列全表追加拷贝进归档池（id 重映射：新 id = 原 id + 基数；
// 子节点引用同步偏移；-1 哨兵保持）。返回本批基数（首个新节点 id）。
// 前提：调用方已 sstate.load_ast 成功。拷贝后 a_root = 本批根 StmtList。
pub func archive_add() -> i64 {
    var base = a_n
    var off = a_n
    var i: i64 = 0
    while i < s_n {
        table_push(a_tags, s_tags[i])
        table_push(a_names, s_names[i])
        table_push(a_vals, s_vals[i])
        table_push(a_aux, s_aux[i])
        table_push(a_lines, s_lines[i])
        table_push(a_cols, s_cols[i])
        table_push(a_coff, len(a_kids))
        table_push(a_cnts, s_nchild[i])
        var k: i64 = 0
        while k < s_nchild[i] {
            var c = s_children[s_coff[i] + k]
            if c < 0 {
                table_push(a_kids, -1)
            } else {
                table_push(a_kids, c + off)
            }
            k = k + 1
        }
        i = i + 1
    }
    a_n = a_n + s_n
    a_root = a_n - 1
    return base
}

// 归档节点访问（跨 eval 稳定的节点句柄）。
pub func ntag(id: i64) -> i64 {
    return a_tags[id]
}
pub func nname(id: i64) -> i64 {
    return a_names[id]
}
pub func nval(id: i64) -> i64 {
    return a_vals[id]
}
pub func naux(id: i64) -> i64 {
    return a_aux[id]
}
pub func nchild(id: i64) -> i64 {
    return a_cnts[id]
}
pub func nchild_at(id: i64, k: i64) -> i64 {
    if k < 0 {
        return -1
    }
    if k >= a_cnts[id] {
        return -1
    }
    return a_kids[a_coff[id] + k]
}
// 节点名字字段 → 文本（-1 无名字 → 空串；interner 与 parser 共享同一池）。
pub func nname_str(id: i64) -> string {
    var nid = a_names[id]
    if nid < 0 {
        return ""
    }
    return interner.lookup(nid)
}

// 节点起始行/列（1 起；S3.3 克隆准引用子树保留 span 用）。
pub func nline(id: i64) -> i64 {
    return a_lines[id]
}
pub func ncol(id: i64) -> i64 {
    return a_cols[id]
}

// 节点辅助整数槽 → 标签文本（For 的 aux=循环标签；-1 无标签 → 空串）。
// 标签与名字字段同约定：存字符串池 id。
pub func naux_label(id: i64) -> string {
    var v = a_aux[id]
    if v < 0 {
        return ""
    }
    return interner.lookup(v)
}

// ==================== globals ====================

// globals 线性查找（interned id 键）：命中返回下标，未命中 -1。
func g_find_nid(nid: i64) -> i64 {
    var i: i64 = 0
    while i < len(g_nids) {
        if g_nids[i] == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

// 顶层全局声明（顶层 var 初始化后登记；重复声明由调用方校验）。
pub func g_declare_nid(nid: i64, v: Value) {
    table_push(g_nids, nid)
    table_push(g_vals, v)
}

// 顶层全局读取：未命中置 w_err 返回 Nil（文本对齐 Rust 变量未声明）。
pub func g_lookup_nid(nid: i64) -> Value {
    var i = g_find_nid(nid)
    if i < 0 {
        w_err = "变量 '" + interner.lookup(nid) + "' 未声明"
        return Value.Nil
    }
    return g_vals[i]
}

// 顶层全局写回：未声明置 w_err 返回 -1（对齐 Rust assign 兜底错误）。
pub func g_assign_nid(nid: i64, v: Value) -> i64 {
    var i = g_find_nid(nid)
    if i < 0 {
        w_err = "变量 '" + interner.lookup(nid) + "' 未声明"
        return -1
    }
    g_vals[i] = v
    return 0
}

// 字符串兼容薄包装（冷路径：REPL 绑定 / 脚本参数注入等文本入口）。
pub func g_declare(name: string, v: Value) {
    g_declare_nid(interner.intern(name), v)
}
pub func g_lookup(name: string) -> Value {
    return g_lookup_nid(interner.intern(name))
}
pub func g_assign(name: string, v: Value) -> i64 {
    return g_assign_nid(interner.intern(name), v)
}

// ==================== funcs / externs ====================
// p.9.17.3 后半：函数表键改 interned id（整数键线性扫描，对齐 g_nids/env_nids
// 先例——热路径 call_fn/gen_method_call 直传 id，免 nname_str 字符串构造与
// 逐条字符串比较；错误/显示文本只在冷分支 interner.lookup 还原）。

func f_find_nid(nid: i64) -> i64 {
    var i: i64 = 0
    while i < len(f_nids) {
        if f_nids[i] == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

pub func f_has_nid(nid: i64) -> bool {
    return f_find_nid(nid) >= 0
}

// 函数注册（顶层裸名 / 命名空间全名）。nid 版主实现。
pub func f_put_nid(nid: i64, node: i64) {
    var i = f_find_nid(nid)
    if i >= 0 {
        f_nodes[i] = node  // 同名重复注册：覆盖（Rust HashMap insert 语义）
        return
    }
    table_push(f_nids, nid)
    table_push(f_keys, interner.lookup(nid))
    table_push(f_nodes, node)
}

// 按全名取函数节点 id；未注册 -1。
pub func f_get_nid(nid: i64) -> i64 {
    var i = f_find_nid(nid)
    if i < 0 {
        return -1
    }
    return f_nodes[i]
}

// 字符串兼容薄包装（冷路径：REPL 绑定 / 调试 / 文本入口，内部 intern 一次）。
func f_find(name: string) -> i64 {
    return f_find_nid(interner.intern(name))
}

pub func f_has(name: string) -> bool {
    return f_has_nid(interner.intern(name))
}

pub func f_put(name: string, node: i64) {
    f_put_nid(interner.intern(name), node)
}

pub func f_get(name: string) -> i64 {
    return f_get_nid(interner.intern(name))
}

// ==================== macros（S3.3） ====================

// 宏名登记（register_top_level 注册 N_MACRO_DEF 时调用；nid 版主实现，线性去重）。
pub func m_put_nid(nid: i64) {
    var i: i64 = 0
    while i < len(m_nids) {
        if m_nids[i] == nid {
            return
        }
        i = i + 1
    }
    table_push(m_nids, nid)
    table_push(m_keys, interner.lookup(nid))
}

// 宏名登记（字符串兼容薄包装，冷路径）。
pub func m_put(name: string) {
    m_put_nid(interner.intern(name))
}

// 名字是否已注册宏（调用点宏展开分派用；nid 版主实现）。
pub func m_has_nid(nid: i64) -> bool {
    var i: i64 = 0
    while i < len(m_nids) {
        if m_nids[i] == nid {
            return true
        }
        i = i + 1
    }
    return false
}

// 字符串兼容薄包装。
pub func m_has(name: string) -> bool {
    return m_has_nid(interner.intern(name))
}

// extern 声明登记（解释路径不可调用，仅记录名字；nid 版主实现）。
pub func e_add_nid(nid: i64) {
    var i: i64 = 0
    while i < len(e_nids) {
        if e_nids[i] == nid {
            return
        }
        i = i + 1
    }
    table_push(e_nids, nid)
    table_push(e_keys, interner.lookup(nid))
}

// 字符串兼容薄包装。
pub func e_add(name: string) {
    e_add_nid(interner.intern(name))
}

// extern 查询（nid 版主实现）。
pub func e_has_nid(nid: i64) -> bool {
    var i: i64 = 0
    while i < len(e_nids) {
        if e_nids[i] == nid {
            return true
        }
        i = i + 1
    }
    return false
}

// 字符串兼容薄包装。
pub func e_has(name: string) -> bool {
    return e_has_nid(interner.intern(name))
}

// ==================== 作用域栈 ====================

// 压一层作用域（段起点 = 当前扁平表长度）。采用**活动段计数**模型：
// env_soff/env_scnt 的下标 0..env_depth-1 为活动段；弹层不新增哨兵段，而是把
// 段索引归还给父作用域，因此遍历/声明永远只作用在活动段上（旧"哨兵占位"方案
// 会在每层弹栈后把新哨兵段留在栈顶，使递归/嵌套调用返回后当前块的 `var` 落入
// 废弃哨兵段——重入 bug 根因：作用域栈只增不减 + scope_top 取 len-1）。
pub func scope_push() {
    var seg = env_depth
    if seg == len(env_soff) {
        table_push(env_soff, len(env_nids))
        table_push(env_scnt, 0)
    } else {
        env_soff[seg] = len(env_nids)
        env_scnt[seg] = 0
    }
    env_depth = env_depth + 1
}

// 弹一层作用域：活动段数减一，段内条目不再被遍历（等效死亡；不缩表，段槽可被
// 后续 push 复用）。
pub func scope_pop() {
    if env_depth == 0 {
        return
    }
    env_depth = env_depth - 1
}

// 当前作用域层下标（活动栈顶段索引；无作用域返回 -1）。
pub func scope_top() -> i64 {
    return env_depth - 1
}

// 当前作用域声明变量（重复声明由调用方经 var_declared 校验）。
pub func var_declare_nid(nid: i64, v: Value) {
    table_push(env_nids, nid)
    table_push(env_vals, v)
    table_push(env_alive, 1)
    var top = env_depth - 1
    if top < 0 {
        top = 0
    }
    table_push(env_seg, top)      // 记录条目所属段（扁平表非连续，须逐条标记归属）
    env_scnt[top] = env_scnt[top] + 1
}

// 字符串兼容薄包装（冷路径：REPL 绑定 / 脚本参数注入等文本入口）。
pub func var_declare(name: string, v: Value) {
    var_declare_nid(interner.intern(name), v)
}

// 段内变量查找：从扁平表尾部回溯到该段起点，只匹配归属该段（env_seg）的存活条目。
// 旧实现假设段内条目在 env_keys 中**连续**（[soff..soff+scnt) 区间）——但内层作用域
// （嵌套块/循环/递归调用）追加的条目会穿插在外层段条目之间，破坏连续性，使「段内的
// 后续外层 var」落到区间外而查不到（变量未声明）。改为按逐条归属标记定位，天然免疫
// 穿插：内层段条目 env_seg 更大而被跳过，本段条目无论穿插到哪里都被命中。
func seg_find_rev_nid(seg: i64, nid: i64) -> i64 {
    var off = env_soff[seg]
    var i = len(env_nids) - 1
    while i >= off {
        if env_alive[i] != 0 {
            if env_seg[i] == seg {
                if env_nids[i] == nid {
                    return i
                }
            }
        }
        i = i - 1
    }
    return -1
}

// 引用槽段内查找（当前函数 ref 形参名 id → 调用方变量名 id；未命中 -1）。
func ref_find_nid(nid: i64) -> i64 {
    var n = len(r_soff)
    if n == 0 {
        return -1
    }
    var off = r_soff[n - 1]
    var i = len(r_nids) - 1
    while i >= off {
        if r_nids[i] == nid {
            return r_cnids[i]
        }
        i = i - 1
    }
    return -1
}

// 变量查找（interned id 键）：ref 槽穿透调用方 → 作用域栈 [env_base..顶部] 逆序 → globals。
// 未命中**置 w_err** 返回 Nil（文本对齐 Rust 变量未声明；调用方按 w_err 判失败）。
pub func lookup_nid(nid: i64) -> Value {
    // T0.3 by_ref：引用槽优先——ref 形参从调用方槽取当前值
    var cnid = ref_find_nid(nid)
    if cnid >= 0 {
        return lookup_caller_nid(cnid)
    }
    // 函数作用域栈（env_base..顶部）逆序（只遍历活动段）
    var s = env_depth - 1
    while s >= env_base {
        var idx = seg_find_rev_nid(s, nid)
        if idx >= 0 {
            return env_vals[idx]
        }
        s = s - 1
    }
    // 顶层 globals
    var i = g_find_nid(nid)
    if i >= 0 {
        return g_vals[i]
    }
    w_err = "变量 '" + interner.lookup(nid) + "' 未声明"
    return Value.Nil
}

// 字符串兼容薄包装（文本入口：REPL / 脚本参数注入）。
pub func lookup(name: string) -> Value {
    return lookup_nid(interner.intern(name))
}

// ref 穿透目标查找（interned id）：调用方变量槽 = 调用方作用域（env_base 之下）逆序 →
// 顶层 globals（对齐 Rust RefTarget 解析：调用方作用域或 globals）。
func lookup_caller_nid(cnid: i64) -> Value {
    var s = env_base - 1
    while s >= 0 {
        var idx = seg_find_rev_nid(s, cnid)
        if idx >= 0 {
            return env_vals[idx]
        }
        s = s - 1
    }
    var i = g_find_nid(cnid)
    if i >= 0 {
        return g_vals[i]
    }
    w_err = "变量 '" + interner.lookup(cnid) + "' 未声明"
    return Value.Nil
}

// 变量赋值（interned id 键）：ref 槽穿透 → 作用域栈 [env_base..顶部] 逆序 → globals。
// 未声明置 w_err 返回 -1（文本对齐 Rust assign 兜底）。
pub func assign_nid(nid: i64, v: Value) -> i64 {
    var cnid = ref_find_nid(nid)
    if cnid >= 0 {
        return assign_caller_nid(cnid, v)
    }
    var s = env_depth - 1
    while s >= env_base {
        var idx = seg_find_rev_nid(s, nid)
        if idx >= 0 {
            env_vals[idx] = v
            return 0
        }
        s = s - 1
    }
    var i = g_find_nid(nid)
    if i >= 0 {
        g_vals[i] = v
        return 0
    }
    w_err = "变量 '" + interner.lookup(nid) + "' 未声明"
    return -1
}

// 字符串兼容薄包装（文本入口）。
pub func assign(name: string, v: Value) -> i64 {
    return assign_nid(interner.intern(name), v)
}

func assign_caller_nid(cnid: i64, v: Value) -> i64 {
    var s = env_base - 1
    while s >= 0 {
        var idx = seg_find_rev_nid(s, cnid)
        if idx >= 0 {
            env_vals[idx] = v
            return 0
        }
        s = s - 1
    }
    var i = g_find_nid(cnid)
    if i >= 0 {
        g_vals[i] = v
        return 0
    }
    w_err = "变量 '" + interner.lookup(cnid) + "' 未声明"
    return -1
}

// 变量是否已声明（当前函数 ref 槽 / 作用域栈 / 顶层；VarDecl 重复声明校验用）。
pub func var_declared_nid(nid: i64) -> bool {
    if ref_find_nid(nid) >= 0 {
        return true
    }
    var s = env_depth - 1
    while s >= env_base {
        if seg_find_rev_nid(s, nid) >= 0 {
            return true
        }
        s = s - 1
    }
    return g_find_nid(nid) >= 0
}

// 字符串兼容薄包装（文本入口）。
pub func var_declared(name: string) -> bool {
    return var_declared_nid(interner.intern(name))
}

// 仅检查最顶层作用域段（当前块）是否已声明同名变量——函数/块体内 `var` 允许
// 遮蔽顶层全局（对齐词法作用域惯例），重复声明判据只限当前块。
// 无作用域（REPL/脚本顶层）回退到 globals 判据。
pub func scope_local_declared_nid(nid: i64) -> bool {
    var top = env_depth - 1
    if top < 0 {
        return g_find_nid(nid) >= 0
    }
    return seg_find_rev_nid(top, nid) >= 0
}

// 字符串兼容薄包装（文本入口）。
pub func scope_local_declared(name: string) -> bool {
    return scope_local_declared_nid(interner.intern(name))
}

// ==================== by_ref 引用槽层 ====================

// 压一层引用槽（进入被调函数时；记录段起点）。
pub func ref_push() {
    table_push(r_soff, len(r_nids))
}

// 登记当前层一个 ref 形参：形参名 id → 调用方变量名 id（热路径直接传 id）。
pub func ref_add_nid(pnid: i64, cnid: i64) {
    table_push(r_nids, pnid)
    table_push(r_cnids, cnid)
}

// 字符串兼容薄包装（文本入口：形参名/调用方变量名由调用方持文本时用）。
pub func ref_add(pname: string, cname: string) {
    ref_add_nid(interner.intern(pname), interner.intern(cname))
}

// 弹一层引用槽（标记本层条目死亡；不缩表）。
pub func ref_pop() {
    var n = len(r_soff)
    if n == 0 {
        return
    }
    table_push(r_soff, len(r_nids))  // 不可缩表：哨兵占位
}

// ==================== 命名空间前缀（裸调用补全） ====================

// 保存当前命名空间前缀（调用用户函数前；返回副本供恢复）。
pub func ns_save() -> table<string> {
    var out: table<string> = table_new_string()
    var i: i64 = 0
    while i < len(env_ns) {
        table_push(out, env_ns[i])
        i = i + 1
    }
    return out
}

pub func ns_restore(t: table<string>) {
    env_ns = t
}

}   // namespace isess
