type tie<class>
// std/result.tie —— 错误处理模型预置枚举（S2.3，error-model.md L1）。
// ============================================================
// 预置 Result/Option 枚举（与用户自定义 enum 无差别，生态统一）：
//   - enum Result<T, E> { Ok(T) Err(E) }：可恢复错误（外部错误/输入/IO）
//   - enum Option<T>     { Some(T) None }：可选值（有值/无值）
// 用法（import 引入后即可见）：
//   import "../../std/result.tie"
//   func read_cfg() -> Result<string, string> {
//       if !fs.exists("cfg.toml") { return Result.err("配置不存在") }
//       return Result.ok(fs.read("cfg.toml"))
//   }
//   var v = read_cfg() ?          // Err → 函数提前返回 Err；Ok → 解包
// 构造：Result.Ok(v) / Result.Err(e) / Option.Some(v) / Option.None
//   （与 Rust 同名变体风格一致，switch 匹配 + ? 解包均可用）
// 解包：switch 匹配（已有）或 `expr ?`（S2.3，仅限返回 Result 的函数内）
// ============================================================

// 可恢复错误枚举：Ok(T) 成功值 / Err(E) 失败值
enum Result<T, E> {
    Ok(T)
    Err(E)
}

// 可选值枚举：Some(T) 有值 / None 无值
enum Option<T> {
    Some(T)
    None
}

// ---- 文本解析族：可预期失败的数值转换（规格 §2.11 的 tp_ 族）----
// 与 to_i64 / to_f64 的区别只在失败语义：to_ 系失败触发内建检查（程序错误），
// tp_ 系返回 Result，由调用方分支处理。接受的语言与 to_ 系完全一致——
// 整型：[+-]? 数字+（无空白、无十六进制、无下划线；溢出 i64 判失败）；
// 浮点：[+-]?(数字+[.数字*] | .数字+)([eE][+-]?数字+)?，且整串必须是合法数值。
// 浮点落值复用 to_f64，保证与内建解析逐位一致。

// 文本 → Result<i64, string>。累加按负数进行，天然覆盖 i64 最小值。
pub func tp_i64(s: string) -> Result<i64, string> {
    var n = str_len(s)
    if n == 0 {
        return Result.Err("空文本不是整数")
    }
    var i: i64 = 0
    var neg = false
    var c0 = str_char(s, 0)
    if c0 == "+" {
        i = 1
    }
    if c0 == "-" {
        neg = true
        i = 1
    }
    if i >= n {
        return Result.Err("整数缺少数字")
    }
    var acc: i64 = 0
    var seen: i64 = 0
    var lim: i64 = 0 - 922337203685477580
    while i < n {
        var cp = char_code(str_char(s, i))
        if cp < 48 {
            return Result.Err("整数含有非数字字符")
        }
        if cp > 57 {
            return Result.Err("整数含有非数字字符")
        }
        var d = cp - 48
        if acc < lim {
            return Result.Err("整数超出 i64 范围")
        }
        if acc == lim && d > 8 {
            return Result.Err("整数超出 i64 范围")
        }
        acc = acc * 10 - d
        seen = seen + 1
        i = i + 1
    }
    if seen == 0 {
        return Result.Err("整数缺少数字")
    }
    if neg {
        return Result.Ok(acc)
    }
    // 累加按负数进行，幅值上限是 9223372036854775808（即 i64 最小值的绝对值）；
    // 正数只有取到该幅值才算溢出，其它情形 acc 恒为负，不能据此判溢出。
    var mn: i64 = 0 - 9223372036854775807
    mn = mn - 1
    if acc == mn {
        return Result.Err("整数超出 i64 范围")
    }
    return Result.Ok(0 - acc)
}

// 单字符是否为 ASCII 数字（内部用）。
func tp_is_dig(c: string) -> bool {
    var cp = char_code(c)
    if cp < 48 {
        return false
    }
    if cp > 57 {
        return false
    }
    return true
}

// 文本 → Result<f64, string>。先按 to_f64 的语法整串校验，再交给 to_f64 取值。
pub func tp_f64(s: string) -> Result<f64, string> {
    var n = str_len(s)
    if n == 0 {
        return Result.Err("空文本不是浮点数")
    }
    var i: i64 = 0
    var c0 = str_char(s, 0)
    if c0 == "+" {
        i = 1
    }
    if c0 == "-" {
        i = 1
    }
    var dig: i64 = 0
    while i < n && tp_is_dig(str_char(s, i)) {
        dig = dig + 1
        i = i + 1
    }
    if i < n && str_char(s, i) == "." {
        i = i + 1
        while i < n && tp_is_dig(str_char(s, i)) {
            dig = dig + 1
            i = i + 1
        }
    }
    if dig == 0 {
        return Result.Err("浮点数缺少数字")
    }
    if i < n {
        var ce = str_char(s, i)
        if ce == "e" || ce == "E" {
            i = i + 1
            if i < n && (str_char(s, i) == "+" || str_char(s, i) == "-") {
                i = i + 1
            }
            var ed: i64 = 0
            while i < n && tp_is_dig(str_char(s, i)) {
                ed = ed + 1
                i = i + 1
            }
            if ed == 0 {
                return Result.Err("浮点数指数缺少数字")
            }
        }
    }
    if i != n {
        return Result.Err("浮点数含有非数字字符")
    }
    return Result.Ok(to_f64(s))
}

// ---- 组合子族（规格 §8.4）----
// 管线箭头 `x -> f(...)` 把数据作末参传入，故组合子统一写成「函数在前、结果在后」，
// 与 std/prelude.tie 的 stream_* 适配器保持同一调用形式。
// 短闭包实参（`v -> v + 1`）传给泛型被调方时，必须显式写出类型实参：
// `r -> map_result<i64, i64, string>(v -> v + 1)`。短闭包展开需在语义期
// 已知道具体 fn 形参类型；无显式类型实参时泛型调用先推断实参再实例化，
// 此时闭包形参无类型可依（具名函数实参不受此限，可省类型实参）。

// 对 Ok 值做变换，Err 原样透传；成功类型可变，错误类型不变。
pub func map_result<T, U, E>(f: fn(T) -> U, r: Result<T, E>) -> Result<U, E> {
    switch r {
        case Ok(v):
            return Result.Ok(f(v))
        case Err(e):
            return Result.Err(e)
    }
    panic("map_result 不可达")
}

// Ok 值继续交给下一个返回 Result 的步骤，Err 原样透传（链式校验）。
pub func and_then<T, U, E>(f: fn(T) -> Result<U, E>, r: Result<T, E>) -> Result<U, E> {
    switch r {
        case Ok(v):
            return f(v)
        case Err(e):
            return Result.Err(e)
    }
    panic("and_then 不可达")
}
