type tie<class>
// std/ui.tie —— 第 14 章「界面元素块与图语法」的运行时支撑
// ============================================================================
// 设计契约（§14.1）：元素块与图不是独立语言，而是同一套表达式的书写形态。
//   * 解析期把 `@ window "标题" { ... }` 降解为对本模块的普通调用序列
//     （begin / attr_str / modifier / text / on_name / end）——不引入
//     新的求值模型，走既有语义检查与代码生成。
//   * 本模块只做「存储 + 查询」：元素树是全局合一的一棵树（父节点由压栈
//     决定），属性/修饰/事件按节点 id 存平行表；图与样式单元按 id 存平行表。
//   * 渲染后端不在本层（§14.9 只规定契约）；后端按查询接口取树/图/样式。
//   * 顶层样式/图单元是声明式数据：解析期折成 `unit_decl(...)` /
//     `graph_decl(...)` 一次调用，载荷是块体原文（"k:v;k:v"），由本模块
//     在运行时切分成条目——保证「声明即注册」不需要额外的注册语句。
import "./string.tie" as str

// ============================================================================
// 布局词表（第 14 章 §9 键类型表）：尺寸 / 分布 / 溢出 / 锚点
// ----------------------------------------------------------------------------
// 四类值都以「词」书写，但在程序里是带类型的一等值：
//   * Size —— 尺寸代数（hug / fill / px / pct / fr / em / pt / vw / vh / ratio）
//   * Dist —— 轴分布词（start / center / end / space-* / stretch）
//   * Overflow —— 溢出策略（clip / scroll / expand / error）
//   * Anchor —— overlay 子项锚点（九点 + fill）
// 解析器（lib/front/pstmt_ui.tie）把属性值降解为 `Size.fill()` / `Dist.center`
// 这样的构造调用，再由 `ui.w(...)` 一类设置器写回**规范字符串**（§9 降级表）。
// 类型化只发生在编译期：运行期属性表仍是「键 → 字符串」，`ui.attr_of(id,"w")`
// 对 `w: fill` 仍返回 "fill"，与类型化之前的文本形态逐字节兼容。
//
// Size 的编码（kind/a/b 三槽，不借道浮点，避免文本往返丢精度）：
//   * kind = SizeKind 变体序号（0..9，见 enum SizeKind）
//   * px/pct/fr/em/pt/vw/vh：a = 数值 × 100（百分之一单位，i64 承载两位小数）
//   * hug/fill：a = b = 0
//   * ratio：a = 前项，b = 后项（原值）
// 规范文本由 Size.to_attr 还原：150 → "1.5em"，200 → "2fr"，6000 → "60%"。
// ============================================================================

// 尺寸形态。
enum SizeKind {
    hug
    fill
    px
    pct
    fr
    em
    pt
    vw
    vh
    ratio
}

// 尺寸值。
struct Size {
    var kind: i64 = 0            // SizeKind 变体序号
    var a: i64 = 0               // 数值 × 100（ratio 时是前项）
    var b: i64 = 0               // ratio 的后项
}

namespace Size {
    // 百分之一单位 → 十进制文本：150 → "1.5"，200 → "2"，25 → "0.25"。
    pub func fmt_hundredths(h: i64) -> string {
        var neg = false
        var v = h
        if v < 0 {
            neg = true
            v = -v
        }
        var whole = v / 100
        var frac = v % 100
        var s = to_string(whole)
        if frac != 0 {
            if frac % 10 == 0 {
                s = s + "." + to_string(frac / 10)
            } else if frac < 10 {
                s = s + ".0" + to_string(frac)
            } else {
                s = s + "." + to_string(frac)
            }
        }
        if neg {
            s = "-" + s
        }
        return s
    }
    // 半单位进位：×100 取整时四舍五入（0.29 不会掉成 28）。
    pub func half_sign(x: f64) -> f64 {
        if x < 0.0 {
            return -0.5
        }
        return 0.5
    }

    // 内部统一构造。
    pub func make(kind: i64, a: i64, b: i64) -> Size {
        return Size(kind, a, b)
    }
    // 内容尺寸（默认）。
    pub func hug() -> Size {
        return Size.make(0, 0, 0)
    }
    // 占满剩余空间（等价 1fr）。
    pub func fill() -> Size {
        return Size.make(1, 0, 0)
    }
    // 逻辑像素。
    pub func px(n: i64) -> Size {
        return Size.make(2, n * 100, 0)
    }
    // 父内容盒百分比（整数）。
    pub func pct(n: i64) -> Size {
        return Size.make(3, n * 100, 0)
    }
    // 份数。
    pub func fr(w: f64) -> Size {
        return Size.make(4, to_i64(w * 100.0 + half_sign(w)), 0)
    }
    // 相对字号倍数。
    pub func em(x: f64) -> Size {
        return Size.make(5, to_i64(x * 100.0 + half_sign(x)), 0)
    }
    // 点（1pt = 4/3 逻辑像素）。
    pub func pt(x: f64) -> Size {
        return Size.make(6, to_i64(x * 100.0 + half_sign(x)), 0)
    }
    // 视口宽百分比。
    pub func vw(n: f64) -> Size {
        return Size.make(7, to_i64(n * 100.0 + half_sign(n)), 0)
    }
    // 视口高百分比。
    pub func vh(n: f64) -> Size {
        return Size.make(8, to_i64(n * 100.0 + half_sign(n)), 0)
    }
    // 宽高比。
    pub func ratio(a: i64, b: i64) -> Size {
        return Size.make(9, a, b)
    }
    // 变体序号（SizeKind 与 kind: i64 的桥）。
    pub func tag_of(k: SizeKind) -> i64 {
        switch k {
        case SizeKind.hug: return 0
        case SizeKind.fill: return 1
        case SizeKind.px: return 2
        case SizeKind.pct: return 3
        case SizeKind.fr: return 4
        case SizeKind.em: return 5
        case SizeKind.pt: return 6
        case SizeKind.vw: return 7
        case SizeKind.vh: return 8
        case SizeKind.ratio: return 9
        }
        return 0
    }
    // 规范文本（§9 降级表：属性表里存的就是这个形态）。
    pub func to_attr(s: Size) -> string {
        switch s.kind {
        case 0: return "hug"
        case 1: return "fill"
        case 2: return fmt_hundredths(s.a)
        case 3: return fmt_hundredths(s.a) + "%"
        case 4: return fmt_hundredths(s.a) + "fr"
        case 5: return fmt_hundredths(s.a) + "em"
        case 6: return fmt_hundredths(s.a) + "pt"
        case 7: return fmt_hundredths(s.a) + "vw"
        case 8: return fmt_hundredths(s.a) + "vh"
        case 9: return "ratio(" + to_string(s.a) + ":" + to_string(s.b) + ")"
        }
        return "hug"
    }
}

// 轴分布词。
enum Dist {
    start
    center
    end
    space_between
    space_around
    space_evenly
    stretch
}

// 溢出策略。
enum Overflow {
    clip
    scroll
    expand
    err
}

// overlay 子项锚点。
enum Anchor {
    top_start
    top
    top_end
    start
    center
    end
    bottom_start
    bottom
    bottom_end
    fill
}

namespace ui {

// ---------- v2：函数值事件 / 端口 / 单元结构化属性与规则 / 主题 ----------
var g_fnow: table<i64>
var g_fnname: table<string>
var g_fnfn: table<fn(i64, i64, i64, string) -> i64>
var g_port: table<string>
var g_pown: table<i64>
var g_upk: table<string>
var g_upv: table<string>
var g_upown: table<i64>
var g_rsel: table<string>
var g_rprop: table<string>
var g_rval: table<string>
var g_urown: table<i64>
var g_thname: table<string>
var g_thkey: table<string>
var g_thval: table<string>
var g_layers: table<string>

// ---------- 元素树 ----------
var g_kind: table<string>
var g_name: table<string>
var g_parent: table<i64>
var g_ak: table<string>      // 属性键（与 g_av/g_own 平行）
var g_av: table<string>      // 属性值（已降解为字符串，含颜色/尺寸原文）
var g_aown: table<i64>
var g_mod: table<string>     // 修饰（无值属性）
var g_mown: table<i64>
var g_ev: table<string>      // 事件名（on_click 等）
var g_evh: table<string>     // 事件处理器（函数名/端口名）
var g_eown: table<i64>
var g_roots: table<i64>
var g_stack: table<i64>

// ---------- 视图/组件单元 ----------
var g_vkind: table<string>
var g_vname: table<string>
var g_vpn: table<string>     // 参数名/出端口名（与 g_vpt 平行）
var g_vpt: table<string>     // 参数类型/出端口类型书写形态
var g_vpo: table<i64>        // 所属单元节点 id
var g_vio: table<i64>        // 0=参数 1=出端口

// ---------- 图 ----------
var g_gn: table<string>      // 图层名
var g_gnode: table<string>   // 节点名（与 g_gnow 平行）
var g_gnow: table<i64>
var g_gfrom: table<string>
var g_gto: table<string>
var g_gwhen: table<string>
var g_gow: table<i64>

// ---------- 样式/主题/层/作用域单元 ----------
var g_uk: table<string>
var g_un: table<string>
var g_ud: table<string>      // 载荷原文 "k:v;k:v"

var g_ready: bool = false

func ensure() {
    if g_ready {
        return
    }
    g_ready = true
    g_kind = table_new_string()
    g_name = table_new_string()
    g_parent = table_new_i64()
    g_ak = table_new_string()
    g_av = table_new_string()
    g_aown = table_new_i64()
    g_mod = table_new_string()
    g_mown = table_new_i64()
    g_ev = table_new_string()
    g_evh = table_new_string()
    g_eown = table_new_i64()
    g_roots = table_new_i64()
    g_stack = table_new_i64()
    g_vkind = table_new_string()
    g_vname = table_new_string()
    g_vpn = table_new_string()
    g_vpt = table_new_string()
    g_vpo = table_new_i64()
    g_vio = table_new_i64()
    g_gn = table_new_string()
    g_gnode = table_new_string()
    g_gnow = table_new_i64()
    g_gfrom = table_new_string()
    g_gto = table_new_string()
    g_gwhen = table_new_string()
    g_gow = table_new_i64()
    g_uk = table_new_string()
    g_un = table_new_string()
    g_ud = table_new_string()
    g_fnow = table_new_i64()
    g_fnname = table_new_string()
    g_fnfn = []
    g_port = table_new_string()
    g_pown = table_new_i64()
    g_upk = table_new_string()
    g_upv = table_new_string()
    g_upown = table_new_i64()
    g_rsel = table_new_string()
    g_rprop = table_new_string()
    g_rval = table_new_string()
    g_urown = table_new_i64()
    g_thname = table_new_string()
    g_thkey = table_new_string()
    g_thval = table_new_string()
    g_layers = table_new_string()
}

// 清空全部 UI 数据（测试与重入场景）。
pub func reset() {
    g_ready = false
    ensure()
}

// ---------- 元素构造 ----------

// 开一个元素：kind 是元素名（window/panel/button…或任何未定义标识符），
// name 是实例名（可空）。新元素挂到「当前父节点」下并成为新的当前节点。
pub func begin(kind: string, name: string) -> i64 {
    ensure()
    var id = len(g_kind)
    table_push(g_kind, kind)
    table_push(g_name, name)
    var parent: i64 = -1
    if len(g_stack) > 0 {
        parent = g_stack[len(g_stack) - 1]
    }
    table_push(g_parent, parent)
    if parent < 0 {
        table_push(g_roots, id)
    }
    table_push(g_stack, id)
    return id
}

// 关当前元素（弹栈）。返回关闭的节点 id（空栈返回 -1）。
pub func end() -> i64 {
    ensure()
    var n = len(g_stack)
    if n == 0 {
        return -1
    }
    var id = g_stack[n - 1]
    table_trunc(g_stack, n - 1)
    return id
}

// 当前节点（栈顶），无则 -1。
pub func current() -> i64 {
    ensure()
    var n = len(g_stack)
    if n == 0 {
        return -1
    }
    return g_stack[n - 1]
}

// 给当前节点加属性（键值都按书写原文存字符串）。
pub func attr_str(key: string, value: string) -> i64 {
    ensure()
    var id = current()
    if id < 0 {
        return -1
    }
    table_push(g_ak, key)
    table_push(g_av, value)
    table_push(g_aown, id)
    return id
}

// 给当前节点加修饰（无值属性，如 accent）。
pub func modifier(name: string) -> i64 {
    ensure()
    var id = current()
    if id < 0 {
        return -1
    }
    table_push(g_mod, name)
    table_push(g_mown, id)
    return id
}

// 给当前节点加文本内容（内容字符串=子文本元素）。
pub func content(s: string) -> i64 {
    var id = begin("text", "")
    table_push(g_av, s)
    table_push(g_ak, "content")
    table_push(g_aown, id)
    return end()
}

// 给当前节点绑定事件：on_click/on_submit… → 处理器（函数名或视图出端口）。
pub func on_name(event: string, handler: string) -> i64 {
    ensure()
    var id = current()
    if id < 0 {
        return -1
    }
    table_push(g_ev, event)
    table_push(g_evh, handler)
    table_push(g_eown, id)
    return id
}

// ---------- 元素查询 ----------
pub func count() -> i64 {
    ensure()
    return len(g_kind)
}

pub func kind_at(id: i64) -> string {
    ensure()
    if id < 0 || id >= len(g_kind) {
        return ""
    }
    return g_kind[id]
}

pub func name_at(id: i64) -> string {
    ensure()
    if id < 0 || id >= len(g_name) {
        return ""
    }
    return g_name[id]
}

pub func parent_at(id: i64) -> i64 {
    ensure()
    if id < 0 || id >= len(g_parent) {
        return -1
    }
    return g_parent[id]
}

pub func root_count() -> i64 {
    ensure()
    return len(g_roots)
}

pub func root_at(i: i64) -> i64 {
    ensure()
    if i < 0 || i >= len(g_roots) {
        return -1
    }
    return g_roots[i]
}

// 按实例名查节点（同名取先建者）；不存在返回 -1。
pub func find(name: string) -> i64 {
    ensure()
    var i: i64 = 0
    while i < len(g_name) {
        if g_name[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

pub func child_count(id: i64) -> i64 {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_parent) {
        if g_parent[i] == id {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub func child_at(id: i64, k: i64) -> i64 {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_parent) {
        if g_parent[i] == id {
            if n == k {
                return i
            }
            n = n + 1
        }
        i = i + 1
    }
    return -1
}

pub func attr_of(id: i64, key: string) -> string {
    ensure()
    var i: i64 = 0
    while i < len(g_ak) {
        if g_aown[i] == id && g_ak[i] == key {
            return g_av[i]
        }
        i = i + 1
    }
    return ""
}

pub func attr_count(id: i64) -> i64 {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_ak) {
        if g_aown[i] == id {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub func attr_key_at(id: i64, k: i64) -> string {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_ak) {
        if g_aown[i] == id {
            if n == k {
                return g_ak[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

pub func attr_val_at(id: i64, k: i64) -> string {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_ak) {
        if g_aown[i] == id {
            if n == k {
                return g_av[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

pub func mod_count(id: i64) -> i64 {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_mod) {
        if g_mown[i] == id {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub func mod_at(id: i64, k: i64) -> string {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_mod) {
        if g_mown[i] == id {
            if n == k {
                return g_mod[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

pub func has_mod(id: i64, name: string) -> bool {
    ensure()
    var i: i64 = 0
    while i < len(g_mod) {
        if g_mown[i] == id && g_mod[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

pub func event_count(id: i64) -> i64 {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_ev) {
        if g_eown[i] == id {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub func event_at(id: i64, k: i64) -> string {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_ev) {
        if g_eown[i] == id {
            if n == k {
                return g_ev[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

pub func handler_at(id: i64, k: i64) -> string {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_ev) {
        if g_eown[i] == id {
            if n == k {
                return g_evh[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

// ---------- 视图/组件单元 ----------

// 开一个视图/组件单元（单元本身也是一个元素节点，故内部元素自动归属）。
pub func view_begin(kind: string, name: string) -> i64 {
    var id = begin(kind, name)
    table_push(g_vkind, kind)
    table_push(g_vname, name)
    return id
}

// 登记单元形参：name 形参名，ty 类型书写形态。
pub func view_param(name: string, ty: string) -> i64 {
    var id = current()
    table_push(g_vpn, name)
    table_push(g_vpt, ty)
    table_push(g_vpo, id)
    table_push(g_vio, 0)
    return id
}

// 登记单元出端口（动作契约）。
pub func view_out(name: string, ty: string) -> i64 {
    var id = current()
    table_push(g_vpn, name)
    table_push(g_vpt, ty)
    table_push(g_vpo, id)
    table_push(g_vio, 1)
    return id
}

pub func view_end() -> i64 {
    return end()
}

// 单元参数数（io=0）或出端口数（io=1）。
pub func view_io_count(id: i64, io: i64) -> i64 {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_vpn) {
        if g_vpo[i] == id && g_vio[i] == io {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub func view_io_name(id: i64, io: i64, k: i64) -> string {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_vpn) {
        if g_vpo[i] == id && g_vio[i] == io {
            if n == k {
                return g_vpn[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

pub func view_io_type(id: i64, io: i64, k: i64) -> string {
    ensure()
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_vpt) {
        if g_vpo[i] == id && g_vio[i] == io {
            if n == k {
                return g_vpt[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

// ---------- 样式/主题/层/作用域单元 ----------

// 声明一个样式单元：kind = style/theme/layer/scope，payload = 块体原文
// （"k:v;k:v"——条目间 `;`，键值间 `:`）。返回单元序号（从 0 起）。
pub func unit_decl(kind: string, name: string, payload: string) -> i64 {
    ensure()
    var id = len(g_uk)
    table_push(g_uk, kind)
    table_push(g_un, name)
    table_push(g_ud, payload)
    return id
}

pub func unit_count() -> i64 {
    ensure()
    return len(g_uk)
}

pub func unit_kind_at(i: i64) -> string {
    ensure()
    if i < 0 || i >= len(g_uk) {
        return ""
    }
    return g_uk[i]
}

pub func unit_name_at(i: i64) -> string {
    ensure()
    if i < 0 || i >= len(g_un) {
        return ""
    }
    return g_un[i]
}

pub func unit_payload_at(i: i64) -> string {
    ensure()
    if i < 0 || i >= len(g_ud) {
        return ""
    }
    return g_ud[i]
}

pub func unit_find(kind: string, name: string) -> i64 {
    ensure()
    var i: i64 = 0
    while i < len(g_uk) {
        if g_uk[i] == kind && g_un[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// 取样式单元的某个属性值（按 "k:v;k:v" 载荷切分）；不存在返回空串。
pub func unit_prop(kind: string, name: string, key: string) -> string {
    var u = unit_find(kind, name)
    if u < 0 {
        return ""
    }
    var items = str.split(g_ud[u], ";")
    var i: i64 = 0
    while i < len(items) {
        var it = str.trim(items[i])
        var c = str.find(it, ":")
        if c > 0 {
            var k = str.trim(str.slice(it, 0, c))
            if k == key {
                return str.trim(str.slice(it, c + 1, len(it)))
            }
        }
        i = i + 1
    }

    return ""
}
// ---------- 类型化属性（§14.4：属性值是表达式，保留值类型） ----------

// 整数属性。
pub func attr_i64(key: string, value: i64) -> i64 {
    return attr_str(key, to_string(value))
}

// 浮点属性。
pub func attr_f64(key: string, value: f64) -> i64 {
    return attr_str(key, to_string(value))
}

// 布尔属性。
pub func attr_bool(key: string, value: bool) -> i64 {
    if value {
        return attr_str(key, "true")
    }
    return attr_str(key, "false")
}

// 结构化字面量的书写原文：颜色 #2d7ff9、尺寸 480 x 320、百分比 100%。
pub func attr_raw(key: string, raw: string) -> i64 {
    return attr_str(key, raw)
}

// 计算表达式：保留实参类型后文本化，交后端按需解析。
pub func attr_expr<T>(key: string, value: T) -> i64 {
    return attr_str(key, to_string(value))
}

// 分布 / 溢出 / 锚点词的规范文本（枚举 → §9 降级表形态）。
// 枚举类型不能与同名 namespace 共存（`Dist.to_attr` 会被当成变体查找），
// 所以这三张词表放在 ui 命名空间里，只有 struct 形的 Size 用 `Size.to_attr`。
pub func dist_attr(d: Dist) -> string {
    switch d {
    case Dist.start: return "start"
    case Dist.center: return "center"
    case Dist.end: return "end"
    case Dist.space_between: return "space-between"
    case Dist.space_around: return "space-around"
    case Dist.space_evenly: return "space-evenly"
    case Dist.stretch: return "stretch"
    }
    return "start"
}

pub func overflow_attr(o: Overflow) -> string {
    switch o {
    case Overflow.clip: return "clip"
    case Overflow.scroll: return "scroll"
    case Overflow.expand: return "expand"
    case Overflow.err: return "error"
    }
    return "clip"
}

pub func anchor_attr(a: Anchor) -> string {
    switch a {
    case Anchor.top_start: return "top-start"
    case Anchor.top: return "top"
    case Anchor.top_end: return "top-end"
    case Anchor.start: return "start"
    case Anchor.center: return "center"
    case Anchor.end: return "end"
    case Anchor.bottom_start: return "bottom-start"
    case Anchor.bottom: return "bottom"
    case Anchor.bottom_end: return "bottom-end"
    case Anchor.fill: return "fill"
    }
    return "center"
}

// ---------- 布局设置器（§9 键类型表：类型化键写回规范字符串） ----------
// 这些函数是解析期降解的目标：属性值先按类型构造（Size/Dist/Overflow/Anchor），
// 再在这里折成规范文本存进键值表——属性表形态与类型化之前逐字节一致，
// 渲染后端与 `attr_of` 的现存契约不变。

// 宽、高与轴向限制（Size）。
pub func w(s: Size) -> i64 { return attr_str("w", Size.to_attr(s)) }
pub func h(s: Size) -> i64 { return attr_str("h", Size.to_attr(s)) }
pub func min_w(s: Size) -> i64 { return attr_str("min-w", Size.to_attr(s)) }
pub func max_w(s: Size) -> i64 { return attr_str("max-w", Size.to_attr(s)) }
pub func min_h(s: Size) -> i64 { return attr_str("min-h", Size.to_attr(s)) }
pub func max_h(s: Size) -> i64 { return attr_str("max-h", Size.to_attr(s)) }

// 轴分布（Dist）：x/y 的分布词绑定绝对轴，不随书写方向翻转。
pub func dist_x(d: Dist) -> i64 { return attr_str("x", dist_attr(d)) }
pub func dist_y(d: Dist) -> i64 { return attr_str("y", dist_attr(d)) }

// 溢出策略与锚点。
pub func overflow(o: Overflow) -> i64 { return attr_str("overflow", overflow_attr(o)) }
pub func anchor(a: Anchor) -> i64 { return attr_str("anchor", anchor_attr(a)) }

// 长度类（§9：i64 / 长度）。
pub func pad(n: i64) -> i64 { return attr_str("pad", to_string(n)) }
pub func pad_x(n: i64) -> i64 { return attr_str("pad-x", to_string(n)) }
pub func pad_y(n: i64) -> i64 { return attr_str("pad-y", to_string(n)) }
pub func pad_top(n: i64) -> i64 { return attr_str("pad-top", to_string(n)) }
pub func pad_right(n: i64) -> i64 { return attr_str("pad-right", to_string(n)) }
pub func pad_bottom(n: i64) -> i64 { return attr_str("pad-bottom", to_string(n)) }
pub func pad_left(n: i64) -> i64 { return attr_str("pad-left", to_string(n)) }
pub func gap(n: i64) -> i64 { return attr_str("gap", to_string(n)) }
pub func dx(n: i64) -> i64 { return attr_str("dx", to_string(n)) }
pub func dy(n: i64) -> i64 { return attr_str("dy", to_string(n)) }
pub func radius(n: i64) -> i64 { return attr_str("radius", to_string(n)) }
pub func font_size(n: i64) -> i64 { return attr_str("font-size", to_string(n)) }
pub func border(n: i64) -> i64 { return attr_str("border", to_string(n)) }

// 样式引用（§9：style → 样式名）。
pub func style_ref(name: string) -> i64 { return attr_str("style", name) }

// ---------- 事件：函数值（§14.4 on_事件名: 函数值） ----------

// 在当前节点上绑定函数值事件处理器。
pub func on(event: string, handler: fn(i64, i64, i64, string) -> i64) -> i64 {
    ensure()
    table_push(g_fnow, current())
    table_push(g_fnname, event)
    table_push(g_fnfn, handler)
    return len(g_fnow) - 1
}

// 在指定节点上触发事件：命中函数值处理器则调用并返回其返回值。
pub func fire_at(id: i64, event: string, x: i64, y: i64, kind: string) -> i64 {
    ensure()
    var i: i64 = 0
    var n = len(g_fnow)
    while i < n {
        if g_fnow[i] == id && g_fnname[i] == event {
            var fh = g_fnfn[i]
            return fh(id, x, y, kind)
        }
        i = i + 1
    }
    return -1
}

// 在当前节点上触发事件。
pub func fire(event: string, x: i64, y: i64, kind: string) -> i64 {
    return fire_at(current(), event, x, y, kind)
}

// 指定节点上是否绑定了名为 event 的函数值处理器。
pub func has_fn_event(id: i64, event: string) -> bool {
    ensure()
    var i: i64 = 0
    while i < len(g_fnow) {
        if g_fnow[i] == id && g_fnname[i] == event {
            return true
        }
        i = i + 1
    }
    return false
}

// ---------- 端口（§14.6 出端口：-> Inc） ----------

// 在当前节点上登记一个出端口名。
pub func port_add(name: string) -> i64 {
    ensure()
    table_push(g_port, name)
    table_push(g_pown, current())
    return len(g_port) - 1
}

pub func port_count(id: i64) -> i64 {
    ensure()
    var i: i64 = 0
    var n: i64 = 0
    while i < len(g_port) {
        if g_pown[i] == id {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub func port_at(id: i64, k: i64) -> string {
    ensure()
    var i: i64 = 0
    var n: i64 = 0
    while i < len(g_port) {
        if g_pown[i] == id {
            if n == k {
                return g_port[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

// ---------- 单元：结构化属性 / 规则 / 主题 / 层 ----------

// 开一个声明式单元（style / theme / scope / layer）。
pub func unit_begin(kind: string, name: string) -> i64 {
    return unit_decl(kind, name, "")
}

// 结构化属性写入（字符串）。
pub func unit_prop_str(u: i64, key: string, value: string) -> i64 {
    ensure()
    table_push(g_upk, key)
    table_push(g_upv, value)
    table_push(g_upown, u)
    return len(g_upk) - 1
}

pub func unit_prop_i64(u: i64, key: string, value: i64) -> i64 {
    return unit_prop_str(u, key, to_string(value))
}

pub func unit_prop_raw(u: i64, key: string, raw: string) -> i64 {
    return unit_prop_str(u, key, raw)
}

// 选择器规则：@scope Card { .title { 前景: 表面色 } }。
pub func unit_rule(u: i64, sel: string, prop: string, val: string) -> i64 {
    ensure()
    table_push(g_rsel, sel)
    table_push(g_rprop, prop)
    table_push(g_rval, val)
    table_push(g_urown, u)
    return len(g_rsel) - 1
}

// 主题取值：@theme dark { 表面色 = 深灰900 }。
pub func theme_set(theme: string, key: string, val: string) -> i64 {
    ensure()
    table_push(g_thname, theme)
    table_push(g_thkey, key)
    table_push(g_thval, val)
    return len(g_thkey) - 1
}

// 按主题名查值（未命中返回空串）。
pub func theme_get(theme: string, key: string) -> string {
    ensure()
    var i: i64 = 0
    while i < len(g_thkey) {
        if g_thname[i] == theme && g_thkey[i] == key {
            return g_thval[i]
        }
        i = i + 1
    }
    return ""
}

// 层的声明顺序（@layer base, components, overrides）。
pub func layer_decl(name: string) -> i64 {
    ensure()
    table_push(g_layers, name)
    return len(g_layers) - 1
}

pub func layer_count() -> i64 {
    ensure()
    return len(g_layers)
}

pub func layer_at(i: i64) -> string {
    ensure()
    return g_layers[i]
}

// 单元属性查询：先查结构化登记，未命中回退载荷形态。
pub func unit_prop_find(kind: string, name: string, key: string) -> string {
    ensure()
    var u = unit_find(kind, name)
    if u >= 0 {
        var i: i64 = 0
        while i < len(g_upk) {
            if g_upown[i] == u && g_upk[i] == key {
                return g_upv[i]
            }
            i = i + 1
        }
        return unit_prop(kind, name, key)
    }
    return ""
}

pub func rule_count(u: i64) -> i64 {
    ensure()
    var i: i64 = 0
    var n: i64 = 0
    while i < len(g_rsel) {
        if g_urown[i] == u {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

pub func rule_sel_at(u: i64, k: i64) -> string {
    ensure()
    var i: i64 = 0
    var n: i64 = 0
    while i < len(g_rsel) {
        if g_urown[i] == u {
            if n == k {
                return g_rsel[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

pub func rule_prop_at(u: i64, k: i64) -> string {
    ensure()
    var i: i64 = 0
    var n: i64 = 0
    while i < len(g_rsel) {
        if g_urown[i] == u {
            if n == k {
                return g_rprop[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

pub func rule_val_at(u: i64, k: i64) -> string {
    ensure()
    var i: i64 = 0
    var n: i64 = 0
    while i < len(g_rsel) {
        if g_urown[i] == u {
            if n == k {
                return g_rval[i]
            }
            n = n + 1
        }
        i = i + 1
    }
    return ""
}

// 按名字找视图/组件单元，未命中返回 -1。
pub func view_find(kind: string, name: string) -> i64 {
    ensure()
    var i: i64 = 0
    while i < len(g_vkind) {
        if g_vkind[i] == kind && g_vname[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}
}
