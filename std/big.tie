type tie<class>
// ============================================================================
// big.tie：标准库——有符号任意精度整数类型 Big（命名空间 Big）
// 用途：数值底座唯一大数内核（ROAD p.9.10.11）。dec 真小数（p.9.10.10）慢径、
//   进制转换器（p.9.10.12）、素数寻找器（p.9.10.13）大数域全部消费本模块，
//   零重复实现。u64/i128 能算的场景不绕道 big（快径纪律，同 dec 哲学）。
//
// == 表示方案（limb 布局与位宽）==
//   有符号整数 = 符号（neg: bool）× 系数（limbs: table<i64>），系数为变长
//   **基 10^18** 小端肢数组（limbs[0] 为最低位）。
//   - 每个 limb 恒 ∈ [0, 10^18)，存进 i64（正数，符号位恒 0）。
//   - 为何基 10^18 而非 2^32：与 dec 慢径同源（尾零处理/十进制串化天然高效，
//     每肢恰 18 个十进制位）；任意两肢乘积 < (10^18)^2 = 10^36 < 2^120，
//     配合 u128 中间量乘/进位/试商永不溢出。
//   - 归一化不变量：最高肢非零；**数值 0 表示为空表（len==0）且 neg=false**
//     （规范零：零只有一种表示，is_zero/相等语义/串化因此自洽）。
//   - i128 中间积为关键底座（tests/language/i128_full.tie 验收）；i64 肢内
//     加/借位链 t < 2·10^18 < 2^63，i64 充裕，无需升宽。
//
// == 语义纪律（对齐 dec 设计）==
//   - **不可变值类型**：运算恒返回新 Big，从不原地改 limbs。struct 赋值/传参
//     为句柄拷贝（limbs 表共享），因不可变约定而安全（无别名突变风险）；
//     neg/abs 零分配共享 limbs（O(1)）。
//   - 用户侧仍可能用 struct 字面量 Big(true, t) 绕过规范零——文档约定不鼓励；
//     op_eq/比较已按「空表即零、与符号无关」防御，规范零泄漏不影响比较语义。
//   - 构造与解析的非法输入**陷阱**（可捕获 panic，对齐 p.9.11.9 checked 哲学）：
//     静默返回 0 的容错约定（bigint.from_hex 风格）在数值类型上是偏差隐患，
//     本模块不做。
//
// == 与 std/bigint.tie 的边界（写清避免「两个大数」混淆）==
//   bigint.tie：密码域无符号大数（基 2^32 肢、十六进制编解码、模幂/模逆、
//     常数时间注记）——服务 Ed25519/X25519/RSA 等，函数式 limb 表接口。
//   big.tie：通用数值域有符号大数（基 10^18 肢、struct 值类型、op_ 运算符
//     重载、十进制文法）——服务 dec/进制器/素数器与科学计算。
//   两者表示与语义不同（无符号模运算域 vs 有符号精确值域），并存不重叠；
//   合并评估留待算法族演进（不做预设）。
//
// == 错误/边界约定 ==
//   - parse("")/parse("-")/含非十进制字符 → panic（可捕获）。
//   - 除法/取模本子项未含（p.9.10.11.2 落地，届时除零陷阱）。
//   - op_ 混合运算边界（p.8.2.4 裁决表，如实写明）：`Big + i64` 不成立
//     （op_ 形参严格类型匹配，无隐式构造提升）——惯用法
//     `x + Big.from_i64(1)`；文档化代价，与 dec 同题同解。
//
// == 命名空间说明 ==
//   命名空间 = Big（与类型同名）：p.8.2.4 op_ 方法绑定的命名约定要求
//   <Struct>::op_X 形态，命名空间必须与 struct 同名；设计文档原拟小写 big，
//   落地以契约为准（调用面 Big.parse / Big.to_str）。
//
// 依赖：仅原生原语（str_len/str_char/char_code/len/table_new_*/table_push/
//   to_string/as_u128/as_i64/u128·i128 算术 + panic），不 import 任何 std 模块，
//   自包含。
// 命名规范：命名空间内互调为裸调用，公共 API 全部 pub（Big.xxx 调用）。
// 分期：本文件 = p.9.10.11.1（表示/构造/比较/加减乘/十进制串化）；
//   p.9.10.11.2 补除模/gcd/lcm/pow 与任意基串化；dec 改挂 big 同批。
// ============================================================================

// 十进制数字台（模块级顶层字符串全局，b48/bigint 同模式）。
var DIGITS: string = "0123456789"

// 肢基数 10^18（i64 域乘加安全上界见头部论证）。
var LIMB: i64 = 1000000000000000000
// 肢基数的 u128 形态（乘法内层除/模用）。
var LIMB_U: u128 = 1000000000000000000u128

struct Big {
    var neg: bool = false
    var limbs: table<i64> = []
}

namespace Big {

// ---------------------------------------------------------------------------
// 归一化与内部工具
// ---------------------------------------------------------------------------

// 归一化构造：去最高端零肢 + 规范零（空表 → neg=false）。
// 全部公共运算经此出口，保证「零只有一种表示」不变量。
func make(neg: bool, limbs: table<i64>) -> Big {
    var n = len(limbs)
    var top = n
    while top > 0 && limbs[top - 1] == 0 {
        top = top - 1
    }
    if top == 0 {
        return Big(false, table_new_i64())
    }
    var r = table_new_i64()
    var i: i64 = 0
    while i < top {
        table_push(r, limbs[i])
        i = i + 1
    }
    return Big(neg, r)
}

// 复制表（tie 表赋值会句柄别名，需显式 clone；返回全新表）。
func clone_limbs(a: table<i64>) -> table<i64> {
    var r = table_new_i64()
    var i: i64 = 0
    while i < len(a) {
        table_push(r, a[i])
        i = i + 1
    }
    return r
}

// 幅值比较：-1 / 0 / 1（与符号无关，只比 |x|）。
func cmp_mag(a: table<i64>, b: table<i64>) -> i64 {
    var na = len(a)
    var nb = len(b)
    if na != nb {
        if na > nb {
            return 1
        }
        return -1
    }
    var i: i64 = na - 1
    while i >= 0 {
        if a[i] != b[i] {
            if a[i] > b[i] {
                return 1
            }
            return -1
        }
        i = i - 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// 幅值算术（无符号域，op_ 层负责符号）
// ---------------------------------------------------------------------------

// 幅值加法（进位链）：肢和 < 2·10^18 < 2^63，i64 充裕。
func add_mag(a: table<i64>, b: table<i64>) -> table<i64> {
    var r = table_new_i64()
    var na = len(a)
    var nb = len(b)
    var nmax: i64 = na
    if nb > nmax {
        nmax = nb
    }
    var carry: i64 = 0
    var i: i64 = 0
    while i < nmax {
        var va: i64 = 0
        if i < na {
            va = a[i]
        }
        var vb: i64 = 0
        if i < nb {
            vb = b[i]
        }
        var s = va + vb + carry
        if s >= LIMB {
            s = s - LIMB
            carry = 1
        } else {
            carry = 0
        }
        table_push(r, s)
        i = i + 1
    }
    if carry > 0 {
        table_push(r, carry)
    }
    return r
}

// 幅值减法（借位链；约定 |a| ≥ |b|，op_add 已按大小择序）。
func sub_mag(a: table<i64>, b: table<i64>) -> table<i64> {
    var r = table_new_i64()
    var na = len(a)
    var nb = len(b)
    var borrow: i64 = 0
    var i: i64 = 0
    while i < na {
        var vb: i64 = 0
        if i < nb {
            vb = b[i]
        }
        var d = a[i] - vb - borrow
        if d < 0 {
            d = d + LIMB
            borrow = 1
        } else {
            borrow = 0
        }
        table_push(r, d)
        i = i + 1
    }
    // 高位借位清零 → 归一化去顶零。
    return make_norm(r)
}

// make 的肢域别名（sub_mag 内部复用归一化；不设符号）。
func make_norm(x: table<i64>) -> table<i64> {
    var n = len(x)
    var top = n
    while top > 0 && x[top - 1] == 0 {
        top = top - 1
    }
    var r = table_new_i64()
    var i: i64 = 0
    while i < top {
        table_push(r, x[i])
        i = i + 1
    }
    return r
}

// 幅值乘法（schoolbook，u128 内层）：
//   t = a[i]·b[j] + r[i+j] + carry ≤ (10^18-1)^2 + 2·(10^18-1) < 10^36 < 2^120，
//   u128 充裕；肢提取 t % 10^18、进位 t / 10^18 均单宽完成。
func mul_mag(a: table<i64>, b: table<i64>) -> table<i64> {
    var na = len(a)
    var nb = len(b)
    if na == 0 || nb == 0 {
        return table_new_i64()
    }
    var r = table_new_i64()
    var i: i64 = 0
    while i < na + nb {
        table_push(r, 0)
        i = i + 1
    }
    i = 0
    while i < na {
        var carry: u128 = to_u128(0)
        var j: i64 = 0
        while j < nb {
            var t: u128 = to_u128(a[i]) * to_u128(b[j]) + to_u128(r[i + j]) + carry
            r[i + j] = to_i64(t % LIMB_U)
            carry = t / LIMB_U
            j = j + 1
        }
        // 折入高位进位（标准 schoolbook 上界论证：不会再越出 r[na+nb-1]）。
        var k: i64 = i + nb
        while carry != to_u128(0) && k < na + nb {
            var t2: u128 = to_u128(r[k]) + carry
            r[k] = to_i64(t2 % LIMB_U)
            carry = t2 / LIMB_U
            k = k + 1
        }
        i = i + 1
    }
    return make_norm(r)
}

// 幅值 × 单肢（m ≤ 10^18；parse 分块累加用）：
//   t = a[i]·m + carry ≤ (10^18-1)·10^18 + (10^18-1) < 10^36 < 2^120，u128 充裕。
func mul_limb(a: table<i64>, m: i64) -> table<i64> {
    var r = table_new_i64()
    var carry: i64 = 0
    var i: i64 = 0
    while i < len(a) {
        var t: u128 = to_u128(a[i]) * to_u128(m) + to_u128(carry)
        table_push(r, to_i64(t % LIMB_U))
        carry = to_i64(t / LIMB_U)
        i = i + 1
    }
    if carry > 0 {
        table_push(r, carry)
    }
    return r
}

// 幅值 + 单肢（d ∈ [0, 10^18)；parse 分块累加用）：和 < 2·10^18，i64 充裕。
func add_limb(a: table<i64>, d: i64) -> table<i64> {
    var r = table_new_i64()
    var carry: i64 = d
    var i: i64 = 0
    while i < len(a) && carry > 0 {
        var s = a[i] + carry
        if s >= LIMB {
            s = s - LIMB
            carry = 1
        } else {
            carry = 0
        }
        table_push(r, s)
        i = i + 1
    }
    while i < len(a) {
        table_push(r, a[i])
        i = i + 1
    }
    if carry > 0 {
        table_push(r, carry)
    }
    return r
}

// ---------------------------------------------------------------------------
// 构造
// ---------------------------------------------------------------------------

// 规范零：`Big()` 零参构造（全字段默认 = Big(false, 空表)）。
// 注：设计文档 API 面原拟 `zero()`——`zero` 是 tie 保留关键字（字面量零，
// 同 true/false 族），函数名不可占用；零参构造即规范零出口，语义等价。
// 该勘误随实现记录（dec 设计 API 面的 zero() 同题，落地时同解）。

// i128 → Big（i64 一并覆盖；i128::MIN 经首肢直取处理，无回绕）。
// 负值首肢：r0 = -(m % B) ∈ [0,B)（tie % 为截断除余数，负值余数 ≤ 0）；
// 其后 |m/B| < 2^127 / 10^18，i128 正数充裕，正常分肢。
pub func from_i128(v: i128) -> Big {
    var neg: bool = v < 0i128
    var limbs = table_new_i64()
    if v == 0i128 {
        return Big(false, limbs)
    }
    var m: i128 = v
    if neg {
        var r0: i128 = -(m % 1000000000000000000i128)
        table_push(limbs, to_i64(r0))
        m = m / 1000000000000000000i128
        m = -m
    }
    while m > 0i128 {
        table_push(limbs, to_i64(m % 1000000000000000000i128))
        m = m / 1000000000000000000i128
    }
    return Big(neg, limbs)
}

// i64 → Big（i128 承接，i64::MIN 无回绕）。
pub func from_i64(v: i64) -> Big {
    return from_i128(to_i128(v))
}

// 十进制文法解析（零偏差：数字串直入 limbs，永不过浮点）。
//   文法：['-'|'+']? 数字+（前导零允许，归一化消除；"-0" → 规范零）。
//   非法输入陷阱（可捕获）：空串/仅有符号/含非十进制字符。
//   算法：自右按 18 位分块 chunk，acc = acc·10^18 + chunk（mul_limb+add_limb）。
pub func parse(s: string) -> Big {
    var n: i64 = str_len(s)
    var start: i64 = 0
    var neg: bool = false
    if n > 0 && str_char(s, 0) == "-" {
        neg = true
        start = 1
    } else if n > 0 && str_char(s, 0) == "+" {
        start = 1
    }
    if n - start <= 0 {
        panic("big.parse: 空字符串（或仅有符号）不是合法十进制整数")
    }
    var i: i64 = start
    while i < n {
        var d = char_code(str_char(s, i)) - 48
        if d < 0 || d > 9 {
            panic("big.parse: 非法十进制字符")
        }
        i = i + 1
    }
    var acc = table_new_i64()
    var end: i64 = n
    while end > start {
        var cstart = end - 18
        if cstart < start {
            cstart = start
        }
        var chunk: i64 = 0
        var j: i64 = cstart
        while j < end {
            chunk = chunk * 10 + (char_code(str_char(s, j)) - 48)
            j = j + 1
        }
        acc = mul_limb(acc, LIMB)
        acc = add_limb(acc, chunk)
        end = cstart
    }
    return make(neg, acc)
}

// ---------------------------------------------------------------------------
// 查询（计算属性形态：零额外参数，x.is_zero / x.sign 直读）
// ---------------------------------------------------------------------------

// 是否零（空表即零，与符号位无关）。
pub func is_zero(self: Big) -> bool {
    return len(self.limbs) == 0
}

// 符号：-1 / 0 / 1。
pub func sign(self: Big) -> i64 {
    if len(self.limbs) == 0 {
        return 0
    }
    if self.neg {
        return -1
    }
    return 1
}

// 显式全序比较：-1 / 0 / 1（零参与、符号参与，规范零与 -0 同值）。
pub func cmp(self: Big, o: Big) -> i64 {
    var za = len(self.limbs) == 0
    var zo = len(o.limbs) == 0
    if za && zo {
        return 0
    }
    if za {
        if o.neg {
            return 1
        }
        return -1
    }
    if zo {
        if self.neg {
            return -1
        }
        return 1
    }
    if self.neg == o.neg {
        var c = cmp_mag(self.limbs, o.limbs)
        if self.neg {
            return -c
        }
        return c
    }
    if self.neg {
        return -1
    }
    return 1
}

// 绝对值（零分配：共享 limbs，符号归正；零经规范正零）。
pub func abs(self: Big) -> Big {
    return Big(false, self.limbs)
}

// ---------------------------------------------------------------------------
// 运算符重载（op_ 契约，p.8.2.4；形参严格 Big，混合整数运算走显式构造）
// ---------------------------------------------------------------------------

// 加法：同号幅值相加；异号比幅值、大减小、号随大（幅值相等 → 规范零）。
pub func op_add(self: Big, o: Big) -> Big {
    if self.neg == o.neg {
        return make(self.neg, add_mag(self.limbs, o.limbs))
    }
    var c = cmp_mag(self.limbs, o.limbs)
    if c == 0 {
        return Big(false, table_new_i64())
    }
    if c > 0 {
        return make(self.neg, sub_mag(self.limbs, o.limbs))
    }
    return make(o.neg, sub_mag(o.limbs, self.limbs))
}

// 减法：a - b = a + (-b)（复用加法的号/幅值裁决）。
pub func op_sub(self: Big, o: Big) -> Big {
    return op_add(self, op_neg(o))
}

// 乘法：幅值相乘，号 = 异或（零由 make 规范）。
pub func op_mul(self: Big, o: Big) -> Big {
    return make(self.neg != o.neg, mul_mag(self.limbs, o.limbs))
}

// 一元负号（零分配：共享 limbs；零保持规范正零）。
pub func op_neg(self: Big) -> Big {
    if len(self.limbs) == 0 {
        return Big(false, self.limbs)
    }
    return Big(!self.neg, self.limbs)
}

// 相等：零与符号无关（防御非规范零）；其余号同且幅值同。
pub func op_eq(self: Big, o: Big) -> bool {
    var za = len(self.limbs) == 0
    var zo = len(o.limbs) == 0
    if za || zo {
        return za && zo
    }
    if self.neg != o.neg {
        return false
    }
    return cmp_mag(self.limbs, o.limbs) == 0
}

pub func op_ne(self: Big, o: Big) -> bool {
    return !op_eq(self, o)
}

pub func op_lt(self: Big, o: Big) -> bool {
    return cmp(self, o) < 0
}

pub func op_le(self: Big, o: Big) -> bool {
    return cmp(self, o) <= 0
}

pub func op_gt(self: Big, o: Big) -> bool {
    return cmp(self, o) > 0
}

pub func op_ge(self: Big, o: Big) -> bool {
    return cmp(self, o) >= 0
}

// ---------------------------------------------------------------------------
// 十进制串化（最小表示：无前导零，0 → "0"，负数 "-" 前缀）
//   基 10^18 肢的红利：最高肢裸 to_string，其余肢恒 18 位补零直出，
//   无逐位除法全串开销（除/模各 17 次/肢，i64 域）。
//   任意基串化（tie 连续字符台）归 p.9.10.11.2。
// ---------------------------------------------------------------------------

pub func to_str(self: Big) -> string {
    var n = len(self.limbs)
    if n == 0 {
        return "0"
    }
    // 10^0..10^17（逐位提取用，10^18 恒不需要：肢 < 10^18）。
    var pow10: table<i64> = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000, 1000000000000000, 10000000000000000, 100000000000000000]
    var out: string = ""
    if self.neg {
        out = "-"
    }
    out = out + to_string(self.limbs[n - 1])
    var i: i64 = n - 2
    while i >= 0 {
        var limb = self.limbs[i]
        var k: i64 = 17
        while k >= 0 {
            out = out + str_char(DIGITS, (limb / pow10[k]) % 10)
            k = k - 1
        }
        i = i - 1
    }
    return out
}

}   // namespace Big
