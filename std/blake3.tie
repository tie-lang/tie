        var x52c = v15 ^ v0
        v15 = ((x52c >> 8) | (x52c << 24)) & 4294967295
        v10 = (v10 + v15) & 4294967295
        var x52d = v5 ^ v10
        v5 = ((x52d >> 7) | (x52d << 25)) & 4294967295
        v1 = (v1 + v6 + w2) & 4294967295
        var x53a = v12 ^ v1
        v12 = ((x53a >> 16) | (x53a << 16)) & 4294967295
        v11 = (v11 + v12) & 4294967295
        var x53b = v6 ^ v11
        v6 = ((x53b >> 12) | (x53b << 20)) & 4294967295
        v1 = (v1 + v6 + w12) & 4294967295
        var x53c = v12 ^ v1
        v12 = ((x53c >> 8) | (x53c << 24)) & 4294967295
        v11 = (v11 + v12) & 4294967295
        var x53d = v6 ^ v11
        v6 = ((x53d >> 7) | (x53d << 25)) & 4294967295
        v2 = (v2 + v7 + w3) & 4294967295
        var x54a = v13 ^ v2
        v13 = ((x54a >> 16) | (x54a << 16)) & 4294967295
        v8 = (v8 + v13) & 4294967295
        var x54b = v7 ^ v8
        v7 = ((x54b >> 12) | (x54b << 20)) & 4294967295
        v2 = (v2 + v7 + w4) & 4294967295
        var x54c = v13 ^ v2
        v13 = ((x54c >> 8) | (x54c << 24)) & 4294967295
        v8 = (v8 + v13) & 4294967295
        var x54d = v7 ^ v8
        v7 = ((x54d >> 7) | (x54d << 25)) & 4294967295
        v3 = (v3 + v4 + w7) & 4294967295
        var x55a = v14 ^ v3
        v14 = ((x55a >> 16) | (x55a << 16)) & 4294967295
        v9 = (v9 + v14) & 4294967295
        var x55b = v4 ^ v9
        v4 = ((x55b >> 12) | (x55b << 20)) & 4294967295
        v3 = (v3 + v4 + w13) & 4294967295
        var x55c = v14 ^ v3
        v14 = ((x55c >> 8) | (x55c << 24)) & 4294967295
        v9 = (v9 + v14) & 4294967295
        var x55d = v4 ^ v9
        v4 = ((x55d >> 7) | (x55d << 25)) & 4294967295
    var o0 = (v0 ^ v8) & 4294967295
    var o1 = (v1 ^ v9) & 4294967295
    var o2 = (v2 ^ v10) & 4294967295
    var o3 = (v3 ^ v11) & 4294967295
    var o4 = (v4 ^ v12) & 4294967295
    var o5 = (v5 ^ v13) & 4294967295
    var o6 = (v6 ^ v14) & 4294967295
    var o7 = (v7 ^ v15) & 4294967295
    return B3Cv(o0, o1, o2, o3, o4, o5, o6, o7)
}

func chunk_cv(msg: string, n: i64, off: i64, clen: i64, counter: i64, is_root: bool) -> B3Cv {
    var cv = B3Cv(1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225)
    var nblocks: i64 = 1
    if clen > 0 {
        nblocks = (clen + 63) / 64
    }
    var bi: i64 = 0
    while bi < nblocks {
        var start = bi * 64
        var blen: i64 = 64
        if start + 64 > clen {
            blen = clen - start
        }
        var flags: i64 = 0
        if bi == 0 {
            flags = flags | 1
        }
        if bi == nblocks - 1 {
            flags = flags | 2
            if is_root {
                flags = flags | 8
            }
        }
        cv = compress_local(msg, off + start, blen, n, counter, flags, cv.c0, cv.c1, cv.c2, cv.c3, cv.c4, cv.c5, cv.c6, cv.c7)
        bi = bi + 1
    }
    return cv
}

// 父块压缩：block1-16 字 = 左 cv8 + 右 cv8，counter=0，blen=64。

// 32 位值 → 8 位小写 hex（按字节小端：字节低地址在前，字节内高半字节在前）。
func hex8_le(v: i64) -> string {
    var hex = "0123456789abcdef"
    var sb = string_builder()
    var b: i64 = 0
    while b < 4 {
        var hi2 = (v >> (8 * b + 4)) & 0xF
        var lo = (v >> (8 * b)) & 0xF
        sb_append(sb, str_char(hex, hi2))
        sb_append(sb, str_char(hex, lo))
        b = b + 1
    }
    return sb_build(sb)
}

// BLAKE3-256 主入口：输入 ≤1024 → 单 chunk；否则树形合并，输出 32 字节 = 64 hex。
// B3Cv → 32 字节小端 hex。
func hex_cv(cv: B3Cv) -> string {
    var out: string = ""
    out = out + hex8_le(cv.c0)
    out = out + hex8_le(cv.c1)
    out = out + hex8_le(cv.c2)
    out = out + hex8_le(cv.c3)
    out = out + hex8_le(cv.c4)
    out = out + hex8_le(cv.c5)
    out = out + hex8_le(cv.c6)
    out = out + hex8_le(cv.c7)
    return out
}

pub func blake3_256(msg: string) -> string {
    var n: i64 = len(msg)
    if n == 0 {
        var cv0 = chunk_cv(msg, n, 0, 0, 0, true)
        return hex_cv(cv0)
    }
    if n <= 1024 {
        var cv1 = chunk_cv(msg, n, 0, n, 0, true)
        return hex_cv(cv1)
    }
    // 多 chunk：CV 栈（O(log n) 内存，单遍流式——BLAKE3 官方栈算法）
    var stack = table_new_i64()
    var slen: i64 = 0
    var pos: i64 = 0
    var ci: i64 = 0
    var total: i64 = 0
    var cv = B3Cv(1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225)
    while pos < n {
        var clen: i64 = 1024
        if pos + 1024 > n {
            clen = n - pos
        }
        cv = chunk_cv(msg, n, pos, clen, ci, false)
        pos = pos + clen
        ci = ci + 1
        total = total + 1
        // 官方语义：只有「已完成且仍有后续输入」的 chunk 才做子树合并并入栈；
        // 末 chunk 不入栈（它是 finalize 右链的起点）——否则会多合并一次（parent(cv,cv)）。
        if pos < n {
            var t = total
            while t % 2 == 0 {
                var b = (slen - 1) * 8
                var lft = B3Cv(stack[b + 0], stack[b + 1], stack[b + 2], stack[b + 3], stack[b + 4], stack[b + 5], stack[b + 6], stack[b + 7])
                cv = parent_local(lft, cv, 4)
                slen = slen - 1
                t = t / 2
            }
            stack[slen * 8 + 0] = cv.c0
            stack[slen * 8 + 1] = cv.c1
            stack[slen * 8 + 2] = cv.c2
            stack[slen * 8 + 3] = cv.c3
            stack[slen * 8 + 4] = cv.c4
            stack[slen * 8 + 5] = cv.c5
            stack[slen * 8 + 6] = cv.c6
            stack[slen * 8 + 7] = cv.c7
            slen = slen + 1
        }
    }
    // 排空栈：弹出（较旧/较大子树）在左，累积在右；最后一次合并 = 根（PARENT|ROOT）
    var si = slen
    while si > 0 {
        var b = (si - 1) * 8
        var lft = B3Cv(stack[b + 0], stack[b + 1], stack[b + 2], stack[b + 3], stack[b + 4], stack[b + 5], stack[b + 6], stack[b + 7])
        var fl: i64 = 4
        if si == 1 {
            fl = 12
        }
        cv = parent_local(lft, cv, fl)
        si = si - 1
    }
    return hex_cv(cv)
}

// cv（8 字）→ 32 字节小端 hex。
func hex(cv: table<i64>) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < 8 {
        out = out + hex8_le(cv[i])
        i = i + 1
    }
    return out
}

// ---------- CAS 验证流（tink v3 §8）：叶 / 父 CV 封装 ----------

// 叶 CV：chunk（off/clen；counter = chunk 序号；非根）→ 32 字节小端 hex
pub func cas_leaf_hex(msg: string, off: i64, clen: i64, counter: i64) -> string {
    return hex_cv(chunk_cv(msg, len(msg), off, clen, counter, false))
}

// hex 字符 → 4 位值
func cas_nib(c: string) -> i64 {
    var v = char_code(c)
    if v >= 48 && v <= 57 { return v - 48 }
    if v >= 97 && v <= 102 { return v - 97 + 10 }
    if v >= 65 && v <= 70 { return v - 65 + 10 }
    return 0
}

// 64 字符 hex → B3Cv（8 字，逐字小端；与 hex_cv 互逆）
func cas_cv_from_hex(h: string) -> B3Cv {
    var w = table_new_i64()
    var k: i64 = 0
    while k < 8 {
        var b0 = cas_nib(str_char(h, k * 8)) * 16 + cas_nib(str_char(h, k * 8 + 1))
        var b1 = cas_nib(str_char(h, k * 8 + 2)) * 16 + cas_nib(str_char(h, k * 8 + 3))
        var b2 = cas_nib(str_char(h, k * 8 + 4)) * 16 + cas_nib(str_char(h, k * 8 + 5))
        var b3 = cas_nib(str_char(h, k * 8 + 6)) * 16 + cas_nib(str_char(h, k * 8 + 7))
        table_push(w, b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
        k = k + 1
    }
    return B3Cv(w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7])
}

// 父 CV：l/r 为 32 字节小端 hex；root = 顶层合并（PARENT|ROOT）否则 PARENT
pub func cas_parent_hex(l_hex: string, r_hex: string, root: bool) -> string {
    var l = cas_cv_from_hex(l_hex)
    var r = cas_cv_from_hex(r_hex)
    var fl: i64 = 4
    if root { fl = 12 }
    return hex_cv(parent_local(l, r, fl))
}

}   // namespace blake3

