type tie<logic>
import "../../tools/tiec/src/frontend/parser.tie"

func main() {
    var src = "import \"tests/_p91131_selimp_probe/lib_a.tie\".{" + "pub_a}\n"
    var rc = parser.parse_ast(src)
    println("rc=" + to_string(rc))
    if rc < 0 {
        println(parser.ast_err_protocol())
        exit(1)
    }
    exit(0)
}
