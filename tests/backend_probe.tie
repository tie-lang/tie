type tie<logic, unsafe:mem, unsafe:ext>
import "../lib/ir/ir.tie"
import "../lib/ir/types.tie"
import "../lib/support/interner.tie"
import "../lib/backend/render.tie"
import "../lib/jit/llvmc.tie"
namespace tie.tests.backend;
// backend_probe.tie —— 真实 IR → 后端 → LLJIT 的整条垂直切片
// ============================================================
// 运行（仓根）：
//   tiec tests/backend_probe.tie -o _local_only/bin/backend_probe.exe
//   _local_only/bin/backend_probe.exe
// 前置：_local_only/bin/tiej_llvm.dll。

var g_fail: i64 = 0

func chk(ok: bool, tag: string) {
    if ok {
        println("[PASS] " + tag)
    } else {
        println("[FAIL] " + tag)
        g_fail = g_fail + 1
    }
}

func build_add() {
    types.init_tup()
    types.init_sym()
    var t64 = types.named(3)
    var params: table<i64> = [t64, t64]
    var f = ir.new_func(interner.intern("jadd"), t64, params)
    var blk = ir.new_block(f, interner.intern("entry"))
    var i = ir.new_inst(blk, 0, t64)
    ir.add_operand(i, 0, 0)
    ir.add_operand(i, 1, 0)
    var r = ir.new_inst(blk, 32, -1)
    ir.add_operand(r, ir.get_value(i), 0)
}

func main() {
    build_add()
    var ll = tie.backend::render(ir.ctx_current())
    chk(str_len(ll) > 0, "render")
    println(ll)
    chk(tie.jit::available(), "tiej_llvm.dll available")
    if !tie.jit::available() {
        return
    }
    var j = tie.jit::open()
    chk(j != 0, "jit open")
    if j == 0 {
        return
    }
    var rc = tie.jit::add_ir(j, ll)
    if rc != 0 {
        println("[jit] " + tie.jit::last_error())
    }
    chk(rc == 0, "add_ir")
    var a = tie.jit::lookup(j, "jadd")
    chk(a != 0, "lookup jadd")
    if a != 0 {
        unsafe {
            var r = dyn_call_p(a, 3, 4, 0, 0, 0)
            chk(r == 7, "jadd(3,4) = " + to_string(r))
            var r2 = dyn_call_p(a, 0 - 5, 5, 0, 0, 0)
            chk(r2 == 0, "jadd(-5,5) = " + to_string(r2))
        }
    }
    tie.jit::close(j)
    if g_fail == 0 {
        println("ALL:PASS")
    } else {
        println("FAIL:" + to_string(g_fail))
    }
}
