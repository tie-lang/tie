type tie<logic, unsafe:mem, unsafe:ext>
import "../lib/jit/llvmc.tie"
namespace tie.tests.jit;
// jit_probe.tie —— LLVM 层第一档（纯函数）：手写 .ll → LLJIT → 查符号 → 调用
// ============================================================
// 运行（仓根）：
//   tiec tests/jit_probe.tie -o _local_only/bin/jit_probe.exe
//   _local_only/bin/jit_probe.exe
// 前置：_local_only/bin/tiej_llvm.dll 已按 lib/jit/tiej_llvm.c 头注释构建。

var IR: string = "define i64 @jadd(i64 %a, i64 %b) {\nentry:\n  %r = add i64 %a, %b\n  ret i64 %r\n}\n\ndefine i64 @jmul(i64 %a, i64 %b) {\nentry:\n  %r = mul i64 %a, %b\n  ret i64 %r\n}\n"

var g_fail: i64 = 0

func chk(ok: bool, tag: string) {
    if ok {
        println("[PASS] " + tag)
    } else {
        println("[FAIL] " + tag)
        g_fail = g_fail + 1
    }
}

func main() {
    chk(tie.jit::available(), "tiej_llvm.dll available")
    if !tie.jit::available() {
        return
    }
    var j = tie.jit::open()
    chk(j != 0, "open")
    if j == 0 {
        println("[jit] " + tie.jit::last_error())
        return
    }
    var rc = tie.jit::add_ir(j, IR)
    if rc != 0 {
        println("[jit] " + tie.jit::last_error())
    }
    chk(rc == 0, "add_ir")
    var a = tie.jit::lookup(j, "jadd")
    chk(a != 0, "lookup jadd")
    if a != 0 {
        unsafe {
            var r = dyn_call_p(a, 3, 4, 0, 0, 0)
            chk(r == 7, "jadd(3,4) = " + to_string(r))
            var r2 = dyn_call_p(a, 0 - 5, 5, 0, 0, 0)
            chk(r2 == 0, "jadd(-5,5) = " + to_string(r2))
        }
    }
    var m = tie.jit::lookup(j, "jmul")
    chk(m != 0, "lookup jmul")
    if m != 0 {
        unsafe {
            var r3 = dyn_call_p(m, 6, 7, 0, 0, 0)
            chk(r3 == 42, "jmul(6,7) = " + to_string(r3))
        }
    }
    tie.jit::close(j)
    if g_fail == 0 {
        println("P1 ALL:PASS")
    } else {
        println("P1 FAIL:" + to_string(g_fail))
    }
}
