type tie<logic>
// 表克隆内建 table_clone(t) 机制验收（规范 §13.5 克隆）
// 规格：返回与源完全独立的副本——数据缓冲、锁、长度各自一份；
// 元素为深表时内层表也递归深克隆，因此改副本的内层元素不会回写源。
import "/std/assert.tie"
using assert;

func main() -> i64 {
    // 1. 浅表：副本内容与源一致，之后两者长度互不影响
    var xs: table<i64> = table_new_i64()
    table_push(xs, 1)
    table_push(xs, 2)
    var ys: table<i64> = table_clone(xs)
    assert.assert_eq(len(xs), 2)
    assert.assert_eq(len(ys), 2)
    table_push(xs, 3)
    assert.assert_eq(len(xs), 3)
    assert.assert_eq(len(ys), 2)

    // 2. 下标写隔离：改副本不回写源（独立缓冲，非同一句柄）
    ys[0] = 77
    assert.assert_eq(ys[0], 77)
    assert.assert_eq(xs[0], 1)
    table_push(ys, 9)
    assert.assert_eq(ys[2], 9)
    assert.assert_eq(len(ys), 3)
    assert.assert_eq(len(xs), 3)

    // 3. 空表克隆：得到独立空表，向副本 push 不影响源
    var e: table<i64> = table_new_i64()
    var e2: table<i64> = table_clone(e)
    assert.assert_eq(len(e2), 0)
    table_push(e2, 5)
    assert.assert_eq(len(e), 0)
    assert.assert_eq(len(e2), 1)

    // 4. 字符串表：元素 (ptr,len) 按字节拷贝，内容一致且互不影响
    var ss: table<string> = table_new_string()
    table_push(ss, "ab")
    table_push(ss, "cd")
    var sc: table<string> = table_clone(ss)
    assert.assert_eq(sc[0], "ab")
    assert.assert_eq(sc[1], "cd")
    table_push(sc, "ef")
    assert.assert_eq(len(ss), 2)
    assert.assert_eq(len(sc), 3)

    // 5. 深表：内层表逐元素 retain，改副本内层不影响源
    var d: table<table<i64>> = [1, 2; 3, 4]
    var dc: table<table<i64>> = table_clone(d)
    assert.assert_eq(len(dc), 2)
    assert.assert_eq(dc[0][1], 2)
    assert.assert_eq(dc[1][0], 3)
    dc[0][0] = 99
    assert.assert_eq(dc[0][0], 99)
    assert.assert_eq(d[0][0], 1)
    return 0
}
