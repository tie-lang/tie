type tie<logic>
// ============================================================================
// param_shared_probe.tie —— r.1.6.12 `shared` 形参修饰符（正例）
// ----------------------------------------------------------------------------
// 语义：`shared` 声明「该形参**共享**调用方的值，不做任何复制」。
//   · 对表/聚合：调用方与本函数看同一份底层数据，函数内写入调用方可见。
//   · 与 `deep` 语义对立（deep = 入口深拷贝、完全独立）⇒ 同槽双标由语义层拒绝。
//
// 定位：`shared` 是**显式共享**的书写面——把当前「隐式共享」变成可读的意图声明，
// 并为后续「默认值语义 + 显式共享」的演进提供迁移目标（见 ROAD 表语义条目）。
// 今天它与默认行为等价（默认即共享），故本条只断言「可解析、可运行、语义确为共享」。
//
// 期望输出（逐行）：
//   shared-ref len=2
//   shared-struct len=1
//   shared-plain-table len=3
//   PARAMSHARED PASS
// ============================================================================

struct S {
    var t: table<i64> = [];
}

// ① shared + ref：可写借用（共享，不复制）
func acc(shared into: ref table<i64>, v: i64) {
    table_push(into, v)
}

// ② shared 用于聚合形参：表字段共享，函数内 push 调用方可见
func grow(shared s: S) -> i64 {
    var h = s.t
    table_push(h, 1)
    return len(h)
}

// ③ shared 用于普通表形参（非 ref）
func touch(shared t: table<i64>) -> i64 {
    return len(t)
}

func main() {
    var fails: i64 = 0

    var a = table_new_i64()
    acc(a, 5)
    acc(a, 6)
    println("shared-ref len=" + to_string(len(a)))
    if len(a) != 2 {
        fails = fails + 1
    }

    var st = S([])
    var got = grow(st)
    println("shared-struct len=" + to_string(got))
    if got != 1 {
        fails = fails + 1
    }

    var c = table_new_i64()
    table_push(c, 1)
    table_push(c, 2)
    table_push(c, 3)
    var n = touch(c)
    println("shared-plain-table len=" + to_string(n))
    if n != 3 {
        fails = fails + 1
    }

    if fails > 0 {
        println("PARAMSHARED FAIL(" + to_string(fails) + ")")
    } else {
        println("PARAMSHARED PASS")
    }
}
