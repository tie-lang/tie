type tie<logic>
import "/std/result.tie"
import "/std/assert.tie"
using assert;

func dbl(v: i64) -> i64 {
    return v * 2
}

func validate(v: i64) -> Result<i64, string> {
    if v < 0 {
        return Result.Err("负数")
    }
    return Result.Ok(v)
}

func main() -> i64 {
    var r: Result<i64, string> = tp_i64("21")
    // 具名函数实参：类型实参由实参类型推断
    var a = map_result(dbl, r)
    switch a {
        case Ok(v):
            assert.assert_eq(v, 42)
        case Err(e):
            panic("unexpected err")
    }
    // 短闭包实参：泛型被调方需显式写出类型实参
    var b = r -> map_result<i64, i64, string>(v -> v + 1)
    switch b {
        case Ok(v):
            assert.assert_eq(v, 22)
        case Err(e):
            panic("unexpected err")
    }
    // Err 短路：f 不被调用，错误原样传递
    var r2: Result<i64, string> = tp_i64("abc")
    var c = map_result<i64, i64, string>(v -> v * 100, r2)
    switch c {
        case Ok(v):
            panic("should be err")
        case Err(e):
            assert.assert_eq(e, "整数含有非数字字符")
    }
    // and_then：成功继续、失败短路
    var d = and_then(validate, r)
    switch d {
        case Ok(v):
            assert.assert_eq(v, 21)
        case Err(e):
            panic("unexpected err")
    }
    var e0: Result<i64, string> = Result.Ok(0 - 3)
    var e = and_then<i64, i64, string>(validate, e0)
    switch e {
        case Ok(v):
            panic("should be err")
        case Err(msg):
            assert.assert_eq(msg, "负数")
    }
    println("result combinator probe 全过")
    return 0
}
