type tie<logic>
// 第 14 章元素块探针：声明式元素块在解析期降解为 ui.* 调用，
// 运行时由 std/ui.tie 记录独立于 tiu 的中立描述。
import "/std/assert.tie" as assert

func main() -> i64 {
    @ window "主窗口" (id: root) {
        @ panel "内容" (pad: 8) {
            @ label "提示" (text: "hello")
        }
    }
    assert.assert_eq(ui.count(), 3)
    assert.assert_eq(ui.kind_at(0), "window")
    assert.assert_eq(ui.name_at(0), "主窗口")
    assert.assert_eq(ui.root_count(), 1)
    assert.assert_eq(ui.root_at(0), 0)
    assert.assert_eq(ui.child_count(0), 1)
    assert.assert_eq(ui.child_at(0, 0), 1)
    assert.assert_eq(ui.parent_at(1), 0)
    assert.assert_eq(ui.attr_of(0, "id"), "root")
    assert.assert_eq(ui.attr_of(1, "pad"), "8")
    assert.assert_eq(ui.attr_of(2, "text"), "hello")
    assert.assert_eq(ui.find("内容"), 1)
    return 0
}
