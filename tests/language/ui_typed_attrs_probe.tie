type tie<logic>
// 第 14 章属性类型化探针：§9 键类型表与值侧语法糖。
// 元素头 `(...)` 与元素体 `键: 值;` 两条路径都要把类型化值降解成规范字符串
// 写回 ui.attr_of，未登记键仍原样捕获原文。
import "/std/assert.tie" as assert

func main() -> i64 {
    var off: i64 = 7
    @ window "主窗口" (id: root, w: fill, h: 480, min-w: 200, max-w: 60%, min-h: 2fr, max-h: 1.5em, x: center, y: space-between, overflow: scroll, anchor: bottom-start, pad: 12, pad-x: 4, gap: 8, dy: off, radius: 6, style: card, modal: true) {
        @ label "提示" {
            text: "hello";
            w: hug;
            h: 12pt;
            min-w: 50vw;
            max-w: 50vh;
            x: end;
            y: space-evenly;
            overflow: expand;
            anchor: fill;
            pad-y: 6;
        }
        @ image "封面" (w: ratio(16:9), h: 200px, min-h: 0, min-w: Size.pct(25), anchor: center, dx: -6)
    }
    assert.assert_eq(ui.count(), 3)
    assert.assert_eq(ui.kind_at(0), "window")
    assert.assert_eq(ui.name_at(1), "提示")
    assert.assert_eq(ui.child_count(0), 2)
    assert.assert_eq(ui.attr_count(0), 18)
    assert.assert_eq(ui.attr_count(1), 10)
    assert.assert_eq(ui.attr_count(2), 6)
    // 元素头：尺寸键
    assert.assert_eq(ui.attr_of(0, "w"), "fill")
    assert.assert_eq(ui.attr_of(0, "h"), "480")
    assert.assert_eq(ui.attr_of(0, "min-w"), "200")
    assert.assert_eq(ui.attr_of(0, "max-w"), "60%")
    assert.assert_eq(ui.attr_of(0, "min-h"), "2fr")
    assert.assert_eq(ui.attr_of(0, "max-h"), "1.5em")
    // 元素头：词表键
    assert.assert_eq(ui.attr_of(0, "x"), "center")
    assert.assert_eq(ui.attr_of(0, "y"), "space-between")
    assert.assert_eq(ui.attr_of(0, "overflow"), "scroll")
    assert.assert_eq(ui.attr_of(0, "anchor"), "bottom-start")
    // 元素头：长度键与样式键
    assert.assert_eq(ui.attr_of(0, "pad"), "12")
    assert.assert_eq(ui.attr_of(0, "pad-x"), "4")
    assert.assert_eq(ui.attr_of(0, "gap"), "8")
    assert.assert_eq(ui.attr_of(0, "dy"), "7")
    assert.assert_eq(ui.attr_of(0, "radius"), "6")
    assert.assert_eq(ui.attr_of(0, "style"), "card")
    // 未登记键：原样捕获 / 布尔
    assert.assert_eq(ui.attr_of(0, "id"), "root")
    assert.assert_eq(ui.attr_of(0, "modal"), "true")
    // 元素体：`键: 值;` 走同一套降解
    assert.assert_eq(ui.attr_of(1, "text"), "hello")
    assert.assert_eq(ui.attr_of(1, "w"), "hug")
    assert.assert_eq(ui.attr_of(1, "h"), "12pt")
    assert.assert_eq(ui.attr_of(1, "min-w"), "50vw")
    assert.assert_eq(ui.attr_of(1, "max-w"), "50vh")
    assert.assert_eq(ui.attr_of(1, "x"), "end")
    assert.assert_eq(ui.attr_of(1, "y"), "space-evenly")
    assert.assert_eq(ui.attr_of(1, "overflow"), "expand")
    assert.assert_eq(ui.attr_of(1, "anchor"), "fill")
    assert.assert_eq(ui.attr_of(1, "pad-y"), "6")
    // 比率、像素后缀、零值、负偏移、表达式逃生口
    assert.assert_eq(ui.attr_of(2, "w"), "ratio(16:9)")
    assert.assert_eq(ui.attr_of(2, "h"), "200")
    assert.assert_eq(ui.attr_of(2, "min-h"), "0")
    assert.assert_eq(ui.attr_of(2, "min-w"), "25%")
    assert.assert_eq(ui.attr_of(2, "anchor"), "center")
    assert.assert_eq(ui.attr_of(2, "dx"), "-6")
    println("ui typed attrs ok")
    return 0
}
