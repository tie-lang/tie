type tie<logic>
// 降解为 ui.unit_decl(kind, 名, "键:值;键:值") 并注入 main 体开头（声明即注册）；
// 属性值是块体 token 原文拼接，故 `#2d7ff9`、`12px` 等无需新的字面量语法。
import "/std/assert.tie"
using assert;

style Button {
    accent: #2d7ff9;
    radius: 12px;
}

@theme dark {
    surface: #1e1e1e;
}

func main() -> i64 {
    assert.assert_eq(ui.unit_count(), 2)
    assert.assert_eq(ui.unit_prop("style", "Button", "accent"), "#2d7ff9")
    assert.assert_eq(ui.unit_prop("style", "Button", "radius"), "12px")
    assert.assert_eq(ui.unit_prop("theme", "dark", "surface"), "#1e1e1e")
    assert.assert_eq(ui.unit_prop("style", "Button", "missing"), "")
    println("style ok")
    return 0
}
