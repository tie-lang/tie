type tie<logic>
// 第 14 章运行时 API 探针：元素树 / 类型化属性 / 函数值事件 / 端口 / 单元 / 图。
import "/std/assert.tie"
import "/std/ui.tie" as ui
import "/std/graph.tie" as graph
using assert;

func on_click(id: i64, x: i64, y: i64, kind: string) -> i64 {
    return id * 10 + x + y
}

func main() -> i64 {
    ui.reset()
    assert_eq(ui.begin("window", "w"), 0)
    ui.attr_i64("size", 480)
    ui.attr_str("title", "设置")
    ui.attr_raw("color", "#2d7ff9")
    ui.attr_bool("modal", true)
    ui.attr_expr("count", 3)
    assert_eq(ui.attr_of(0, "size"), "480")
    assert_eq(ui.attr_of(0, "modal"), "true")
    assert_eq(ui.attr_of(0, "color"), "#2d7ff9")
    assert_eq(ui.attr_of(0, "count"), "3")
    ui.begin("button", "ok")
    ui.content("保存")
    ui.port_add("save")
    assert_eq(ui.on("click", on_click), 0)
    ui.end()
    ui.end()
    assert_eq(ui.count(), 3)
    assert_eq(ui.child_count(0), 1)
    assert_eq(ui.child_at(0, 0), 1)
    assert_eq(ui.port_at(1, 0), "save")
    assert_eq(ui.has_fn_event(1, "click"), true)
    assert_eq(ui.fire_at(1, "click", 2, 3, "click"), 15)

    var st = ui.unit_begin("style", "Button")
    ui.unit_prop_raw(st, "accent", "#2d7ff9")
    ui.unit_rule(st, ".title", "前景", "表面色")
    assert_eq(ui.unit_prop_find("style", "Button", "accent"), "#2d7ff9")
    assert_eq(ui.rule_sel_at(st, 0), ".title")
    assert_eq(ui.rule_val_at(st, 0), "表面色")
    ui.theme_set("dark", "表面色", "深灰900")
    assert_eq(ui.theme_get("dark", "表面色"), "深灰900")
    ui.layer_decl("base")
    assert_eq(ui.layer_at(0), "base")

    graph.g_reset()
    var g = graph.g_new("Pipeline")
    graph.g_add_node(g, "fetch")
    graph.g_add_node(g, "parse")
    graph.g_add_node(g, "store")
    graph.g_add_edge(g, "fetch", "parse", true)
    graph.g_add_edge(g, "parse", "store", false)
    assert_eq(graph.g_count(), 1)
    assert_eq(graph.g_node_count(g), 3)
    assert_eq(graph.g_edge_count(g), 2)
    assert_eq(graph.g_edge_to(g, 0), "parse")
    assert_eq(graph.g_edge_when(g, 1), false)
    assert_eq(graph.g_out_count(g, "fetch"), 1)
    assert_eq(graph.g_out_at(g, "fetch", 0), "parse")
    println("ui api ok")
    return 0
}
