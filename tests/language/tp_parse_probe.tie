type tie<logic>
// tp_ 族（可预期失败的文本解析）机制验收探针
// 规格 §2.11：tp_i64(s) / tp_f64(s) 解析失败返回 Result::Err，由调用方分支处理；
// 接受的语言与 to_i64 / to_f64 完全一致（整串消费、无空白、无十六进制、无下划线）。
import "/std/result.tie"
import "/std/assert.tie"
using assert;

func expect_i(s: string, want: i64) {
    switch tp_i64(s) {
        case Ok(v): assert.assert_eq(v, want)
        case Err(e): panic("tp_i64 意外失败: " + e)
    }
}

func expect_i_err(s: string) {
    switch tp_i64(s) {
        case Ok(v): panic("tp_i64 应当失败却成功")
        case Err(e): return
    }
}

func expect_f(s: string, want: f64) {
    switch tp_f64(s) {
        case Ok(v): assert.assert_eq(v, want)
        case Err(e): panic("tp_f64 意外失败: " + e)
    }
}

func expect_f_err(s: string) {
    switch tp_f64(s) {
        case Ok(v): panic("tp_f64 应当失败却成功")
        case Err(e): return
    }
}

func main() {
    // 整型：合法形态
    expect_i("0", 0)
    expect_i("42", 42)
    expect_i("-7", -7)
    expect_i("+9", 9)
    expect_i("007", 7)
    expect_i("-0", 0)
    expect_i("9223372036854775807", 9223372036854775807)
    expect_i("-9223372036854775808", -9223372036854775807 - 1)
    // 整型：应当拒绝
    expect_i_err("")
    expect_i_err("+")
    expect_i_err("-")
    expect_i_err("12a")
    expect_i_err(" 42")
    expect_i_err("42 ")
    expect_i_err("0x10")
    expect_i_err("1_000")
    expect_i_err("9223372036854775808")
    expect_i_err("-9223372036854775809")
    expect_i_err("99999999999999999999999")
    // 浮点：合法形态
    expect_f("3.5", 3.5)
    expect_f("-0.25", -0.25)
    expect_f(".5", 0.5)
    expect_f("5.", 5.0)
    expect_f("1e3", 1000.0)
    expect_f("1.5e-2", 0.015)
    expect_f("0", 0.0)
    // 浮点：应当拒绝
    expect_f_err("")
    expect_f_err(".")
    expect_f_err("abc")
    expect_f_err("1.2.3")
    expect_f_err("1e")
    expect_f_err("1e+")
    expect_f_err("12abc")
    println("tp 族探针全过")
}
