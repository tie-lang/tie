type tie<logic>
// heap_dup_move_neg.tie —— 负例：可变容器的重复转移必须被拒绝
// ============================================================================
// tie 的表赋值是**浅拷贝共享**（实测 `var b = a; b[0]=99` 会改到 `a[0]`），
// 若同一份可变数据被两处同时持有，写入互相可见，故转移必须可追踪。
// §13.2 规定所有权转移要**显式**：`var b = a` 属 §13.1「按值赋值」，原位置
// 继续有效，不产生转移（对照：string 是不可变值，同样不做此检查）。
// 转移只发生在两处：显式 `move` 形参的实参位、凭据（§11.6 身份唯一）。
// 本负例用前者：第 2 次 `take(a)` 时 a 已被移走，必须报「已移动」。
// （2026-10-03 之前按类型推断消耗源，`var b = a; var c = a` 本身即违规；该
//   推断与 §13.1 冲突已废止，见 lib/front/smove_stmt.tie 的 VarDecl 注释。）

func take(move t: table<i64>) -> i64 {
    return len(t)
}

func dup_table() -> i64 {
    var a: table<i64> = [1, 2, 3]
    var b = take(a)
    var c = take(a)
    return b + c
}

func main() {
    println(to_string(dup_table()))
}
