type tie<class>
// lib_math.tie：import 验证用的库文件（被主文件导入）；角色 library → 可独立编译为静态库
// 只定义函数，不定义 main。示例库使用命名空间形式：mathlib.add / mathlib.mul 等。

namespace mathlib;
pub func add(a: i64, b: i64) -> i64 {
    return a + b
}

pub func mul(a: i64, b: i64) -> i64 {
    return a * b
}

pub func greet(name: string) -> string {
    return "Hello, " + name
}

pub func max2(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}
